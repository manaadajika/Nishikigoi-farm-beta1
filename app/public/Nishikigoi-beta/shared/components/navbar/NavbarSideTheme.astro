---
import Icon from '@ui/Icon.astro'
---

<!-- BEGIN THEME TOGGLE -->
<div class="nav-item">
  <a href="?theme=dark" class="nav-link px-0 hide-theme-dark js-theme-toggle" title="Enable dark mode" data-theme-value="dark" data-bs-toggle="tooltip" data-bs-placement="bottom">
    <Icon name="moon" />
