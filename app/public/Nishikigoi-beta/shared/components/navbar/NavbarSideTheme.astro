  <a href="?theme=light" class="nav-link px-0 hide-theme-light js-theme-toggle" title="Enable light mode" data-theme-value="light" data-bs-toggle="tooltip" data-bs-placement="bottom">
    <Icon name="sun" />
  </a>
</div>
<!-- END THEME TOGGLE -->
