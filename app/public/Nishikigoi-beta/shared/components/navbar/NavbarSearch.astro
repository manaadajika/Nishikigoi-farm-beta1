---
// breakpoint param (default 'lg') is unused.
// Form action is "./" for root-level pages.
import InputIcon from '@ui/form/InputIcon.astro'

interface Props {
  class?: string
  rounded?: boolean
}

const { class: className, rounded = false } = Astro.props
---

<!-- BEGIN NAVBAR SEARCH -->
<div class:list={['navbar-global-search', className]}>
  <InputIcon prepend rounded={rounded} id="navbar-global-search" name="global_search" autocomplete="off" ariaLabel="Cari data" placeholder="Cari data..." inputClass="navbar-global-search-input" />
  <button type="button" class="navbar-global-search-clear" data-navbar-search-clear aria-label="Hapus pencarian" title="Hapus pencarian">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M18 6l-12 12" /><path d="M6 6l12 12" /></svg>
  </button>
</div>
<!-- END NAVBAR SEARCH -->

<script is:inline>
  ;(() => {
    const normalize = (value) =>
      String(value || '')
        .toLowerCase()
        .trim()

    const pageSearchSelector = ['[data-koi-search]', '[data-pond-search]', '[data-gallery-search]', '[data-report-search]', '[data-breeding-search]', '[data-log-search]', '[data-sell-search]', '[data-invoice-search]', '[data-inventory-search]'].join(', ')

    const getPageSearch = () => {
      const candidates = Array.from(document.querySelectorAll(pageSearchSelector)).filter((input) => !input.closest('.modal, .dropdown-menu, #offcanvas-settings'))

      return candidates.find((input) => input.matches('[data-breeding-search], [data-report-search], [data-gallery-search], [data-koi-search], [data-pond-search], [data-log-search], [data-sell-search], [data-invoice-search], [data-inventory-search]')) || null
    }

    const getSearchTargets = () => {
      const tableRows = Array.from(document.querySelectorAll('tbody tr')).filter((row) => row.children.length)
      const cards = Array.from(document.querySelectorAll('.card')).filter((card) => {
        if (card.closest('.modal, .dropdown-menu, #offcanvas-settings')) return false
        return !card.querySelector('table')
      })
      return tableRows
    }

    const applyGlobalSearch = (query) => {
      const pageSearch = getPageSearch()

      if (pageSearch && pageSearch.value !== query) {
        pageSearch.value = query
        pageSearch.dispatchEvent(new Event('input', { bubbles: true }))
        return
      }

      const text = normalize(query)
      const terms = text.split(/\s+/).filter(Boolean)
      getSearchTargets().forEach((target) => {
        const haystack = normalize(target.dataset.searchText || target.textContent || '')
        const matches = target.dataset.searchText ? terms.some((term) => haystack.includes(term)) : terms.every((term) => haystack.includes(term))
        target.classList.toggle('d-none', terms.length > 0 && !matches)
      })

      document.querySelectorAll('tbody tr.table-active').forEach((groupRow) => {
        if (terms.length === 0) {
          groupRow.classList.remove('d-none')
          return
        }

        let hasVisibleItem = false
        let row = groupRow.nextElementSibling
        while (row && !row.classList.contains('table-active')) {
          if (!row.classList.contains('d-none')) {
            hasVisibleItem = true
            break
          }
          row = row.nextElementSibling
        }

        groupRow.classList.toggle('d-none', !hasVisibleItem)
      })
    }

    const syncSearchClear = (input) => {
      const wrapper = input.closest('.navbar-global-search')
      wrapper?.classList.toggle('has-value', Boolean(input.value))
    }

    const bindSearch = () => {
      document.querySelectorAll('.navbar-global-search-input').forEach((input) => {
        if (input.dataset.globalSearchReady) return
        input.dataset.globalSearchReady = 'true'
        input.addEventListener('input', () => {
          applyGlobalSearch(input.value)
          syncSearchClear(input)
        })
        input.closest('.navbar-global-search')?.querySelector('[data-navbar-search-clear]')?.addEventListener('click', () => {
          input.value = ''
          applyGlobalSearch('')
          syncSearchClear(input)
          input.focus()
        })
        syncSearchClear(input)
      })

      const pageSearch = getPageSearch()
      const globalSearch = document.querySelector('.navbar-global-search-input')
      if (pageSearch && globalSearch && pageSearch.value && !globalSearch.value) {
        globalSearch.value = pageSearch.value
        syncSearchClear(globalSearch)
      }
    }

    bindSearch()
    document.addEventListener('DOMContentLoaded', bindSearch)
  })()
</script>

<style>
  .navbar-global-search {
    width: min(34vw, 360px);
  }

  /* position:relative only below md: at md+ the wrapper already gets
     position:absolute from Navbar.astro (for its floating centered layout),
     and overriding that back to relative here would break the centering. */
  @media (max-width: 767.98px) {
    .navbar-global-search {
      position: relative;
    }
  }

  :global(.navbar-global-search-input) {
    min-width: 0;
  }

  .navbar-global-search-clear {
    display: none;
    position: absolute;
    top: 50%;
    right: .5rem;
    transform: translateY(-50%);
    border: 0;
    background: none;
    padding: .2rem;
    line-height: 0;
    color: var(--tblr-secondary);
    cursor: pointer;
  }

  .navbar-global-search-clear:hover {
    color: var(--tblr-body-color);
  }

  .navbar-global-search.has-value .navbar-global-search-clear {
    display: flex;
  }

  .navbar-global-search.has-value :global(.navbar-global-search-input) {
    padding-right: 2rem;
  }

  @media (max-width: 767.98px) {
    .navbar-global-search {
      order: 10 !important;
      width: 100%;
      margin: .45rem 0 0 !important;
      flex: 0 0 100%;
    }

    :global(.navbar-global-search .input-icon) {
      width: 100%;
    }

    :global(.navbar-global-search-input) {
      width: 100%;
      height: 2.35rem;
      border-radius: var(--tblr-border-radius);
    }
  }
</style>
