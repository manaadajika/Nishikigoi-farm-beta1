---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
---

<DefaultLayout title="Laporan" pageHeader="Laporan" pretitle="Management" pageMenu="farm-reports">
  <style is:global>
    .report-spectrum-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:.5rem}
    .report-spectrum-grid.is-empty{display:none}
    .report-spectrum-item{border:1px solid var(--tblr-border-color);border-radius:.5rem;padding:.65rem .75rem;background:var(--tblr-bg-surface);color:var(--tblr-body-color);display:flex;align-items:center;justify-content:space-between;gap:.75rem}
    .report-spectrum-label{font-size:.75rem;font-weight:700;line-height:1.2;color:var(--tblr-secondary)}
    .report-spectrum-count{font-weight:700;white-space:nowrap}
    .report-media-preview{width:96px;aspect-ratio:2/3;height:auto;object-fit:cover;cursor:zoom-in}.report-token-list{min-height:2.25rem}
    .report-form-section{border:1px solid var(--tblr-border-color);border-radius:.55rem;background:rgba(var(--tblr-body-color-rgb),.015);padding:1rem;margin-top:1rem}
    .report-form-section>h4:first-child,.report-form-section .section-title{margin-top:0}
    .report-linked-card{border:1px solid var(--tblr-border-color);border-radius:.5rem;background:var(--tblr-bg-surface);padding:.75rem}
    .report-linked-main{display:grid;grid-template-columns:76px 1fr auto;gap:.75rem;align-items:start}
    .report-linked-main.is-breeding{grid-template-columns:1fr auto}
    .report-linked-preview{width:76px;aspect-ratio:2/3;border-radius:.5rem;overflow:hidden;border:1px solid var(--tblr-border-color);background:var(--tblr-bg-surface-secondary);display:flex;align-items:center;justify-content:center;color:var(--tblr-secondary);font-size:.7rem;text-align:center;cursor:zoom-in;padding:0}
    .report-linked-preview img{width:100%;height:100%;object-fit:contain;display:block}
    .report-linked-title{font-weight:700}.report-linked-meta{font-size:.75rem;color:var(--tblr-secondary)}
    .report-linked-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem .75rem;margin-top:.4rem;font-size:.75rem;color:var(--tblr-secondary)}
    .report-linked-details strong{display:block;color:var(--tblr-body-color);font-size:.82rem}
    .report-parent-list{display:grid;gap:.5rem;margin-top:.6rem}.report-parent-chip{display:grid;grid-template-columns:44px 1fr;gap:.6rem;align-items:start;border:1px solid var(--tblr-border-color);border-radius:.45rem;background:var(--tblr-bg-surface-secondary);padding:.5rem}.report-parent-chip img,.report-parent-chip span:first-child{width:44px;aspect-ratio:2/3;border-radius:.35rem;object-fit:cover;background:var(--tblr-bg-surface);display:flex;align-items:center;justify-content:center;color:var(--tblr-secondary);font-size:.65rem}.report-parent-control{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:.5rem;align-items:center;margin-top:.45rem}
    .report-linked-controls{display:grid;grid-template-columns:minmax(140px,max-content) minmax(0,1fr);gap:.5rem;align-items:center;margin-top:.6rem}
    .report-linked-controls.has-role{grid-template-columns:minmax(140px,max-content) 170px minmax(0,1fr)}
    .report-preview-lightbox{position:fixed;inset:0;z-index:1085;background:rgba(5,10,20,.86);display:flex;align-items:center;justify-content:center;padding:1.5rem}.report-preview-lightbox img,.report-preview-lightbox video{max-width:min(92vw,980px);max-height:90vh;object-fit:contain;border-radius:.5rem;background:#111}.report-preview-close{position:absolute;top:1rem;right:1rem}
    .report-search-wrap{position:relative}
    .report-search-menu{position:absolute;top:calc(100% + .25rem);left:0;right:0;z-index:30;max-height:280px;overflow:auto;border:1px solid var(--tblr-border-color);border-radius:var(--tblr-border-radius);background:var(--tblr-bg-surface);box-shadow:var(--tblr-shadow-dropdown)}
    .report-search-item{width:100%;border:0;border-bottom:1px solid var(--tblr-border-color);padding:.6rem .75rem;background:transparent;color:var(--tblr-body-color);text-align:left;display:flex;align-items:center;gap:.65rem}
    .report-search-item:last-child{border-bottom:0}
    .report-search-item:hover,.report-search-item:focus{background:var(--tblr-bg-surface-secondary);color:var(--tblr-primary);outline:0}
    .report-search-thumb{width:42px;height:52px;flex:0 0 42px;border:1px solid var(--tblr-border-color);border-radius:var(--tblr-border-radius);object-fit:cover;background:var(--tblr-bg-surface-secondary);display:flex;align-items:center;justify-content:center;color:var(--tblr-secondary);font-size:.7rem;font-weight:700}
    .report-search-copy{min-width:0}
    .report-table-wrap{overflow:visible}
    .report-actions-cell{position:relative;white-space:nowrap}
    .report-actions-menu{z-index:1040}
    @media (max-width: 767.98px){
      .report-table-wrap{overflow-x:auto;overflow-y:visible;padding-bottom:5rem}
      .report-actions-dropdown .dropdown-menu.show{position:fixed!important;right:1rem!important;left:auto!important;top:auto!important;bottom:1rem!important;transform:none!important;min-width:150px}
    }
    .report-search-title{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.report-search-meta{font-size:.75rem;color:var(--tblr-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    @media (max-width:575.98px){.report-linked-main{grid-template-columns:64px 1fr}.report-linked-main .btn{grid-column:2;justify-self:start}.report-linked-preview{width:64px}.report-linked-controls,.report-linked-controls.has-role,.report-linked-details{grid-template-columns:1fr}}
  </style>

  <div class="modal modal-blur fade" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" data-report-modal>
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <form class="modal-content" data-report-form>
        <div class="modal-header">
          <h5 class="modal-title" data-report-modal-title>Formulir Tambah Laporan</h5>
          <button type="button" class="btn-close" aria-label="Tutup" data-report-cancel></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" data-report-error></div>
          <div class="alert alert-success d-none" data-report-success></div>
          <div class="report-form-section mt-0">
            <label class="form-label required">Jenis Laporan</label>
            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column flex-md-row">
              <label class="form-selectgroup-item flex-fill"><input type="radio" name="report_type" value="data_ulang" class="form-selectgroup-input" checked /><span class="form-selectgroup-label d-flex align-items-center p-3"><span class="me-3"><span class="form-selectgroup-check"></span></span><span><span class="form-selectgroup-title strong mb-1">Data Ulang</span><span class="d-block text-secondary">Isi field laporan sama dengan panen.</span></span></span></label>
              <label class="form-selectgroup-item flex-fill"><input type="radio" name="report_type" value="panen" class="form-selectgroup-input" /><span class="form-selectgroup-label d-flex align-items-center p-3"><span class="me-3"><span class="form-selectgroup-check"></span></span><span><span class="form-selectgroup-title strong mb-1">Panen</span><span class="d-block text-secondary">Isi field laporan sama dengan data ulang.</span></span></span></label>
            </div>
          </div>
          <div class="report-form-section"><div class="row g-3">
            <div class="col-md-3"><label class="form-label required">Tanggal</label><input class="form-control" type="date" name="report_date" required data-report-date /></div>
            <div class="col-md-3"><label class="form-label">Kode Batch</label><input class="form-control" name="batch_code" readonly data-batch-code placeholder="Otomatis" /></div>
            <div class="col-md-3"><label class="form-label">Judul Laporan</label><input class="form-control" name="report_title" placeholder="Contoh: Data ulang kolam A" /></div><div class="col-md-3"><label class="form-label">Varietas Dominan</label><div class="report-search-wrap"><input class="form-control" name="dominant_variety" placeholder="Contoh: Kohaku, Showa, Sanke" autocomplete="off" data-dominant-variety-search /><div class="report-search-menu d-none" data-dominant-variety-search-menu></div></div></div>
          </div></div>
          <div class="report-form-section">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2"><h4 class="mb-0">Lokasi Kolam</h4><button class="btn btn-sm" type="button" data-add-pond-entry>Tambah Lokasi</button></div>
            <div class="form-hint mb-2">Opsional. Bisa lebih dari satu. Isi lokasi, hasil, ukuran rata-rata, dan catatan masing-masing.</div>
            <datalist id="pond-options"></datalist><div class="vstack gap-2" data-pond-entry-list></div>
          </div>
          <div class="report-form-section">
            <h4>Kategori Ukuran (Spectrum Variance)</h4>
            <label class="form-label">Input Deret Ukuran Ikan (cm, pisah dengan spasi, koma, titik koma, atau baris baru - Opsional)</label>
            <textarea class="form-control" name="report_spectrum_input" rows="2" placeholder="Contoh: 12 19 24.5 101 atau 12, 19, 24.5" data-spectrum-input></textarea>
            <div class="report-spectrum-grid mt-3 is-empty" data-spectrum-grid></div>
          </div>
          <div class="report-form-section"><div class="row g-3">
            <div class="col-lg-6"><h4>Hubungkan Sesi Breeding</h4><div class="input-group mb-2 report-search-wrap"><input class="form-control" name="report_breeding_search" placeholder="Cari kode/nama sesi breeding" autocomplete="off" data-breeding-search /><button class="btn" type="button" data-add-breeding-entry>Tambah</button><div class="report-search-menu d-none" data-breeding-search-menu></div></div><div class="vstack gap-2" data-breeding-entry-list></div></div>
            <div class="col-lg-6"><h4>Mention Ikan</h4><div class="input-group mb-2 report-search-wrap"><input class="form-control" name="report_koi_search" placeholder="Cari kode/nama ikan" autocomplete="off" data-koi-search /><button class="btn" type="button" data-add-koi-entry>Tambah</button><div class="report-search-menu d-none" data-koi-search-menu></div></div><div class="vstack gap-2" data-koi-entry-list></div></div>
          </div></div>
          <div class="report-form-section"><div class="row g-3">
            <div class="col-lg-6"><h4>Petugas</h4><div class="input-group mb-2 report-search-wrap"><input class="form-control" name="report_account_search" placeholder="Cari nama / username" autocomplete="off" data-account-search /><button class="btn" type="button" data-add-account-entry>Tambah</button><div class="report-search-menu d-none" data-account-search-menu></div></div><div class="report-token-list d-flex flex-wrap gap-2" data-account-entry-list></div></div>
            <div class="col-lg-6"><h4>Checklist Validasi Website</h4><div class="form-selectgroup form-selectgroup-boxes d-flex flex-column"><label class="form-selectgroup-item flex-fill"><input type="checkbox" name="report_validation_check" value="ikan_di_foto" class="form-selectgroup-input" data-validation-check /><span class="form-selectgroup-label">Ikan di foto</span></label><label class="form-selectgroup-item flex-fill"><input type="checkbox" name="report_validation_check" value="ikan_masuk_web" class="form-selectgroup-input" data-validation-check /><span class="form-selectgroup-label">Ikan masuk web</span></label><label class="form-selectgroup-item flex-fill"><input type="checkbox" name="report_validation_check" value="ikan_di_pindah" class="form-selectgroup-input" data-validation-check /><span class="form-selectgroup-label">Ikan di pindah</span></label></div></div>
          </div></div>
          <div class="report-form-section"><h4>Media Laporan</h4><div class="d-flex flex-wrap gap-2"><input class="form-control flex-grow-1" name="report_media_files" type="file" accept="image/*,video/mp4,video/webm" multiple data-media-input /><button class="btn btn-outline-primary" type="button" data-media-paste>Paste Gambar</button></div><div class="form-hint">Bisa upload gambar atau video. Video maksimal 100 MB, format mp4/webm.</div><div class="row g-2 mt-2" data-media-preview-list></div><div class="mt-2 text-secondary" data-media-status></div></div>
          <div class="report-form-section"><label class="form-label">Catatan Laporan</label><textarea class="form-control" name="notes" rows="4" placeholder="Keterangan umum laporan. Opsional."></textarea></div>
        </div>
        <div class="modal-footer"><button class="btn" type="button" data-report-cancel>Batal</button><button class="btn btn-primary" type="submit" data-report-submit>Simpan Laporan</button></div>
      </form>
    </div>
  </div>
  <div class="row row-cards"><div class="col-12"><div class="card"><div class="card-header"><h3 class="card-title">Riwayat Laporan</h3><div class="card-actions"><button class="btn btn-primary" type="button" data-report-open>Tambah Laporan</button></div></div><div class="table-responsive report-table-wrap"><table class="table card-table table-vcenter table-hover"><thead><tr><th>Tanggal</th><th>Kode Batch</th><th>Judul Laporan</th><th>Jenis</th><th>Lokasi</th><th>Breeding</th><th>Petugas</th><th class="text-end">Aksi</th></tr></thead><tbody data-report-table><tr><td colspan="8" class="text-secondary">Memuat laporan.</td></tr></tbody></table></div></div></div></div>  <script>
    const apiUrl='/api'
    const form=document.querySelector('[data-report-form]')
    const reportModalElement=document.querySelector('[data-report-modal]')
    const reportModal=window.bootstrap?new window.bootstrap.Modal(reportModalElement,{backdrop:'static',keyboard:false}):null
    const modalTitle=document.querySelector('[data-report-modal-title]')
    const errorBox=document.querySelector('[data-report-error]')
    const successBox=document.querySelector('[data-report-success]')
    const submitButton=document.querySelector('[data-report-submit]')
    const reportDate=document.querySelector('[data-report-date]')
    const batchCodeInput=document.querySelector('[data-batch-code]')
    const reportTable=document.querySelector('[data-report-table]')
    const pondEntryList=document.querySelector('[data-pond-entry-list]')
    const breedingEntryList=document.querySelector('[data-breeding-entry-list]')
    const koiEntryList=document.querySelector('[data-koi-entry-list]')
    const accountEntryList=document.querySelector('[data-account-entry-list]')
    const mediaPreviewList=document.querySelector('[data-media-preview-list]')
    const mediaStatus=document.querySelector('[data-media-status]')
    const spectrumInput=document.querySelector('[data-spectrum-input]')
    const spectrumGrid=document.querySelector('[data-spectrum-grid]')
    const labels={data_ulang:'Data Ulang',panen:'Panen'}
    const spectrumRanges=[['up_to_12','UP TO 12 CM',0,12],['13_15','13 - 15 CM',13,15],['16_20','16 - 20 CM',16,20],['21_25','21 - 25 CM',21,25],['26_30','26 - 30 CM',26,30],['31_35','31 - 35 CM',31,35],['36_40','36 - 40 CM',36,40],['41_45','41 - 45 CM',41,45],['46_50','46 - 50 CM',46,50],['51_55','51 - 55 CM',51,55],['56_60','56 - 60 CM',56,60],['61_65','61 - 65 CM',61,65],['66_70','66 - 70 CM',66,70],['71_75','71 - 75 CM',71,75],['76_80','76 - 80 CM',76,80],['81_85','81 - 85 CM',81,85],['86_90','86 - 90 CM',86,90],['91_95','91 - 95 CM',91,95],['96_99','96 - 99 CM',96,99],['over_100','OVER 100 CM',100,Infinity]]
    let ponds=[],koiItems=[],breedingItems=[],accountItems=[],reportItems=[],mediaEntries=[],readonlyMode=false,editingReportId=null,reportRealtimeSignature=''
    const reportCacheKey='nishikigoi-cache:farm-reports'
    const escapeHtml=(value)=>String(value??'').replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]))
    const parseJson=(value,fallback=[])=>{try{return value?JSON.parse(value):fallback}catch{return fallback}}
    const formatDate=(value)=>value?new Date(`${String(value).slice(0,10)}T00:00:00`).toLocaleDateString('id-ID'):'-'
    const loadNextReportBatchCode=async()=>{if(editingReportId)return;const date=reportDate.value;if(!date){batchCodeInput.value='';return}try{const response=await fetch(`${apiUrl}/farm-report-next-code?date=${encodeURIComponent(date)}`);const data=await response.json();batchCodeInput.value=data.batch_code||''}catch{batchCodeInput.value=''}}
    const showForm=()=>reportModal?reportModal.show():(reportModalElement.classList.add('show'),reportModalElement.style.display='block')
    const hideForm=()=>reportModal?reportModal.hide():(reportModalElement.classList.remove('show'),reportModalElement.style.display='none')
    const findBySearch=(items,query,labeler)=>{const value=String(query||'').toLowerCase().trim();return items.find((item)=>labeler(item).toLowerCase()===value)||items.find((item)=>labeler(item).toLowerCase().includes(value))}
    const closeReportSearchMenus=(except=null)=>document.querySelectorAll('[data-koi-search-menu],[data-breeding-search-menu],[data-account-search-menu],[data-dominant-variety-search-menu]').forEach((menu)=>{if(menu!==except){menu.classList.add('d-none');menu.innerHTML=''}})
    const koiLabel=(item)=>[item.code,item.name,item.variety].filter(Boolean).join(' - ')
    const breedingLabel=(item)=>[item.batch_code,item.session_name].filter(Boolean).join(' - ')
    const accountLabel=(item)=>`${item.name||item.username} @${item.username}`
    const breedingRoleLabels={both:'Female & Male',female:'Female',male:'Male',none:'Tidak ditentukan'}
    const resolveMediaUrl=(value)=>{const raw=String(value||'').trim();if(!raw)return'';const resolved=window.KoiAuth?.apiUrl?window.KoiAuth.apiUrl(raw):raw;try{return new URL(resolved,window.location.origin).href}catch{return resolved}}
    const linkedPreviewUrl=(item={})=>item.image_url||item.photo_url||item.thumbnail_url||item.avatar||item.female_image_url||item.male_image_url||item.female_photo_url||item.male_photo_url||''
    const linkedMeta=(item={},type)=>type==='breeding'?[item.spawning_method,item.method,item.status,item.pond_name,item.pond_label].filter(Boolean).join(' - '):[item.variety,item.gender,item.current_length_cm?`${item.current_length_cm} cm`:item.size_cm?`${item.size_cm} cm`:item.size].filter(Boolean).join(' - ')
    const normalizeGender=(value)=>{const raw=String(value||'').toLowerCase();if(raw.includes('female')||raw.includes('betina'))return'Female';if(raw.includes('male')||raw.includes('jantan'))return'Male';return value||'Unknown'}
    const koiDetails=(item={})=>[{label:'ID',value:item.code||item.kode||item.id||'-'},{label:'Variety',value:item.variety||item.varietas||'-'},{label:'Gender',value:normalizeGender(item.gender||item.sex)},{label:'Nama',value:item.name||item.nama||'-'}]
    const parseParentEntries=(value,fallbackId,fallbackLabel)=>{try{const parsed=typeof value==='string'?JSON.parse(value):value;const entries=Array.isArray(parsed)?parsed:[];return entries.length?entries:(fallbackId?[{koi_id:fallbackId,label:fallbackLabel||'',notes:''}]:[])}catch{return fallbackId?[{koi_id:fallbackId,label:fallbackLabel||'',notes:''}]:[]}}
    const parentFromEntry=(entry,gender)=>{const koi=entry?.koi_id?koiItems.find((item)=>String(item.id)===String(entry.koi_id)):null;const labelParts=String(entry?.label||'').split(' - ').map((part)=>part.trim()).filter(Boolean);const code=koi?.code||entry?.code||labelParts[0]||entry?.koi_id||'-';const name=koi?.name||entry?.name||labelParts[1]||'-';return{id:entry?.koi_id||code,code,name,variety:koi?.variety||entry?.variety||'-',gender:koi?.gender?normalizeGender(koi.gender):gender,bloodline:koi?.bloodline||entry?.bloodline||'',image_url:koi?.image_url||entry?.image_url||'',notes:entry?.notes||'',length_cm:entry?.length_cm||koi?.current_length_cm||''}}
    const breedingParents=(item={})=>{const femaleName=[item.female_koi_code,item.female_koi_name].filter(Boolean).join(' - ');const maleName=[item.male_koi_code,item.male_koi_name].filter(Boolean).join(' - ');return[...parseParentEntries(item.female_parent_entries,item.female_koi_id,femaleName).map((entry)=>parentFromEntry(entry,'Female')),...parseParentEntries(item.male_parent_entries,item.male_koi_id,maleName).map((entry)=>parentFromEntry(entry,'Male'))]}
    const linkedDetails=(item={},type)=>type==='breeding'?[{label:'ID',value:item.batch_code||item.id||'-'},{label:'Variety',value:breedingParents(item).map((parent)=>parent.variety).filter((value)=>value&&value!=='-').join(', ')||'-'},{label:'Gender',value:breedingParents(item).map((parent)=>parent.gender).join(' & ')||'-'},{label:'Nama',value:item.session_name||item.name||'-'}]:koiDetails(item)
    const detailsHtml=(details=[])=>`<div class="report-linked-details">${details.map((detail)=>`<span><strong>${escapeHtml(detail.value||'-')}</strong>${escapeHtml(detail.label)}</span>`).join('')}</div>`
    const parentListHtml=(parents=[])=>parents.length?`<div class="report-parent-list">${parents.map((parent,index)=>{const image=resolveMediaUrl(parent.image_url);return `<div class="report-parent-chip" data-report-parent-index="${index}">${image?`<img src="${escapeHtml(image)}" alt="${escapeHtml(parent.code)}" />`:`<span>No foto</span>`}<div><div class="report-linked-title">${escapeHtml(parent.code||'-')}</div><div class="report-linked-meta">${escapeHtml([parent.variety,parent.gender,parent.name].filter(Boolean).join(' - ')||'-')}</div><div class="report-parent-control"><label class="form-check mb-0"><input class="form-check-input" name="report_parent_show_print" type="checkbox" data-parent-show-print ${parent.show_on_print===false?'':'checked'} /><span class="form-check-label">Pilih</span></label><input class="form-control form-control-sm" name="report_parent_notes" data-parent-notes placeholder="Catatan indukan ini" autocomplete="off" value="${escapeHtml(parent.notes||'')}" /></div></div></div>`}).join('')}</div>`:''
    const searchKeywords=(item,type)=>[type==='breeding'?breedingLabel(item):koiLabel(item),linkedMeta(item,type),...linkedDetails(item,type).map((detail)=>detail.value),...breedingParents(item).flatMap((parent)=>[parent.code,parent.variety,parent.gender,parent.name])].join(' ').toLowerCase()
    const renderReportSearchMenu=(type)=>{const input=document.querySelector(type==='breeding'?'[data-breeding-search]':'[data-koi-search]');const menu=document.querySelector(type==='breeding'?'[data-breeding-search-menu]':'[data-koi-search-menu]');if(!input||!menu)return;const labeler=type==='breeding'?breedingLabel:koiLabel;const query=input.value.toLowerCase().trim();const items=(type==='breeding'?breedingItems:koiItems).filter((item)=>searchKeywords(item,type).includes(query)).slice(0,8);closeReportSearchMenus(menu);if(!items.length){menu.innerHTML='<div class="report-search-item text-secondary">Tidak ada data cocok.</div>';menu.classList.remove('d-none');return}menu.innerHTML=items.map((item)=>{const preview=resolveMediaUrl(linkedPreviewUrl(item));const meta=[linkedMeta(item,type),linkedDetails(item,type).map((detail)=>detail.value).filter((value)=>value&&value!=='-').join(' | ')].filter(Boolean).join(' - ')||'-';return `<button class="report-search-item" type="button" data-report-search-pick="${escapeHtml(type)}" data-report-search-id="${escapeHtml(item.id)}">${preview?`<img class="report-search-thumb" src="${escapeHtml(preview)}" alt="${escapeHtml(labeler(item))}" />`:`<span class="report-search-thumb">${type==='breeding'?'BR':'KOI'}</span>`}<span class="report-search-copy"><span class="report-search-title">${escapeHtml(labeler(item)||'-')}</span><span class="report-search-meta">${escapeHtml(meta)}</span></span></button>`}).join('');menu.classList.remove('d-none')}
    const reportVarietyOptions=()=>[...new Set(koiItems.map((item)=>String(item.variety||'').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'id',{sensitivity:'base'}))
    const splitReportVarieties=(value)=>String(value||'').split(',').map((item)=>item.trim()).filter(Boolean)
