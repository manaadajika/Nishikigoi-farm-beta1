        alert('Ikan terpilih belum memiliki gambar.')
        return
      }

      downloadImagesButton.disabled = true

      try {
        const files = await Promise.all(images.map(async (item) => {
          const response = await fetch(item.image_url)
          const buffer = await response.arrayBuffer()
          const extension = item.image_url.split('.').pop()?.split('?')[0] || 'jpg'

          return {
            name: `${selectedImageFilename(item)}.${extension}`,
            buffer,
          }
        }))
        downloadBlob(createZip(files), `gambar-ikan-terpilih-${new Date().toISOString().slice(0, 10)}.zip`)
      } finally {
        downloadImagesButton.disabled = false
