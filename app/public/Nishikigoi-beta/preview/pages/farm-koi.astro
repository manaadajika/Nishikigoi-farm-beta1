    const uniqueKoiValues = (key) => [...new Set(koiItems.map((item) => filterValue(item, key)).filter(Boolean))].sort()
    const readKoiDrafts = () => {
      try {
        return JSON.parse(localStorage.getItem(draftStorageKey) || '[]')
      } catch {
        return []
      }
    }
    const formatDraftName = (value) => {
      const date = new Date(value)

      if (Number.isNaN(date.getTime())) {
        return 'Draft tanpa tanggal'
      }

      return date.toLocaleString('id-ID', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    }
    const breedingLabel = (item) => {
      const code = item.batch_code || `#${item.id}`
      const sessionName = item.session_name || 'Tanpa nama sesi'
      const koiNames = [item.male_koi_name, item.female_koi_name].filter(Boolean).join(' x ')

      return koiNames ? `${code} - ${sessionName} - ${koiNames}` : `${code} - ${sessionName}`
    }
    const parseParentEntries = (value, fallbackId, fallbackLabel) => {
      try {
        const parsed = typeof value === 'string' ? JSON.parse(value) : value
        const entries = Array.isArray(parsed) ? parsed : []

        return entries.length > 0 ? entries : fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '' }] : []
      } catch {
        return fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '' }] : []
      }
    }
    const parentLabel = (entry) => entry.label || `ID ${entry.koi_id}`
    const parentPreviewCard = (label, imageUrl, detail = '') => {
      const tag = imageUrl ? 'button' : 'div'
      const attrs = imageUrl
        ? ` type="button" data-preview-parent-photo="${escapeHtml(imageUrl)}" data-preview-parent-title="${escapeHtml(label || 'Parent')}"`
        : ''

      return `
      <${tag} class="koi-parent-preview-card d-flex align-items-center gap-2 p-2"${attrs}>
        ${imageUrl ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(label)}" />` : `<div class="avatar avatar-lg">${escapeHtml(label || '-').slice(0, 1)}</div>`}
        <div class="min-width-0">
          <div class="fw-medium text-truncate">${escapeHtml(label || '-')}</div>
          <div class="text-secondary small text-truncate">${escapeHtml(detail || '')}</div>
        </div>
      </${tag}>
    `
    }
    const koiById = (id) => koiItems.find((item) => String(item.id) === String(id || ''))
    const parentEntryPreview = (entry, fallbackImage = '', fallbackDetail = '') => {
      const koi = koiById(entry?.koi_id)

      return {
        label: parentLabel(entry),
        image: koi?.image_url || fallbackImage || '',
        detail: [koi?.variety, koi?.bloodline].filter(Boolean).join(' - ') || fallbackDetail || '',
      }
    }
    const breedingSearchValues = (item) => [
      breedingLabel(item),
      item.batch_code,
      item.session_name,
      item.male_koi_name,
      item.female_koi_name,
    ].filter(Boolean)
    const findBreedingByValue = (value) => {
      const normalized = parseParentInfoParts(value).parent.trim().toLowerCase()

      if (!normalized) {
        return null
      }

      return breedingItems.find((item) => {
        const label = breedingLabel(item).toLowerCase()
        const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
        const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
        const parentValues = [
          ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).map(parentLabel),
          ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).map(parentLabel),
        ]

        const candidates = [label, ...breedingSearchValues(item), ...parentValues]
          .map((candidate) => String(candidate || '').trim().toLowerCase())
          .filter(Boolean)

        return candidates.some((candidate) => candidate === normalized || candidate.includes(normalized) || normalized.startsWith(candidate))
      }) || null
    }
    const parentSearchText = (item) => {
      const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
      const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')

      return [
        breedingLabel(item),
        ...breedingSearchValues(item),
        ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).flatMap((entry) => [entry.koi_id, parentLabel(entry)]),
        ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).flatMap((entry) => [entry.koi_id, parentLabel(entry)]),
      ].filter(Boolean).join(' ').toLowerCase()
    }
    const parentSearchMatches = (value) => {
      const terms = String(value || '').trim().toLowerCase().split(/\s+/).filter(Boolean)

      return breedingItems
        .filter((item) => terms.length === 0 || terms.every((term) => parentSearchText(item).includes(term)))
        .slice(0, 8)
    }
    const renderParentSearchMenu = (input) => {
      const menu = input.closest('.koi-parent-search')?.querySelector('[data-parent-search-menu]')

      if (!menu) {
        return
      }

      const matches = parentSearchMatches(input.value)
      menu.innerHTML = matches.length
        ? matches.map((item) => {
          const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
          const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
          const method = isNaturalBreeding(item) ? 'Alami' : 'Stripping'
          const thumbUrl = item.female_koi_image_url || item.male_koi_image_url || ''
          const thumbMarkup = thumbUrl
            ? `<img class="koi-parent-search-thumb" src="${escapeHtml(thumbUrl)}" alt="${escapeHtml(breedingLabel(item))}" loading="lazy" decoding="async" fetchpriority="low" />`
            : '<span class="koi-parent-search-thumb koi-parent-search-placeholder">BR</span>'

          return `
            <button class="koi-parent-search-item" type="button" data-parent-search-pick="${escapeHtml(item.id)}">
              <span class="koi-parent-search-main">
                ${thumbMarkup}
                <span class="koi-parent-search-copy">
                  <span class="d-block fw-medium text-truncate">${escapeHtml(breedingLabel(item))}</span>
                  <span class="d-block text-secondary small text-truncate">Female: ${escapeHtml(femaleFallback || '-')} | Male: ${escapeHtml(maleFallback || 'Mix')} | ${escapeHtml(method)}</span>
                </span>
              </span>
            </button>
          `
        }).join('')
        : '<div class="koi-parent-search-empty">Tidak ada sesi breeding yang cocok</div>'
      menu.classList.remove('d-none')
    }
    const closeParentSearchMenus = (exceptInput = null) => {
      document.querySelectorAll('[data-parent-search-menu]').forEach((menu) => {
        if (exceptInput && menu === exceptInput.closest('.koi-parent-search')?.querySelector('[data-parent-search-menu]')) {
          return
        }

        menu.classList.add('d-none')
      })
    }
    const enrichParentInfoValue = (parentValue, maleValue = 'mix') => {
      const parts = parseParentInfoParts(parentValue)

      if (parts.parent && (parts.female || parts.male)) {
        return buildParentInfoFromParts(parts.parent, parts.female, parts.male || maleValue)
      }

      const breeding = findBreedingByValue(parentValue)

      if (!breeding) {
        return parentValue
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)
      const femaleName = femaleEntries.map(parentLabel).join(', ') || femaleFallback || '-'

      return selectedBreederLabel(breeding, maleValue, femaleName)
    }
    const pickParentSearchItem = (button) => {
      const input = button.closest('.koi-parent-search')?.querySelector('[data-parent-search-input]')
      const breeding = breedingItems.find((item) => String(item.id) === String(button.dataset.parentSearchPick))

      if (!input || !breeding) {
        return
      }

      input.value = breedingLabel(breeding)
      updateParentClearVisibility(input.closest('.koi-parent-search'))
      closeParentSearchMenus()

      const entry = input.closest('[data-koi-entry]')
      if (entry) {
        updateEntryParentPreview(entry)
        return
      }

      if (input.matches('[data-bulk-parent-session]')) {
        updateBulkParentSelectors()
        return
      }

      updateEditBreederParents()
    }

    const showKoiError = (message) => {
      errorBox.textContent = message
      errorBox.classList.remove('d-none')
    }

    const hideKoiError = () => {
      errorBox.textContent = ''
      errorBox.classList.add('d-none')
    }

    const showImportStatus = (message) => {
      importStatusBox.textContent = message
      importStatusBox.classList.remove('d-none')
    }

    const hideImportStatus = () => {
      importStatusBox.textContent = ''
      importStatusBox.classList.add('d-none')
    }
    const updateParentClearVisibility = (wrapper) => {
      const input = wrapper?.querySelector('[data-parent-search-input]')
      const button = wrapper?.querySelector('[data-parent-clear]')

      if (!input || !button) {
        return
      }

      button.classList.toggle('d-none', !String(input.value || '').trim())
    }
    const clearParentField = (button) => {
      const wrapper = button.closest('.koi-parent-search')
      const input = wrapper?.querySelector('[data-parent-search-input]')

      if (!input) {
        return
      }

      input.value = ''
      closeParentSearchMenus()
      updateParentClearVisibility(wrapper)

      const entry = input.closest('[data-koi-entry]')
      if (entry) {
        updateEntryParentPreview(entry)
        input.focus()
        return
      }

      if (input.matches('[data-bulk-parent-session]')) {
        updateBulkParentSelectors()
        input.focus()
        return
      }

      updateEditBreederParents()
      input.focus()
    }
    const parentEntriesForBreeding = (breeding, role) => {
      if (!breeding) {
        return []
      }

      const fallbackCode = role === 'female' ? breeding.female_koi_code : breeding.male_koi_code
      const fallbackName = role === 'female' ? breeding.female_koi_name : breeding.male_koi_name
      const fallbackId = role === 'female' ? breeding.female_koi_id : breeding.male_koi_id
      const source = role === 'female' ? breeding.female_parent_entries : breeding.male_parent_entries
      const fallbackLabel = [fallbackCode, fallbackName].filter(Boolean).join(' - ')

      return parseParentEntries(source, fallbackId, fallbackLabel)
    }
    const renderParentOptionList = (entries, includeMix = false) => [
      ...(includeMix ? [{ value: 'mix', label: 'Mix' }] : []),
      ...entries.map((entry) => ({ value: parentLabel(entry), label: parentLabel(entry) })),
    ]
    const entryCodeTokens = (entry) => [
      entry.koi_id,
      entry.code,
      entry.label,
      parentLabel(entry),
    ].filter(Boolean).map((item) => String(item).trim().toLowerCase())
    const findParentEntryByToken = (entries, token) => {
      const normalized = String(token || '').trim().toLowerCase()
      if (!normalized) return null

      return entries.find((entry) => entryCodeTokens(entry).some((candidate) => candidate === normalized || candidate.includes(normalized)))
    }
    const parseBulkParentShortcut = (rawValue = '') => {
      const raw = String(rawValue || '').trim()
      if (!raw) return { breeding: null, female: '', male: 'mix', parent: '' }

      const exactBatch = breedingItems.find((item) => {
        const code = String(item.batch_code || '').trim().toLowerCase()
        return code && new RegExp(`^${code.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*-\\s*`, 'i').test(raw)
      })
      const maleToken = exactBatch
        ? raw.replace(new RegExp(`^${String(exactBatch.batch_code).trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*-\\s*`, 'i'), '').trim()
        : ''
      const breeding = exactBatch || findBreedingByValue(raw)

      if (!breeding) {
        return { breeding: null, female: '', male: 'mix', parent: raw }
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const maleFallback = [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parentEntriesForBreeding(breeding, 'female')
      const maleEntries = parentEntriesForBreeding(breeding, 'male')
      const female = femaleEntries.map(parentLabel).join(', ') || femaleFallback || '-'
      const selectedMale = findParentEntryByToken(maleEntries, maleToken)
      const male = maleToken
        ? parentLabel(selectedMale || { label: maleToken })
        : 'mix'

      return {
        breeding,
        female,
        male,
        parent: breedingLabel(breeding),
      }
    }
    const updateBulkParentSelectors = () => {
      const sessionInput = bulkValueContainer.querySelector('[data-bulk-parent-session]')
      const femaleSelect = bulkValueContainer.querySelector('[data-bulk-parent-female]')
      const maleSelect = bulkValueContainer.querySelector('[data-bulk-parent-male]')
      const shortcut = parseBulkParentShortcut(sessionInput?.value)
      const breeding = shortcut.breeding || findBreedingByValue(sessionInput?.value)

      if (!sessionInput || !femaleSelect || !maleSelect) {
        return
      }

      if (!breeding) {
        femaleSelect.innerHTML = '<option value="">Pilih sesi dulu</option>'
        maleSelect.innerHTML = '<option value="mix">Mix</option>'
        femaleSelect.disabled = true
        maleSelect.disabled = true
        return
      }

      const femaleOptions = renderParentOptionList(parentEntriesForBreeding(breeding, 'female'))
      const maleOptions = renderParentOptionList(parentEntriesForBreeding(breeding, 'male'), true)
      const previousFemale = femaleSelect.value
      const previousMale = maleSelect.value

      femaleSelect.innerHTML = femaleOptions.length
        ? femaleOptions.map((option) => `<option value="${escapeHtml(option.value)}">${escapeHtml(option.label)}</option>`).join('')
        : '<option value="-">-</option>'
      maleSelect.innerHTML = maleOptions.map((option) => `<option value="${escapeHtml(option.value)}">${escapeHtml(option.label)}</option>`).join('')
      femaleSelect.value = femaleOptions.some((option) => option.value === previousFemale) ? previousFemale : femaleOptions[0]?.value || '-'
      maleSelect.value = maleOptions.some((option) => option.value === shortcut.male)
        ? shortcut.male
        : maleOptions.some((option) => option.value === previousMale) ? previousMale : 'mix'
      femaleSelect.disabled = false
      maleSelect.disabled = false
    }
    const updateKoiFieldClearVisibility = (field) => {
      const control = field?.querySelector('input.form-control:not([type="hidden"]), textarea.form-control')
      const button = field?.querySelector('[data-koi-field-clear]')

      if (!control || !button) {
        return
      }

      button.classList.toggle('d-none', !String(control.value || '').trim())
    }
    const clearKoiField = (button) => {
      const field = button.closest('.koi-help-field')
      const control = field?.querySelector('input.form-control:not([type="hidden"]), textarea.form-control')

      if (!control || control.disabled || control.readOnly) {
        return
      }

      control.value = ''
      control.dispatchEvent(new Event('input', { bubbles: true }))
      control.dispatchEvent(new Event('change', { bubbles: true }))
      updateKoiFieldClearVisibility(field)
      control.focus()
    }
    const decorateKoiClearFields = (root = document) => {
      root.querySelectorAll('.koi-help-field').forEach((field) => {
        if (field.classList.contains('has-clear') || field.querySelector('.koi-parent-search')) {
          return
        }

        const control = field.querySelector('input.form-control:not([type="hidden"]):not([type="file"]), textarea.form-control')

        if (!control || control.disabled || control.readOnly) {
          return
        }

        field.classList.add('has-clear')
        field.insertAdjacentHTML('beforeend', '<button class="koi-field-clear d-none" type="button" data-koi-field-clear aria-label="Kosongkan field" title="Kosongkan field">&times;</button>')
        updateKoiFieldClearVisibility(field)
      })
    }
    const observeKoiClearFields = () => {
      decorateKoiClearFields()
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === Node.ELEMENT_NODE) {
              decorateKoiClearFields(node)
              if (typeof node.querySelectorAll === 'function') {
                node.querySelectorAll('.koi-parent-search').forEach(updateParentClearVisibility)
              }
            }
          })
        })
      })
      observer.observe(document.body, { childList: true, subtree: true })
    }
    const selectedBreederLabel = (item, maleValue = 'mix', femaleName = editBreederFemale.value) => {
      const maleName = maleValue === 'mix' ? 'Mix' : maleValue

      return `${breedingLabel(item)} | Female: ${femaleName || '-'} | Male: ${maleName || '-'}`
    }
    const parseParentInfoParts = (value = '') => {
      const text = String(value || '').trim()
      const [, parent = text] = text.match(/^(.*?)\s*\|\s*Female:/i) || []
      const [, female = ''] = text.match(/\|\s*Female:\s*(.*?)(?:\s*\|\s*Male:|$)/i) || []
      const [, male = ''] = text.match(/\|\s*Male:\s*(.*?)$/i) || []

      return {
        parent: parent.trim(),
        female: female.trim(),
        male: male.trim(),
      }
    }
    const buildParentInfoFromParts = (parentInfo = '', female = '', male = '') => {
      const parent = String(parentInfo || '').trim()
      const femaleValue = String(female || '').trim()
      const maleValue = String(male || '').trim()

      if (!parent || parent.includes('| Female:')) {
        return parent
      }

      if (!femaleValue && !maleValue) {
        return parent
      }

      return `${parent} | Female: ${femaleValue || '-'} | Male: ${maleValue || '-'}`
    }
    const parentBatchCodeFromInfo = (value = '') => {
      const parent = parseParentInfoParts(value).parent
      const breeding = findBreedingByValue(parent)

      if (breeding?.batch_code) {
        return breeding.batch_code
      }

      return String(parent || '').split(' - ')[0].trim()
    }
    const isNaturalBreeding = (breeding) => String(breeding?.spawning_method || '').toLowerCase() === 'alami'
    const maleParentOptions = (breeding) => {
      const maleFallback = [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - ')
      const maleEntries = parseParentEntries(breeding.male_parent_entries, breeding.male_koi_id, maleFallback)

      return [
        { value: 'mix', label: 'Mix' },
        ...maleEntries.map((entry) => ({ value: parentLabel(entry), label: parentLabel(entry) })),
      ]
    }
    const renderParentPreview = (panel, femalePreview, malePreview, maleSelect, breeding) => {
      if (!breeding) {
        panel?.classList.add('d-none')
        if (femalePreview) femalePreview.innerHTML = ''
        if (malePreview) malePreview.innerHTML = ''
        if (maleSelect) {
          maleSelect.innerHTML = ''
          maleSelect.disabled = false
          maleSelect.title = ''
        }
        return
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)
      const femaleName = femaleEntries.map(parentLabel).join(', ') || femaleFallback || '-'
      const femalePrimary = parentEntryPreview(femaleEntries[0], breeding.female_koi_image_url, [breeding.female_koi_variety, breeding.female_koi_bloodline].filter(Boolean).join(' - '))
      const maleOptions = maleParentOptions(breeding)
      const savedMale = parseParentInfoParts(maleSelect?.closest('[data-koi-entry], form')?.querySelector('[name="parent_info"]')?.value).male
      const selectedMale = maleSelect?.value || savedMale || 'mix'
      const maleName = selectedMale === 'mix' ? 'Mix' : selectedMale
      const selectedMaleEntry = parseParentEntries(
        breeding.male_parent_entries,
        breeding.male_koi_id,
        [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - '),
      ).find((entry) => parentLabel(entry) === selectedMale)
      const malePrimary = selectedMaleEntry ? parentEntryPreview(selectedMaleEntry, breeding.male_koi_image_url, [breeding.male_koi_variety, breeding.male_koi_bloodline].filter(Boolean).join(' - ')) : null

      if (femalePreview) {
        femalePreview.innerHTML = parentPreviewCard(femaleName, femalePrimary.image, femalePrimary.detail)
      }
      if (malePreview) {
        malePreview.innerHTML = parentPreviewCard(maleName, selectedMale === 'mix' ? '' : malePrimary?.image || breeding.male_koi_image_url, selectedMale === 'mix' ? 'Semua male dalam sesi' : malePrimary?.detail || [breeding.male_koi_variety, breeding.male_koi_bloodline].filter(Boolean).join(' - '))
      }
      if (maleSelect) {
        maleSelect.innerHTML = maleOptions.map((option) => `<option value="${escapeHtml(option.value)}">${escapeHtml(option.label)}</option>`).join('')
        maleSelect.value = maleOptions.some((option) => option.value === selectedMale) ? selectedMale : 'mix'
        maleSelect.disabled = false
        maleSelect.title = ''
      }
      panel?.classList.remove('d-none')
    }
    const updateEditBreederParents = () => {
      const parentField = editForm.querySelector('[name="parent_info"]')
      const breeding = findBreedingByValue(parentField.value)

      if (!breeding) {
        editBreederFemale.value = ''
        renderParentPreview(editBreederParentPanel, editParentFemalePreview, editParentMalePreview, editBreederMale, null)
        return
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)

      editBreederFemale.value = femaleEntries.map(parentLabel).join(', ') || '-'
      renderParentPreview(editBreederParentPanel, editParentFemalePreview, editParentMalePreview, editBreederMale, breeding)

      const bloodlineField = editForm.querySelector('[name="bloodline"]')
      const parentBloodline = breeding.female_koi_bloodline || breeding.male_koi_bloodline || ''

      if (bloodlineField && !bloodlineField.value && parentBloodline) {
        bloodlineField.value = parentBloodline
      }
    }
    const findPondByName = (name) => pondsList.find((pond) => pond.name.toLowerCase() === String(name || '').trim().toLowerCase())

    const pondSearchText = (pond) => [pond.name, pond.location, pond.status].filter(Boolean).join(' ').toLowerCase()
    const pondSearchMatches = (value) => {
      const terms = String(value || '').trim().toLowerCase().split(/\s+/).filter(Boolean)

      return pondsList
        .filter((pond) => terms.length === 0 || terms.every((term) => pondSearchText(pond).includes(term)))
        .slice(0, 12)
    }
    const updatePondClearVisibility = (wrapper) => {
      const input = wrapper?.querySelector('[data-pond-search-input]')
      const button = wrapper?.querySelector('[data-pond-clear]')

      if (!input || !button) {
        return
      }

      button.classList.toggle('d-none', !String(input.value || '').trim())
    }
    const closePondSearchMenus = (exceptInput = null) => {
      document.querySelectorAll('[data-pond-search-menu]').forEach((menu) => {
        if (exceptInput && menu === exceptInput.closest('.koi-pond-search')?.querySelector('[data-pond-search-menu]')) {
          return
        }

        menu.classList.add('d-none')
      })
    }
    const renderPondSearchMenu = (input) => {
      const menu = input.closest('.koi-pond-search')?.querySelector('[data-pond-search-menu]')

      if (!menu) {
        return
      }

      const isLocationInput = input.matches('[data-edit-pond-location]')
      const matches = pondSearchMatches(input.value)
      menu.innerHTML = `
        <button class="koi-pond-search-item" type="button" data-pond-search-pick="">
          <span class="koi-pond-search-main">
            <span class="koi-pond-search-copy">
              <span class="d-block fw-medium text-truncate">${isLocationInput ? 'Tanpa lokasi' : 'Tanpa kolam'}</span>
              <span class="d-block text-secondary small text-truncate">${isLocationInput ? 'Kosongkan kolam dan lokasi ikan' : 'Kosongkan lokasi ikan'}</span>
            </span>
          </span>
        </button>
        ${matches.length
          ? matches.map((pond) => `
            <button class="koi-pond-search-item" type="button" data-pond-search-pick="${escapeHtml(pond.id)}" data-pond-search-name="${escapeHtml(pond.name)}" data-pond-search-location="${escapeHtml(pond.location || '')}">
              <span class="koi-pond-search-main">
                <span class="koi-pond-search-copy">
                  <span class="d-block fw-medium text-truncate">${escapeHtml(isLocationInput ? pond.location || 'Tanpa area' : pond.name || '-')}</span>
                  <span class="d-block text-secondary small text-truncate">${escapeHtml([pond.location, labels[pond.status] || pond.status].filter(Boolean).join(' | ') || 'Tanpa area')}</span>
                </span>
              </span>
            </button>
