        const parentField = entry.querySelector('[name="parent_info"]')
        const breeding = findBreedingByValue(parentField.value)

        if (breeding) {
          const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
          const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)
          parentField.value = selectedBreederLabel(breeding, event.target.value, femaleEntries.map(parentLabel).join(', ') || '-')
        }
        updateEntryParentPreview(entry)
        return
      }

      if (!event.target.matches('[data-koi-image-input]')) {
        return
      }

      const entry = event.target.closest('[data-koi-entry]')
      uploadImage(entry, event.target.files[0]).catch((error) => {
        entry.querySelector('[data-koi-upload-status]').textContent = error.message
      })
    })
    entriesContainer.addEventListener('input', (event) => {
      if (event.target.matches('[data-money-input]')) {
        formatMoneyInput(event.target)
        return
      }

      if (event.target.matches('[data-entry-parent-info]')) {
        renderParentSearchMenu(event.target)
        updateParentClearVisibility(event.target.closest('.koi-parent-search'))
        updateEntryParentPreview(event.target.closest('[data-koi-entry]'))
        return
      }

      if (event.target.matches('[data-pond-select]')) {
        renderPondSearchMenu(event.target)
        syncEntryPond(event.target.closest('[data-koi-entry]'))
        updatePondClearVisibility(event.target.closest('.koi-pond-search'))
        return
      }

      if (event.target.matches('[data-variety-search-input]')) {
        renderVarietySearchMenu(event.target)
      }
    })
    entriesContainer.addEventListener('focusin', (event) => {
      if (event.target.matches('[data-entry-parent-info]')) {
        closeParentSearchMenus(event.target)
        renderParentSearchMenu(event.target)
      }
      if (event.target.matches('[data-pond-select]')) {
        closePondSearchMenus(event.target)
        renderPondSearchMenu(event.target)
      }
      if (event.target.matches('[data-variety-search-input]')) {
        closeVarietySearchMenus(event.target)
        renderVarietySearchMenu(event.target)
      }
    })
    entriesContainer.addEventListener('click', (event) => {
      const parentPick = event.target.closest('[data-parent-search-pick]')
      const parentPreview = event.target.closest('[data-preview-parent-photo]')
      const parentClear = event.target.closest('[data-parent-clear]')
      const pondPick = event.target.closest('[data-pond-search-pick]')
      const pondClear = event.target.closest('[data-pond-clear]')
      const varietyPick = event.target.closest('[data-variety-search-pick]')

      if (parentPick) {
        pickParentSearchItem(parentPick)
        return
      }

      if (parentClear) {
        clearParentField(parentClear)
        return
      }

      if (pondPick) {
        pickPondSearchItem(pondPick)
        return
      }

      if (pondClear) {
        clearPondField(pondClear)
        return
      }

      if (varietyPick) {
        pickVarietySearchItem(varietyPick)
        return
      }

      if (parentPreview) {
        openPhotoHistoryZoom(parentPreview.dataset.previewParentPhoto, parentPreview.dataset.previewParentTitle)
      }
    })
    entriesContainer.addEventListener('dragover', (event) => {
      const uploadBox = event.target.closest('[data-koi-upload-box]')

      if (!uploadBox) {
        return
      }

      event.preventDefault()
      uploadBox.classList.add('is-dragover')
    })
    entriesContainer.addEventListener('dragleave', (event) => {
      const uploadBox = event.target.closest('[data-koi-upload-box]')

      if (uploadBox && !uploadBox.contains(event.relatedTarget)) {
        uploadBox.classList.remove('is-dragover')
      }
    })
    entriesContainer.addEventListener('drop', (event) => {
      const uploadBox = event.target.closest('[data-koi-upload-box]')

      if (!uploadBox) {
        return
      }

      event.preventDefault()
      uploadBox.classList.remove('is-dragover')

      const entry = uploadBox.closest('[data-koi-entry]')
      const file = [...event.dataTransfer.files].find((item) => item.type.startsWith('image/'))

      uploadImage(entry, file).catch((error) => {
        entry.querySelector('[data-koi-upload-status]').textContent = error.message
      })
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      hideKoiError()
      submitButton.disabled = true
      submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Menyimpan ikan"></span>'
      submitButton.setAttribute('title', 'Menyimpan ikan...')

      try {
        const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
        await uploadPendingZipImages(entries)

        // Per-entry, bukan global: entry yang ditandai `editKoiId` (dipilih lewat Tarik Data Ikan,
        // Edit Terpilih, atau Kode Koi cocok saat Import ZIP) di-PATCH sebagai update; sisanya
        // di-POST sebagai ikan baru. Keduanya bisa campur dalam satu kali Simpan.
        const existingEntries = entries.filter((entry) => entry.dataset.editKoiId)
        const newEntries = entries.filter((entry) => !entry.dataset.editKoiId)

        if (existingEntries.length > 0) {
          // Chunked, bukan Promise.all atas SEMUA entry sekaligus — puluhan fetch() PATCH paralel
          // dalam satu waktu (mis. Edit Terpilih 37 ikan) bisa bikin sebagian gagal dengan "Failed
          // to fetch" (limit koneksi browser/Worker), bukan error dari server yang jelas.
          const patchChunkSize = 5
          let patchedCount = 0

          for (let start = 0; start < existingEntries.length; start += patchChunkSize) {
            const chunk = existingEntries.slice(start, start + patchChunkSize)

            if (existingEntries.length > patchChunkSize) {
              showImportStatus(`Memperbarui ikan ${patchedCount + 1}-${patchedCount + chunk.length}/${existingEntries.length}...`)
            }

            await Promise.all(chunk.map(async (entry) => {
              const id = entry.dataset.editKoiId
              const originalItem = koiItems.find((item) => String(item.id) === String(id)) || {}
              const entryPayload = readEntryPayload(entry)
              const nextPayload = koiPatchPayload(originalItem, entryPayload)
              const response = await fetch(`${apiUrl}/koi/${id}`, {
                method: 'PATCH',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(nextPayload),
              })
              const data = await response.json()

              if (!response.ok) {
                const baseMessage = data.error || 'Ikan terpilih gagal diperbarui'
                const savedNote = patchedCount > 0 ? ` (${patchedCount} ikan sebelumnya sudah tersimpan, sisanya belum)` : ''
                throw new Error(`${baseMessage}${savedNote}`)
              }
            }))

            patchedCount += chunk.length
          }
        }

        if (newEntries.length > 0) {
          const entryPayloads = newEntries.map(readEntryPayload)
          const koiSaveChunkSize = 8
          let savedCount = 0

          for (let start = 0; start < entryPayloads.length; start += koiSaveChunkSize) {
            const chunk = entryPayloads.slice(start, start + koiSaveChunkSize)

            if (entryPayloads.length > koiSaveChunkSize) {
              showImportStatus(`Menyimpan ikan baru ${savedCount + 1}-${savedCount + chunk.length}/${entryPayloads.length}...`)
            }

            const response = await fetch(`${apiUrl}/koi`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ items: chunk }),
            })
            const data = await response.json()

            if (!response.ok) {
              const baseMessage = data.error || 'Ikan gagal disimpan'
              const detail = data.detail && data.detail !== baseMessage ? `${baseMessage}: ${data.detail}` : baseMessage
              const totalSavedBefore = savedCount + existingEntries.length
              const savedNote = totalSavedBefore > 0 ? ` (${totalSavedBefore} ikan sebelumnya sudah tersimpan, sisanya belum)` : ''
              throw new Error(`${detail}${savedNote}`)
            }

            savedCount += chunk.length
          }
        }

        hideImportStatus()
        closeModal(modalElement)
        resetAddFormMode()
        keepScroll(loadKoi)
      } catch (error) {
        hideImportStatus()
        showKoiError(error.message)
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = saveIcon
        submitButton.setAttribute('title', 'Simpan ikan')
      }
    })

    editForm.addEventListener('submit', (event) => {
      event.preventDefault()
      editErrorBox.classList.add('d-none')
      editSubmitButton.disabled = true
      editSubmitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Menyimpan perubahan"></span>'
      editSubmitButton.setAttribute('title', 'Menyimpan perubahan...')

      const id = editForm.querySelector('[name="id"]').value

      fetch(`${apiUrl}/koi/${id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(readEditPayload()),
      })
        .then(async (response) => {
          const data = await response.json()

          if (!response.ok) {
            throw new Error(data.error || 'Ikan gagal diperbarui')
          }

          closeModal(editModalElement)
          keepScroll(loadKoi)
        })
        .catch((error) => {
          editErrorBox.textContent = error.message
          editErrorBox.classList.remove('d-none')
        })
        .finally(() => {
          editSubmitButton.disabled = false
          editSubmitButton.innerHTML = saveIcon
          editSubmitButton.setAttribute('title', 'Simpan perubahan')
        })
    })
    editForm.addEventListener('input', (event) => {
      if (event.target.matches('[name="purchase_price"], [name="sale_price"]')) {
        formatMoneyInput(event.target)
      }

      if (event.target.matches('[data-parent-search-input]')) {
        renderParentSearchMenu(event.target)
        updateParentClearVisibility(event.target.closest('.koi-parent-search'))
        updateEditBreederParents()
      }
      if (event.target.matches('[data-edit-pond-select], [data-edit-pond-location]')) {
        renderPondSearchMenu(event.target)
        syncPondSearchContext(event.target)
        updatePondClearVisibility(event.target.closest('.koi-pond-search'))
      }
      if (event.target.matches('[data-variety-search-input]')) {
        renderVarietySearchMenu(event.target)
      }
    })
    editForm.addEventListener('focusin', (event) => {
      if (event.target.matches('[data-parent-search-input]')) {
        closeParentSearchMenus(event.target)
        renderParentSearchMenu(event.target)
      }
      if (event.target.matches('[data-edit-pond-select], [data-edit-pond-location]')) {
        closePondSearchMenus(event.target)
        renderPondSearchMenu(event.target)
      }
      if (event.target.matches('[data-variety-search-input]')) {
        closeVarietySearchMenus(event.target)
        renderVarietySearchMenu(event.target)
      }
    })
    editForm.addEventListener('click', (event) => {
      const parentPick = event.target.closest('[data-parent-search-pick]')
      const parentPreview = event.target.closest('[data-preview-parent-photo]')
      const parentClear = event.target.closest('[data-parent-clear]')
      const pondPick = event.target.closest('[data-pond-search-pick]')
      const pondClear = event.target.closest('[data-pond-clear]')
      const varietyPick = event.target.closest('[data-variety-search-pick]')

      if (parentPick) {
        pickParentSearchItem(parentPick)
        return
      }

      if (parentClear) {
        clearParentField(parentClear)
        return
      }

      if (pondPick) {
        pickPondSearchItem(pondPick)
        return
      }

      if (pondClear) {
        clearPondField(pondClear)
        return
      }

      if (varietyPick) {
        pickVarietySearchItem(varietyPick)
        return
      }

      if (parentPreview) {
        openPhotoHistoryZoom(parentPreview.dataset.previewParentPhoto, parentPreview.dataset.previewParentTitle)
      }
    })
    document.addEventListener('input', (event) => {
      const field = event.target.closest?.('.koi-help-field.has-clear')

      if (field) {
        updateKoiFieldClearVisibility(field)
      }
    })
    document.addEventListener('change', (event) => {
      const field = event.target.closest?.('.koi-help-field.has-clear')

      if (field) {
        updateKoiFieldClearVisibility(field)
      }
    })
    document.addEventListener('click', (event) => {
      const fieldClear = event.target.closest('[data-koi-field-clear]')

      if (fieldClear) {
        clearKoiField(fieldClear)
        return
      }

      if (!event.target.closest('.koi-parent-search')) {
        closeParentSearchMenus()
      }
      if (!event.target.closest('.koi-pond-search')) {
        closePondSearchMenus()
      }
      if (!event.target.closest('.koi-variety-search')) {
        closeVarietySearchMenus()
      }
    })
    editPondSelect.addEventListener('input', syncEditPond)
    editProgressPhotoButton.addEventListener('click', () => editProgressPhotoInput.click())
    editProgressPhotoPasteButton.addEventListener('click', async () => {
      if (!editForm.querySelector('[name="id"]').value) {
        return
      }

      editProgressPhotoPasteButton.disabled = true
      try {
        const file = await readClipboardImageFile()
        await uploadProgressPhoto(file)
      } catch (error) {
        alert(error.message || 'Paste gambar progress gagal.')
      } finally {
        editProgressPhotoPasteButton.disabled = false
      }
    })
    editProgressPhotoInput.addEventListener('change', () => {
      uploadProgressPhoto(editProgressPhotoInput.files[0]).catch((error) => alert(error.message))
    })
    editPhotoHistory.addEventListener('click', (event) => {
      const deleteButton = event.target.closest('[data-delete-photo-history]')
      const previewButton = event.target.closest('[data-preview-photo-history]')
      const editSizeButton = event.target.closest('[data-edit-photo-history-size]')

      if (editSizeButton) {
        editPhotoHistorySize(editSizeButton.dataset.editPhotoHistorySize).catch((error) => alert(error.message))
        return
      }

      if (deleteButton) {
        deletePhotoHistory(deleteButton.dataset.deletePhotoHistory).catch((error) => alert(error.message))
        return
      }

      if (previewButton) {
        openPhotoHistoryZoom(previewButton.dataset.previewPhotoHistory, previewButton.dataset.previewPhotoTitle)
      }
    })
    editPhotoHistory.addEventListener('pointerdown', photoHistoryDragStart)
    document.addEventListener('pointermove', photoHistoryDragMove, { passive: false })
    document.addEventListener('pointerup', photoHistoryDragEnd)
    document.addEventListener('pointercancel', photoHistoryDragEnd)
    editForm.addEventListener('change', (event) => {
      if (event.target.matches('[data-edit-gender]')) {
        setEditGender(event.target.checked ? event.target.value : 'unknown')
      }
    })
    editForm.querySelector('[name="parent_info"]').addEventListener('input', (event) => {
      renderParentSearchMenu(event.target)
      updateParentClearVisibility(event.target.closest('.koi-parent-search'))
      updateEditBreederParents()
    })
    editForm.querySelector('[name="parent_info"]').addEventListener('focusin', (event) => {
      closeParentSearchMenus(event.target)
      renderParentSearchMenu(event.target)
    })
    editForm.addEventListener('click', (event) => {
      const parentPick = event.target.closest('[data-parent-search-pick]')
      const parentClear = event.target.closest('[data-parent-clear]')

      if (parentPick) {
        pickParentSearchItem(parentPick)
        return
      }

      if (parentClear) {
        clearParentField(parentClear)
      }
    })
    editBreederMale.addEventListener('change', () => {
      const parentField = editForm.querySelector('[name="parent_info"]')
      const breeding = findBreedingByValue(parentField.value)

      if (breeding) {
        parentField.value = selectedBreederLabel(breeding, editBreederMale.value)
        updateEditBreederParents()
      }
    })

    form.addEventListener('paste', (event) => {
      const file = [...event.clipboardData.files].find((item) => item.type.startsWith('image/'))
      const entry = event.target.closest('[data-koi-entry]')

      if (file && entry) {
        event.preventDefault()
        uploadImage(entry, file).catch((error) => {
          entry.querySelector('[data-koi-upload-status]').textContent = error.message
        })
      }
    })

    addKoiEntry()
    renderBulkInput()
    renderDraftMenu()
    loadPonds()
    loadBreeding()
    observeKoiClearFields()
    const hasCachedKoi = restoreKoiCache()
    keepScroll(() => loadKoi(hasCachedKoi))
    updateActionDock()
    window.KoiAuth?.registerRealtimeRefresh(() => keepScroll(() => loadKoi(true)), { intervalMs: 20000 })
  </script>
</DefaultLayout>











































