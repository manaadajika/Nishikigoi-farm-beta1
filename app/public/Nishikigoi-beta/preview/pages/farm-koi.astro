      }
      const headerRow = zipEntryColumns.map(([header]) => header)
      const dataRows = [sampleValues, sampleExistingValues].map((values) => zipEntryColumns.map(([, key]) => values[key] ?? ''))
      const xlsxWorksheet = XLSX.utils.aoa_to_sheet([headerRow, ...dataRows])
      const xlsxWorkbook = XLSX.utils.book_new()
      XLSX.utils.book_append_sheet(xlsxWorkbook, xlsxWorksheet, 'Data Ikan')
      const xlsxBuffer = XLSX.write(xlsxWorkbook, { type: 'array', bookType: 'xlsx' })
      const guide = [
        'Format ZIP Import Tambah Ikan',
        '',
        'Isi ZIP wajib:',
        '1. Tepat satu file .xlsx (kolom persis seperti data-ikan.xlsx contoh ini).',
        '2. Foto ikan untuk tiap baris.',
        '',
        'Kolom "No" wajib diisi urut (1, 2, 3, ...) untuk setiap baris di sesi upload ini.',
        '',
        'Kolom "Kode Koi" menentukan baris itu ikan BARU atau ikan yang SUDAH ADA:',
        '- Kode Koi DIKOSONGKAN  = ikan baru. Data lain di baris itu dipakai untuk membuat entry baru.',
        '  Foto dicocokkan lewat nomor urut di kolom "No" -> nama file foto harus sama dengan angka itu,',
        '  contoh: baris No 1 -> foto bernama 1.jpg / 1.png (dst).',
        '- Kode Koi DIISI kode yang SUDAH ADA di Data Ikan = data ikan itu otomatis ditarik (sama seperti',
        '  fitur Tarik Data Ikan), lalu ditimpa dengan kolom yang diisi di baris ini (kolom kosong = data',
        '  lama tetap dipakai, tidak dikosongkan). Foto baru untuk ikan ini akan MASUK ke History Progress',
        '  Foto (foto lama tidak hilang). Foto dicocokkan lewat Kode Koi -> nama file foto harus sama',
        '  persis dengan Kode Koi itu, contoh: kode 26ZNZP -> foto bernama 26ZNZP.jpg / 26ZNZP.png (dst).',
        '- Kode Koi diisi tapi TIDAK ketemu di Data Ikan (typo dsb) = import ditolak, baris & kode yang',
        '  bermasalah akan disebutkan di pesan error.',
        '',
        'Contoh isi data-ikan.xlsx (2 baris):',
        '- No 1, Kode Koi kosong -> foto bernama 1.png (entry baru)',
        '- No 2, Kode Koi CONTOH-KODE-EXISTING -> ganti dulu dengan Kode Koi asli sebelum upload, foto',
        '  bernama sama dengan kode itu (update data + tambah foto progress ikan existing)',
      ].join('\r\n')
      const samplePng = base64ToUint8Array('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAFgwJ/lD86bQAAAABJRU5ErkJggg==')
      const zipBlob = createZip([
        { name: 'data-ikan.xlsx', buffer: xlsxBuffer },
        { name: '1.png', buffer: samplePng.buffer },
        { name: 'README-format.txt', buffer: encoder.encode(guide).buffer },
      ])

      downloadBlob(zipBlob, `template-import-ikan-${new Date().toISOString().slice(0, 10)}.zip`)
    }
    const selectedImageFilename = (item) => {
