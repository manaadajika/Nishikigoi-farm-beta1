      const uploadEmpty = entry.querySelector('[data-koi-upload-empty]')

      uploadBox.classList.add('is-loading')
      uploadEmpty.innerHTML = '<div class="w-100 px-2"><div class="small fw-medium mb-2">Mengompres dan mengupload foto...</div><div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div></div>'
      uploadStatus.textContent = 'Memproses foto agar lebih ringan.'

      try {
        const compressedImageData = await compressImageFile(file)
        const imageData = compressedImageData || await readFileAsDataUrl(file)
        const response = await fetch(`${apiUrl}/koi-images`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_data: imageData,
            prefix: uploadPrefixFromCode(entry.querySelector('[name="code"]')?.value),
          }),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Foto gagal diupload')
        }

        setUploadedImage(entry, data.image_url)
      } catch (error) {
        uploadEmpty.innerHTML = '<div class="fw-medium small">Upload foto</div><div class="text-secondary small">Klik atau paste</div>'
        throw error
      } finally {
        uploadBox.classList.remove('is-loading')
      }
    }

    const uploadPendingZipImages = async (entries) => {
      const pendingEntries = entries.filter((entry) => pendingZipImages.has(entry))

      if (pendingEntries.length === 0) {
        return
      }

      for (const [index, entry] of pendingEntries.entries()) {
        const pending = pendingZipImages.get(entry)
        const code = entry.querySelector('[name="code"]')?.value || `Entry ${index + 1}`

        showImportStatus(`Mengupload foto ZIP ${index + 1}/${pendingEntries.length}: ${code}`)
        await uploadImage(entry, pending.file)
        if (pending.previewUrl) {
          URL.revokeObjectURL(pending.previewUrl)
        }
      }
      hideImportStatus()
    }

    const uploadProgressPhoto = async (file) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!file || !file.type.startsWith('image/') || !koiId) {
        return
      }

      editProgressPhotoButton.disabled = true
      editProgressPhotoButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-label="Upload foto progress"></span><span class="progress progress-sm flex-fill"><span class="progress-bar progress-bar-indeterminate"></span></span>'

      try {
        const compressedImageData = await compressImageFile(file)
        const imageData = compressedImageData || await readFileAsDataUrl(file)
        const uploadResponse = await fetch(`${apiUrl}/koi-images`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_data: imageData,
            prefix: `${uploadPrefixFromCode(editForm.querySelector('[name="code"]')?.value)}-progress`,
          }),
        })
        const uploadData = await uploadResponse.json()

        if (!uploadResponse.ok) {
          throw new Error(uploadData.error || 'Foto progress gagal diupload')
        }

        const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_url: uploadData.image_url,
            measured_at: new Date().toISOString().slice(0, 10),
            length_cm: editForm.querySelector('[name="current_length_cm"]').value,
          }),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Foto progress gagal disimpan')
        }

        await loadPhotoHistory(koiId)
        editKoiPreview.innerHTML = `<img src="${escapeHtml(uploadData.image_url)}" alt="Foto terbaru" />`
        keepScroll(loadKoi)
      } finally {
        editProgressPhotoButton.disabled = false
        editProgressPhotoButton.innerHTML = uploadIcon
        editProgressPhotoInput.value = ''
      }
    }

    const readClipboardImageFile = async (filename = 'clipboard-progress') => {
      if (!navigator.clipboard?.read) {
        throw new Error('Browser belum mengizinkan baca clipboard gambar.')
      }

      const items = await navigator.clipboard.read()
      for (const item of items) {
        const imageType = item.types.find((type) => type.startsWith('image/'))
        if (!imageType) {
          continue
        }

        const blob = await item.getType(imageType)
        const extension = imageType.split('/')[1] || 'png'
        return new File([blob], `${filename}.${extension}`, { type: imageType })
      }

      throw new Error('Clipboard tidak berisi gambar.')
    }

    const refreshEntryControls = () => {
      const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
      entries.forEach((entry, index) => {
        entry.querySelector('[data-koi-entry-index]').textContent = index + 1
        entry.querySelector('[data-remove-koi-entry]').disabled = entries.length === 1 && bulkEditKoiIds.length === 0
        entry.querySelectorAll('[data-entry-gender]').forEach((input) => {
          input.name = `entry_gender_option_${index}`
        })
      })
      initEntryHelpPopovers()
      initEntryDatepickers()
    }

    const updateEntrySourceBadge = (entry) => {
      const badge = entry.querySelector('[data-entry-source-badge]')
      const isExisting = Boolean(entry.dataset.editKoiId)

      if (!badge) {
        return
      }

      badge.textContent = isExisting ? 'Data existing' : 'Data baru'
      badge.classList.toggle('bg-blue-lt', !isExisting)
      badge.classList.toggle('bg-green-lt', isExisting)
    }

    const addKoiEntry = () => {
      entriesContainer.insertAdjacentHTML('beforeend', createEntryTemplate())
      updateEntrySourceBadge([...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1))
      refreshEntryControls()
    }

    const ensureEntryCount = (count) => {
      while (entriesContainer.querySelectorAll('[data-koi-entry]').length < count) {
        addKoiEntry()
      }
    }

    const uploadBulkImages = async (files) => {
      const imageFiles = [...files].filter((file) => file.type.startsWith('image/'))

      if (imageFiles.length === 0) {
        return
      }

      ensureEntryCount(imageFiles.length)
      bulkUploadButton.disabled = true
      bulkUploadButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Upload masal"></span>'

      const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')].slice(0, imageFiles.length)

      try {
        await Promise.all(imageFiles.map((file, index) => uploadImage(entries[index], file).catch((error) => {
          entries[index].querySelector('[data-koi-upload-status]').textContent = error.message
        })))
      } finally {
        bulkUploadButton.disabled = false
        bulkUploadButton.innerHTML = uploadIcon
        bulkUploadInput.value = ''
      }
    }

    const renderBulkInput = () => {
      bulkValueContainer.innerHTML = bulkFieldConfig[bulkField.value]?.() || ''
      initEntryDatepickers(bulkValueContainer)
      if (bulkField.value === 'parent_info') {
        updateBulkParentSelectors()
      }
    }

    const setEntryGender = (entry, gender = 'unknown') => {
      const normalizedGender = ['unknown', 'male', 'female'].includes(gender) ? gender : 'unknown'
      const genderInput = entry.querySelector('[name="gender"]')

      if (genderInput) {
        genderInput.value = normalizedGender
      }

      entry.querySelectorAll('[data-entry-gender]').forEach((input) => {
        input.checked = input.value === normalizedGender
      })
    }

    const applyBulkValue = () => {
      const fieldName = bulkField.value
      const rawBulkValue = bulkValueContainer.querySelector('[data-bulk-value]')?.value || ''
      const bulkValue = moneyFieldNames.has(fieldName) ? cleanMoneyValue(rawBulkValue) : rawBulkValue
      const bulkParentShortcut = fieldName === 'parent_info' ? parseBulkParentShortcut(rawBulkValue) : null
      const bulkParentFemale = bulkValueContainer.querySelector('[data-bulk-parent-female]')?.value || ''
      const bulkParentMale = bulkValueContainer.querySelector('[data-bulk-parent-male]')?.value || 'mix'
      const bulkParentValue = bulkParentShortcut?.breeding
        ? buildParentInfoFromParts(bulkParentShortcut.parent, bulkParentShortcut.female || bulkParentFemale, bulkParentShortcut.male || bulkParentMale)
        : bulkValue

      const selectedEntries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
        .filter((entry) => entry.querySelector('[data-entry-bulk-apply]')?.checked)

      if (fieldName === 'code') {
        const codes = rawBulkValue.split(/[\s,;]+/).map((code) => code.trim()).filter(Boolean)
        const uniqueCodes = new Set(codes.map((code) => code.toUpperCase()))

        if (codes.length === 0) {
          selectedEntries.forEach((entry) => {
            const field = entry.querySelector('[name="code"]')
            if (field) field.value = ''
          })
          errorBox.classList.add('d-none')
          return
        }
        if (uniqueCodes.size !== codes.length) {
          errorBox.textContent = 'Kode Koi aksi masal tidak boleh duplikat.'
          errorBox.classList.remove('d-none')
          return
        }
        if (codes.length !== selectedEntries.length) {
          errorBox.textContent = `Jumlah Kode Koi (${codes.length}) harus sama dengan entry yang dicentang (${selectedEntries.length}).`
          errorBox.classList.remove('d-none')
          return
        }

        selectedEntries.forEach((entry, index) => {
          const field = entry.querySelector('[name="code"]')
          if (field) field.value = codes[index]
        })
        errorBox.classList.add('d-none')
        return
      }

      selectedEntries.forEach((entry) => {
        if (fieldName === 'pond_id') {
          const pond = findPondByName(bulkValue)
          setEntryPond(entry, pond?.id || '')
          return
        }

        if (fieldName === 'gender') {
          setEntryGender(entry, bulkValue)
          return
        }

        if (fieldName === 'parent_type') {
          entry.querySelector('[name="parent_type"]').checked = bulkValue === 'indukan'
          return
        }

        const field = entry.querySelector(`[name="${fieldName}"]`)

        if (field) {
          field.value = fieldName === 'parent_info'
            ? bulkParentValue
            : moneyFieldNames.has(fieldName) ? formatMoneyValue(bulkValue) : bulkValue
        }

        if (fieldName === 'parent_info') {
          const maleSelect = entry.querySelector('[data-entry-parent-male]')
          if (maleSelect) {
            maleSelect.value = bulkParentShortcut?.male || bulkParentMale
          }
          updateEntryParentPreview(entry)
        }
      })
    }

    const readEntryPayload = (entry) => {
      syncEntryPond(entry)
      const value = (name) => {
        const fieldValue = entry.querySelector(`[name="${name}"]`)?.value || ''

        return moneyFieldNames.has(name) ? cleanMoneyValue(fieldValue) : fieldValue
      }
      const parentType = entry.querySelector('[name="parent_type"]').checked ? 'indukan' : 'non_indukan'
      const parentMale = entry.querySelector('[data-entry-parent-male]')?.value || 'mix'

      return {
        code: value('code'),
        name: value('name'),
        pond_id: value('pond_id'),
        variety: value('variety'),
        bloodline: value('bloodline'),
        farm_name: value('farm_name'),
        breeder: value('breeder'),
        parent_info: enrichParentInfoValue(value('parent_info'), parentMale),
        gender: value('gender'),
        parent_type: parentType,
        image_url: value('image_url'),
        birth_date: value('birth_date'),
        purchase_date: value('purchase_date'),
        purchase_price: value('purchase_price'),
        sale_price: value('sale_price'),
        current_length_cm: value('current_length_cm'),
        status: value('status'),
        notes: value('notes'),
      }
    }

    const saveKoiDraft = () => {
      const items = [...entriesContainer.querySelectorAll('[data-koi-entry]')].map(readEntryPayload)
      const drafts = readKoiDrafts()

      drafts.unshift({
        id: crypto.randomUUID?.() || String(Date.now()),
        created_at: new Date().toISOString(),
        name: '',
        items,
      })

      localStorage.setItem(draftStorageKey, JSON.stringify(drafts))
      draftButton.innerHTML = draftIcon
      draftButton.setAttribute('title', `Draft tersimpan (${drafts.length})`)
      draftButton.setAttribute('aria-label', `Draft tersimpan. Total ${drafts.length} draft`)
      renderDraftMenu()
    }

    const setEntryValue = (entry, name, value) => {
      const field = entry.querySelector(`[name="${name}"]`)

      if (field) {
        field.value = moneyFieldNames.has(name) ? formatMoneyValue(value) : value || ''
      }
    }

    const fillEntryFromDraft = (entry, item) => {
      entry.dataset.editKoiId = item.id || ''
      updateEntrySourceBadge(entry)
      setEntryValue(entry, 'code', item.code)
      setEntryValue(entry, 'name', item.name)
      setEntryPond(entry, item.pond_id)
      setEntryValue(entry, 'variety', item.variety)
      setEntryValue(entry, 'bloodline', item.bloodline)
      setEntryValue(entry, 'farm_name', item.farm_name)
      setEntryValue(entry, 'breeder', item.breeder)
      setEntryValue(entry, 'parent_info', item.parent_info)
      setEntryGender(entry, item.gender || 'unknown')
      entry.querySelector('[name="parent_type"]').checked = item.parent_type === 'indukan'
      setEntryValue(entry, 'status', item.status || 'active')
      setEntryValue(entry, 'birth_date', item.birth_date)
      updateEntryParentPreview(entry)
      setEntryValue(entry, 'purchase_date', item.purchase_date)
      setEntryValue(entry, 'purchase_price', item.purchase_price)
      setEntryValue(entry, 'sale_price', item.sale_price)
      setEntryValue(entry, 'current_length_cm', item.current_length_cm)
      setEntryValue(entry, 'notes', item.notes)

      if (item.image_url) {
        setUploadedImage(entry, item.image_url)
      }
    }

    const resetAddFormMode = () => {
      bulkEditKoiIds = []
      addFormTitle.textContent = 'Formulir Tambah Ikan'
      addEntryButton.disabled = false
      draftButton.disabled = false
      draftToggle.disabled = false
      if (pullKoiIdsInput) pullKoiIdsInput.value = ''
      if (pullKoiIdsStatus) pullKoiIdsStatus.textContent = ''
      form.reset()
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      addKoiEntry()
    }

    const openSelectedEditForm = () => {
      const items = selectedKoiItems()

      if (items.length === 0) {
        return
      }

      bulkEditKoiIds = items.map((item) => String(item.id))
      addFormTitle.textContent = `Formulir Edit ${items.length} Ikan Terpilih`
      addEntryButton.disabled = true
      draftButton.disabled = true
      draftToggle.disabled = true
      if (pullKoiIdsInput) pullKoiIdsInput.value = ''
      if (pullKoiIdsStatus) pullKoiIdsStatus.textContent = `${items.length} data existing masuk ke formulir edit.`
      form.reset()
      errorBox.classList.add('d-none')
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())

      items.forEach((item) => {
        addKoiEntry()
        const entry = [...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1)
        fillEntryFromDraft(entry, {
          ...item,
          birth_date: item.birth_date ? String(item.birth_date).slice(0, 10) : '',
          purchase_date: item.purchase_date ? String(item.purchase_date).slice(0, 10) : '',
        })
      })

      refreshEntryControls()
      openModal(modalElement)
    }

    const loadKoiDraft = (draftId) => {
      const draft = readKoiDrafts().find((item) => String(item.id) === String(draftId))

      if (!draft) {
        return
      }

      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      draft.items.forEach((item) => {
        addKoiEntry()
        const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
        fillEntryFromDraft(entries.at(-1), item)
      })

      if (draft.items.length === 0) {
        addKoiEntry()
      }

      refreshEntryControls()
    }

    const deleteKoiDraft = (draftId) => {
      const drafts = readKoiDrafts().filter((item) => String(item.id) !== String(draftId))

      localStorage.setItem(draftStorageKey, JSON.stringify(drafts))
      renderDraftMenu()
    }

    const renameKoiDraft = (draftId) => {
      const drafts = readKoiDrafts()
      const draft = drafts.find((item) => String(item.id) === String(draftId))

      if (!draft) {
        return
      }

      const currentName = draft.name || formatDraftName(draft.created_at)
      const nextName = window.prompt('Nama draft', currentName)?.trim()

      if (!nextName) {
        return
      }

      draft.name = nextName
      draft.updated_at = new Date().toISOString()
      localStorage.setItem(draftStorageKey, JSON.stringify(drafts))
      renderDraftMenu()
    }

    const renderDraftMenu = () => {
      const drafts = readKoiDrafts()

      draftMenu.innerHTML = drafts.length
        ? drafts.map((draft) => `
          <div class="koi-draft-item">
            <button class="dropdown-item" type="button" data-load-koi-draft="${escapeHtml(draft.id)}">
              ${escapeHtml(draft.name || formatDraftName(draft.created_at))}
            </button>
            <button class="btn btn-outline-primary btn-sm btn-icon" type="button" data-rename-koi-draft="${escapeHtml(draft.id)}" aria-label="Rename draft" title="Rename draft">
              ${pencilIcon}
            </button>
            <button class="btn btn-outline-danger btn-sm btn-icon" type="button" data-delete-koi-draft="${escapeHtml(draft.id)}" data-role-required="database-write" aria-label="Hapus draft" title="Hapus draft">
              ${trashIcon}
            </button>
          </div>
        `).join('')
        : '<span class="dropdown-item text-secondary">Belum ada draft</span>'
    }

    const readEditPayload = () => {
      syncEditPond()
      const value = (name) => {
        const fieldValue = editForm.querySelector(`[name="${name}"]`)?.value || ''

        return moneyFieldNames.has(name) ? cleanMoneyValue(fieldValue) : fieldValue
      }
      const editParentMale = editBreederMale?.value || 'mix'

      return {
        code: value('code'),
        name: value('name'),
        pond_id: value('pond_id'),
        variety: value('variety'),
        bloodline: value('bloodline'),
        farm_name: value('farm_name'),
        breeder: value('breeder'),
        parent_info: enrichParentInfoValue(value('parent_info'), editParentMale),
        gender: value('gender'),
        parent_type: editForm.querySelector('[name="parent_type"]').checked ? 'indukan' : 'non_indukan',
        birth_date: value('birth_date'),
        purchase_date: value('purchase_date'),
        purchase_price: value('purchase_price'),
        sale_price: value('sale_price'),
        current_length_cm: value('current_length_cm'),
        status: value('status'),
        notes: value('notes'),
      }
    }

    const setEditValue = (name, value) => {
      const field = editForm.querySelector(`[name="${name}"]`)

      if (field) {
        field.value = moneyFieldNames.has(name) ? formatMoneyValue(value) : value || ''
      }
    }

    const findKoiByIdOrCode = (value) => {
      const token = String(value || '').trim().toLowerCase()

      if (!token) {
        return null
      }

      return koiItems.find((item) => String(item.id) === token || String(item.code || '').toLowerCase() === token) || null
    }

    const pullKoiTokens = () => String(pullKoiIdsInput?.value || '').split(/\s+/).map((item) => item.trim()).filter(Boolean)
    const closePullKoiMenu = () => {
      document.querySelector('[data-pull-koi-menu]')?.classList.add('d-none')
    }
    const renderPullKoiMenu = () => {
      const menu = document.querySelector('[data-pull-koi-menu]')
      if (!menu || !pullKoiIdsInput) return

      const tokens = pullKoiTokens()
      const currentWord = String(pullKoiIdsInput.value || '').split(/\s+/).pop().trim().toLowerCase()
      const selected = new Set(tokens.map((token) => token.toLowerCase()))
      const matches = koiItems
        .filter((item) => {
          const textValue = [item.id, item.code, item.name, item.variety, item.bloodline].filter(Boolean).join(' ').toLowerCase()
          return !currentWord || textValue.includes(currentWord)
        })
        .slice(0, 10)

      menu.innerHTML = matches.length
        ? matches.map((item) => {
          const code = String(item.code || item.id || '').trim()
          const active = selected.has(code.toLowerCase()) || selected.has(String(item.id).toLowerCase())
          return `
            <button class="koi-parent-search-item" type="button" data-pull-koi-pick="${escapeHtml(code)}">
              <span class="koi-parent-search-main">
                ${item.image_url ? `<img class="koi-parent-search-thumb" src="${escapeHtml(item.image_url)}" alt="${escapeHtml(code)}" loading="lazy" decoding="async" fetchpriority="low" />` : '<span class="koi-parent-search-thumb koi-parent-search-placeholder">KOI</span>'}
                <span class="koi-parent-search-copy">
                  <span class="d-block fw-medium text-truncate">${active ? '✓ ' : ''}${escapeHtml(code)}</span>
                  <span class="d-block text-secondary small text-truncate">${escapeHtml([item.name, item.variety, item.bloodline].filter(Boolean).join(' - ') || 'Data ikan')}</span>
                </span>
              </span>
            </button>
          `
        }).join('')
        : '<div class="koi-parent-search-empty">Tidak ada ikan yang cocok</div>'
      menu.classList.remove('d-none')
    }
    const pickPullKoiItem = (code) => {
      if (!pullKoiIdsInput || !code) return
      const tokens = pullKoiTokens()
      const exists = tokens.some((token) => token.toLowerCase() === String(code).toLowerCase())
      const rawValue = String(pullKoiIdsInput.value || '')
      const shouldReplaceLast = !/\s$/.test(rawValue) && tokens.length > 0
      const nextTokens = exists
        ? tokens
        : shouldReplaceLast
          ? [...tokens.slice(0, -1), code]
          : [...tokens, code]

      pullKoiIdsInput.value = nextTokens.filter(Boolean).join(' ') + ' '
      pullKoiIdsStatus.textContent = `${nextTokens.length} ID/kode dipilih.`
      pullKoiIdsInput.focus()
      renderPullKoiMenu()
    }

    const pullKoiEntriesByIds = () => {
      const tokens = pullKoiTokens()

      if (tokens.length === 0) {
        pullKoiIdsStatus.textContent = 'Masukkan ID/kode ikan terlebih dahulu.'
        return
      }

      const found = []
      const missing = []
      const seen = new Set()

      tokens.forEach((token) => {
        const koi = findKoiByIdOrCode(token)

        if (!koi) {
          missing.push(token)
          return
        }

        if (seen.has(String(koi.id))) {
          return
        }

        seen.add(String(koi.id))
        found.push(koi)
      })

      if (found.length === 0) {
        pullKoiIdsStatus.textContent = `Tidak ada data cocok: ${missing.join(', ')}`
        return
      }

      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      found.forEach((item) => {
        addKoiEntry()
        const entry = [...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1)
        fillEntryFromDraft(entry, {
          ...item,
          birth_date: item.birth_date ? String(item.birth_date).slice(0, 10) : '',
          purchase_date: item.purchase_date ? String(item.purchase_date).slice(0, 10) : '',
        })
      })
      bulkEditKoiIds = found.map((item) => String(item.id))
      addFormTitle.textContent = `Formulir Edit ${found.length} Ikan dari ID/Kode`
      addEntryButton.disabled = true
      draftButton.disabled = true
      draftToggle.disabled = true
      pullKoiIdsStatus.textContent = missing.length
        ? `${found.length} data ditarik. Tidak ditemukan: ${missing.join(', ')}`
        : `${found.length} data ditarik ke formulir.`
      refreshEntryControls()
    }

    const setEditGender = (value = 'unknown') => {
      const normalized = ['male', 'female'].includes(String(value || '').toLowerCase()) ? String(value).toLowerCase() : 'unknown'
      const hidden = editForm.querySelector('[data-edit-gender-value]')

      if (hidden) {
        hidden.value = normalized
      }

      editForm.querySelectorAll('[data-edit-gender]').forEach((input) => {
        input.checked = input.value === normalized
      })
    }

    const setEditPreview = (koi) => {
      editKoiPreview.innerHTML = koi.image_url
        ? `<img src="${escapeHtml(koi.image_url)}" alt="${escapeHtml(text(koi.name))}" />`
        : `<span class="koi-card-preview-code">${escapeHtml(text(koi.code))}</span>`
    }

    const openPhotoHistoryZoom = (imageUrl, title) => {
      photoZoomImage.src = imageUrl
      photoZoomTitle.textContent = title || 'Preview Foto'
      openModal(photoZoomModalElement)
    }

    let currentPhotoHistory = []
    let photoHistoryDrag = null
    const photoHistoryLabel = (item, index) => `[${index + 1}] ${item.length_cm ? `${escapeHtml(formatDecimal(item.length_cm))} cm` : 'Tanpa ukuran'}`
    const dragHandleIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>'
    const renderPhotoHistory = (history) => {
      currentPhotoHistory = [...history]
      editPhotoHistory.innerHTML = history.map((item, index) => {
        const label = photoHistoryLabel(item, index)

        return `
          <div class="koi-photo-history-item" data-photo-history-card="${escapeHtml(item.id)}">
            <div class="koi-photo-history-actions btn-list flex-nowrap">
              <span class="btn btn-outline-secondary btn-sm btn-icon koi-photo-history-drag-handle" data-photo-history-drag-handle aria-label="Geser untuk urutkan" title="Geser untuk urutkan">${dragHandleIcon}</span>
              <button class="btn btn-outline-danger btn-sm btn-icon" type="button" data-delete-photo-history="${escapeHtml(item.id)}" aria-label="Hapus foto progress" title="Hapus foto progress">${trashIcon}</button>
            </div>
            <button class="koi-photo-history-preview" type="button" data-preview-photo-history="${escapeHtml(item.image_url)}" data-preview-photo-title="${label}" aria-label="Preview foto progress">
              <img src="${escapeHtml(item.image_url)}" alt="Progress foto" loading="lazy" />
            </button>
            <button class="btn btn-link p-0 mt-1 small fw-medium text-start" type="button" data-edit-photo-history-size="${escapeHtml(item.id)}" title="Edit ukuran progress">${label}</button>
            <div class="text-secondary small">${escapeHtml(item.measured_at ? String(item.measured_at).slice(0, 10) : '')}</div>
          </div>
        `
      }).join('') || '<div class="text-secondary">Belum ada history foto.</div>'
    }

    const savePhotoHistoryOrder = async (nextHistory) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!koiId || nextHistory.length === 0) {
        return
      }

      renderPhotoHistory(nextHistory)
      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/order`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ids: nextHistory.map((historyItem) => historyItem.id) }),
      })
      const data = await response.json()

      if (!response.ok) {
        await loadPhotoHistory(koiId)
        throw new Error(data.detail || data.error || 'Urutan history foto gagal disimpan')
      }

      // Cover foto & size ikan ikut kode di endpoint order (lihat POST /koi/:id/photo-history/order),
      // jadi cukup patch data lokal di sini — tidak perlu fetch ulang+render ulang SELURUH grid ikan.
      const latestKoi = koiItems.find((koiItem) => String(koiItem.id) === String(koiId))
      const cover = nextHistory[0]

      if (latestKoi && cover?.image_url) {
        latestKoi.image_url = cover.image_url
        if (cover.length_cm != null) latestKoi.current_length_cm = cover.length_cm
        if (cover.weight_g != null) latestKoi.current_weight_g = cover.weight_g
        setEditPreview(latestKoi)
        renderCards()
      }
    }

    const getPhotoHistoryCards = () => Array.from(editPhotoHistory.querySelectorAll('[data-photo-history-card]'))

    const photoHistoryGridPosition = (drag, index) => {
      const col = index % drag.colCount
      const row = Math.floor(index / drag.colCount)
      return { x: drag.originLeft + col * drag.cellWidth, y: drag.originTop + row * drag.cellHeight }
    }

    const photoHistoryDragStart = (event) => {
      if (event.button !== undefined && event.button !== 0) return

      const card = event.target.closest('[data-photo-history-card]')

      // Drag only starts from the dedicated handle — never from the photo/preview button or the
      // other action buttons. On touch, a finger is far less precise than a mouse cursor, so
      // letting drag start from the same area as tap-to-zoom made the two gestures fight each
      // other (mobile taps kept getting swallowed as micro-drags).
      if (!card || !event.target.closest('[data-photo-history-drag-handle]')) return

      const cards = getPhotoHistoryCards()

      if (cards.length <= 1) return

      const rects = new Map(cards.map((item) => [item.dataset.photoHistoryCard, item.getBoundingClientRect()]))
      const firstRect = rects.get(cards[0].dataset.photoHistoryCard)
      let colCount = 1

      for (let i = 1; i < cards.length; i += 1) {
        const rect = rects.get(cards[i].dataset.photoHistoryCard)
        if (Math.abs(rect.top - firstRect.top) > 1) break
        colCount += 1
      }

      const secondRowCard = cards[colCount]

      photoHistoryDrag = {
        pointerId: event.pointerId,
        card,
        id: card.dataset.photoHistoryCard,
        startX: event.clientX,
        startY: event.clientY,
        initialOrder: cards.map((item) => item.dataset.photoHistoryCard),
        order: cards.map((item) => item.dataset.photoHistoryCard),
        colCount,
        cellWidth: colCount > 1 ? rects.get(cards[1].dataset.photoHistoryCard).left - firstRect.left : firstRect.width,
        cellHeight: secondRowCard ? rects.get(secondRowCard.dataset.photoHistoryCard).top - firstRect.top : firstRect.height,
        originLeft: firstRect.left,
        originTop: firstRect.top,
        activated: false,
      }
    }

    const photoHistoryDragMove = (event) => {
      const drag = photoHistoryDrag

      if (!drag || event.pointerId !== drag.pointerId) return

      const dx = event.clientX - drag.startX
      const dy = event.clientY - drag.startY

      if (!drag.activated) {
        if (Math.abs(dx) < 4 && Math.abs(dy) < 4) return

        drag.activated = true
        drag.card.classList.add('is-dragging')
        editPhotoHistory.classList.add('is-reordering')
        drag.card.setPointerCapture(drag.pointerId)
        document.body.style.userSelect = 'none'
        document.body.style.touchAction = 'none'
      }

      event.preventDefault()
      drag.card.style.transform = `translate(${dx}px, ${dy}px)`

      // Column/row shift = how many whole cell-widths/heights the pointer has moved,
      // added to the dragged item's ORIGINAL column/row (not its current one).
      const startIndex = drag.initialOrder.indexOf(drag.id)
      const startCol = startIndex % drag.colCount
      const startRow = Math.floor(startIndex / drag.colCount)
      const col = Math.min(drag.colCount - 1, Math.max(0, Math.round(startCol + dx / drag.cellWidth)))
      const row = Math.max(0, Math.round(startRow + dy / drag.cellHeight))
      const targetIndex = Math.min(drag.order.length - 1, row * drag.colCount + col)
      const fromIndex = drag.order.indexOf(drag.id)

      if (targetIndex !== fromIndex) {
        drag.order.splice(fromIndex, 1)
        drag.order.splice(targetIndex, 0, drag.id)
      }

      drag.order.forEach((id, currentIndex) => {
        if (id === drag.id) return

        const card = getPhotoHistoryCards().find((item) => item.dataset.photoHistoryCard === id)
        if (!card) return

        const naturalIndex = drag.initialOrder.indexOf(id)
        const naturalPos = photoHistoryGridPosition(drag, naturalIndex)
        const targetPos = photoHistoryGridPosition(drag, currentIndex)
        const shiftX = targetPos.x - naturalPos.x
        const shiftY = targetPos.y - naturalPos.y

        card.style.transform = shiftX || shiftY ? `translate(${shiftX}px, ${shiftY}px)` : ''
      })
    }

    const photoHistoryDragEnd = (event) => {
      const drag = photoHistoryDrag

      if (!drag || (event.pointerId !== undefined && event.pointerId !== drag.pointerId)) return

      photoHistoryDrag = null
      document.body.style.userSelect = ''
      document.body.style.touchAction = ''

      if (!drag.activated) return

      editPhotoHistory.classList.remove('is-reordering')

      const changed = drag.order.some((id, index) => id !== drag.initialOrder[index])

      if (!changed) {
        getPhotoHistoryCards().forEach((card) => { card.style.transform = '' })
        drag.card.classList.remove('is-dragging')
        return
      }

      const nextHistory = drag.order
        .map((id) => currentPhotoHistory.find((item) => String(item.id) === String(id)))
        .filter(Boolean)

      // renderPhotoHistory() (called synchronously at the start of savePhotoHistoryOrder, before
      // its first await) rebuilds the grid in the new order, so the dragged card gets swapped for a
      // fresh element sitting right in its natural resting slot. Capture where it visually was and
      // "fly" the new element from there back to rest, instead of letting it just snap into place.
      const beforeRect = drag.card.getBoundingClientRect()
      const savePromise = savePhotoHistoryOrder(nextHistory)
      const newCard = getPhotoHistoryCards().find((item) => item.dataset.photoHistoryCard === drag.id)

      if (newCard) {
        const afterRect = newCard.getBoundingClientRect()
        const flyX = beforeRect.left - afterRect.left
        const flyY = beforeRect.top - afterRect.top

        newCard.style.transition = 'none'
        newCard.style.transform = `translate(${flyX}px, ${flyY}px)`

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            newCard.style.transition = 'transform .2s ease'
            newCard.style.transform = ''
            newCard.addEventListener('transitionend', () => {
              newCard.style.transition = ''
            }, { once: true })
          })
        })
      }

      savePromise.catch((error) => alert(error.message))
    }

    const loadPhotoHistory = async (koiId) => {
      editPhotoHistory.innerHTML = '<div class="text-secondary">Memuat history foto.</div>'
      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history`)
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'History foto gagal dimuat')
      }

      renderPhotoHistory(data)
    }

    const editPhotoHistorySize = async (historyId) => {
      const koiId = editForm.querySelector('[name="id"]').value
      const history = currentPhotoHistory.find((item) => String(item.id) === String(historyId))
      const currentValue = history?.length_cm ? formatDecimal(history.length_cm) : ''
      const nextValue = window.prompt('Isi ukuran progress foto dalam cm. Kosongkan untuk Tanpa ukuran.', currentValue)

      if (nextValue === null || !koiId) {
        return
      }

      const normalizedValue = String(nextValue || '').trim().replace(',', '.')
      if (normalizedValue && !Number.isFinite(Number(normalizedValue))) {
        alert('Ukuran tidak valid.')
        return
      }

      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/${historyId}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ length_cm: normalizedValue }),
      })
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'Ukuran history foto gagal disimpan')
      }

      await loadPhotoHistory(koiId)
      await keepScroll(loadKoi)
      const latestKoi = koiItems.find((item) => String(item.id) === String(koiId))

      if (latestKoi) {
        setEditPreview(latestKoi)
      }
    }
    const deletePhotoHistory = async (historyId) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!koiId || !window.confirm('Hapus foto progress ini?')) {
        return
      }

      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/${historyId}`, { method: 'DELETE' })
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'History foto gagal dihapus')
      }

      await loadPhotoHistory(koiId)
      await keepScroll(loadKoi)
      const latestKoi = koiItems.find((item) => String(item.id) === String(koiId))

      if (latestKoi) {
        setEditPreview(latestKoi)
      }
    }

    const openEditKoi = (id) => {
      const koi = koiItems.find((item) => String(item.id) === String(id))

      if (!koi) {
        return
      }

      editErrorBox.classList.add('d-none')
      setEditPreview(koi)
      setEditValue('id', koi.id)
      setEditValue('code', koi.code)
      setEditValue('name', koi.name)
      setEditValue('pond_id', koi.pond_id)
      editForm.querySelector('[data-edit-pond-select]').value = koi.pond_name || ''
      editForm.querySelector('[data-edit-pond-location]').value = koi.pond_location || koi.location_name || ''
      updatePondClearVisibility(editForm.querySelector('[data-edit-pond-select]')?.closest('.koi-pond-search'))
      updatePondClearVisibility(editForm.querySelector('[data-edit-pond-location]')?.closest('.koi-pond-search'))
      setEditValue('variety', koi.variety)
      setEditValue('bloodline', koi.bloodline)
      setEditValue('farm_name', koi.farm_name)
      setEditValue('breeder', koi.breeder)
      setEditValue('parent_info', koi.parent_info)
      setEditGender(koi.gender || 'unknown')
      editForm.querySelector('[name="parent_type"]').checked = koi.parent_type === 'indukan'
      setEditValue('status', koi.status || 'active')
      setEditValue('birth_date', koi.birth_date ? String(koi.birth_date).slice(0, 10) : '')
      setEditValue('purchase_date', koi.purchase_date ? String(koi.purchase_date).slice(0, 10) : '')
      setEditValue('purchase_price', koi.purchase_price)
      setEditValue('sale_price', koi.sale_price)
      setEditValue('current_length_cm', koi.current_length_cm)
      setEditValue('notes', koi.notes)
      updateEditBreederParents()
      loadPhotoHistory(koi.id).catch((error) => {
        editPhotoHistory.innerHTML = `<div class="text-danger">${escapeHtml(error.message)}</div>`
      })
      openModal(editModalElement)
    }

    const buildFilterOptions = () => {
      filters.forEach((filter) => {
        const key = filter.dataset.filter
        const currentValue = filter.value
        const values = uniqueKoiValues(key)
        filter.innerHTML = '<option value="">Semua</option>' + values.map((value) => `
          <option value="${escapeHtml(value)}">${escapeHtml(labels[value] || value)}</option>
        `).join('')
        filter.value = values.includes(currentValue) ? currentValue : ''
      })

      varietyOptions.innerHTML = uniqueKoiValues('variety').map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
      buildBreederOptions()
    }

    const buildBreederOptions = () => {
      const values = [...new Set([
        ...koiItems.map((item) => filterValue(item, 'breeder')).filter(Boolean),
      ])].sort()

      breederOptions.innerHTML = values.map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
      parentOptions.innerHTML = [...new Set([
        ...koiItems.map((item) => filterValue(item, 'parent_info')).filter(Boolean),
        ...breedingItems.flatMap((item) => {
          const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
          const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')

          return [
            ...breedingSearchValues(item),
            ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).map(parentLabel),
            ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).map(parentLabel),
          ].filter(Boolean)
        }),
      ])].sort()
        .map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
    }

    const normalizeSearchText = (value) => String(value || '').trim().toLowerCase()
    const parseSearchTerms = (value) => normalizeSearchText(value)
      .split(/[,\s]+/)
      .map((term) => term.trim())
      .filter(Boolean)
    const parseSizeRange = (value) => {
      const match = normalizeSearchText(value).match(/^(\d+(?:[.,]\d+)?)\s*-\s*(\d+(?:[.,]\d+)?)$/)

      if (!match) {
        return null
      }

      const min = Number(match[1].replace(',', '.'))
      const max = Number(match[2].replace(',', '.'))

      return Number.isFinite(min) && Number.isFinite(max) ? [Math.min(min, max), Math.max(min, max)] : null
    }
    const koiSequenceCompare = (first, second) => {
      const firstDate = String(first.created_at || '')
      const secondDate = String(second.created_at || '')
      const dateCompare = firstDate.localeCompare(secondDate)

      return dateCompare || Number(first.id || 0) - Number(second.id || 0)
    }

    const rebuildKoiSequence = () => {
      koiSequenceById = new Map([...koiItems]
        .sort(koiSequenceCompare)
        .map((item, index) => [String(item.id), index + 1]))
    }

    const koiSequenceIndex = (item) => koiSequenceById.get(String(item.id)) || 0

    const matchesKoiSearch = (item) => {
      const keyword = searchInput.value.trim()

      if (!keyword) {
        return true
      }

      const sizeRange = parseSizeRange(keyword)
      if (sizeRange) {
        const size = Number(item.current_length_cm)

        return Number.isFinite(size) && size >= sizeRange[0] && size <= sizeRange[1]
      }

      const terms = parseSearchTerms(keyword)
      const searchableValues = [
        item.id,
        koiSequenceNumber(item),
        item.code,
        item.name,
        item.bloodline,
        item.farm_name,
        item.notes,
        item.current_length_cm,
      ].map(normalizeSearchText)

      return terms.length === 0 || terms.some((term) => searchableValues.some((value) => value.includes(term)))
    }

    const selectedGenderFilter = () => genderFilterInputs.find((input) => input.checked)?.value || ''

    const selectedParentTypeFilters = () => parentTypeFilters.filter((input) => input.checked).map((input) => input.value)

    const hasActiveKoiFilters = () => Boolean(searchInput.value.trim()) || filters.some((filter) => Boolean(filter.value)) || Boolean(selectedGenderFilter()) || selectedParentTypeFilters().length > 0

    const updateClearFiltersButton = () => {
      clearFiltersButton?.classList.toggle('d-none', !hasActiveKoiFilters())
    }

    const clearKoiFilters = () => {
      searchInput.value = ''
      filters.forEach((filter) => {
        filter.value = ''
        filter.dispatchEvent(new Event('change', { bubbles: true }))
      })
      genderFilterInputs.forEach((input) => {
        input.checked = false
      })
      parentTypeFilters.forEach((input) => {
        input.checked = false
      })
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    }
    const getFilteredKoi = () => {
      const direction = sequenceSortDirection === 'desc' ? -1 : 1
      const filteredItems = koiItems.filter((item) => {
        if (showSelectedOnly && !selectedKoiIds.has(String(item.id))) {
          return false
        }

        if (hideSelected && selectedKoiIds.has(String(item.id))) {
          return false
        }

        if (!matchesKoiSearch(item)) {
          return false
        }

        const matchDropdownFilters = filters.every((filter) => {
          const value = filter.value
          return !value || filterValue(item, filter.dataset.filter) === value
        })

        if (!matchDropdownFilters) {
          return false
        }

        const genderFilter = selectedGenderFilter()
        if (genderFilter && filterValue(item, 'gender') !== genderFilter) {
          return false
        }

        const parentTypeValues = selectedParentTypeFilters()
        return !parentTypeValues.length || parentTypeValues.includes(filterValue(item, 'parent_type') || 'non_indukan')
      })

      return filteredItems.sort((first, second) => {
        const sequenceDiff = koiSequenceIndex(first) - koiSequenceIndex(second)

        return direction * (sequenceDiff || Number(first.id || 0) - Number(second.id || 0))
      })
    }

    const getVisibleKoi = () => getFilteredKoi().slice((currentPage - 1) * pageSize, currentPage * pageSize)

    const pageRange = (current, total) => {
      const pages = new Set([1, total])

      for (let page = current - 2; page <= current + 2; page += 1) {
        if (page >= 1 && page <= total) {
          pages.add(page)
        }
      }

      return [...pages].sort((a, b) => a - b)
    }

    const renderPagination = (totalItems, totalPages) => {
      previewControls.classList.toggle('d-none', totalItems === 0)
      pageSizeButtons.forEach((button) => {
        const active = Number(button.dataset.koiPageSize) === pageSize
        button.classList.toggle('btn-primary', active)
        button.classList.toggle('btn-outline-primary', !active)
      })

      if (totalItems === 0) {
        pageSummary.textContent = ''
        pagination.innerHTML = ''
        return
      }

      const start = (currentPage - 1) * pageSize + 1
      const end = Math.min(currentPage * pageSize, totalItems)

      pageSummary.textContent = `Menampilkan ${start} - ${end} dari ${totalItems} ikan`
      pagination.innerHTML = `
        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
          <button class="page-link" type="button" data-koi-page="${currentPage - 1}" data-mobile-label="Prev" aria-label="Halaman sebelumnya">Sebelumnya</button>
        </li>
        ${pageRange(currentPage, totalPages).map((page, index, pages) => `
          ${index > 0 && page - pages[index - 1] > 1 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
          <li class="page-item ${page === currentPage ? 'active' : ''}">
            <button class="page-link" type="button" data-koi-page="${page}">${page}</button>
          </li>
        `).join('')}
        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
          <button class="page-link" type="button" data-koi-page="${currentPage + 1}" data-mobile-label="Next" aria-label="Halaman berikutnya">Berikutnya</button>
        </li>
      `
    }

    const updateSelectedCount = () => {
      selectedNumber.textContent = selectedKoiIds.size
      selectedCount.classList.toggle('btn-outline-primary', !showSelectedOnly)
      selectedCount.classList.toggle('btn-primary', showSelectedOnly)
      selectedCount.disabled = selectedKoiIds.size === 0
      selectedCount.setAttribute('aria-pressed', showSelectedOnly ? 'true' : 'false')
      selectedCount.setAttribute('aria-label', showSelectedOnly ? 'Tampilkan semua data ikan' : `Tampilkan ${selectedKoiIds.size} ikan yang dipilih`)
      selectedCount.setAttribute('title', showSelectedOnly ? 'Tampilkan semua data' : 'Tampilkan yang dipilih')
      hideSelectedButton.classList.toggle('btn-outline-primary', !hideSelected)
      hideSelectedButton.classList.toggle('btn-primary', hideSelected)
      hideSelectedButton.setAttribute('aria-pressed', hideSelected ? 'true' : 'false')
      hideSelectedButton.setAttribute('aria-label', hideSelected ? 'Tampilkan kembali yang disembunyikan' : 'Sembunyikan yang dipilih')
      hideSelectedButton.setAttribute('title', hideSelected ? 'Tampilkan kembali yang disembunyikan' : 'Sembunyikan yang dipilih')
      deleteSelectedButton.classList.toggle('d-none', selectedKoiIds.size === 0)
      selectedActionButtons.forEach((button) => button.classList.toggle('d-none', selectedKoiIds.size === 0))
      deleteSelectedButton.innerHTML = trashIcon
      deleteSelectedButton.setAttribute('aria-label', selectedKoiIds.size > 0 ? `Hapus ${selectedKoiIds.size} ikan terpilih` : 'Hapus terpilih')
      deleteSelectedButton.setAttribute('title', selectedKoiIds.size > 0 ? `Hapus ${selectedKoiIds.size} ikan terpilih` : 'Hapus terpilih')
    }

    const syncSelectionView = () => {
      if (selectedKoiIds.size === 0) {
        showSelectedOnly = false
        hideSelected = false
      }

      if (showSelectedOnly || hideSelected) {
        currentPage = 1
        renderCards()
      } else {
        updateSelectedCount()
      }
    }

    const toggleKoiSelection = (id, forceSelected = null) => {
      const koiId = String(id)
      const shouldSelect = forceSelected ?? !selectedKoiIds.has(koiId)

      if (shouldSelect) {
        selectedKoiIds.add(koiId)
      } else {
        selectedKoiIds.delete(koiId)
      }

      const escapedId = window.CSS?.escape ? CSS.escape(koiId) : koiId.replace(/"/g, '\\"')
      cards.querySelectorAll(`[data-koi-preview-select="${escapedId}"]`).forEach((preview) => {
        preview.closest('.koi-card-compact')?.classList.toggle('is-selected', selectedKoiIds.has(koiId))
      })
      syncSelectionView()
    }

    const selectVisibleKoi = () => {
      getVisibleKoi().forEach((item) => selectedKoiIds.add(String(item.id)))
      showSelectedOnly = false
      hideSelected = false
      renderCards()
    }

    const clearSelectedKoi = () => {
      selectedKoiIds.clear()
      showSelectedOnly = false
      hideSelected = false
      currentPage = 1
      renderCards()
    }

    const copyText = async (value) => {
      const textValue = String(value || '')

      if (!textValue || textValue === '-') {
        return false
      }

      const textarea = document.createElement('textarea')
      textarea.value = textValue
      textarea.setAttribute('readonly', '')
