---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Icon from '@shared/ui/Icon.astro'
import icons from '@data/icons.json'

const iconSvg = (name: string) => {
  const icon = (icons as unknown as Record<string, { svg: Record<string, string> }>)[name]
  let svg = icon?.svg?.outline ?? ''

  svg = svg.replace(/<path stroke="none" d="M0 0h24v24H0z" fill="none"\s*\/>/, '')
  svg = svg.replace(/class="[^"]+"/, 'aria-hidden="true" focusable="false" class="icon"')

  return svg
}

const editIcon = iconSvg('edit')
const printIcon = iconSvg('printer')
const trashIcon = iconSvg('trash')
const saveIcon = iconSvg('device-floppy')
---

<DefaultLayout title="Breeding" pageHeader="Breeding" pretitle="Management" pageMenu="farm-breeding" pageLibs={['litepicker']}>
  <style is:global>
    .breeding-parent-preview {
      min-height: 0;
    }

    .breeding-parent-photo {
      width: 72px;
      aspect-ratio: 2 / 3;
      flex: 0 0 auto;
      border: 1px solid var(--tblr-border-color);
      border-radius: 6px;
      background: var(--tblr-bg-surface-secondary);
      overflow: hidden;
    }

    .breeding-parent-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .breeding-parent-photo-button {
      border: 0;
      padding: 0;
      background: transparent;
      cursor: zoom-in;
    }

    .breeding-parent-placeholder {
      width: 100%;
      height: 100%;
      padding: 0.35rem;
      color: var(--tblr-secondary);
      font-size: 0.68rem;
      line-height: 1.15;
      text-align: center;
    }

    .breeding-parent-size {
      width: 72px;
      max-width: 100%;
    }

    .breeding-parent-size .form-label {
      display: block;
      text-align: center;
    }

    .breeding-parent-size .form-control {
      padding-right: 0.25rem;
      padding-left: 0.25rem;
      text-align: center;
    }

    .breeding-parent-size .form-control::-webkit-outer-spin-button,
    .breeding-parent-size .form-control::-webkit-inner-spin-button {
      margin: 0;
      appearance: none;
    }

    .breeding-parent-size .form-control[type='number'] {
      appearance: textfield;
    }

    .breeding-parent-search-wrap {
      position: relative;
    }

    .breeding-parent-suggestions {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      z-index: 1080;
      max-height: 240px;
      overflow-y: auto;
      background: var(--tblr-bg-surface);
      border: 1px solid var(--tblr-border-color);
      border-radius: 6px;
      box-shadow: var(--tblr-box-shadow-dropdown);
    }

    .breeding-parent-suggestion {
      width: 100%;
      border: 0;
      border-bottom: 1px solid var(--tblr-border-color);
      background: transparent;
      color: inherit;
      text-align: left;
    }

    .breeding-parent-suggestion:last-child {
      border-bottom: 0;
    }

    .breeding-parent-suggestion:hover,
    .breeding-parent-suggestion:focus {
      background: var(--tblr-bg-surface-secondary);
    }

    [data-parent-entry='male'] {
      border-top: 2px solid var(--tblr-border-color);
      padding-top: 1rem;
      margin-top: 0.75rem;
    }

    [data-parent-entry='male']:first-child {
      border-top: 0;
      padding-top: 0;
    }

    [data-pond-entry] {
      border-top: 2px solid var(--tblr-border-color);
      padding-top: 0.85rem;
      margin-top: 0.85rem;
    }

    [data-pond-entry]:first-child {
      border-top: 0;
      padding-top: 0;
      margin-top: 0;
    }

    .breeding-mention-wrap {
      position: relative;
    }

    .breeding-zoom {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(15, 23, 42, 0.82);
    }

    .breeding-zoom img {
      max-width: min(92vw, 720px);
      max-height: 86vh;
      border-radius: 8px;
      background: var(--tblr-bg-surface);
      object-fit: contain;
    }

    .breeding-zoom-close {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 2001;
    }

    .breeding-table-wrap {
      overflow: visible;
    }

    .breeding-actions-menu {
      z-index: 1085;
    }

    @media (max-width: 991.98px) {
      .breeding-table-wrap {
        overflow-x: auto;
        overflow-y: visible;
        padding-bottom: 4.5rem;
      }

      .breeding-actions-dropdown .dropdown-menu.show {
        position: fixed !important;
        right: 1rem !important;
        left: auto !important;
        top: auto !important;
        bottom: 1rem !important;
        transform: none !important;
        min-width: 150px;
      }
    }
  </style>

  <div class="modal modal-blur fade" id="breeding-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <form class="modal-content" data-breeding-form>
        <div class="modal-header">
          <h5 class="modal-title" data-breeding-modal-title>Formulir Tambah Breeding</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" data-breeding-error></div>
          <input type="hidden" name="id" />
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Kode Batch</label>
              <input class="form-control" name="batch_code" placeholder="Kosongkan untuk otomatis" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Nama Sesi Breeding</label>
              <input class="form-control" name="session_name" placeholder="Contoh: Kohaku Januari" />
            </div>
            <div class="col-md-4">
              <label class="form-label">Tanggal</label>
              <input class="form-control" type="text" name="breeding_date" placeholder="yyyy-mm-dd" data-breeding-datepicker required />
            </div>
            <div class="col-md-4">
              <label class="form-label">Metode Pemijahan</label>
              <div class="btn-group w-100" role="group" data-exclusive-group="spawning_method">
                <input class="btn-check" type="checkbox" name="spawning_method" id="method-alami" value="alami" checked data-exclusive-option />
                <label class="btn" for="method-alami">Alami</label>
                <input class="btn-check" type="checkbox" name="spawning_method" id="method-stripping" value="stripping" data-exclusive-option />
                <label class="btn" for="method-stripping">Stripping</label>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Status Hasil Breeding</label>
              <div class="btn-group" role="group" data-exclusive-group="status">
                <input class="btn-check" type="checkbox" name="status" id="status-planning" value="planning" checked data-exclusive-option />
                <label class="btn" for="status-planning">Planning</label>
                <input class="btn-check" type="checkbox" name="status" id="status-proses" value="proses" data-exclusive-option />
                <label class="btn" for="status-proses">Proses</label>
                <input class="btn-check" type="checkbox" name="status" id="status-completed" value="completed" data-exclusive-option />
                <label class="btn" for="status-completed">Completed</label>
                <input class="btn-check" type="checkbox" name="status" id="status-failed" value="failed" data-exclusive-option />
                <label class="btn" for="status-failed">Failed</label>
              </div>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label mb-0">Indukan Betina</label>
              </div>
              <div class="vstack gap-2" data-parent-list="female"></div>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label mb-0">Indukan Jantan</label>
              </div>
              <div class="vstack gap-2" data-parent-list="male"></div>
              <button class="btn btn-sm btn-outline-primary mt-2" type="button" data-add-parent="male">Tambah Jantan</button>
            </div>
            <div class="col-12 border-top pt-3">
              <label class="form-label">Kolam</label>
              <div class="vstack gap-2" data-pond-list></div>
              <button class="btn btn-sm btn-outline-primary mt-2" type="button" data-add-pond>Mention Kolam</button>
            </div>
            <div class="col-md-6">
              <label class="form-label">Burayak</label>
              <input class="form-control" type="number" min="0" step="1" name="fry_count" placeholder="0" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Berat Telur (g)</label>
              <div class="input-group input-group-flat">
                <input class="form-control" type="number" min="0" step="0.01" name="egg_weight_g" placeholder="0" />
                <span class="input-group-text">g</span>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Catatan Utama</label>
              <textarea class="form-control" name="notes" rows="3"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label">Dokumentasi Breeding</label>
              <div class="d-flex flex-wrap gap-2">
                <input class="form-control flex-grow-1" name="breeding_documentation_files" type="file" accept="image/*,video/mp4,video/webm" multiple data-documentation-input />
                <button class="btn btn-outline-primary" type="button" data-documentation-paste>Paste Gambar</button>
              </div>
              <div class="form-hint">Bisa pilih lebih dari satu foto/video. Dokumentasi tersimpan di data breeding ini dan tidak otomatis masuk Gallery.</div>
              <div class="row g-2 mt-2" data-documentation-preview></div>
              <div class="text-secondary mt-2" data-documentation-status></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-icon" data-bs-dismiss="modal" aria-label="Batal" title="Batal">
            <Icon name="x" />
          </button>
          <button type="submit" class="btn btn-primary btn-icon" data-breeding-submit aria-label="Simpan breeding" title="Simpan breeding">
            <Icon name="device-floppy" />
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="breeding-zoom d-none" data-breeding-zoom>
    <button class="btn btn-light btn-icon breeding-zoom-close" type="button" data-close-breeding-zoom aria-label="Tutup preview">
      <Icon name="x" />
    </button>
    <img data-breeding-zoom-image alt="Preview indukan" />
  </div>

  <div class="row row-deck row-cards">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Daftar Breeding</h3>
          <div class="card-actions">
            <button class="btn btn-primary btn-icon" type="button" data-add-breeding aria-label="Tambah breeding" title="Tambah breeding">
              <Icon name="plus" />
            </button>
          </div>
        </div>
        <div class="table-responsive breeding-table-wrap">
          <table class="table card-table table-vcenter">
            <thead>
              <tr>
                <th>Kode Batch</th>
                <th>Nama Sesi</th>
                <th>Tanggal</th>
                <th>Indukan Betina</th>
                <th>Kolam</th>
                <th>Metode</th>
                <th>Status</th>
                <th>Burayak</th>
                <th>Berat Telur</th>
                <th class="w-1">Aksi</th>
              </tr>
            </thead>
            <tbody data-breeding-table>
              <tr><td colspan="10" class="text-secondary">Memuat data breeding.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <input class="d-none" id="breeding-search" name="breeding_search" type="search" data-breeding-search aria-hidden="true" tabindex="-1" autocomplete="off" />

  <div class="koi-print-root" data-breeding-print-root aria-hidden="true"></div>

  <style is:global>
    .koi-print-root { display: none; }

    @media print {
      body.koi-printing {
        background: #ffffff !important;
      }

      body.koi-printing > *:not(.koi-print-root) {
        display: none !important;
      }

      body.koi-printing .koi-print-root {
        display: block !important;
        position: static !important;
        width: 100% !important;
        min-height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #172033 !important;
      }
    }
  </style>

  <script define:vars={{ editIcon, printIcon, trashIcon, saveIcon }}>
    const apiUrl = '/api'
    const table = document.querySelector('[data-breeding-table]')
    const breedingSearchInput = document.querySelector('[data-breeding-search]')
    const form = document.querySelector('[data-breeding-form]')
    const zoom = document.querySelector('[data-breeding-zoom]')
    const zoomImage = document.querySelector('[data-breeding-zoom-image]')
    const errorBox = document.querySelector('[data-breeding-error]')
    const submitButton = document.querySelector('[data-breeding-submit]')
    const modalElement = document.querySelector('#breeding-modal')
    const modalTitle = document.querySelector('[data-breeding-modal-title]')
    const addButton = document.querySelector('[data-add-breeding]')
    const maleParentList = document.querySelector('[data-parent-list="male"]')
    const femaleParentList = document.querySelector('[data-parent-list="female"]')
    const pondList = document.querySelector('[data-pond-list]')
    const addPondButton = document.querySelector('[data-add-pond]')
    const documentationInput = document.querySelector('[data-documentation-input]')
    const documentationPasteButton = document.querySelector('[data-documentation-paste]')
    const documentationPreview = document.querySelector('[data-documentation-preview]')
    const documentationStatus = document.querySelector('[data-documentation-status]')
    const keepScroll = async (callback) => {
      const scrollX = window.scrollX
      const scrollY = window.scrollY
      const result = await callback()
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY))
      return result
    }
    let documentationFiles = []
    let breedingItems = []
    let breedingRealtimeSignature = ''
    const breedingCacheKey = 'nishikigoi-cache:farm-breeding'
    let maleOptions = []
    let femaleOptions = []
    let pondOptions = []
    let pondById = new Map()
    let koiById = new Map()

    const labels = {
      planning: { label: 'Planning', className: 'bg-secondary-lt' },
      proses: { label: 'Proses', className: 'bg-blue-lt' },
      completed: { label: 'Completed', className: 'bg-teal-lt' },
      failed: { label: 'Failed', className: 'bg-red-lt' },
    }
    const methodLabels = {
      alami: 'Alami',
      stripping: 'Stripping',
    }
    const activeStatuses = new Set(['planning', 'proses'])
    const text = (value) => value || '-'
    const escapeHtml = (value) =>
      String(value ?? '').replace(
        /[&<>'"]/g,
        (char) =>
          ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;',
          })[char],
      )
    const formatDate = (value) => (value ? new Date(value).toLocaleDateString('id-ID') : '-')
    const koiLabel = (item) => [item.code || `ID ${item.id}`, item.name].filter(Boolean).join(' - ') || 'Tanpa nama'
    const koiSearchText = (item) => [item.id, item.code, item.name, item.variety, item.bloodline, item.breeder].filter(Boolean).join(' ').toLowerCase()
    const parseJson = (value, fallback = []) => {
      try {
        return value ? JSON.parse(value) : fallback
      } catch {
        return fallback
      }
    }
    const normalizeSearch = (value) =>
      String(value || '')
        .toLowerCase()
        .trim()
    const parseEntries = (value, fallbackId, fallbackLabel) => {
      try {
        const parsed = typeof value === 'string' ? JSON.parse(value) : value
        const entries = Array.isArray(parsed) ? parsed : []

        return entries.length > 0 ? entries : fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '', notes: '' }] : []
      } catch (error) {
        return fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '', notes: '' }] : []
      }
    }
    const parsePondEntries = (value, fallbackId, fallbackLabel) => {
      try {
        const parsed = typeof value === 'string' ? JSON.parse(value) : value
        const entries = Array.isArray(parsed) ? parsed : []

        return entries.length > 0 ? entries : fallbackId ? [{ pond_id: fallbackId, label: fallbackLabel || '', notes: '' }] : []
      } catch (error) {
        return fallbackId ? [{ pond_id: fallbackId, label: fallbackLabel || '', notes: '' }] : []
      }
    }

    const getModalApi = () => window.tabler?.bootstrap?.Modal || window.bootstrap?.Modal

    const openModal = () => {
      const modalApi = getModalApi()

      if (modalApi) {
        modalApi.getOrCreateInstance(modalElement).show()
        return
      }

      modalElement.classList.add('show')
      modalElement.style.display = 'block'
      modalElement.removeAttribute('aria-hidden')
      modalElement.setAttribute('aria-modal', 'true')
      modalElement.setAttribute('role', 'dialog')
      document.body.classList.add('modal-open')

      if (!document.querySelector('[data-fallback-modal-backdrop]')) {
        const backdrop = document.createElement('div')
        backdrop.className = 'modal-backdrop fade show'
        backdrop.dataset.fallbackModalBackdrop = 'true'
        document.body.appendChild(backdrop)
      }
    }

    const closeModal = () => {
      const modalApi = getModalApi()

      if (modalApi) {
        modalApi.getInstance(modalElement)?.hide()
        return
      }

      modalElement.classList.remove('show')
      modalElement.style.display = 'none'
      modalElement.setAttribute('aria-hidden', 'true')
      modalElement.removeAttribute('aria-modal')
      modalElement.removeAttribute('role')
      document.body.classList.remove('modal-open')
      document.querySelector('[data-fallback-modal-backdrop]')?.remove()
    }

    const getBreedingSearchText = (item) => {
      const maleName = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
      const femaleName = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
      const maleEntries = parseEntries(item.male_parent_entries, item.male_koi_id, maleName)
      const femaleEntries = parseEntries(item.female_parent_entries, item.female_koi_id, femaleName)
      const pondEntries = parsePondEntries(item.pond_entries, item.pond_id, item.pond_name)
      const parentText = [...maleEntries, ...femaleEntries]
        .map((entry) => {
          const koi = entry.koi_id ? koiById.get(String(entry.koi_id)) : null
          return [entry.koi_id, entry.label, entry.notes, koi?.id, koi?.code, koi?.name, koi?.variety, koi?.bloodline, koi?.breeder, koi?.farm_name].filter(Boolean).join(' ')
        })
        .join(' ')
      const pondText = pondEntries.map((entry) => [entry.pond_id, entry.label, entry.notes].filter(Boolean).join(' ')).join(' ')

      return normalizeSearch([item.id, item.batch_code, item.session_name, item.breeding_date, methodLabels[item.spawning_method], item.spawning_method, labels[item.status]?.label, item.status, item.notes, item.fry_count, item.egg_weight_g, parentText, pondText].join(' '))
    }

    const filteredBreedingItems = () => {
      const query = normalizeSearch(breedingSearchInput?.value)

      return query ? breedingItems.filter((item) => getBreedingSearchText(item).includes(query)) : breedingItems
    }

    const setSummary = (items = breedingItems) => {
      const summaryActive = document.querySelector('[data-summary="active"]')
      const summaryMale = document.querySelector('[data-summary="male"]')
      const summaryFemale = document.querySelector('[data-summary="female"]')
      const summaryFry = document.querySelector('[data-summary="fry"]')

      if (summaryActive) summaryActive.textContent = items.filter((item) => activeStatuses.has(item.status)).length
      if (summaryMale) summaryMale.textContent = new Set(items.flatMap((item) => parseEntries(item.male_parent_entries, item.male_koi_id).map((entry) => entry.koi_id)).filter(Boolean)).size
      if (summaryFemale) summaryFemale.textContent = new Set(items.flatMap((item) => parseEntries(item.female_parent_entries, item.female_koi_id).map((entry) => entry.koi_id)).filter(Boolean)).size
      if (summaryFry) summaryFry.textContent = items.reduce((total, item) => total + Number(item.fry_count || 0), 0)
    }

    const renderTable = () => {
      const visibleItems = filteredBreedingItems()

      table.innerHTML =
        visibleItems
          .map((item) => {
            const status = labels[item.status] || labels.planning
            const femaleName = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
            const femaleEntries = parseEntries(item.female_parent_entries, item.female_koi_id, femaleName)
            const pondEntries = parsePondEntries(item.pond_entries, item.pond_id, item.pond_name)
            const renderFemalePreview = (entries) => {
              const entry = entries[0]
              const femaleFromOptions = entry?.koi_id ? koiById.get(String(entry.koi_id)) : null
              const female = {
                code: item.female_koi_code || femaleFromOptions?.code || entry?.label,
                name: item.female_koi_name || femaleFromOptions?.name,
                image_url: item.female_koi_image_url || femaleFromOptions?.image_url,
                variety: item.female_koi_variety || femaleFromOptions?.variety,
                bloodline: item.female_koi_bloodline || femaleFromOptions?.bloodline,
              }

              return entry
                ? `
            <div class="d-inline-flex flex-column align-items-center gap-1">
              <button class="breeding-parent-photo breeding-parent-photo-button d-flex align-items-center justify-content-center" type="button" data-zoom-image="${escapeHtml(female.image_url || '')}">
                ${female.image_url ? `<img src="${escapeHtml(female.image_url)}" alt="${escapeHtml(text(entry.label))}" loading="lazy" decoding="async" fetchpriority="low" />` : `<div class="breeding-parent-placeholder d-flex align-items-center justify-content-center">No foto</div>`}
              </button>
              <div class="small text-secondary text-center">${escapeHtml(text(female.code))}</div>
              ${entry.length_cm ? `<div class="text-secondary small text-center">${escapeHtml(entry.length_cm)} cm</div>` : ''}
              ${entry.notes ? `<div class="text-secondary small text-center">${escapeHtml(entry.notes)}</div>` : ''}
            </div>
          `
                : '-'
            }
            const renderPondSummary = (entries) =>
              entries
                .map(
                  (entry) => `
          <div>
            <div>${escapeHtml(text(entry.label))}</div>
            ${entry.notes ? `<div class="text-secondary small">${escapeHtml(entry.notes)}</div>` : ''}
          </div>
        `,
                )
                .join('') || '-'

            return `
          <tr>
            <td class="fw-medium">${escapeHtml(text(item.batch_code))}</td>
            <td>${escapeHtml(text(item.session_name))}</td>
            <td>${formatDate(item.breeding_date)}</td>
            <td>${renderFemalePreview(femaleEntries)}</td>
            <td>${renderPondSummary(pondEntries)}</td>
            <td>${escapeHtml(methodLabels[item.spawning_method] || text(item.spawning_method))}</td>
            <td><span class="badge ${status.className}">${status.label}</span></td>
            <td>${Number(item.fry_count || 0)}</td>
            <td>${item.egg_weight_g ? `${escapeHtml(item.egg_weight_g)} g` : '-'}</td>
            <td>
              <div class="dropdown breeding-actions-dropdown">
                <button class="btn btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" data-bs-display="dynamic" aria-expanded="false">
                  Aksi
                </button>
                <div class="dropdown-menu dropdown-menu-end breeding-actions-menu">
                  <button class="dropdown-item" type="button" data-print-breeding="${escapeHtml(item.id)}">${printIcon} Print</button>
                  <button class="dropdown-item" type="button" data-edit-breeding="${escapeHtml(item.id)}">${editIcon} Edit</button>
                  <button class="dropdown-item text-danger" type="button" data-delete-breeding="${escapeHtml(item.id)}">${trashIcon} Hapus</button>
                </div>
              </div>
            </td>
          </tr>
        `
          })
          .join('') || '<tr><td colspan="10" class="text-secondary">Data breeding tidak ditemukan.</td></tr>'
      setSummary(visibleItems)
    }

    const readFileAsDataUrl = (file) =>
      new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.addEventListener('load', () => resolve(reader.result))
        reader.addEventListener('error', () => reject(new Error('File dokumentasi gagal dibaca')))
        reader.readAsDataURL(file)
      })

    const loadImage = (src) =>
      new Promise((resolve, reject) => {
        const image = new Image()
        image.addEventListener('load', () => resolve(image))
        image.addEventListener('error', () => reject(new Error('Gambar dokumentasi gagal diproses')))
        image.src = src
      })

    const compressImage = async (file) => {
      const dataUrl = await readFileAsDataUrl(file)
      const image = await loadImage(dataUrl)
      const maxSize = 1600
      const scale = Math.min(1, maxSize / Math.max(image.naturalWidth, image.naturalHeight))
      const canvas = document.createElement('canvas')
      canvas.width = Math.max(1, Math.round(image.naturalWidth * scale))
      canvas.height = Math.max(1, Math.round(image.naturalHeight * scale))
      canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height)
      return canvas.toDataURL('image/jpeg', 0.76)
    }

    const createVideoThumbnail = (file) =>
      new Promise((resolve) => {
        const video = document.createElement('video')
        const canvas = document.createElement('canvas')
        const objectUrl = URL.createObjectURL(file)

        video.muted = true
        video.playsInline = true
        video.preload = 'metadata'
        video.addEventListener(
          'loadeddata',
          () => {
            canvas.width = video.videoWidth || 640
            canvas.height = video.videoHeight || 360
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height)
            URL.revokeObjectURL(objectUrl)
            resolve(canvas.toDataURL('image/webp', 0.82))
          },
          { once: true },
        )
        video.addEventListener(
          'error',
          () => {
            URL.revokeObjectURL(objectUrl)
            resolve('')
          },
          { once: true },
        )
        video.src = objectUrl
      })

    const resetDocumentation = () => {
      documentationFiles = []
      documentationInput.value = ''
      documentationPreview.innerHTML = ''
      documentationStatus.textContent = ''
    }

    const renderDocumentationPreview = () => {
      documentationPreview.innerHTML = documentationFiles
        .map(
          (item, index) => `
        <div class="col-sm-6 col-md-4" data-documentation-item="${index}">
          <div class="border rounded p-2">
            ${item.type === 'video' ? `<video class="w-100 rounded border" controls preload="metadata" src="${escapeHtml(item.previewUrl)}"></video>` : `<img class="w-100 rounded border" src="${escapeHtml(item.previewUrl)}" alt="${escapeHtml(item.file?.name || item.name || 'Dokumentasi breeding')}" loading="lazy" decoding="async" fetchpriority="low" />`}
            <input class="form-control mt-2" name="breeding_documentation_notes" data-documentation-notes placeholder="Catatan dokumentasi" autocomplete="off" value="${escapeHtml(item.notes || '')}" />
            <button class="btn btn-sm btn-outline-danger mt-2" type="button" data-remove-documentation="${index}">Hapus</button>
          </div>
        </div>
      `,
        )
        .join('')
    }

    const addDocumentationFiles = (files) => {
      const acceptedFiles = [...files].filter((file) => file.type.startsWith('image/') || ['video/mp4', 'video/webm'].includes(file.type))
      const tooLarge = acceptedFiles.find((file) => file.type.startsWith('video/') && file.size > 100 * 1024 * 1024)

      if (tooLarge) {
        documentationStatus.textContent = `Video ${tooLarge.name} melebihi 100 MB.`
        return
      }

      documentationFiles.push(
        ...acceptedFiles.map((file) => ({
          file,
          type: file.type.startsWith('video/') ? 'video' : 'image',
          previewUrl: URL.createObjectURL(file),
          url: '',
          thumbnail_url: '',
          name: file.name,
          notes: '',
        })),
      )
      renderDocumentationPreview()
      documentationStatus.textContent = documentationFiles.length ? `${documentationFiles.length} file siap disimpan di breeding.` : ''
    }

    const pasteDocumentationImages = async () => {
      try {
        const clipboardItems = await navigator.clipboard.read()
        const imageFiles = []

        for (const item of clipboardItems) {
          const imageType = item.types.find((type) => type.startsWith('image/'))
          if (!imageType) continue
          const blob = await item.getType(imageType)
          imageFiles.push(new File([blob], `paste-breeding-${Date.now()}-${imageFiles.length + 1}.${imageType.split('/')[1] || 'png'}`, { type: imageType }))
        }

        if (!imageFiles.length) {
          throw new Error('Clipboard tidak berisi gambar.')
        }

        addDocumentationFiles(imageFiles)
      } catch (error) {
        documentationStatus.textContent = error.message || 'Paste gambar gagal.'
      }
    }

    const uploadDocumentationMedia = async () => {
      documentationPreview.querySelectorAll('[data-documentation-item]').forEach((element) => {
        const index = Number(element.dataset.documentationItem)
        documentationFiles[index].notes = element.querySelector('[data-documentation-notes]').value.trim()
      })

      const mediaEntries = []
      for (const [index, item] of documentationFiles.entries()) {
        if (item.url) {
          mediaEntries.push({ type: item.type || 'image', url: item.url, thumbnail_url: item.thumbnail_url || item.url, name: item.name || '', notes: item.notes || '' })
          continue
        }

        documentationStatus.textContent = `Mengupload dokumentasi ${index + 1}/${documentationFiles.length}...`
        if (item.type === 'video') {
          const [videoData, thumbnailData] = await Promise.all([readFileAsDataUrl(item.file), createVideoThumbnail(item.file)])
          const response = await fetch(`${apiUrl}/videos`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ prefix: 'breeding-doc-video', video_data: videoData, thumbnail_data: thumbnailData }),
          })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error(data.error || data.detail || 'Video dokumentasi gagal diupload')
          mediaEntries.push({ type: 'video', url: data.video_url, thumbnail_url: data.video_thumbnail_url, name: item.name || item.file?.name || '', notes: item.notes || '' })
          continue
        }

        const response = await fetch(`${apiUrl}/images`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ prefix: 'breeding-doc-image', image_data: await compressImage(item.file) }),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.error || data.detail || 'Gambar dokumentasi gagal diupload')
        mediaEntries.push({ type: 'image', url: data.image_url, thumbnail_url: data.image_url, name: item.name || item.file?.name || '', notes: item.notes || '' })
      }

      documentationStatus.textContent = mediaEntries.length ? 'Dokumentasi siap disimpan.' : ''
      return mediaEntries
    }

    const previewMarkup = (item) =>
      item
        ? `
      <div class="breeding-parent-preview d-flex flex-column gap-1 align-items-center text-center" data-parent-preview>
        <button class="breeding-parent-photo breeding-parent-photo-button d-flex align-items-center justify-content-center" type="button" data-zoom-image="${escapeHtml(item.image_url || '')}">
          ${item.image_url ? `<img src="${escapeHtml(item.image_url)}" alt="${escapeHtml(koiLabel(item))}" loading="lazy" decoding="async" fetchpriority="low" />` : `<div class="breeding-parent-placeholder d-flex align-items-center justify-content-center">Belum ada foto</div>`}
        </button>
      </div>
    `
        : '<div class="breeding-parent-preview" data-parent-preview></div>'

    const koiSizeValue = (item) => item?.current_length_cm ?? item?.latest_length_cm ?? item?.length_cm ?? item?.size_cm ?? item?.size ?? ''
    const parentSizeValue = (entry, selectedItem) => entry.length_cm ?? koiSizeValue(selectedItem)

    const parentRowTemplate = (type, entry = {}) => {
      const selectedItem = entry.koi_id ? koiById.get(String(entry.koi_id)) : null

      return `
        <div class="row g-2 align-items-start" data-parent-entry="${type}">
          <div class="col-auto">
            ${previewMarkup(selectedItem)}
            <div class="breeding-parent-size mt-2">
              <label class="form-label">Size</label>
              <div class="input-group input-group-flat">
                <input class="form-control" name="breeding_parent_length" type="number" min="0" step="0.01" data-parent-length placeholder="0" value="${escapeHtml(parentSizeValue(entry, selectedItem))}" />
                <span class="input-group-text">cm</span>
              </div>
            </div>
          </div>
          <div class="col breeding-parent-search-wrap">
            <input class="form-control" name="breeding_parent_search" data-parent-search placeholder="Mention ID/nama/bloodline/breeder/variety" autocomplete="off" value="" />
            <input type="hidden" name="breeding_parent_koi" data-parent-koi value="${escapeHtml(entry.koi_id || '')}" />
            <div class="breeding-parent-suggestions d-none" data-parent-suggestions></div>
            <label class="form-label mt-2">Catatan indukan</label>
            <input class="form-control" name="breeding_parent_notes" data-parent-notes placeholder="Catatan ikan ini" autocomplete="off" value="${escapeHtml(entry.notes || '')}" />
          </div>
          <div class="col-auto">
            <button class="btn btn-outline-danger btn-icon" type="button" data-remove-parent aria-label="Hapus indukan" title="Hapus indukan">${trashIcon}</button>
          </div>
        </div>
      `
    }

    const addParentRow = (type, entry = {}) => {
      const list = type === 'male' ? maleParentList : femaleParentList
      list.insertAdjacentHTML('beforeend', parentRowTemplate(type, entry))
      const row = list.lastElementChild
      row.querySelector('[data-parent-preview]').outerHTML = previewMarkup(entry.koi_id ? koiById.get(String(entry.koi_id)) : null)
      row.querySelector('[data-remove-parent]').disabled = type === 'female'
      row.querySelector('[data-parent-search]').value = entry.koi_id ? koiLabel(koiById.get(String(entry.koi_id)) || entry) : ''
    }

    const matchingKoi = (type, query) => {
      const options = type === 'male' ? maleOptions : femaleOptions
      const loweredQuery = query.trim().toLowerCase()
      const selectedIds = new Set([...form.querySelectorAll(`[data-parent-entry="${type}"] [data-parent-koi]`)].map((input) => input.value).filter(Boolean))

      return (loweredQuery ? options.filter((item) => koiSearchText(item).includes(loweredQuery)) : options).filter((item) => !selectedIds.has(String(item.id))).slice(0, 8)
    }

    const suggestionMarkup = (items) =>
      items
        .map(
          (item) => `
      <button class="breeding-parent-suggestion p-2" type="button" data-parent-suggestion="${escapeHtml(item.id)}">
        <div class="d-flex gap-2 align-items-center">
          <div class="breeding-parent-photo d-flex align-items-center justify-content-center">
            ${item.image_url ? `<img src="${escapeHtml(item.image_url)}" alt="${escapeHtml(koiLabel(item))}" loading="lazy" decoding="async" fetchpriority="low" />` : `<div class="breeding-parent-placeholder d-flex align-items-center justify-content-center">No foto</div>`}
          </div>
          <div class="min-w-0">
            <div class="fw-medium text-truncate">${escapeHtml(koiLabel(item))}</div>
            <div class="text-secondary small text-truncate">${escapeHtml([item.variety, item.bloodline, item.breeder].filter(Boolean).join(' / ') || '-')}</div>
          </div>
        </div>
      </button>
    `,
        )
        .join('') || '<div class="p-2 text-secondary small">Data ikan tidak ditemukan.</div>'

    const showSuggestions = (row) => {
      const type = row.dataset.parentEntry
      const suggestions = row.querySelector('[data-parent-suggestions]')
      suggestions.innerHTML = suggestionMarkup(matchingKoi(type, row.querySelector('[data-parent-search]').value))
      suggestions.classList.remove('d-none')
    }

    const hideSuggestions = (row) => {
      row?.querySelector('[data-parent-suggestions]')?.classList.add('d-none')
    }

    const hasEmptyMaleRow = () => [...maleParentList.querySelectorAll('[data-parent-entry]')].some((row) => !row.querySelector('[data-parent-koi]').value)

    const selectParent = (row, item) => {
      const type = row.dataset.parentEntry
      const duplicate = [...form.querySelectorAll(`[data-parent-entry="${type}"]`)].some((entryRow) => entryRow !== row && String(entryRow.querySelector('[data-parent-koi]').value) === String(item.id))

      if (duplicate) {
        row.querySelector('[data-parent-search]').value = ''
        row.querySelector('[data-parent-koi]').value = ''
        row.querySelector('[data-parent-preview]').outerHTML = previewMarkup(null)
        hideSuggestions(row)
        return
      }

      row.querySelector('[data-parent-koi]').value = item.id
      row.querySelector('[data-parent-search]').value = koiLabel(item)
      row.querySelector('[data-parent-length]').value = koiSizeValue(item)
      row.querySelector('[data-parent-preview]').outerHTML = previewMarkup(item)
      hideSuggestions(row)

      if (type === 'male' && !hasEmptyMaleRow()) {
        addParentRow('male')
        maleParentList.lastElementChild.querySelector('[data-parent-search]').focus()
      }
    }

    const pondLabel = (pond) => pond?.name || `Kolam ${pond?.id || ''}`
    const pondSearchText = (pond) => [pond.name, pond.location].filter(Boolean).join(' ').toLowerCase()
    const pondMatchRank = (pond, query) => {
      const name = String(pond?.name || '').toLowerCase()
      const location = String(pond?.location || '').toLowerCase()

      if (name === query) return 0
      if (name.startsWith(query)) return 1
      if (name.includes(query)) return 2
      if (location === query) return 3
      if (location.startsWith(query)) return 4
      return 5
    }
    const matchingPonds = (query) => {
      const loweredQuery = query.trim().toLowerCase()
      const selectedIds = new Set([...pondList.querySelectorAll('[data-pond-value]')].map((input) => input.value).filter(Boolean))
      const matches = loweredQuery
        ? pondOptions
            .filter((pond) => pondSearchText(pond).includes(loweredQuery))
            .sort((first, second) => pondMatchRank(first, loweredQuery) - pondMatchRank(second, loweredQuery) || pondLabel(first).localeCompare(pondLabel(second)))
        : pondOptions

      return matches.filter((pond) => !selectedIds.has(String(pond.id))).slice(0, 8)
    }

    const pondSuggestionsMarkup = (ponds) =>
      ponds
        .map(
          (pond) => `
      <button class="breeding-parent-suggestion p-2" type="button" data-pond-suggestion="${escapeHtml(pond.id)}">
        <div class="fw-medium">${escapeHtml(pondLabel(pond))}</div>
        <div class="text-secondary small">${escapeHtml([pond.location, pond.status].filter(Boolean).join(' / ') || '-')}</div>
      </button>
    `,
        )
        .join('') || '<div class="p-2 text-secondary small">Data kolam tidak ditemukan.</div>'

    const pondRowTemplate = (entry = {}) => `
      <div class="row g-2 align-items-start" data-pond-entry>
        <div class="col-md-6 breeding-mention-wrap">
          <input class="form-control" name="breeding_pond_search" data-pond-search placeholder="Mention nama kolam/area" autocomplete="off" value="${escapeHtml(entry.label || '')}" />
          <input type="hidden" name="breeding_pond_id" data-pond-value value="${escapeHtml(entry.pond_id || '')}" />
          <div class="breeding-parent-suggestions d-none" data-pond-suggestions></div>
        </div>
        <div class="col-md-5">
          <input class="form-control" name="breeding_pond_notes" data-pond-notes placeholder="Catatan kolam ini" autocomplete="off" value="${escapeHtml(entry.notes || '')}" />
        </div>
        <div class="col-md-1">
          <button class="btn btn-outline-danger btn-icon" type="button" data-remove-pond aria-label="Hapus kolam" title="Hapus kolam">${trashIcon}</button>
        </div>
      </div>
    `

    const addPondRow = (entry = {}) => {
      pondList.insertAdjacentHTML('beforeend', pondRowTemplate(entry))
    }

    const resetPondRows = () => {
      pondList.innerHTML = ''
      addPondRow()
    }

    const showPondSuggestions = (row) => {
      const suggestions = row.querySelector('[data-pond-suggestions]')
      suggestions.innerHTML = pondSuggestionsMarkup(matchingPonds(row.querySelector('[data-pond-search]').value))
      suggestions.classList.remove('d-none')
    }

    const hidePondSuggestions = (row) => {
      row?.querySelector('[data-pond-suggestions]')?.classList.add('d-none')
    }

    const hasEmptyPondRow = () => [...pondList.querySelectorAll('[data-pond-entry]')].some((row) => !row.querySelector('[data-pond-value]').value)

    const selectPond = (row, pond) => {
      row.querySelector('[data-pond-value]').value = pond.id
      row.querySelector('[data-pond-search]').value = pondLabel(pond)
      hidePondSuggestions(row)

      if (!hasEmptyPondRow()) {
        addPondRow()
      }
    }

    const resetParentRows = () => {
      maleParentList.innerHTML = ''
      femaleParentList.innerHTML = ''
      addParentRow('male')
      addParentRow('female')
    }

    const readParentEntries = (type) => {
      const list = type === 'male' ? maleParentList : femaleParentList

      return [...list.querySelectorAll('[data-parent-entry]')]
        .map((row) => {
          const koiId = row.querySelector('[data-parent-koi]').value
          const item = koiById.get(String(koiId))

          return {
            koi_id: koiId,
            label: item ? koiLabel(item) : row.querySelector('[data-parent-search]').value.trim(),
            length_cm: row.querySelector('[data-parent-length]').value,
            notes: row.querySelector('[data-parent-notes]').value.trim(),
          }
        })
        .filter((entry) => entry.koi_id)
    }

    const readPondEntries = () =>
      [...pondList.querySelectorAll('[data-pond-entry]')]
        .map((row) => {
          const pondId = row.querySelector('[data-pond-value]').value
          const pond = pondById.get(String(pondId))

          return {
            pond_id: pondId,
            label: pond ? pondLabel(pond) : row.querySelector('[data-pond-search]').value.trim(),
            notes: row.querySelector('[data-pond-notes]').value.trim(),
          }
        })
        .filter((entry) => entry.pond_id)

    const loadOptions = async () => {
      const [koiResponse, pondsResponse] = await Promise.all([fetch(`${apiUrl}/koi`), fetch(`${apiUrl}/ponds`)])
      const koi = koiResponse.ok ? await koiResponse.json() : []
      const ponds = pondsResponse.ok ? await pondsResponse.json() : []
      const males = koi.filter((item) => item.gender === 'male')
      const females = koi.filter((item) => item.gender === 'female')

      koiById = new Map(koi.map((item) => [String(item.id), item]))
      pondById = new Map(ponds.map((pond) => [String(pond.id), pond]))
      maleOptions = males
      femaleOptions = females
      pondOptions = ponds
      resetParentRows()
      resetPondRows()
    }

    const loadBreeding = async (silent = false) => {
      if (!silent) {
        table.innerHTML = '<tr><td colspan="10" class="text-secondary">Memuat data breeding.</td></tr>'
      }

      try {
        const response = await fetch(`${apiUrl}/breeding`)

        if (!response.ok) {
          throw new Error('Data breeding gagal dimuat')
        }

        const items = await response.json()
        const signature = JSON.stringify(items)
        if (silent && signature === breedingRealtimeSignature) {
          return
        }
        breedingRealtimeSignature = signature
        localStorage.setItem(breedingCacheKey, signature)
        breedingItems = items
        renderTable()
      } catch (error) {
        if (!silent) {
          table.innerHTML = '<tr><td colspan="10" class="text-danger">Data breeding gagal dimuat. Pastikan API berjalan.</td></tr>'
        }
      }
    }

    const restoreBreedingCache = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(breedingCacheKey) || '[]')
        if (!Array.isArray(cached) || cached.length === 0) return false
        breedingRealtimeSignature = JSON.stringify(cached)
        breedingItems = cached
        renderTable()
        return true
      } catch {
        localStorage.removeItem(breedingCacheKey)
        return false
      }
    }

    const setFormValue = (name, value) => {
      const field = form.querySelector(`[name="${name}"]`)

      if (field) {
        field.value = value || ''
      }
    }

    const setExclusiveValue = (name, value) => {
      const group = form.querySelector(`[data-exclusive-group="${name}"]`)

      group?.querySelectorAll('[data-exclusive-option]').forEach((input) => {
        input.checked = input.value === value
      })
    }

    const printImageUrl = (value) => {
      const rawValue = String(value || '').trim()

      if (!rawValue || rawValue.startsWith('data:') || rawValue.startsWith('blob:')) {
        return rawValue
      }

      const apiResolved = window.KoiAuth?.apiUrl ? window.KoiAuth.apiUrl(rawValue) : rawValue

      try {
        return new URL(apiResolved, window.location.origin).href
      } catch {
        return apiResolved
      }
    }
    const printParentCards = (entries, type, item) =>
      entries.length
        ? entries
            .map((entry) => {
              const koi = entry?.koi_id ? koiById.get(String(entry.koi_id)) : null
              const imageUrl = type === 'female' ? item.female_koi_image_url || koi?.image_url : koi?.image_url
              const code = type === 'female' ? item.female_koi_code || koi?.code || entry.label : koi?.code || entry.label
              const name = type === 'female' ? item.female_koi_name || koi?.name : koi?.name
              const variety = type === 'female' ? item.female_koi_variety || koi?.variety : koi?.variety
              const bloodline = type === 'female' ? item.female_koi_bloodline || koi?.bloodline : koi?.bloodline
              const badge = type === 'female' ? 'Betina' : 'Jantan'
              const badgeClass = type === 'female' ? 'badge-female' : 'badge-male'

              return `
                <article class="fish-card">
                  <div class="fish-photo">
                    ${imageUrl ? `<img src="${escapeHtml(printImageUrl(imageUrl))}" alt="${escapeHtml(text(code))}" />` : '<span>No foto</span>'}
                  </div>
                  <div class="fish-meta">
                    <span class="fish-badge ${badgeClass}">${badge}</span>
                    <h3>${escapeHtml(text(code))}</h3>
                    <p>${escapeHtml(text(name))}</p>
                    <div class="fish-detail">${escapeHtml([variety, bloodline].filter(Boolean).join(' / ') || '-')}</div>
                    <div class="fish-size">${entry.length_cm ? `${escapeHtml(entry.length_cm)} cm` : 'Size -'}</div>
                    ${entry.notes ? `<div class="fish-notes">${escapeHtml(entry.notes)}</div>` : ''}
                  </div>
                </article>
              `
            })
            .join('')
        : '<div class="empty-state">Belum ada data.</div>'

    const printPondCards = (entries) =>
      entries.length
        ? entries
            .map(
              (entry) => `
                <article class="pond-card">
                  <strong>${escapeHtml(text(entry.label))}</strong>
                  ${entry.notes ? `<p>${escapeHtml(entry.notes)}</p>` : '<p>-</p>'}
                </article>
              `,
            )
            .join('')
        : '<div class="empty-state">Belum ada data.</div>'

    const waitForPrintImages = (printWindow, timeout = 8000) => {
      const images = Array.from(printWindow.document.images || [])

      if (!images.length) return Promise.resolve()

      return Promise.race([
        Promise.all(images.map((image) => {
          if (image.complete && image.naturalWidth > 0) return Promise.resolve()

          return new Promise((resolve) => {
            let settled = false
            const done = () => {
              if (settled) return
              settled = true
              resolve()
            }

            image.onload = done
            image.onerror = done

            if (typeof image.decode === 'function') {
              image.decode().then(done).catch(() => {})
            }
          })
        })),
        new Promise((resolve) => setTimeout(resolve, timeout)),
      ])
    }

    const openBreedingPrintDocument = (title, bodyHtml) => {
      const printWindow = window.open('', '_blank')

      if (!printWindow) {
        alert('Jendela cetak gagal dibuka. Izinkan pop-up untuk mencetak.')
        return
      }

      const safeTitle = escapeHtml(title || 'Laporan Breeding')
      printWindow.document.open()
      printWindow.document.write(`<!doctype html>
        <html>
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <base href="${escapeHtml(window.location.origin)}/">
            <title>${safeTitle}</title>
          </head>
          <body>${bodyHtml}</body>
        </html>`)
      printWindow.document.close()
      printWindow.focus()
      waitForPrintImages(printWindow).then(() => {
        setTimeout(() => printWindow.print(), 180)
      })
    }

    const printBreeding = (id) => {
      const item = breedingItems.find((entry) => String(entry.id) === String(id))

      if (!item) {
        return
      }

      const maleName = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
      const femaleName = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
      const maleEntries = parseEntries(item.male_parent_entries, item.male_koi_id, maleName)
      const femaleEntries = parseEntries(item.female_parent_entries, item.female_koi_id, femaleName)
      const pondEntries = parsePondEntries(item.pond_entries, item.pond_id, item.pond_name)
      const status = labels[item.status] || labels.planning

      openBreedingPrintDocument(
        `Breeding ${text(item.batch_code)}`,
        `
          <style>
            .breeding-print-sheet, .breeding-print-sheet * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .breeding-print-sheet { width: 100%; background: #ffffff; color: #172033; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 1.35; }
            .breeding-print-page { width: 100%; margin: 0 auto; padding: 18px; background: #ffffff; }
            .header { display: flex; justify-content: space-between; gap: 16px; padding: 14px 16px; border: 1px solid #d6deea; border-radius: 10px; background: #f8fafc; }
            .brand { display: flex; align-items: center; gap: 12px; }
            .brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 8px; color: #206bc4; background: #edf5ff; font-weight: 800; }
            h1 { margin: 0; color: #111827; font-size: 20px; letter-spacing: .02em; }
            .subtitle, .muted { color: #64748b; font-size: 12px; }
            .print-date { text-align: right; font-size: 11px; color: #64748b; }
            .summary-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin: 14px 0; }
            .summary-item { border: 1px solid #d6deea; border-radius: 8px; padding: 9px 10px; background: #f8fafc; }
            .summary-item span { display: block; margin-bottom: 4px; color: #64748b; font-size: 9px; font-weight: 800; text-transform: uppercase; }
            .summary-item strong { color: #111827; font-size: 12px; }
            .section-title { margin: 18px 0 10px; padding: 8px 10px; color: #1f4f82; background: #eef5ff; border-left: 4px solid #206bc4; border-radius: 6px; font-size: 12px; font-weight: 800; text-transform: uppercase; }
            .fish-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(138px, 1fr)); gap: 10px; }
            .fish-card { border: 1px solid #d6deea; border-radius: 10px; padding: 10px; background: #ffffff; break-inside: avoid; }
            .fish-photo { width: 92px; aspect-ratio: 2 / 3; margin: 0 auto 8px; display: grid; place-items: center; overflow: hidden; border: 1px solid #d6deea; border-radius: 8px; background: #f1f5f9; color: #64748b; font-size: 10px; }
            .fish-photo img { width: 100%; height: 100%; object-fit: contain; display: block; }
            .fish-badge { display: block; margin-bottom: 6px; padding: 3px 6px; border-radius: 999px; text-align: center; font-size: 9px; font-weight: 800; text-transform: uppercase; }
            .badge-female { color: #9f1239; background: #ffe4ed; }
            .badge-male { color: #1d4ed8; background: #dbeafe; }
            .fish-card h3 { margin: 0; color: #111827; text-align: center; font-size: 13px; }
            .fish-card p { margin: 3px 0; color: #334155; text-align: center; font-size: 11px; font-weight: 700; }
            .fish-detail, .fish-size, .fish-notes { margin-top: 5px; color: #475569; text-align: center; font-size: 10px; }
            .fish-size { color: #111827; font-weight: 700; }
            .pond-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
            .pond-card, .notes-box { border: 1px solid #d6deea; border-radius: 10px; padding: 10px; background: #ffffff; }
            .pond-card p, .notes-box p { margin: 6px 0 0; color: #475569; font-size: 11px; }
            .empty-state { padding: 12px; border: 1px dashed #d6deea; border-radius: 10px; color: #64748b; font-size: 12px; }
            .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; margin-top: 34px; text-align: center; color: #475569; font-size: 11px; }
            .sign-line { margin-top: 44px; border-top: 1px solid #172033; }
            .footer { margin-top: 24px; padding-top: 10px; border-top: 1px solid #d6deea; text-align: right; color: #64748b; font-size: 10px; }
            @media print { @page { size: auto; margin: 10mm; } .breeding-print-page { padding: 0; } .header, .summary-item, .fish-card, .pond-card, .notes-box { box-shadow: none; } }
          </style>
          <main class="breeding-print-sheet">
            <section class="breeding-print-page">
              <header class="header">
                <div class="brand">
                  <div class="brand-mark">KOI</div>
                  <div>
                    <h1>Laporan Breeding</h1>
                    <div class="subtitle">${escapeHtml(text(item.session_name))}</div>
                  </div>
                </div>
                <div class="print-date">
                  <strong>${escapeHtml(text(item.batch_code))}</strong><br />
                  ${escapeHtml(formatDate(item.breeding_date))}
                </div>
              </header>

              <section class="summary-grid">
                <div class="summary-item"><span>Kode Batch</span><strong>${escapeHtml(text(item.batch_code))}</strong></div>
                <div class="summary-item"><span>Tanggal</span><strong>${escapeHtml(formatDate(item.breeding_date))}</strong></div>
                <div class="summary-item"><span>Metode</span><strong>${escapeHtml(methodLabels[item.spawning_method] || text(item.spawning_method))}</strong></div>
                <div class="summary-item"><span>Status</span><strong>${escapeHtml(status.label)}</strong></div>
                <div class="summary-item"><span>Burayak</span><strong>${Number(item.fry_count || 0)}</strong></div>
              </section>

              <div class="section-title">Indukan Betina</div>
              <section class="fish-grid">${printParentCards(femaleEntries, 'female', item)}</section>

              <div class="section-title">Indukan Jantan</div>
              <section class="fish-grid">${printParentCards(maleEntries, 'male', item)}</section>

              <div class="section-title">Kolam</div>
              <section class="pond-grid">${printPondCards(pondEntries)}</section>

              <div class="section-title">Catatan Sesi Breeding</div>
              <section class="notes-box">
                <p>${escapeHtml(text(item.notes))}</p>
                <p><strong>Berat Telur:</strong> ${item.egg_weight_g ? `${escapeHtml(item.egg_weight_g)} g` : '-'}</p>
              </section>

              <section class="signatures">
                <div>Petugas Lapangan<div class="sign-line"></div></div>
                <div>Pimpinan Farm<div class="sign-line"></div></div>
              </section>
              <div class="footer">Tanggal Cetak: ${escapeHtml(new Date().toLocaleString('id-ID'))}</div>
            </section>
          </main>
        `,
      )
    }
    const initBreedingDatepicker = () => {
      if (!window.Litepicker || form.elements.breeding_date.dataset.breedingDatepickerReady) {
        return false
      }

      new window.Litepicker({
        element: form.elements.breeding_date,
        format: 'YYYY-MM-DD',
        singleMode: true,
        autoApply: true,
        dropdowns: {
          minYear: 1990,
          maxYear: new Date().getFullYear() + 5,
          months: true,
          years: true,
        },
      })
      form.elements.breeding_date.dataset.breedingDatepickerReady = 'true'
      return true
    }

    const openCreateForm = () => {
      form.reset()
      setFormValue('id', '')
      setFormValue('breeding_date', new Date().toISOString().slice(0, 10))
      setExclusiveValue('spawning_method', 'alami')
      setExclusiveValue('status', 'planning')
      resetParentRows()
      resetPondRows()
      resetDocumentation()
      errorBox.classList.add('d-none')
      modalTitle.textContent = 'Formulir Tambah Breeding'
      openModal()
    }

    const openEditForm = (id) => {
      const item = breedingItems.find((entry) => String(entry.id) === String(id))

      if (!item) {
        return
      }

      form.reset()
      errorBox.classList.add('d-none')
      modalTitle.textContent = 'Formulir Edit Breeding'
      setFormValue('id', item.id)
      setFormValue('batch_code', item.batch_code)
      setFormValue('session_name', item.session_name)
      setFormValue('breeding_date', item.breeding_date ? String(item.breeding_date).slice(0, 10) : '')
      setFormValue('status', item.status || 'planning')
      setExclusiveValue('status', item.status || 'planning')
      setExclusiveValue('spawning_method', item.spawning_method || 'alami')
      setFormValue('fry_count', item.fry_count)
      setFormValue('egg_weight_g', item.egg_weight_g)
      setFormValue('notes', item.notes)
      resetDocumentation()
      documentationFiles = parseJson(item.media_entries).map((media) => ({
        file: null,
        type: media.type || media.media_type || 'image',
        previewUrl: media.thumbnail_url || media.url || media.image_url || '',
        url: media.url || media.image_url || '',
        thumbnail_url: media.thumbnail_url || media.url || media.image_url || '',
        name: media.name || '',
        notes: media.notes || '',
      }))
      renderDocumentationPreview()
      documentationStatus.textContent = documentationFiles.length ? `${documentationFiles.length} dokumentasi tersimpan di breeding.` : ''
      maleParentList.innerHTML = ''
      femaleParentList.innerHTML = ''
      const maleName = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
      const femaleName = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
      const maleEntries = parseEntries(item.male_parent_entries, item.male_koi_id, maleName)
      const femaleEntries = parseEntries(item.female_parent_entries, item.female_koi_id, femaleName)
      ;(maleEntries.length ? maleEntries : [{}]).forEach((entry) => addParentRow('male', entry))
      ;(femaleEntries.length ? femaleEntries.slice(0, 1) : [{}]).forEach((entry) => addParentRow('female', entry))
      pondList.innerHTML = ''
      const pondEntries = parsePondEntries(item.pond_entries, item.pond_id, item.pond_name)
      ;(pondEntries.length ? pondEntries : [{}]).forEach((entry) => addPondRow(entry))
      openModal()
    }

    const readPayload = () => ({
      ...Object.fromEntries(new FormData(form).entries()),
      male_parent_entries: readParentEntries('male'),
      female_parent_entries: readParentEntries('female').slice(0, 1),
      pond_id: readPondEntries()[0]?.pond_id || '',
      pond_entries: readPondEntries(),
    })

    addButton.addEventListener('click', openCreateForm)
    breedingSearchInput?.addEventListener('input', renderTable)
    addPondButton.addEventListener('click', () => addPondRow())
    documentationInput.addEventListener('change', () => addDocumentationFiles(documentationInput.files))
    documentationPasteButton.addEventListener('click', pasteDocumentationImages)
    form.addEventListener('click', (event) => {
      const addParentButton = event.target.closest('[data-add-parent]')
      const removeParentButton = event.target.closest('[data-remove-parent]')
      const removePondButton = event.target.closest('[data-remove-pond]')
      const removeDocumentationButton = event.target.closest('[data-remove-documentation]')

      if (addParentButton) {
        addParentRow(addParentButton.dataset.addParent)
      }

      if (removeParentButton) {
        const row = removeParentButton.closest('[data-parent-entry]')
        const list = row.parentElement

        row.remove()

        if (!list.querySelector('[data-parent-entry]')) {
          addParentRow(list.dataset.parentList)
        }
      }

      if (removePondButton) {
        const row = removePondButton.closest('[data-pond-entry]')
        row.remove()

        if (!pondList.querySelector('[data-pond-entry]')) {
          addPondRow()
        }
      }

      if (removeDocumentationButton) {
        const index = Number(removeDocumentationButton.dataset.removeDocumentation)
        const [removed] = documentationFiles.splice(index, 1)
        if (removed?.previewUrl) URL.revokeObjectURL(removed.previewUrl)
        renderDocumentationPreview()
        documentationStatus.textContent = documentationFiles.length ? `${documentationFiles.length} file siap disimpan di breeding.` : ''
      }
    })
    form.addEventListener('input', (event) => {
      if (!event.target.matches('[data-parent-search]')) {
        if (event.target.matches('[data-pond-search]')) {
          const row = event.target.closest('[data-pond-entry]')
          row.querySelector('[data-pond-value]').value = ''
          showPondSuggestions(row)
        }
        return
      }

      const row = event.target.closest('[data-parent-entry]')
      row.querySelector('[data-parent-koi]').value = ''
      row.querySelector('[data-parent-preview]').outerHTML = previewMarkup(null)
      showSuggestions(row)
    })
    form.addEventListener('focusin', (event) => {
      if (event.target.matches('[data-parent-search]')) {
        showSuggestions(event.target.closest('[data-parent-entry]'))
      }
      if (event.target.matches('[data-pond-search]')) {
        showPondSuggestions(event.target.closest('[data-pond-entry]'))
      }
    })
    form.addEventListener('change', (event) => {
      if (event.target.matches('[data-exclusive-option]')) {
        const group = event.target.closest('[data-exclusive-group]')

        if (event.target.checked) {
          group.querySelectorAll('[data-exclusive-option]').forEach((input) => {
            input.checked = input === event.target
          })
        } else if (![...group.querySelectorAll('[data-exclusive-option]')].some((input) => input.checked)) {
          event.target.checked = true
        }
      }
    })
    table.addEventListener('click', async (event) => {
      const printButton = event.target.closest('[data-print-breeding]')
      const editButton = event.target.closest('[data-edit-breeding]')
      const deleteButton = event.target.closest('[data-delete-breeding]')

      if (printButton) {
        printBreeding(printButton.dataset.printBreeding)
        return
      }

      if (editButton) {
        openEditForm(editButton.dataset.editBreeding)
        return
      }

      if (deleteButton) {
        const item = breedingItems.find((entry) => String(entry.id) === String(deleteButton.dataset.deleteBreeding))

        if (!window.confirm(`Hapus ${text(item?.batch_code)}?`)) {
          return
        }

        deleteButton.disabled = true

        try {
          const response = await fetch(`${apiUrl}/breeding/${deleteButton.dataset.deleteBreeding}`, { method: 'DELETE' })

          if (!response.ok) {
            const result = await response.json().catch(() => ({}))
            throw new Error(result.error || 'Breeding gagal dihapus')
          }

          await keepScroll(loadBreeding)
        } catch (error) {
          alert(error.message)
          deleteButton.disabled = false
        }
      }
    })

    document.addEventListener('click', (event) => {
      const dismiss = event.target.closest('[data-bs-dismiss="modal"]')
      const suggestion = event.target.closest('[data-parent-suggestion]')
      const pondSuggestion = event.target.closest('[data-pond-suggestion]')
      const zoomButton = event.target.closest('[data-zoom-image]')
      const closeZoomButton = event.target.closest('[data-close-breeding-zoom]')

      if (zoomButton) {
        const imageUrl = zoomButton.dataset.zoomImage

        if (imageUrl) {
          zoomImage.src = imageUrl
          zoom.classList.remove('d-none')
        }

        return
      }

      if (closeZoomButton || event.target === zoom) {
        zoom.classList.add('d-none')
        zoomImage.removeAttribute('src')
        return
      }

      if (suggestion) {
        const row = suggestion.closest('[data-parent-entry]')
        const item = koiById.get(String(suggestion.dataset.parentSuggestion))

        if (item) {
          selectParent(row, item)
        }

        return
      }

      if (pondSuggestion) {
        const row = pondSuggestion.closest('[data-pond-entry]')
        const pond = pondById.get(String(pondSuggestion.dataset.pondSuggestion))

        if (pond) {
          selectPond(row, pond)
        }

        return
      }

      if (dismiss && dismiss.closest('#breeding-modal')) {
        closeModal()
      }

      if (!event.target.closest('[data-parent-entry]')) {
        form.querySelectorAll('[data-parent-entry]').forEach(hideSuggestions)
      }
      if (!event.target.closest('[data-pond-entry]')) {
        form.querySelectorAll('[data-pond-entry]').forEach(hidePondSuggestions)
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !zoom.classList.contains('d-none')) {
        zoom.classList.add('d-none')
        zoomImage.removeAttribute('src')
      }
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      errorBox.classList.add('d-none')
      submitButton.disabled = true
      submitButton.innerHTML = saveIcon

      try {
        const payload = readPayload()
        const id = payload.id
        delete payload.id
        payload.media_entries = await uploadDocumentationMedia()
        const response = await fetch(id ? `${apiUrl}/breeding/${id}` : `${apiUrl}/breeding`, {
          method: id ? 'PATCH' : 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const result = await response.json().catch(() => ({}))

        if (!response.ok) {
          throw new Error(result.error || 'Breeding gagal disimpan')
        }

        closeModal()
        await keepScroll(loadBreeding)
      } catch (error) {
        errorBox.textContent = error.message
        errorBox.classList.remove('d-none')
      } finally {
        submitButton.disabled = false
        submitButton.innerHTML = saveIcon
      }
    })

    const hasCachedBreeding = restoreBreedingCache()
    loadBreeding(hasCachedBreeding)
    loadOptions()
    window.KoiAuth?.registerRealtimeRefresh(() => keepScroll(() => loadBreeding(true)), { intervalMs: 30000 })
    if (!initBreedingDatepicker()) {
      window.addEventListener('load', initBreedingDatepicker, { once: true })
    }
  </script>
</DefaultLayout>

