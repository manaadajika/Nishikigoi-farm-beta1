---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
---

<DefaultLayout title="Koi Farm" pageHeader="Dashboard Koi Farm" pretitle="Manajemen" pageMenu="farm-dashboard">
  <div class="row row-deck row-cards">
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Kolam</div>
          <div class="h1 mb-0" data-summary="ponds">0</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Total Koi</div>
          <div class="h1 mb-0" data-summary="koi">0</div>
          <div class="small text-secondary mt-1" data-summary-note="koi"></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Karantina</div>
          <div class="h1 mb-0" data-summary="quarantine">0</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Ikan di Arsip</div>
          <div class="h1 mb-0" data-summary="archived">0</div>
          <div class="small text-secondary mt-1" data-summary-note="archived"></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Indukan aktif</div>
          <div class="h1 mb-0 text-success" data-summary="breeders_active">0</div>
          <div class="small text-secondary mt-1" data-summary-gender="breeders_active">&nbsp;</div>
          <div class="small text-secondary" data-summary-note="breeders_active"></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Ikan terjual</div>
          <div class="h1 mb-0 " data-summary="sold">0</div>
          <div class="small text-secondary mt-1" data-summary-gender="sold">&nbsp;</div>
          <div class="small text-secondary" data-summary-note="sold"></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Indukan mati</div>
          <div class="h1 mb-0 text-danger" data-summary="breeders_dead">0</div>
          <div class="small text-secondary mt-1" data-summary-gender="breeders_dead">&nbsp;</div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card">
        <div class="card-body">
          <div class="subheader">Ikan reguler mati</div>
          <div class="h1 mb-0 text-danger" data-summary="regular_dead">0</div>
          <div class="small text-secondary mt-1" data-summary-gender="regular_dead">&nbsp;</div>
          <div class="small text-secondary" data-summary-note="regular_dead"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="border-top my-4" data-dashboard-divider></div>
  <div class="row row-deck row-cards" data-dashboard-extra></div>

  <script>
    const apiUrl = '/api'
    const keys = ['ponds', 'koi', 'quarantine', 'archived', 'breeders_active', 'breeders_dead', 'sold', 'regular_dead']

    const renderSummary = async () => {
      try {
        const summary = await (await fetch(`${apiUrl}/summary`)).json()
        
        // Per card: how many are male / female (Unknown = no gender filled in); a part with no count is not written, and a card with none has no line
        ;['breeders_active', 'breeders_dead', 'sold', 'regular_dead'].forEach((prefix) => {
          const line = document.querySelector(`[data-summary-gender="${prefix}"]`)
          if (!line) return
          const parts = [['Male', 'male'], ['Female', 'female'], ['Unknown', 'unknown']]
            .map(([label, key]) => [label, Number(summary[`${prefix}_${key}`] ?? 0)])
            .filter(([, count]) => count > 0)
            .map(([label, count]) => `${label} ${count.toLocaleString('id-ID')}`)
          line.textContent = parts.join(' · ')
        })
const deadNote = document.querySelector('[data-summary-note="regular_dead"]')
if (deadNote) deadNote.textContent = Number(summary.regular_dead_month) > 0 ? `+${Number(summary.regular_dead_month).toLocaleString('id-ID')}, mati bulan ini` : ''
const soldNote = document.querySelector('[data-summary-note="sold"]')
if (soldNote) soldNote.textContent = Number(summary.sold_month) > 0 ? `+${Number(summary.sold_month).toLocaleString('id-ID')}, terjual bulan ini` : ''
keys.forEach((key) => {
          const element = document.querySelector(`[data-summary="${key}"]`)
          if (element) element.textContent = Number(summary[key] ?? 0).toLocaleString('id-ID')
        })
      } catch (error) {
        keys.forEach((key) => {
          const element = document.querySelector(`[data-summary="${key}"]`)
          if (element) element.textContent = '-'
        })
      }
    }


    // ---- Extra cards below the divider (data from /summary-extra). The rule is the same everywhere: a part with no count is not
    // written, and a card with nothing to say is not drawn (only "Backup terakhir" is always there).
    const escapeText = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]))
    const numberText = (value) => Number(value || 0).toLocaleString('id-ID')
    const moneyText = (value) => 'Rp ' + Math.round(Number(value || 0)).toLocaleString('id-ID')
    const dateText = (value, withTime = false) => {
      if (!value) return ''
      const formatter = withTime ? window.KoiAuth?.formatDateTime : window.KoiAuth?.formatDate
      return formatter ? formatter(value) : String(value).slice(0, 10)
    }
    const extraCard = (title, body, size = 'col-sm-6 col-lg-3', more = '') =>
      `<div class="${size}"><div class="card h-100"><div class="card-body d-flex flex-column"><div class="subheader">${title}</div>${body}${more ? `<div class="mt-auto pt-3"><button type="button" class="btn btn-sm" data-more="${more}">Lihat selengkapnya</button></div>` : ''}</div></div></div>`
    const bigNumber = (value, color = '') => `<div class="h1 mb-0 ${color}">${numberText(value)}</div>`
    const smallLine = (text) => (text ? `<div class="small text-secondary mt-1">${text}</div>` : '')
    const barRows = (rows) => {
      const max = Math.max(...rows.map((row) => row.count), 1)
      return rows.map((row) => `
        <div class="mb-2">
          <div class="d-flex justify-content-between small"><span class="text-truncate me-2">${escapeText(row.label)}</span><strong>${numberText(row.count)}</strong></div>
          <div class="progress progress-sm"><div class="progress-bar" style="width:${Math.max(3, Math.round(100 * row.count / max))}%"></div></div>
        </div>`).join('')
    }
    const extraGender = (counts) => [['Male', counts.male], ['Female', counts.female], ['Unknown', counts.unknown]]
      .filter(([, count]) => Number(count) > 0).map(([label, count]) => `${label} ${numberText(count)}`).join(' · ')

    const zoomFeedRow = (row) => {
      if (!window.KoiAuth) return
      if (row.koi && window.KoiAuth.zoomKoi) window.KoiAuth.zoomKoi(row.image, row.koi)
      else if (row.image && window.KoiAuth.zoomPhoto) window.KoiAuth.zoomPhoto(row.image, row.title, [row.label])
    }
    const photoSets = {}
    const photoGridMarkup = (set, photos) => {
      if (!photos?.length) return ''
      photoSets[set] = photos
      const small = (url) => { const m = /^\/api\/uploads\/(.+)$/.exec(String(url || '')); return m ? `/api/thumb/240/${m[1]}` : url }
      return `<div class="mt-3" style="display:grid;grid-template-columns:repeat(3,minmax(0,110px));gap:.5rem">${photos.map((photo, at) => `<button type="button" class="p-0 border-0 bg-transparent" data-photo-zoom="${set}:${at}" title="${escapeText(photo.title)}" style="cursor:zoom-in"><img src="${escapeText(small(photo.image))}" alt="" loading="lazy" style="width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:6px;display:block" /></button>`).join('')}</div>`
    }
    const renderExtra = async () => {
      const box = document.querySelector('[data-dashboard-extra]')
      if (!box) return
      let extra
      try {
        const response = await fetch(`${apiUrl}/summary-extra`)
        if (!response.ok) return
        extra = await response.json()
      } catch (error) {
        return
      }
      // small notes on the cards above
      const note = (key, text) => { const element = document.querySelector(`[data-summary-note="${key}"]`); if (element) { element.style.whiteSpace = 'pre-line'; element.textContent = text } }
      note('koi', (extra.regular_total > 0 ? `Ikan reguler ${numberText(extra.regular_total)}${extra.added_30d > 0 ? ` (+${numberText(extra.added_30d)}, bulan ini)` : ''}` : (extra.added_30d > 0 ? `+${numberText(extra.added_30d)}, bulan ini` : '')))
      note('breeders_active', extra.new_breeders_month > 0 ? `Indukan baru +${numberText(extra.new_breeders_month)}, bulan ini` : '')
      note('archived', extra.archived_30d > 0 ? `+${numberText(extra.archived_30d)}, diarsipkan bulan ini` : '')

      const cards = []
      // the cards that ask for attention (to complete, no progress, empty ponds, last backup) go to the very bottom
      const bottom = []
      const inc = extra.incomplete || {}
      const incLines = [['Tanpa foto', inc.no_photo], ['Tanpa lokasi dan area', inc.no_place], ['Tanpa size', inc.no_size], ['Sex Unknown', inc.no_gender], ['Indukan tanpa peternakan', inc.no_farm_breeder]]
        .filter(([, count]) => Number(count) > 0)
        .map(([label, count]) => `<div class="d-flex justify-content-between small mt-1"><span>${label}</span><strong>${numberText(count)}</strong></div>`)
      if (incLines.length) bottom.push(extraCard('Perlu dilengkapi', `<div class="mt-2">${incLines.join('')}</div>`))
      if (extra.no_progress_30d > 0) bottom.push(extraCard('Tanpa foto progress 30 hari', bigNumber(extra.no_progress_30d, 'text-warning') + smallLine('ikan aktif belum ada foto progress dalam 30 hari terakhir'), 'col-sm-6 col-lg-3', 'no_progress'))
      if (extra.ponds_empty?.count > 0) {
        const names = extra.ponds_empty.names.map(escapeText).join(', ')
        const more = extra.ponds_empty.count - extra.ponds_empty.names.length
        bottom.push(extraCard('Kolam kosong', bigNumber(extra.ponds_empty.count) + smallLine(names + (more > 0 ? ` dan ${numberText(more)} lainnya` : '')), 'col-sm-6 col-lg-3', more > 0 ? 'ponds_empty' : ''))
      }
      const backup = extra.last_backup || {}
      const accountBackup = extra.last_account_backup || {}
      const stale = backup.days === null || backup.days === undefined || backup.days > 7
      bottom.push(extraCard('Backup terakhir',
        `<div class="h3 mb-0 ${stale ? 'text-danger' : ''}">${backup.at ? escapeText(dateText(backup.at, true)) : 'Belum pernah'}</div>` +
        smallLine(backup.days === null || backup.days === undefined ? 'segera buat backup' : backup.days === 0 ? 'hari ini' : `${numberText(backup.days)} hari lalu${stale ? ', segera buat backup' : ''}`) +
        `<div class="subheader mt-3">Backup akun terakhir</div><div class="fw-semibold ${accountBackup.at ? '' : 'text-secondary'}">${accountBackup.at ? escapeText(dateText(accountBackup.at, true)) : 'Belum pernah'}</div>` +
        (accountBackup.at ? smallLine(accountBackup.days === 0 ? 'hari ini' : `${numberText(accountBackup.days)} hari lalu`) : '')))
      if (extra.ponds_fullest?.length) cards.push(extraCard('Kolam terpadat', `<div class="mt-2">${barRows(extra.ponds_fullest)}</div>`, 'col-sm-6 col-lg-4', extra.ponds_with_fish > extra.ponds_fullest.length ? 'ponds_all' : ''))
      if (extra.top_variety?.length) cards.push(extraCard('Varietas terbanyak (5 teratas)', `<div class="mt-2">${barRows(extra.top_variety)}</div>`, 'col-sm-6 col-lg-4', extra.variety_distinct > extra.top_variety.length ? 'variety' : ''))
      if (extra.top_farm?.length) cards.push(extraCard('Ternakan terbanyak (5 teratas)', `<div class="mt-2">${barRows(extra.top_farm)}</div>`, 'col-sm-6 col-lg-4', extra.farm_distinct > extra.top_farm.length ? 'farm' : ''))
      if (extra.recent?.length) {
        const thumbOf = (url) => { const m = /^\/api\/uploads\/(.+)$/.exec(String(url || '')); return m ? `/api/thumb/240/${m[1]}` : url }
        const rows = extra.recent.map((row, at) => {
          const photo = row.image
            ? `<button type="button" class="p-0 border-0 bg-transparent flex-shrink-0" data-recent-zoom="${at}" title="Lihat foto" style="cursor:zoom-in"><img src="${escapeText(thumbOf(row.image))}" alt="" loading="lazy" style="width:48px;height:72px;object-fit:cover;border-radius:6px;display:block" /></button>`
            : ''
          return `<div class="d-flex gap-3 align-items-center mt-2">${photo}<div class="small min-w-0"><strong>${escapeText(row.title)}</strong><div class="text-secondary">${escapeText(row.label)} · ${escapeText(dateText(row.at, true))}</div></div></div>`
        }).join('')
        cards.push(extraCard('Aktivitas terbaru', rows, 'col-sm-6 col-lg-4', 'recent'))
      }
      // Size spectrum: the steps of the ladder (largest first) that have fish; a step with no fish is not written
      if (extra.size_spread?.some((step) => step.count > 0)) {
        const max = Math.max(...extra.size_spread.map((step) => step.count), 1)
        const rows = extra.size_spread.filter((step) => step.count > 0).map((step) => `
          <div class="d-flex align-items-center gap-2" style="font-size:.78rem;line-height:1.5">
            <span class="text-secondary" style="width:6.2rem;flex:0 0 auto">${step.label}</span>
            <div class="progress progress-sm flex-fill"><div class="progress-bar" style="width:${step.count > 0 ? Math.max(3, Math.round(100 * step.count / max)) : 0}%"></div></div>
            <strong style="width:2.4rem;text-align:right;flex:0 0 auto">${step.count > 0 ? numberText(step.count) : ''}</strong>
          </div>`).join('')
        cards.push(extraCard('Size Spectrum', `<div class="mt-2">${rows}</div>`, 'col-sm-6 col-lg-4'))
      }
      const breeding = extra.breeding || {}
      if (breeding.proses > 0 || breeding.planning > 0) {
        const lines = [['Proses', breeding.proses], ['Planning', breeding.planning]].filter(([, count]) => Number(count) > 0).map(([label, count]) => `${label} ${numberText(count)}`).join(' · ')
        cards.push(extraCard('Breeding berjalan', bigNumber(Number(breeding.proses || 0) + Number(breeding.planning || 0)) + smallLine(lines) + smallLine(breeding.avg_days !== null && breeding.avg_days !== undefined ? `rata-rata ${numberText(breeding.avg_days)} hari sejak awal pijah (proses)` : ''), 'col-sm-6 col-lg-4'))
      }
      const unused = extra.unused_breeders || {}
      const unusedTotal = Number(unused.male || 0) + Number(unused.female || 0) + Number(unused.unknown || 0)
      if (unusedTotal > 0) cards.push(extraCard('Indukan aktif belum dipakai breeding', bigNumber(unusedTotal) + smallLine(extraGender(unused)) + photoGridMarkup('unused', extra.unused_breeders_photos), 'col-sm-6 col-lg-4', 'unused_breeders'))
      const value = extra.stock_value || {}
      if (value.buy > 0 || value.sale > 0) {
        const lines = `<div class="d-flex justify-content-between small mt-2"><span>Harga beli (${numberText(value.buy_n)} ikan)</span><strong>${value.buy > 0 ? moneyText(value.buy) : '-'}</strong></div>` +
          `<div class="d-flex justify-content-between small mt-1"><span>Harga jual (${numberText(value.sale_n)} ikan)</span><strong>${value.sale > 0 ? moneyText(value.sale) : '-'}</strong></div>` +
          photoGridMarkup('stock', extra.stock_photos)
        cards.push(extraCard('Nilai stok ikan', lines, 'col-sm-6 col-lg-6', 'stock_value'))
      }
      const months = (extra.monthly || []).filter((month) => month.count > 0).map((month) => ({ label: dateText(`${month.month}-01`).replace(/ - 01$/, ''), count: month.count }))
      if (months.length) cards.push(extraCard('Pertambahan ikan per bulan (12 bulan)', `<div class="mt-2">${barRows(months)}</div>`, 'col-sm-6 col-lg-6'))
      box.innerHTML = cards.concat(bottom).join('')
      box.querySelectorAll('[data-photo-zoom]').forEach((button) => button.addEventListener('click', () => {
        const [set, at] = button.dataset.photoZoom.split(':')
        const row = photoSets[set]?.[Number(at)]
        if (row) zoomFeedRow(row)
      }))
      box.querySelectorAll('[data-recent-zoom]').forEach((button) => button.addEventListener('click', () => {
        const row = extra.recent?.[Number(button.dataset.recentZoom)]
        if (row) zoomFeedRow(row)
      }))
    }

        // "Lihat selengkapnya": the longer list of a card in a dialog (data from /summary-more); every row opens the matching search
    const openMoreList = async (kind) => {
      let data
      try {
        const response = await fetch(`${apiUrl}/summary-more?kind=${encodeURIComponent(kind)}`)
        if (!response.ok) throw new Error('gagal')
        data = await response.json()
      } catch (error) {
        window.alert('Daftar belum bisa dimuat. Coba lagi.')
        return
      }
      document.querySelector('[data-more-dialog]')?.remove()
      const overlay = document.createElement('div')
      overlay.setAttribute('data-more-dialog', '')
      overlay.style.cssText = 'position:fixed;inset:0;z-index:4500;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(8,12,20,.72)'
      const photoSmall = (url) => { const m = /^\/api\/uploads\/(.+)$/.exec(String(url || '')); return m ? `/api/thumb/240/${m[1]}` : url }
      const zoomRows = []
      const rows = (data.rows || []).map((row) => {
        const href = row.page ? `./${row.page}${row.page.includes('?') ? '&' : '?'}cari=${encodeURIComponent(row.search || '')}` : ''
        const when = row.at ? ` · ${escapeText(dateText(row.at, true))}` : (row.at_date ? ` ${escapeText(dateText(row.at_date))}` : '')
        const subText = row.feed ? [row.label, row.sub].filter(Boolean).join(' · ') : row.sub
        const sub = subText || when ? `<div class="small text-secondary">${escapeText(subText || '')}${when}</div>` : ''
        const prices = row.buy !== undefined ? `<div class="text-end small text-nowrap">${row.buy > 0 ? `<div>Beli <strong>${moneyText(row.buy)}</strong></div>` : ''}${row.sale > 0 ? `<div>Jual <strong>${moneyText(row.sale)}</strong></div>` : ''}</div>` : ''
        const inner = `<div class="d-flex justify-content-between align-items-start gap-3"><div class="min-w-0"><div class="fw-semibold" style="overflow-wrap:anywhere">${escapeText(row.title)}</div>${sub}</div>${row.count !== undefined ? `<strong>${numberText(row.count)}</strong>` : ''}${prices}</div>`
        if (row.koi || row.feed) {
          const at = zoomRows.push(row) - 1
          const photo = row.image
            ? `<button type="button" class="p-0 border-0 bg-transparent flex-shrink-0" data-more-zoom="${at}" title="Lihat foto" style="cursor:zoom-in"><img src="${escapeText(photoSmall(row.image))}" alt="" loading="lazy" style="width:64px;aspect-ratio:2/3;object-fit:cover;border-radius:8px;display:block" /></button>`
            : ''
          return `<div class="list-group-item d-flex gap-3 align-items-center">${photo}<a class="flex-fill min-w-0 text-reset text-decoration-none" href="${href}">${inner}</a></div>`
        }
        return href ? `<a class="list-group-item list-group-item-action" href="${href}">${inner}</a>` : `<div class="list-group-item">${inner}</div>`
      }).join('')
      overlay.innerHTML = `
        <div class="card" style="width:min(94vw,34rem);max-height:88vh;display:flex;flex-direction:column">
          <div class="card-header"><h3 class="card-title">${escapeText(data.title || 'Selengkapnya')}</h3><div class="card-actions"><button type="button" class="btn-close" data-more-close aria-label="Tutup"></button></div></div>
          <div class="list-group list-group-flush" style="overflow:auto">${rows || '<div class="list-group-item text-secondary">Tidak ada data.</div>'}</div>
          <div class="card-footer text-secondary small">${data.note ? escapeText(data.note) + ' ' : ''}Klik satu baris untuk membuka datanya.</div>
        </div>`
      const close = () => { overlay.remove(); document.removeEventListener('keydown', onKey, true) }
      const onKey = (event) => { if (event.key === 'Escape') { event.stopPropagation(); close() } }
      overlay.addEventListener('click', (event) => {
        const zoom = event.target.closest('[data-more-zoom]')
        if (zoom) {
          const row = zoomRows[Number(zoom.dataset.moreZoom)]
          if (row) zoomFeedRow(row)
          return
        }
        if (event.target === overlay || event.target.closest('[data-more-close]')) close()
      })
      document.addEventListener('keydown', onKey, true)
      document.body.appendChild(overlay)
    }
    document.querySelector('[data-dashboard-extra]')?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-more]')
      if (button) openMoreList(button.dataset.more)
    })

    // the status cards at the top open the list of their fish (with photos) when clicked
    ;['quarantine', 'sold', 'breeders_dead', 'regular_dead'].forEach((kind) => {
      const card = document.querySelector(`[data-summary="${kind}"]`)?.closest('.card')
      if (!card) return
      card.style.cursor = 'pointer'
      card.setAttribute('role', 'button')
      card.setAttribute('tabindex', '0')
      card.setAttribute('title', 'Klik untuk melihat ikannya')
      card.addEventListener('click', () => openMoreList(kind))
      card.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openMoreList(kind) } })
    })
    const refreshAll = () => { renderSummary(); renderExtra() }
    refreshAll()
    window.KoiAuth?.registerRealtimeRefresh?.(refreshAll, { intervalMs: 30000 })
  </script>
</DefaultLayout>
