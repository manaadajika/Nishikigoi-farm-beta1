---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
---

<DefaultLayout title="Galeri" pageHeader="Galeri" pretitle="Manajemen" pageMenu="management.gallery">
  <style is:global>
    .gallery-form-media-card {
      position: relative;
    }

    .gallery-form-preview {
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 6px;
      border: 1px solid var(--tblr-border-color);
      background: var(--tblr-bg-surface-secondary);
      background-position: center;
      background-size: cover;
      overflow: hidden;
    }

    .gallery-form-preview-video {
      color: #fff;
      background-color: #111827;
    }

    .gallery-form-remove {
      position: absolute;
      top: .5rem;
      right: .5rem;
      z-index: 1;
    }

    .gallery-viewer-media {
      max-width: 100%;
      max-height: 78vh;
      object-fit: contain;
    }
  </style>

  <div class="modal modal-blur fade" id="gallery-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
      <form class="modal-content" data-gallery-form>
        <div class="modal-header">
          <h5 class="modal-title" data-modal-title>Formulir Tambah Galeri</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" data-gallery-error></div>
          <input type="hidden" name="id" data-gallery-id />
          <input type="hidden" name="pond_id" data-gallery-pond-id />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Judul Galeri</label>
              <input class="form-control" name="title" placeholder="Kolase panen kolam A" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Tanggal</label>
              <input class="form-control" type="text" data-date-parts name="gallery_date" />
            </div>
            <div class="col-12">
              <label class="form-label">Catatan Formulir</label>
              <textarea class="form-control" name="notes" rows="2" placeholder="Catatan umum untuk kolase ini"></textarea>
            </div>
            <div class="col-12">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <label class="form-label required mb-0">Media Kolase</label>
                <div class="btn-list">
                  <button class="btn btn-primary btn-sm" type="button" data-upload-media>Unggah Foto/Video</button>
                  <button class="btn btn-outline-primary btn-sm" type="button" data-paste-media>Paste Gambar</button>
                  <button class="btn btn-outline-primary btn-sm" type="button" data-add-media>Tambah Media</button>
                </div>
              </div>
              <input class="d-none" name="gallery_media_files" type="file" accept="image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm" multiple data-bulk-media-input />
              <div class="form-hint mb-3">Bisa unggah foto atau video lebih dari satu. Setiap media punya catatan sendiri.</div>
              <div class="row g-3" data-media-list></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn" type="button" data-bs-dismiss="modal">Batal</button>
          <button class="btn btn-primary" type="submit" data-gallery-submit>Simpan Galeri</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal modal-blur fade" id="gallery-viewer-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-viewer-title>Preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup" data-close-viewer></button>
        </div>
        <div class="modal-body text-center" data-viewer-body></div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" type="button" data-open-create data-role-required="database-write">Tambah Galeri</button>
  </div>

  <input class="d-none" type="search" data-gallery-search aria-hidden="true" tabindex="-1" autocomplete="off" />
  <div class="row row-cards" data-gallery-list>
    <div class="col-12">
      <div class="card">
        <div class="card-body text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat data gallery...</span></div></div>
      </div>
    </div>
  </div>

  <script>
    const apiUrl = '/api'
    const form = document.querySelector('[data-gallery-form]')
    const galleryIdInput = document.querySelector('[data-gallery-id]')
    const mediaList = document.querySelector('[data-media-list]')
    const galleryList = document.querySelector('[data-gallery-list]')
    const galleryPondIdInput = document.querySelector('[data-gallery-pond-id]')
    const bulkMediaInput = document.querySelector('[data-bulk-media-input]')
    const pasteMediaButton = document.querySelector('[data-paste-media]')
    const errorBox = document.querySelector('[data-gallery-error]')
    const submitButton = document.querySelector('[data-gallery-submit]')
    const modalTitle = document.querySelector('[data-modal-title]')
    const modalElement = document.querySelector('#gallery-modal')
    const viewerModalElement = document.querySelector('#gallery-viewer-modal')
    const viewerTitle = document.querySelector('[data-viewer-title]')
    const viewerBody = document.querySelector('[data-viewer-body]')
    const keepScroll = async (callback) => {
      const scrollX = window.scrollX
      const scrollY = window.scrollY
      const result = await callback()
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY))
      return result
    }
    let modalBackdrop = null
    let viewerBackdrop = null
    let galleries = []
    const galleryCacheKey = 'nishikigoi-cache:farm-gallery'

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    }[char]))

    const getModalApi = () => window.tabler?.bootstrap?.Modal || window.bootstrap?.Modal

    const readFileAsDataUrl = (file) => new Promise((resolve, reject) => {
      const reader = new FileReader()
      reader.addEventListener('load', () => resolve(reader.result))
      reader.addEventListener('error', () => reject(new Error('Media gagal dibaca')))
      reader.readAsDataURL(file)
    })

    const compressImageFile = async (file) => {
      if (!file || file.type === 'image/gif') return await readFileAsDataUrl(file)
      const dataUrl = await readFileAsDataUrl(file)
      const image = await new Promise((resolve, reject) => {
        const img = new Image()
        img.addEventListener('load', () => resolve(img))
        img.addEventListener('error', () => reject(new Error('Gambar gagal diproses')))
        img.src = dataUrl
      })
      const maxSide = 1600
      const ratio = Math.min(1, maxSide / Math.max(image.naturalWidth, image.naturalHeight))
      const canvas = document.createElement('canvas')
      canvas.width = Math.max(1, Math.round(image.naturalWidth * ratio))
      canvas.height = Math.max(1, Math.round(image.naturalHeight * ratio))
      canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height)
      return canvas.toDataURL('image/jpeg', .76)
    }

    const createVideoThumbnail = (file) => new Promise((resolve) => {
      const video = document.createElement('video')
      const canvas = document.createElement('canvas')
      const objectUrl = URL.createObjectURL(file)

      video.muted = true
      video.playsInline = true
      video.preload = 'metadata'
      video.addEventListener('loadeddata', () => {
        canvas.width = video.videoWidth || 640
        canvas.height = video.videoHeight || 360
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height)
        URL.revokeObjectURL(objectUrl)
        resolve(canvas.toDataURL('image/webp', .82))
      }, { once: true })
      video.addEventListener('error', () => {
        URL.revokeObjectURL(objectUrl)
        resolve('')
      }, { once: true })
      video.src = objectUrl
    })

    const mediaAssetUrl = (url) => window.KoiAuth?.apiUrl ? window.KoiAuth.apiUrl(url || '') : (url || '')
    const mediaBackground = (url) => {
      const source = mediaAssetUrl(url)
      return source ? `background-image: url('${escapeHtml(source)}')` : ''
    }

    const mediaPreview = (media) => {
      const source = media.thumbnail_url || media.image_url
      return media.media_type === 'video'
        ? `<button class="gallery-form-preview gallery-form-preview-video d-flex align-items-center justify-content-center w-100 p-0" type="button" data-media-preview data-view-form-media style="${mediaBackground(source)}">Video</button>`
        : `<button class="gallery-form-preview w-100 p-0" type="button" data-media-preview data-view-form-media style="${mediaBackground(source)}"></button>`
    }

    const applyFileToMediaRow = async (column, file) => {
      const isImage = ['image/png', 'image/jpeg', 'image/webp', 'image/gif'].includes(file.type)
      const isVideo = ['video/mp4', 'video/webm'].includes(file.type)
      if (!isImage && !isVideo) throw new Error('Format media harus gambar, mp4, atau webm')
      if (isVideo && file.size > 100 * 1024 * 1024) throw new Error('Ukuran video maksimal 100 MB')

      column.dataset.mediaType = isVideo ? 'video' : 'image'
      column.dataset.imageUrl = ''
      column.dataset.thumbnailUrl = ''
      const dataUrl = isImage ? await compressImageFile(file) : await readFileAsDataUrl(file)
      if (isVideo) {
        column.dataset.videoData = dataUrl
        column.dataset.imageData = ''
        column.dataset.thumbnailData = await createVideoThumbnail(file)
      } else {
        column.dataset.imageData = dataUrl
        column.dataset.videoData = ''
        column.dataset.thumbnailData = ''
      }
      column.querySelector('[data-media-preview]').outerHTML = mediaPreview({
        media_type: column.dataset.mediaType,
        image_url: isImage ? dataUrl : '',
        thumbnail_url: column.dataset.thumbnailData,
      })
    }

    const createMediaRow = (media = {}) => {
      const column = document.createElement('div')
      column.className = 'col-sm-6 col-lg-4'
      column.dataset.mediaRow = ''
      column.dataset.mediaType = media.media_type || 'image'
      column.dataset.imageUrl = media.image_url || ''
      column.dataset.thumbnailUrl = media.thumbnail_url || ''
      column.dataset.mediaNotes = media.notes || ''
      column.innerHTML = `
        <div class="card gallery-form-media-card">
          <button class="btn btn-icon btn-outline-danger gallery-form-remove" type="button" aria-label="Hapus media" data-remove-media>
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3h6v3" /></svg>
          </button>
          <div class="card-body">
            ${mediaPreview(media)}
            <input class="form-control form-control-sm mt-2" name="gallery_media_file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm" data-media-input>
            <textarea class="form-control form-control-sm mt-2" name="gallery_media_notes" rows="2" placeholder="Catatan media" data-media-notes>${escapeHtml(media.notes || '')}</textarea>
          </div>
        </div>
      `

      const input = column.querySelector('[data-media-input]')
      input.addEventListener('change', async () => {
        const file = input.files[0]
        if (!file) return
        try {
          await applyFileToMediaRow(column, file)
        } catch (error) {
          input.value = ''
          errorBox.textContent = error.message
          errorBox.classList.remove('d-none')
        }
      })
      column.querySelector('[data-remove-media]').addEventListener('click', () => {
        column.remove()
        if (!mediaList.querySelector('[data-media-row]')) createMediaRow()
      })
      column.addEventListener('click', (event) => {
        if (!event.target.closest('[data-view-form-media]')) return
        const media = {
          image_url: column.dataset.imageData || column.dataset.videoData || column.dataset.imageUrl || '',
          media_type: column.dataset.mediaType || 'image',
          thumbnail_url: column.dataset.thumbnailData || column.dataset.thumbnailUrl || '',
          notes: column.querySelector('[data-media-notes]')?.value.trim() || column.dataset.mediaNotes || '',
        }
        if (media.image_url) openViewerModal(media)
      })
      mediaList.appendChild(column)
    }

    const hasFilledMedia = () => Array.from(mediaList.querySelectorAll('[data-media-row]')).some((row) => row.dataset.imageUrl || row.dataset.imageData || row.dataset.videoData)

    const addFilesToGallery = async (files) => {
      errorBox.classList.add('d-none')
      const selectedFiles = Array.from(files || [])
      if (selectedFiles.length === 0) return
      if (!hasFilledMedia()) mediaList.innerHTML = ''

      for (const file of selectedFiles) {
        const beforeCount = mediaList.querySelectorAll('[data-media-row]').length
        createMediaRow()
        const row = mediaList.querySelectorAll('[data-media-row]')[beforeCount]
        await applyFileToMediaRow(row, file)
      }
    }

    const pasteImagesToGallery = async () => {
      errorBox.classList.add('d-none')
      try {
        const clipboardItems = await navigator.clipboard.read()
        const imageFiles = []

        for (const item of clipboardItems) {
          const imageType = item.types.find((type) => type.startsWith('image/'))
          if (!imageType) continue
          const blob = await item.getType(imageType)
          imageFiles.push(new File([blob], `paste-gallery-${Date.now()}-${imageFiles.length + 1}.${imageType.split('/')[1] || 'png'}`, { type: imageType }))
        }

        if (!imageFiles.length) {
          throw new Error('Clipboard tidak berisi gambar.')
        }

        await addFilesToGallery(imageFiles)
      } catch (error) {
        errorBox.textContent = error.message || 'Paste gambar gagal.'
        errorBox.classList.remove('d-none')
      }
    }

    const resetForm = () => {
      form.reset()
      galleryIdInput.value = ''
      galleryPondIdInput.value = ''
      mediaList.innerHTML = ''
      errorBox.classList.add('d-none')
      modalTitle.textContent = 'Formulir Tambah Galeri'
      submitButton.textContent = 'Simpan Galeri'
      createMediaRow()
    }

    const closeGalleryModal = () => {
      const modalApi = getModalApi()
      if (modalApi) {
        modalApi.getInstance(modalElement)?.hide()
        return
      }

      modalElement.classList.remove('show')
      modalElement.style.display = 'none'
      modalElement.setAttribute('aria-hidden', 'true')
      modalElement.removeAttribute('aria-modal')
      modalElement.removeAttribute('role')
      document.body.classList.remove('modal-open')
      document.body.style.removeProperty('overflow')
      document.body.style.removeProperty('padding-right')
      modalBackdrop?.remove()
      modalBackdrop = null
    }

    const closeViewerModal = () => {
      const modalApi = getModalApi()
      viewerBody.innerHTML = ''
      if (modalApi) {
        modalApi.getInstance(viewerModalElement)?.hide()
        return
      }

      viewerModalElement.classList.remove('show')
      viewerModalElement.style.display = 'none'
      viewerModalElement.setAttribute('aria-hidden', 'true')
      viewerModalElement.removeAttribute('aria-modal')
      viewerModalElement.removeAttribute('role')
      document.body.classList.remove('modal-open')
      document.body.style.removeProperty('overflow')
      document.body.style.removeProperty('padding-right')
      viewerBackdrop?.remove()
      viewerBackdrop = null
    }

    const openViewerModal = (media) => {
      const source = media.thumbnail_url || media.image_url
      const imageUrl = mediaAssetUrl(media.image_url)
      const posterUrl = mediaAssetUrl(source)
      viewerTitle.textContent = media.notes || (media.media_type === 'video' ? 'Video' : 'Foto')
      if (window.KoiAuth && window.KoiAuth.zoomPhoto && imageUrl) {
        window.KoiAuth.zoomPhoto(imageUrl, viewerTitle.textContent);
        return;
      }
      viewerBody.innerHTML = media.media_type === 'video'
        ? `<video class="gallery-viewer-media rounded border" src="${escapeHtml(imageUrl)}" poster="${escapeHtml(posterUrl)}" controls autoplay playsinline></video>`
        : `<img class="gallery-viewer-media rounded border" src="${escapeHtml(imageUrl)}" alt="${escapeHtml(media.notes || 'Preview gallery')}" />`

      const modalApi = getModalApi()
      if (modalApi) {
        modalApi.getOrCreateInstance(viewerModalElement).show()
        return
      }

      viewerModalElement.classList.add('show')
      viewerModalElement.style.display = 'block'
      viewerModalElement.removeAttribute('aria-hidden')
      viewerModalElement.setAttribute('aria-modal', 'true')
      viewerModalElement.setAttribute('role', 'dialog')
      document.body.classList.add('modal-open')
      document.body.style.overflow = 'hidden'
      viewerBackdrop = document.createElement('div')
      viewerBackdrop.className = 'modal-backdrop fade show'
      viewerBackdrop.addEventListener('click', closeViewerModal)
      document.body.appendChild(viewerBackdrop)
    }

    const openGalleryModal = (reset = true) => {
      if (reset) resetForm()
      const modalApi = getModalApi()
      if (modalApi) {
        modalApi.getOrCreateInstance(modalElement).show()
        return
      }

      modalElement.classList.add('show')
      modalElement.style.display = 'block'
      modalElement.removeAttribute('aria-hidden')
      modalElement.setAttribute('aria-modal', 'true')
      modalElement.setAttribute('role', 'dialog')
      document.body.classList.add('modal-open')
      document.body.style.overflow = 'hidden'
      modalBackdrop = document.createElement('div')
      modalBackdrop.className = 'modal-backdrop fade show'
      modalBackdrop.addEventListener('click', closeGalleryModal)
      document.body.appendChild(modalBackdrop)
    }

    const collectMedia = () => Array.from(mediaList.querySelectorAll('[data-media-row]')).map((row) => ({
      image_url: row.dataset.imageUrl || '',
      image_data: row.dataset.imageData || '',
      video_data: row.dataset.videoData || '',
      media_type: row.dataset.mediaType || 'image',
      thumbnail_url: row.dataset.thumbnailUrl || '',
      thumbnail_data: row.dataset.thumbnailData || '',
      notes: row.querySelector('[data-media-notes]').value.trim(),
    })).filter((media) => media.image_url || media.image_data || media.video_data)

    const renderMediaTile = (media) => {
      const source = media.thumbnail_url || media.image_url
      return `
        <div class="col-4">
          <button class="d-block ratio ratio-1x1 rounded border position-relative w-100 p-0" type="button" data-view-media="${escapeHtml(media.id)}" style="${mediaBackground(source)}; background-position: center; background-size: cover;">
            ${media.media_type === 'video' ? '<span class="badge bg-dark text-white position-absolute bottom-0 end-0 m-1">Video</span>' : ''}
          </button>
          <div class="small text-secondary text-truncate mt-1">${escapeHtml(media.notes || '-')}</div>
        </div>
      `
    }

// ---- Galeri search: plain words + "field:value" -----------------------------------------------------------
    // "sumber:laporan kolam:mudpond media:telur" -> every field:value must match (a value runs until the next field:).
    // Plain words must all be found in judul, kode sumber, kolam and sumber; a bare number (or #12) is the Galeri ID.
    // A comma inside a text value means "or". Catatan is only searched with catatan: (catatan koleksi) or media: (catatan
    // foto/video).
    var glSearch = ''
    var glAliases = {
      id: 'id', nomor: 'id',
      judul: 'title', nama: 'title',
      tanggal: 'gallery_date', tgl: 'gallery_date',
      kode: 'code',
      kolam: 'pond', lokasi: 'pond',
      sumber: 'source', asal: 'source',
      catatan: 'notes', notes: 'notes',
      media: 'media', foto: 'media',
      idmedia: 'media_id',
      tipe: 'media_type', jenismedia: 'media_type',
    }
    // "bloo:isa" works too: a field name may be shortened to its first letters (2 or more). Exact names win, then the
    // first name in the alias list that starts with what was typed. Unknown names stay plain text.
    function glResolveMarkers(keyword, aliases) {
      var names = Object.keys(aliases)
      var found = []
      var pattern = /(?:^|[\s,])([a-z]+)\s*:/gi
      var match
      while ((match = pattern.exec(keyword))) {
        var key = match[1].toLowerCase()
        var name = aliases[key] ? key : (key.length >= 2 ? names.find(function (alias) { return alias.indexOf(key) === 0 }) : null)
        if (name) {
          var hit = [match[0], name]
          hit.index = match.index
          found.push(hit)
        }
      }
      return found
    }
    
    function glNorm(value) {
      return String(value === null || value === undefined ? '' : value).toLowerCase().trim()
    }
    
    function glParts(item) {
      var source = item.source_type === 'report' ? 'laporan' : item.source_type === 'breeding' ? 'breeding' : item.source_type === 'pond' ? 'kolam data kolam' : 'manual'
      var code = [item.report_batch_code, item.breeding_batch_code].filter(Boolean).join(' ')
      var pond = [item.pond_name, item.source_pond_name].filter(Boolean).join(' ')
      var images = Array.isArray(item.images) ? item.images : []
      return {
        source: glNorm(source),
        code: glNorm(code + ' ' + (item.report_title || '') + ' ' + (item.breeding_session_name || '')),
        pond: glNorm(pond),
        mediaNotes: glNorm(images.map(function (image) { return [image.notes, image.display_name, image.name].filter(Boolean).join(' ') }).join(' ')),
        mediaIds: images.map(function (image) { return String(image.id) }),
        mediaTypes: glNorm(images.map(function (image) { return image.media_type === 'video' ? 'video' : 'foto gambar image' }).join(' ')),
      }
    }
    
    function glDateText(value) {
      var match = String(value || '').trim().match(/^(\d{1,2})[/.-](\d{1,2})[/.-](\d{4})$/)
      return match ? match[3] + '-' + match[2].padStart(2, '0') + '-' + match[1].padStart(2, '0') : String(value || '').trim()
    }
    
    // true / false, or null while the value is still being typed
    function glField(item, parts, field, rawValue) {
      var value = glNorm(rawValue)
      if (!value) return null
      if (field === 'id') return String(item.id) === value.replace(/^#/, '')
      if (field === 'media_id') return parts.mediaIds.indexOf(value.replace(/^#/, '')) >= 0
      if (field === 'gallery_date') return String(item.gallery_date || '').slice(0, 10).includes(glDateText(value))
      return value.split(',').map(function (part) { return part.trim() }).filter(Boolean).some(function (choice) {
        if (field === 'code') return parts.code.includes(choice)
        if (field === 'pond') return parts.pond.includes(choice)
        if (field === 'source') return parts.source.includes(choice)
        if (field === 'media') return parts.mediaNotes.includes(choice)
        if (field === 'media_type') return parts.mediaTypes.includes(choice)
        return glNorm(item[field]).includes(choice)
      })
    }
    
    function glMatches(item) {
      var keyword = String(glSearch || '').trim()
      if (!keyword) return true
      var markers = glResolveMarkers(keyword, glAliases)
      var plain = markers.length ? keyword.slice(0, markers[0].index) : keyword
      var parts = glParts(item)
      for (var index = 0; index < markers.length; index += 1) {
        var marker = markers[index]
        var valueStart = marker.index + marker[0].length
        var valueEnd = index + 1 < markers.length ? markers[index + 1].index : keyword.length
        if (glField(item, parts, glAliases[marker[1].toLowerCase()], keyword.slice(valueStart, valueEnd)) === false) return false
      }
      var alternatives = plain.split(',').map(function (part) { return glNorm(part).split(/\s+/).filter(Boolean) }).filter(function (words) { return words.length })
      if (!alternatives.length) return true
      var blob = glNorm([item.title, parts.code, parts.pond, parts.source].join(' '))
      return alternatives.some(function (words) {
        return words.every(function (word) { return /^#?\d+$/.test(word) ? String(item.id) === word.replace('#', '') || blob.includes(word.replace('#', '')) : blob.includes(word) })
      })
    }
    
    const renderGallery = (items) => {
      galleries = items
      galleryList.innerHTML = items.filter(glMatches).map((item) => `
        <div class="col-md-6 col-xl-4">
          <div class="card h-100">
            <div class="card-body">
              <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                <div>
                  <h3 class="card-title mb-1">${escapeHtml(item.title)}</h3>
                  <div class="text-secondary">${item.gallery_date ? window.KoiAuth.formatDate(item.gallery_date) : '-'}</div>
                  <div class="text-secondary">${item.images.length} media</div>
                </div>
                <div class="btn-list flex-nowrap">
                  <button class="btn btn-icon btn-outline-primary" type="button" aria-label="Edit gallery" data-edit-gallery="${item.id}" data-role-required="database-write">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" /><path d="M13.5 6.5l4 4" /></svg>
                  </button>
                  <button class="btn btn-icon btn-outline-danger" type="button" aria-label="Hapus gallery" data-delete-gallery="${item.id}" data-role-required="database-write">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3h6v3" /></svg>
                  </button>
                </div>
              </div>
              <div class="row g-2 mb-3">
                ${item.images.slice(0, 3).map(renderMediaTile).join('')}
                ${item.images.length > 3 ? `<div class="col-4"><button class="btn w-100 h-100 border" type="button" data-edit-gallery="${item.id}" data-role-required="database-write">+${item.images.length - 3} media</button></div>` : ''}
              </div>
              <div class="text-secondary">${escapeHtml(item.notes || '-')}</div>
            </div>
          </div>
        </div>
      `).join('') || `<div class="col-12"><div class="card"><div class="card-body text-secondary">${glSearch ? 'Galeri tidak ditemukan.' : 'Belum ada data gallery.'}</div></div></div>`
    }

    const loadGallery = (silent = false) => fetch(`${apiUrl}/gallery`)
      .then((response) => response.ok ? response.json() : Promise.reject(new Error('Galeri gagal dimuat')))
      .then((items) => {
        localStorage.setItem(galleryCacheKey, JSON.stringify(items))
        renderGallery(items)
      })
      .catch(() => {
        if (!silent) {
          galleryList.innerHTML = '<div class="col-12"><div class="card"><div class="card-body text-danger">Data gallery gagal dimuat.</div></div></div>'
        }
      })


    // the navbar search feeds the hidden [data-gallery-search] input
    ;(function () {
      var box = document.querySelector('[data-gallery-search]')
      var navbar = document.querySelector('#navbar-global-search')
      if (navbar) {
        navbar.setAttribute('placeholder', 'Judul, kolam, sumber:laporan, media:kata')
        navbar.setAttribute('title', 'Cari bebas: judul, kode laporan/breeding, kolam, sumber, atau ID galeri. Cari per kolom dengan kolom:isi, boleh digabung: sumber:laporan kolam:mudpond media:telur. Nama kolom boleh disingkat (misalnya jen:panen). Kolom: id, judul, tanggal, kode, kolam, sumber, catatan, media, idmedia, tipe.')
      }
      if (box) box.addEventListener('input', function () { glSearch = box.value.trim(); renderGallery(galleries) })
    })()
    
    const restoreGalleryCache = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(galleryCacheKey) || '[]')
        if (!Array.isArray(cached) || cached.length === 0) return
        renderGallery(cached)
      } catch {
        localStorage.removeItem(galleryCacheKey)
      }
    }

    document.querySelector('[data-upload-media]').addEventListener('click', () => bulkMediaInput.click())
    pasteMediaButton.addEventListener('click', pasteImagesToGallery)
    bulkMediaInput.addEventListener('change', () => {
      addFilesToGallery(bulkMediaInput.files).catch((error) => {
        errorBox.textContent = error.message
        errorBox.classList.remove('d-none')
      }).finally(() => {
        bulkMediaInput.value = ''
      })
    })
    document.querySelector('[data-add-media]').addEventListener('click', () => createMediaRow())
    document.querySelector('[data-open-create]').addEventListener('click', () => openGalleryModal())
    modalElement.querySelectorAll('[data-bs-dismiss="modal"], .btn-close').forEach((button) => {
      button.addEventListener('click', closeGalleryModal)
    })
    viewerModalElement.querySelectorAll('[data-bs-dismiss="modal"], [data-close-viewer]').forEach((button) => {
      button.addEventListener('click', closeViewerModal)
    })

    galleryList.addEventListener('click', async (event) => {
      const editButton = event.target.closest('[data-edit-gallery]')
      const deleteButton = event.target.closest('[data-delete-gallery]')
      const viewButton = event.target.closest('[data-view-media]')

      if (viewButton) {
        const mediaId = String(viewButton.dataset.viewMedia)
        const media = galleries.flatMap((gallery) => gallery.images || []).find((item) => String(item.id) === mediaId)
        if (media) openViewerModal(media)
      }

      if (editButton) {
        const item = galleries.find((gallery) => String(gallery.id) === String(editButton.dataset.editGallery))
        if (!item) return
        resetForm()
        modalTitle.textContent = 'Formulir Edit Galeri'
        submitButton.textContent = 'Simpan Perubahan'
        galleryIdInput.value = item.id
        galleryPondIdInput.value = item.pond_id || ''
        form.elements.title.value = item.title || ''
        form.elements.gallery_date.value = item.gallery_date ? String(item.gallery_date).slice(0, 10) : ''
        form.elements.notes.value = item.notes || ''
        mediaList.innerHTML = ''
        item.images.forEach(createMediaRow)
        openGalleryModal(false)
      }

      if (deleteButton && (await window.KoiDialog.confirm('Hapus gallery ini?'))) {
        await fetch(`${apiUrl}/gallery/${deleteButton.dataset.deleteGallery}`, { method: 'DELETE' })
        keepScroll(loadGallery)
      }
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      errorBox.classList.add('d-none')
      submitButton.disabled = true
      submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-label="Menyimpan gallery"></span><span class="progress progress-sm flex-fill"><span class="progress-bar progress-bar-indeterminate"></span></span>'

      try {
        const payload = Object.fromEntries(new FormData(form).entries())
        payload.images = collectMedia()
        if (payload.images.length === 0) throw new Error('Minimal satu foto/video wajib diisi')
        payload.pond_id = payload.pond_id || null
        payload.segment_name = payload.title || 'Galeri'
        payload.gallery_date = payload.gallery_date || new Date().toISOString().slice(0, 10)

        const response = await fetch(`${apiUrl}/gallery${galleryIdInput.value ? `/${galleryIdInput.value}` : ''}`, {
          method: galleryIdInput.value ? 'PUT' : 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.detail || data.error || 'Galeri gagal disimpan')

        resetForm()
        closeGalleryModal()
        keepScroll(loadGallery)
      } catch (error) {
        errorBox.textContent = error.message
        errorBox.classList.remove('d-none')
      } finally {
        submitButton.disabled = false
        submitButton.textContent = galleryIdInput.value ? 'Simpan Perubahan' : 'Simpan Galeri'
      }
    })

    resetForm()
    restoreGalleryCache()
    loadGallery()
  </script>
  <script is:inline src="/assets/gallery-extras.js?v=20261029b"></script>
</DefaultLayout>
