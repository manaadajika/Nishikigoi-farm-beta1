          name: fields.name.value.trim(),
          username: fields.username.value.trim().toLowerCase(),
          password: fields.password.value,
          email: fields.email.value.trim(),
          phone: fields.phone.value.trim(),
          role: fields.role.value,
          status: fields.status.value,
        }

        if (!account.name || !account.username || (!editingAccountId && !account.password)) {
          showMessage(editingAccountId ? 'Nama dan username wajib diisi.' : 'Nama, username, dan password wajib diisi.', 'danger')
