      const formatDateTime = (value) => {
        if (!value) return '-'
        const date = new Date(String(value).replace(' ', 'T'))
        if (Number.isNaN(date.getTime())) return value
        return window.KoiAuth.formatDateTime(date)
      }

      const compactDevice = (value) => {
      const device = String(value || '').trim()
      if (!device) return '-'
      if (/Android/i.test(device)) return 'Android'
      if (/iPhone|iPad/i.test(device)) return 'iPhone/iPad'
      if (/Windows/i.test(device)) return 'Windows'
      if (/Macintosh|Mac OS/i.test(device)) return 'Mac'
      return device.slice(0, 42)
    }

      const sessionBadge = (presence) => {
      if (presence === 'online') return '<span class="badge bg-green-lt">Online</span>'
