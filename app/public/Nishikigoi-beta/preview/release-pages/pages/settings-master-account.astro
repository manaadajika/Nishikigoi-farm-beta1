---
import SettingsLayout from '@shared/layouts/SettingsLayout.astro'
import ButtonList from '@ui/ButtonList.astro'
import CardSubtitle from '@ui/CardSubtitle.astro'
import CardTitle from '@ui/CardTitle.astro'
import FormGroup from '@ui/FormGroup.astro'
---

<SettingsLayout active="settings-master-account" title="Master Akun">
  <span class="d-none" data-page-role-required="master-admin"></span>
  <div class="card-body">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
      <div>
        <h2 class="mb-1">Master Akun</h2>
        <CardSubtitle>Menu ini khusus untuk role Master Admin.</CardSubtitle>
      </div>
      <button type="button" class="btn btn-primary" data-action="new-account">Tambah akun</button>
    </div>

    <div class="border rounded p-3 mb-4" id="program-identity" data-brand-settings-panel>
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
        <div>
          <CardTitle>Identitas Program</CardTitle>
          <CardSubtitle>Atur nama program dan icon yang tampil di header dan halaman login.</CardSubtitle>
        </div>
        <button type="button" class="btn btn-primary" data-action="save-brand-settings">Simpan Identitas</button>
      </div>
      <div class="alert alert-info d-none" data-brand-message></div>
      <div class="row g-3 align-items-end">
        <FormGroup label="Nama Program" for="brand-name" class="col-md-6">
          <input type="text" class="form-control" id="brand-name" data-brand-name-input maxlength="80" placeholder="Nishikigoi" />
        </FormGroup>
        <div class="col-md-6">
          <label class="form-label" for="brand-icon">Icon Program</label>
          <div class="d-flex align-items-center gap-3">
            <span class="avatar avatar-xl" data-brand-icon-preview>N</span>
            <div class="btn-list">
              <input type="file" class="d-none" id="brand-icon" data-brand-icon-input accept="image/*" />
              <button type="button" class="btn" data-action="upload-brand-icon">Upload Icon</button>
              <button type="button" class="btn btn-ghost-danger" data-action="remove-brand-icon">Hapus Icon</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border rounded p-3 mb-4" id="system-backup" data-system-backup-panel>
      <div class="d-flex flex-column gap-3">
        <div>
          <CardTitle>Backup & Restore Sistem</CardTitle>
          <CardSubtitle>Backup mengunduh database dan file gambar/media sebagai ZIP yang bisa direstore lengkap oleh program. Backup sistem tidak memuat akun, setingan, dan tema: itu ada di Backup Akun. Satu tombol Restore mengenali kedua jenis ZIP.</CardSubtitle>
          <div class="text-secondary small mt-2" data-system-backup-stamps>
            <div>Terakhir backup: <strong data-system-stamp="last_backup_at">Memuat...</strong></div>
            <div>Terakhir restore: <strong data-system-stamp="last_restore_at">Memuat...</strong></div>
            <div>Terakhir backup akun: <strong data-system-stamp="last_account_backup_at">Memuat...</strong></div>
            <div>Terakhir restore akun: <strong data-system-stamp="last_account_restore_at">Memuat...</strong></div>
          </div>
        </div>
        <div class="btn-list">
          <button type="button" class="btn btn-primary" data-action="download-system-backup">Buat Backup</button>
          <button type="button" class="btn btn-primary" data-action="download-account-backup" title="Mengunduh semua akun terdaftar, setingan program, dan tema (terpisah dari backup sistem)">Backup Akun</button>
          <input type="file" class="d-none" accept=".zip,application/zip" data-system-restore-input />
          <button type="button" class="btn" data-action="pick-system-restore">Restore</button>
          <button type="button" class="btn" data-action="cleanup-unused-files">Bersihkan File Tidak Terpakai</button>
          <button type="button" class="btn btn-outline-danger" data-action="clear-system-data">Hapus Semua Data</button>
        </div>
      </div>
      <div class="alert alert-info d-none mt-3 mb-0" data-system-backup-message></div>
      <div class="progress progress-sm d-none mt-3" data-system-backup-progress>
        <div class="progress-bar progress-bar-indeterminate"></div>
      </div>
    </div>
    <CardTitle>Daftar Akun</CardTitle>

    <div class="table-responsive mb-4">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Photo Profile</th>
            <th>Nama</th>
            <th>Username</th>
            <th>Email</th>
<th>Telepon</th>
            <th>Role</th>
            <th>Status</th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody data-accounts-table>
          <tr><td colspan="8" class="text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat data akun...</span></div></td></tr>
        </tbody>
      </table>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
      <CardTitle>Akun yang Sedang Login</CardTitle>
      <button type="button" class="btn" data-action="refresh-account-sessions">Refresh Sesi</button>
    </div>

    <div class="table-responsive mb-4">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Akun</th>
            <th>Role</th>
            <th>Status</th>
            <th>Login</th>
            <th>Aktivitas Terakhir</th>
            <th>Remember</th>
            <th>Perangkat</th>
            <th></th>
          </tr>
        </thead>
        <tbody data-account-sessions-table>
          <tr><td colspan="8" class="text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat sesi login...</span></div></td></tr>
        </tbody>
      </table>
    </div>

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
      <CardTitle>Riwayat Login</CardTitle>
      <div class="btn-list">
        <button type="button" class="btn btn-outline-danger" data-action="delete-login-history" data-login-delete-selected disabled>Hapus Terpilih</button>
        <button type="button" class="btn btn-outline-danger" data-action="clear-login-history">Hapus Semua</button>
        <button type="button" class="btn" data-action="refresh-login-history">Refresh Riwayat</button>
      </div>
    </div>

    <div class="table-responsive mb-4">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th style="width:36px"><input class="form-check-input" type="checkbox" data-login-check-all aria-label="Pilih semua riwayat" /></th>
            <th>Waktu</th>
            <th>Akun</th>
            <th>Hasil</th>
            <th>Alamat IP</th>
            <th>Perangkat</th>
          </tr>
        </thead>
        <tbody data-login-history-table>
          <tr><td colspan="6" class="text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat riwayat login...</span></div></td></tr>
        </tbody>
      </table>
    </div>

  </div>

  <div class="modal modal-blur fade" id="account-modal" tabindex="-1" aria-hidden="true" data-account-modal>
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-account-form-title>Tambah Akun</h5>
          <button type="button" class="btn-close" data-action="cancel-account" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-success d-none mb-3" role="alert" data-master-account-message></div>
          <div class="row g-3" data-account-form>
            <div class="col-12">
              <label class="form-label" for="account-avatar">Photo Profile</label>
              <div class="d-flex align-items-center gap-3">
                <span class="avatar avatar-xl" data-account-avatar-preview>HA</span>
                <div class="btn-list">
                  <input type="file" class="d-none" id="account-avatar" accept="image/*" />
                  <button type="button" class="btn" data-action="upload-avatar">Upload Photo Profile</button>
                  <button type="button" class="btn btn-ghost-danger" data-action="remove-avatar">Hapus Photo Profile</button>
                </div>
              </div>
            </div>

            <FormGroup label="Nama" for="account-name" class="col-md-6">
              <input type="text" class="form-control" id="account-name" name="account-name" />
            </FormGroup>
            <div class="col-md-6">
              <label class="form-label" for="account-username">Username untuk login</label>
              <input type="text" class="form-control" id="account-username" name="account-username" autocomplete="username" placeholder="contoh: admin" />
              <div class="form-hint">Username ini dipakai saat akun masuk ke aplikasi.</div>
            </div>
            <FormGroup label="Password" for="account-password" class="col-md-6">
              <input type="password" class="form-control" id="account-password" name="account-password" autocomplete="new-password" />
              <div class="form-hint" data-password-hint>Kosongkan saat edit jika password tidak diubah.</div>
            </FormGroup>
            <FormGroup label="Email (opsional)" for="account-email" class="col-md-6">
              <input type="email" class="form-control" id="account-email" name="account-email" />
            </FormGroup>
            <FormGroup label="Nomor telepon (opsional)" for="account-phone" class="col-md-6">
              <input type="tel" class="form-control" id="account-phone" name="account-phone" inputmode="tel" />
            </FormGroup>
            <FormGroup label="Role" for="account-role" class="col-md-6">
              <select class="form-select" id="account-role" name="account-role">
                <option>Master Admin</option>
                <option>Admin</option>
                <option>Operator</option>
                <option>Viewer</option>
              </select>
            </FormGroup>
            <FormGroup label="Status" for="account-status" class="col-md-6">
              <select class="form-select" id="account-status" name="account-status">
                <option>Active</option>
                <option>Inactive</option>
              </select>
            </FormGroup>
          </div>
        </div>
        <div class="modal-footer">
          <ButtonList class="justify-content-end">
            <button type="button" class="btn" data-action="cancel-account">Cancel</button>
            <button type="button" class="btn btn-primary" data-action="save-account">Submit</button>
          </ButtonList>
        </div>
      </div>
    </div>
  </div>

<script is:inline src="/assets/brand-slots.js?v=20261014a"></script>
<script is:inline>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
      const brandFields = {
        name: document.querySelector('[data-brand-name-input]'),
        icon: document.querySelector('[data-brand-icon-input]'),
        preview: document.querySelector('[data-brand-icon-preview]'),
      }
      let brandIconValue = ''

      const showBrandMessage = (message, variant = 'info') => {
        const element = document.querySelector('[data-brand-message]')
        if (!element) return
        element.textContent = message
        element.className = `alert alert-${variant}`
      }

      const setBrandPreview = (icon, name) => {
        brandIconValue = icon || ''
        if (!brandFields.preview) return
        if (brandIconValue) {
          brandFields.preview.style.backgroundImage = `url(${brandIconValue})`
          brandFields.preview.textContent = ''
        } else {
          brandFields.preview.style.backgroundImage = ''
          brandFields.preview.textContent = String(name || 'Nishikigoi').trim().charAt(0).toUpperCase() || 'N'
        }
        if (brandFields.icon) brandFields.icon.value = ''
      }

      const loadBrandSettings = async () => {
        const settings = await window.KoiAuth.loadAppSettings()
        if (brandFields.name) brandFields.name.value = settings.brand_name || 'Nishikigoi'
        setBrandPreview(settings.brand_icon || '', settings.brand_name || 'Nishikigoi')
      }

      const saveBrandSettings = async () => {
        showBrandMessage('Identitas program sedang disimpan.', 'info')
        const settings = await window.KoiAuth.saveAppSettings({
          brand_name: brandFields.name?.value || 'Nishikigoi',
          brand_icon: brandIconValue,
        })
        if (brandFields.name) brandFields.name.value = settings.brand_name || 'Nishikigoi'
        setBrandPreview(settings.brand_icon || '', settings.brand_name || 'Nishikigoi')
        showBrandMessage('Identitas program berhasil disimpan.', 'success')
      }

      const backupStampNodes = {
        last_backup_at: document.querySelector('[data-system-stamp="last_backup_at"]'),
        last_restore_at: document.querySelector('[data-system-stamp="last_restore_at"]'),
      
        last_account_backup_at: document.querySelector('[data-system-stamp="last_account_backup_at"]'),
        last_account_restore_at: document.querySelector('[data-system-stamp="last_account_restore_at"]'),}
      const stampDay = new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
      const stampTime = new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit', hour12: false })
      const stampText = (value) => {
        const date = value ? new Date(value) : null
        if (!date || Number.isNaN(date.getTime())) return 'Belum pernah'
        return `${window.KoiAuth.formatDate(date, { weekday: true })}, pukul ${stampTime.format(date).replace(':', '.')}`
      }
      const loadBackupStamps = async () => {
        try {
          const response = await fetch(window.KoiAuth.apiUrl('/api/maintenance/status'), { headers: systemJobHeaders() })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error('status')
          Object.keys(backupStampNodes).forEach((key) => { if (backupStampNodes[key]) backupStampNodes[key].textContent = stampText(data[key]) })
        } catch (error) {
          Object.values(backupStampNodes).forEach((node) => { if (node) node.textContent = 'Tidak terbaca' })
        }
      }

      const backupMessage = document.querySelector('[data-system-backup-message]')
      const backupProgress = document.querySelector('[data-system-backup-progress]')
      const restoreInput = document.querySelector('[data-system-restore-input]')

      const showBackupMessage = (message, variant = 'info') => {
        if (!backupMessage) return
        backupMessage.textContent = message
        backupMessage.className = `alert alert-${variant} mt-3 mb-0`
        if (variant === 'success') loadBackupStamps()
      }

      const setBackupBusy = (busy) => {
        backupProgress?.classList.toggle('d-none', !busy)
        if (busy) setBackupProgress(null)
      }

      // A number 0-100 fills the bar (percent of the current stage); null = no countable steps right now (moving stripes).
      const backupBar = backupProgress?.querySelector('.progress-bar')
      const setBackupProgress = (percent) => {
        if (!backupBar) return
        if (percent === null || percent === undefined) {
          backupBar.classList.add('progress-bar-indeterminate')
          backupBar.style.width = ''
          return
        }
        backupBar.classList.remove('progress-bar-indeterminate')
        backupBar.style.width = `${Math.max(0, Math.min(100, Math.floor(percent)))}%`
      }
      const megabytesLabel = (bytes) => (Number(bytes || 0) / 1048576).toFixed(1).replace('.', ',')
      const numberLabel = (value) => Number(value || 0).toLocaleString('id-ID')
      const stopwatch = () => {
        const startedAt = Date.now()
        return () => {
          const seconds = Math.floor((Date.now() - startedAt) / 1000)
          return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`
        }
      }
      // "120 dari 450 file" in a job message -> { done, total, percent }
      const countedFiles = (job) => {
        // the server message carries the size handled so far: "12,3 dari 45,6 MB (120 dari 450 file)"; the percent is of that size
        const match = String(job?.message || '').match(/([\d.,]+) dari ([\d.,]+) MB/)
        if (!match) return null
        const files = String(job?.message || '').match(/(\d+) dari (\d+) file/)
        return { done: match[1], total: match[2], filesDone: files ? files[1] : '', filesTotal: files ? files[2] : '', percent: Math.max(0, Math.min(100, Math.floor(Number(job?.progress) || 0))) }
      }

      window.setTimeout(loadBackupStamps, 0)

      const downloadBlob = (blob, filename) => {
        const url = URL.createObjectURL(blob)
        const link = document.createElement('a')
        link.href = url
        link.download = filename
        document.body.appendChild(link)
        link.click()
        link.remove()
        URL.revokeObjectURL(url)
      }

      const readFileAsDataUrl = (file) => new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.onload = () => resolve(reader.result)
        reader.onerror = () => reject(reader.error || new Error('File backup gagal dibaca.'))
        reader.readAsDataURL(file)
      })

      const systemJobHeaders = (extra = {}) => ({
        'x-koi-role': window.KoiAuth.getSession()?.role || '',
        'x-koi-user': window.KoiAuth.getSession()?.username || '',
        ...extra,
      })

      // Heavy work runs in the background (the server starts a worker process): start it, then follow its progress.
      // If the server could not start a worker, the page asks it to run the job inside one request instead.
      const runSystemJob = async (payload, onProgress) => {
        const response = await fetch(window.KoiAuth.apiUrl('/api/jobs'), {
          method: 'POST',
          headers: systemJobHeaders({ 'content-type': 'application/json' }),
          body: JSON.stringify(payload),
        })
        const started = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(started.detail || started.error || 'Pekerjaan gagal dimulai.')
        const begun = Date.now()
        let askedToRun = false
        while (true) {
          await new Promise((resolve) => window.setTimeout(resolve, 1000))
          const poll = await fetch(window.KoiAuth.apiUrl(`/api/jobs/${started.id}`), { headers: systemJobHeaders() })
          const job = await poll.json().catch(() => ({}))
          if (!poll.ok) throw new Error(job.detail || job.error || 'Status pekerjaan tidak terbaca.')
          if (onProgress) onProgress(job)
          if (job.status === 'completed') return job
          if (job.status === 'failed') throw new Error(job.message || 'Pekerjaan gagal.')
          if (job.status === 'queued' && !askedToRun && Date.now() - begun > 6000) {
            askedToRun = true
            fetch(window.KoiAuth.apiUrl(`/api/jobs/${started.id}/run`), { method: 'POST', headers: systemJobHeaders() }).catch(() => {})
          }
        }
      }

      const downloadSystemBackup = async (button, kind = 'system') => {
        const accounts = kind === 'accounts'
        const idleLabel = button.textContent
        button.disabled = true
        button.textContent = 'Membuat...'
        setBackupBusy(true)

        const elapsedLabel = stopwatch()
        // the status line says the stage, the packages counted so far and the percent of that stage
        let stageLabel = 'Tahap 1/3: menyiapkan data...'
        const renderBackupStatus = () => {
          showBackupMessage(`${accounts ? 'Backup akun sedang dibuat.' : 'Backup sistem sedang dibuat.'} ${stageLabel} (${elapsedLabel()})`, 'info')
        }
        renderBackupStatus()
        const elapsedTimer = window.setInterval(renderBackupStatus, 1000)

        try {
          const job = await runSystemJob({ type: accounts ? 'backup-accounts' : 'backup' }, (current) => {
            const counted = countedFiles(current)
            if (counted) {
              setBackupProgress(counted.percent)
              stageLabel = `Tahap 1/3: mengumpulkan ${accounts ? 'foto dan logo akun' : 'file media'} ${counted.done} dari ${counted.total} MB${counted.filesTotal ? `, ${counted.filesDone} dari ${counted.filesTotal} file` : ''} (${counted.percent}%)`
            } else if (current.progress >= 95) {
              setBackupProgress(null)
              stageLabel = 'Tahap 2/3: menyusun file ZIP...'
            } else {
              setBackupProgress(null)
              stageLabel = 'Tahap 1/3: menyiapkan data...'
            }
            renderBackupStatus()
          })
          setBackupProgress(0)
          const mediaCount = Number(job.result?.media_files || 0)
          const mediaSuffix = mediaCount ? `, isi ${mediaCount} file media` : ''
          stageLabel = `Tahap 3/3: mengunduh${mediaSuffix}...`
          renderBackupStatus()
          const response = await fetch(window.KoiAuth.apiUrl(`/api/jobs/${job.id}/file`), { headers: systemJobHeaders() })
          if (!response.ok) {
            const data = await response.json().catch(() => ({}))
            throw new Error(data.detail || data.error || 'Backup gagal diunduh.')
          }
          const totalBytes = Number(job.result?.size_bytes || response.headers.get('content-length') || 0)
          let blob
          if (response.body?.getReader) {
            const reader = response.body.getReader()
            const chunks = []
            let loaded = 0
            while (true) {
              const { done, value } = await reader.read()
              if (done) break
              chunks.push(value)
              loaded += value.length
              if (totalBytes > 0) {
                const percent = Math.min(100, Math.floor(100 * loaded / totalBytes))
                setBackupProgress(percent)
                stageLabel = `Tahap 3/3: mengunduh ${megabytesLabel(loaded)} dari ${megabytesLabel(totalBytes)} MB (${percent}%)${mediaSuffix}`
              } else {
                setBackupProgress(null)
                stageLabel = `Tahap 3/3: mengunduh ${megabytesLabel(loaded)} MB${mediaSuffix}`
              }
              renderBackupStatus()
            }
            blob = new Blob(chunks, { type: 'application/zip' })
          } else {
            blob = await response.blob()
          }
          setBackupProgress(100)
          downloadBlob(blob, job.result?.file || (accounts ? 'nishikigoi-backup-akun.zip' : 'nishikigoi-backup.zip'))
          showBackupMessage(`${accounts ? `Backup akun berhasil dibuat dan diunduh: ${numberLabel(job.result?.accounts)} akun, ${numberLabel(job.result?.settings)} setingan dan tema (${megabytesLabel(blob.size)} MB).` : `Backup lengkap berhasil dibuat dan diunduh (${megabytesLabel(blob.size)} MB).`} (${elapsedLabel()})`, 'success')
        } catch (error) {
          showBackupMessage(error.message || 'Backup gagal dibuat.', 'danger')
        } finally {
          window.clearInterval(elapsedTimer)
          button.disabled = false
          button.textContent = idleLabel
          setBackupBusy(false)
        }
      }

      const detectBackupKind = async (file) => {
        // a ZIP lists its file names at the end of the file: look there for the marker file of each kind
        try {
          const tail = await file.slice(Math.max(0, file.size - 8 * 1024 * 1024)).arrayBuffer()
          const text = new TextDecoder('latin1').decode(tail)
          if (text.includes('nishikigoi-account-backup.json')) return 'accounts'
          if (text.includes('nishikigoi-backup.json')) return 'system'
        } catch (error) { /* unreadable: the server decides */ }
        return 'unknown'
      }

      const restoreSystemBackup = async (file) => {
        if (!file) return
        const kind = await detectBackupKind(file)
        if (kind === 'unknown') {
          showBackupMessage('File ini bukan backup Nishikigoi (berkas penanda tidak ada di dalam ZIP).', 'danger')
          restoreInput.value = ''
          return
        }
        const accounts = kind === 'accounts'
        const confirmed = await window.KoiDialog.confirm(accounts
          ? { title: 'Restore AKUN dan setingan?', message: 'Ini backup akun. Restore akan mengganti SEMUA akun yang terdaftar, setingan program, dan tema dengan isi backup ini. Data ikan dan media tidak berubah. Anda mungkin perlu masuk ulang setelahnya.', confirmText: 'Ya, restore akun', danger: true }
          : { title: 'Restore data sistem?', message: 'Restore akan mengganti data ikan, kolam, breeding, laporan, gallery, metadata media, dan file gambar/media saat ini. Akun, setingan program, dan tema TIDAK ikut berubah. Lanjutkan?', confirmText: 'Ya, restore', danger: true })
        if (!confirmed) {
          restoreInput.value = ''
          return
        }
        setBackupBusy(true)

        const elapsedLabel = stopwatch()
        let stageLabel = 'Tahap 1/3: mengunggah file backup...'
        const renderRestoreStatus = () => {
          showBackupMessage(`${accounts ? 'Restore akun sedang berjalan.' : 'Restore backup sedang berjalan.'} ${stageLabel} (${elapsedLabel()})`, 'info')
        }
        renderRestoreStatus()
        const elapsedTimer = window.setInterval(renderRestoreStatus, 1000)

        // the file itself is sent as the request body (no base64, nothing is held in memory); XMLHttpRequest reports how much went up
        const uploadBackupFile = (backupFile) => new Promise((resolve, reject) => {
          const request = new XMLHttpRequest()
          request.open('POST', window.KoiAuth.apiUrl('/api/jobs/upload'))
          Object.entries(systemJobHeaders({ 'content-type': 'application/zip' })).forEach(([name, value]) => request.setRequestHeader(name, value))
          // fetch() gets the session id from auth.js on its own; a XMLHttpRequest has to send it itself
          request.setRequestHeader('x-koi-session', window.KoiAuth.getSession()?.sessionId || '')
          request.upload.onprogress = (event) => {
            if (!event.lengthComputable) return
            const percent = Math.min(100, Math.floor(100 * event.loaded / event.total))
            setBackupProgress(percent)
            stageLabel = `Tahap 1/3: mengunggah file backup ${megabytesLabel(event.loaded)} dari ${megabytesLabel(event.total)} MB (${percent}%)`
            renderRestoreStatus()
          }
          request.onload = () => {
            let data = {}
            try { data = JSON.parse(request.responseText) } catch (error) { data = {} }
            if (request.status >= 200 && request.status < 300) resolve(data)
            else reject(new Error(data.detail || data.error || 'File backup gagal diunggah.'))
          }
          request.onerror = () => reject(new Error('File backup gagal diunggah.'))
          request.send(backupFile)
        })

        try {
          const uploaded = await uploadBackupFile(file)
          setBackupProgress(null)
          stageLabel = 'Tahap 2/3: memulihkan data tabel...'
          renderRestoreStatus()
          const job = await runSystemJob({ type: accounts ? 'restore-accounts' : 'restore', upload: uploaded.upload }, (current) => {
            const counted = countedFiles(current)
            if (counted) {
              setBackupProgress(counted.percent)
              stageLabel = `Tahap 3/3: memulihkan ${accounts ? 'foto dan logo akun' : 'file media'} ${counted.done} dari ${counted.total} MB${counted.filesTotal ? `, ${counted.filesDone} dari ${counted.filesTotal} file` : ''} (${counted.percent}%)`
            } else {
              setBackupProgress(null)
              stageLabel = 'Tahap 2/3: memulihkan data tabel...'
            }
            renderRestoreStatus()
          })
          setBackupProgress(100)
          const restoredFiles = Number(job.result?.restored_files || 0)
          showBackupMessage((accounts ? `Restore akun selesai: ${numberLabel(job.result?.restored_accounts)} akun, ${numberLabel(job.result?.restored_settings)} setingan dan tema dipulihkan. Muat ulang halaman; bila diminta, masuk ulang. (${elapsedLabel()})` : `Restore selesai. ${restoredFiles} file gambar/media dipulihkan. Refresh halaman/menu untuk memuat data terbaru. (${elapsedLabel()})`), 'success')
        } catch (error) {
          showBackupMessage(error.message || 'Restore gagal dijalankan.', 'danger')
        } finally {
          window.clearInterval(elapsedTimer)
          restoreInput.value = ''
          setBackupBusy(false)
        }
      }

      const cleanupUnusedFiles = async (button) => {
        const post = async (payload) => {
          const job = await runSystemJob({ type: 'cleanup', ...payload }, (current) => {
            const match = String(current.message || '').match(/(\d+) dari (\d+) file/)
            if (match) showBackupMessage(`${payload.dry_run ? 'Memeriksa' : 'Membersihkan'} file... (${match[1]}/${match[2]})`, 'info')
          })
          return job.result || {}
        }
        const megabytes = (bytes) => (Number(bytes || 0) / 1048576).toFixed(1).replace('.', ',')
        button.disabled = true
        setBackupBusy(true)
        showBackupMessage('Memeriksa file yang tidak terpakai...', 'info')
        try {
          const check = await post({ dry_run: true })
          if (!check.unused) {
            showBackupMessage(`Tidak ada file yang tidak terpakai. Semua ${check.total_files} file dipakai oleh data.`, 'success')
            return
          }
          const list = (check.samples || []).map((name) => `- ${name}`).join('\n')
          const more = check.unused > (check.samples || []).length ? `\n... dan ${check.unused - check.samples.length} file lainnya` : ''
          const ok = (await window.KoiDialog.confirm(`Ditemukan ${check.unused} file (${megabytes(check.unused_bytes)} MB) yang TIDAK dipakai oleh data apa pun: bukan foto utama, riwayat/progress foto ikan, dokumentasi kolam, laporan, galeri, draft, maupun ikon.\n\nContoh:\n${list}${more}\n\nHapus file-file ini dari server? Foto yang masih dipakai tidak disentuh.`))
          if (!ok) {
            showBackupMessage(`Dibatalkan. ${check.unused} file tidak terpakai (${megabytes(check.unused_bytes)} MB) tidak dihapus.`, 'warning')
            return
          }
          showBackupMessage('Menghapus file yang tidak terpakai...', 'info')
          const result = await post({})
          showBackupMessage(`Selesai. ${result.removed} file tidak terpakai (${megabytes(check.unused_bytes)} MB) dihapus. ${result.referenced} foto/media yang dipakai data tetap aman.`, 'success')
        } catch (error) {
