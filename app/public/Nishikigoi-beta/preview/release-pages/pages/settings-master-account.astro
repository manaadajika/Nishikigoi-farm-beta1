      const loginHistoryChecked = () => [...document.querySelectorAll('[data-login-check]:checked')].map((box) => box.value)

      const updateLoginSelection = () => {
        const ids = loginHistoryChecked()
        const boxes = document.querySelectorAll('[data-login-check]')
        const deleteButton = document.querySelector('[data-login-delete-selected]')
        const all = document.querySelector('[data-login-check-all]')
        if (deleteButton) {
          deleteButton.disabled = ids.length === 0
          deleteButton.textContent = ids.length ? 'Hapus Terpilih (' + ids.length + ')' : 'Hapus Terpilih'
        }
        if (all) {
          all.checked = boxes.length > 0 && ids.length === boxes.length
          all.indeterminate = ids.length > 0 && ids.length < boxes.length
        }
      }

      const removeLoginHistory = async (ids) => {
        const path = ids ? '/api/login-history?ids=' + ids.join(',') : '/api/login-history?all=1'
        const response = await fetch(window.KoiAuth.apiUrl(path), { method: 'DELETE' })
        if (!response.ok) throw new Error('Riwayat login gagal dihapus.')
        await loadLoginHistory()
