      const roleBadge = (role) => role === 'Master Admin' ? 'purple' : role === 'Admin' ? 'blue' : role === 'Operator' ? 'teal' : 'secondary'
      const statusBadge = (status) => status === 'Active' ? 'green' : 'secondary'
      const initials = (account) => String(account.name || account.username || 'User').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part.charAt(0).toUpperCase()).join('') || 'U'
