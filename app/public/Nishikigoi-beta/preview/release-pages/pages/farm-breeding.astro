  <script is:inline>
  ;(function () {
    var current = null
    var sides = ['top', 'bottom', 'left', 'right']
    function place(menu, toggle) {
      if (window.innerWidth > 991.98) return
      var r = toggle.getBoundingClientRect()
      var mh = menu.offsetHeight
      menu.style.setProperty('left', 'auto', 'important')
      menu.style.setProperty('right', Math.max(8, window.innerWidth - r.right) + 'px', 'important')
      if (r.bottom + 4 + mh > window.innerHeight - 8) {
        menu.style.setProperty('top', 'auto', 'important')
        menu.style.setProperty('bottom', window.innerHeight - r.top + 4 + 'px', 'important')
      } else {
        menu.style.setProperty('bottom', 'auto', 'important')
        menu.style.setProperty('top', r.bottom + 4 + 'px', 'important')
      }
    }
    document.addEventListener('shown.bs.dropdown', function (event) {
      var dropdown = event.target.closest && event.target.closest('.breeding-actions-dropdown')
      if (!dropdown) return
      var menu = dropdown.querySelector('.dropdown-menu')
      current = { menu: menu, toggle: event.target }
      // Popper applies its own inset after this event; place on the next frames so ours wins.
      requestAnimationFrame(function () {
        place(menu, event.target)
        requestAnimationFrame(function () { place(menu, event.target) })
      })
    })
    document.addEventListener('hidden.bs.dropdown', function (event) {
      var dropdown = event.target.closest && event.target.closest('.breeding-actions-dropdown')
      if (!dropdown) return
      var menu = dropdown.querySelector('.dropdown-menu')
      sides.forEach(function (side) { menu.style.removeProperty(side) })
      current = null
    })
    function reposition() {
      if (!current) return
      requestAnimationFrame(function () {
        if (current) place(current.menu, current.toggle)
      })
    }
    window.addEventListener('scroll', reposition, true)
    window.addEventListener('resize', reposition)
  })()
</script>

