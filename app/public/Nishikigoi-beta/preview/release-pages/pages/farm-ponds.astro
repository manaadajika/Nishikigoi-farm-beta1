---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import icons from '@data/icons.json'

const iconSvg = (name: string) => {
  const icon = (icons as unknown as Record<string, { svg: Record<string, string> }>)[name]
  let svg = icon?.svg?.outline ?? ''

  svg = svg.replace(/<path stroke="none" d="M0 0h24v24H0z" fill="none"\s*\/>/, '')
  svg = svg.replace(/class="[^"]+"/, 'aria-hidden="true" focusable="false" class="icon"')

  return svg
}

const uploadIcon = iconSvg('upload')
const clipboardIcon = iconSvg('clipboard')
---

<DefaultLayout title="Kolam" pageHeader="Data Kolam" pretitle="Management" pageMenu="farm-ponds">
  <style is:global>
    .pond-fish-preview {
      width: 48px;
      aspect-ratio: 2 / 3;
      border-radius: 6px;
      background: var(--tblr-bg-surface-secondary);
      border: 1px solid var(--tblr-border-color);
      overflow: hidden;
    }

    .pond-fish-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pond-fish-preview-placeholder {
      width: 100%;
      height: 100%;
      color: var(--tblr-secondary);
      font-size: .75rem;
      font-weight: 600;
    }

    .pond-documentation-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }

    .pond-documentation-item {
      position: relative;
      border-radius: 6px;
      border: 1px solid var(--tblr-border-color);
      overflow: hidden;
      background: var(--tblr-bg-surface-secondary);
    }

    .pond-documentation-preview {
      display: block;
      width: 100%;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      background: var(--tblr-bg-surface-secondary);
    }

    .pond-documentation-item img,
    .pond-documentation-item video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pond-documentation-notes {
      padding: .5rem;
      background: var(--tblr-bg-surface);
    }

    .pond-documentation-delete {
      position: absolute;
      top: .35rem;
      right: .35rem;
      z-index: 1;
    }

    [data-pond-documentation-status] {
      min-width: 48px;
      white-space: nowrap;
    }

    .pond-print-title {
      display: none;
    }

    .pond-detail-print-title {
      display: none;
    }

    @media print {
      body.printing-pond-list *,
      body.printing-pond-detail * {
        opacity: 1 !important;
        filter: none !important;
        text-shadow: none !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      body:not(.koi-printing) html,
      body:not(.koi-printing),
      body:not(.koi-printing) .page,
      body:not(.koi-printing) .page-wrapper,
      body:not(.koi-printing) .page-body,
      body:not(.koi-printing) .container-xl,
      body:not(.koi-printing) .modal,
      body:not(.koi-printing) .modal-content,
      body:not(.koi-printing) .modal-body,
      body:not(.koi-printing) .card,
      body:not(.koi-printing) .card-body,
      body:not(.koi-printing) .table-responsive {
        background: #ffffff !important;
        background-color: #ffffff !important;
      }

      body:not(.koi-printing) .navbar,
      body:not(.koi-printing) .page-header,
      body:not(.koi-printing):not(.printing-pond-detail) .card-actions,
      body:not(.koi-printing) [data-pond-import-export-message],
      body:not(.koi-printing) .dropdown-menu,
      body:not(.koi-printing) .btn {
        display: none !important;
      }

      body:not(.koi-printing):not(.printing-pond-detail) .modal {
        display: none !important;
      }

      body.printing-pond-detail .page-body > .container-xl > .row,
      body.printing-pond-detail .modal-header,
      body.printing-pond-detail .modal-footer,
      body.printing-pond-detail [data-pond-detail-form],
      body.printing-pond-detail [data-pond-note-history] {
        display: none !important;
      }

      body.printing-pond-detail #pond-detail-modal {
        display: block !important;
        position: static !important;
        opacity: 1 !important;
      }

      body.printing-pond-detail #pond-detail-modal .modal-dialog,
      body.printing-pond-detail #pond-detail-modal .modal-content,
      body.printing-pond-detail #pond-detail-modal .modal-body {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: 0 !important;
      }

      body:not(.koi-printing) .page,
      body:not(.koi-printing) .page-wrapper,
      body:not(.koi-printing) .page-body,
      body:not(.koi-printing) .container-xl,
      body:not(.koi-printing) .card,
      body:not(.koi-printing) .table-responsive {
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: 0 !important;
        overflow: visible !important;
      }

      body:not(.koi-printing) .card-header {
        border: 0 !important;
        padding: 0 0 12px !important;
      }

      body:not(.koi-printing) .card-header .card-title {
        display: none !important;
      }

      .pond-print-title {
        display: block !important;
        margin: 0 0 12px !important;
        color: #000000 !important;
        font-size: 19px !important;
        font-weight: 800 !important;
      }

      body.printing-pond-detail .pond-detail-print-title {
        display: block !important;
        margin: 0 0 12px !important;
        color: #000000 !important;
        font-size: 19px !important;
        font-weight: 800 !important;
      }

      body:not(.koi-printing) .card-title {
        font-size: 19px !important;
        font-weight: 800 !important;
      }

      body:not(.koi-printing) .table {
        width: 100% !important;
        font-size: 13px !important;
        background: #ffffff !important;
        border-collapse: collapse !important;
        color: #000000 !important;
        border-color: #94a3b8 !important;
      }

      body:not(.koi-printing) .table th,
      body:not(.koi-printing) .table td {
        background: #ffffff !important;
        background-color: #ffffff !important;
        color: #000000 !important;
        font-weight: 600 !important;
        padding: 7px 8px !important;
        border-color: #94a3b8 !important;
        border-width: 1px !important;
        opacity: 1 !important;
      }

      body:not(.koi-printing),
      body:not(.koi-printing) .modal,
      body:not(.koi-printing) .modal-content,
      body:not(.koi-printing) .modal-body,
      body:not(.koi-printing) .card,
      body:not(.koi-printing) .table,
      body:not(.koi-printing) .text-secondary {
        color: #000000 !important;
        opacity: 1 !important;
        text-shadow: none !important;
      }

      body:not(.koi-printing) .text-secondary,
      body:not(.koi-printing) [data-pond-detail-summary] .text-secondary {
        color: #111827 !important;
        font-weight: 700 !important;
      }

      body:not(.koi-printing) [data-pond-detail-summary] > div > div,
      body:not(.koi-printing) [data-pond-detail-summary] > div > span + div {
        color: #000000 !important;
        font-weight: 700 !important;
      }

      body.printing-pond-detail [data-pond-detail-summary] {
        margin-bottom: 14px !important;
        color: #000000 !important;
        font-size: 12px !important;
      }

      body.printing-pond-detail [data-pond-detail-summary] .text-secondary {
        color: #111827 !important;
        font-size: 10px !important;
        font-weight: 800 !important;
        text-transform: uppercase !important;
      }

      body:not(.koi-printing) .table {
        color: #000000 !important;
        border-color: #94a3b8 !important;
      }

      body:not(.koi-printing) .table th,
      body:not(.koi-printing) .table td {
        color: #000000 !important;
        border-color: #94a3b8 !important;
        opacity: 1 !important;
      }

      body:not(.koi-printing) .table th {
        background: #e5e7eb !important;
        color: #000000 !important;
        font-weight: 800 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      body:not(.koi-printing) .pond-fish-preview {
        background: transparent !important;
        border: 0 !important;
        border-radius: 3px !important;
        overflow: hidden !important;
      }

      body:not(.koi-printing) .pond-fish-preview img {
        background: transparent !important;
        border-radius: 3px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      body:not(.koi-printing) .pond-fish-preview-placeholder {
        background: transparent !important;
        color: #111827 !important;
      }

      body:not(.koi-printing) .badge {
        background: transparent !important;
        color: #000000 !important;
        padding: 0 !important;
      }

      body:not(.koi-printing) .table-active,
      body:not(.koi-printing) .table-active > * {
        background-color: #dbe4ef !important;
        background: #dbe4ef !important;
        color: #000000 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      body:not(.koi-printing) tr.table-active td,
      body:not(.koi-printing) tr.table-active th {
        background-color: #dbe4ef !important;
        background-image: none !important;
        color: #000000 !important;
      }

      body:not(.koi-printing) :root[data-bs-theme="dark"] .table-active,
      body:not(.koi-printing) :root[data-bs-theme="dark"] .table-active > *,
      :root[data-bs-theme="dark"] body:not(.koi-printing) .table-active,
      :root[data-bs-theme="dark"] body:not(.koi-printing) .table-active > * {
        background-color: #dbe4ef !important;
        background: #dbe4ef !important;
        color: #000000 !important;
      }

      body:not(.koi-printing) :root[data-bs-theme="dark"] tr.table-active td,
      body:not(.koi-printing) :root[data-bs-theme="dark"] tr.table-active th,
      :root[data-bs-theme="dark"] body:not(.koi-printing) tr.table-active td,
      :root[data-bs-theme="dark"] body:not(.koi-printing) tr.table-active th {
        background-color: #dbe4ef !important;
        background-image: none !important;
        color: #000000 !important;
      }

      [data-print-hidden] {
        display: none !important;
      }
    }
    @media print {
      body.printing-pond-list,
      body.printing-pond-detail {
        background: #ffffff !important;
        color: #000000 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      body.printing-pond-list .navbar,
      body.printing-pond-list .page-header,
      body.printing-pond-list .modal,
      body.printing-pond-list .btn,
      body.printing-pond-list .dropdown-menu,
      body.printing-pond-list [data-pond-import-export-message] {
        display: none !important;
      }

      body.printing-pond-list .page,
      body.printing-pond-list .page-wrapper,
      body.printing-pond-list .page-body,
      body.printing-pond-list .container-xl,
      body.printing-pond-list .card,
      body.printing-pond-list .card-body,
      body.printing-pond-list .table-responsive {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        box-shadow: none !important;
        background: #ffffff !important;
        color: #000000 !important;
        overflow: visible !important;
      }

      body.printing-pond-list .pond-print-title {
        display: block !important;
        margin: 0 0 14px !important;
        color: #000000 !important;
        font-size: 18px !important;
        font-weight: 800 !important;
      }

      body.printing-pond-list [data-ponds-table] {
        width: 100% !important;
        border-collapse: collapse !important;
        color: #000000 !important;
        background: #ffffff !important;
      }

      body.printing-pond-list [data-ponds-table] th,
      body.printing-pond-list [data-ponds-table] td {
        border: 1px solid #1f2937 !important;
        background: #ffffff !important;
        color: #000000 !important;
        padding: 5px 6px !important;
        font-size: 9pt !important;
        line-height: 1.25 !important;
        font-weight: 600 !important;
        opacity: 1 !important;
        text-shadow: none !important;
      }

      body.printing-pond-list [data-ponds-table] th {
        background: #e5e7eb !important;
        font-weight: 800 !important;
      }

      body.printing-pond-list [data-ponds-table] tr.table-active {
        break-before: page;
        page-break-before: always;
      }

      body.printing-pond-list [data-ponds-table] tbody tr {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      body.printing-pond-list [data-ponds-table] tbody tr.table-active:first-child {
        break-before: auto;
        page-break-before: auto;
      }

      body.printing-pond-list [data-ponds-table] tr.table-active > * {
        background: #e5e7eb !important;
        color: #000000 !important;
        font-weight: 800 !important;
      }

      body.printing-pond-detail,
      body.printing-pond-detail .modal,
      body.printing-pond-detail .modal-dialog,
      body.printing-pond-detail .modal-content,
      body.printing-pond-detail .modal-body,
      body.printing-pond-detail [data-pond-detail-summary],
      body.printing-pond-detail .table-responsive,
      body.printing-pond-detail .table {
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        color: #000000 !important;
        opacity: 1 !important;
        filter: none !important;
      }

      body.printing-pond-detail #pond-detail-modal *,
      body.printing-pond-detail #pond-detail-modal .text-secondary,
      body.printing-pond-detail #pond-detail-modal .table th,
      body.printing-pond-detail #pond-detail-modal .table td {
        color: #000000 !important;
        opacity: 1 !important;
        filter: none !important;
        text-shadow: none !important;
      }

      body.printing-pond-detail #pond-detail-modal .table th {
        background: #e5e7eb !important;
        background-color: #e5e7eb !important;
        font-weight: 800 !important;
      }

      body.printing-pond-detail #pond-detail-modal .table td {
        background: #ffffff !important;
        background-color: #ffffff !important;
      }

      body.printing-pond-detail #pond-detail-modal .badge {
        background: transparent !important;
        color: #000000 !important;
      }
    }
  </style>

  <div class="modal modal-blur fade" id="pond-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <form class="modal-content" data-pond-form>
        <div class="modal-header">
          <h5 class="modal-title" data-pond-form-title>Formulir Tambah Kolam</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" for="pond-name">Nama Kolam</label>
              <input class="form-control" id="pond-name" name="name" placeholder="Kolam A1" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" for="pond-location">Area</label>
              <select class="form-select" id="pond-location" name="location"><option value="">(Tanpa area)</option></select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="pond-status">Status</label>
              <select class="form-select" id="pond-status" name="status">
                <option value="kosong">Kosong</option>
                <option value="active">Aktif</option>
                <option value="perbaikan">Perbaikan</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="pond-notes">Catatan</label>
              <textarea class="form-control" id="pond-notes" name="notes" rows="3" placeholder="Catatan kondisi kolam"></textarea>
            </div>
          </div>
          <div class="mt-3 text-secondary" data-form-message></div>
        </div>
        <div class="modal-footer">
          <button class="btn" type="button" data-bs-dismiss="modal">Batal</button>
          <button class="btn btn-primary" type="submit" data-pond-submit>Simpan Kolam</button>
        </div>
      </form>
    </div>
  </div>

  <div class="modal modal-blur fade" id="pond-detail-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" data-pond-detail-title>Formulir Kolam</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-3" data-pond-detail-summary></div>
          <form class="card mb-3" data-pond-detail-form>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-4">
                  <label class="form-label" for="pond-detail-unphotographed">Qty Belum Difoto</label>
                  <input class="form-control" id="pond-detail-unphotographed" name="unphotographed_fish_qty" type="number" min="0" step="1" />
                  <div class="row g-3 mt-0">
                    <div class="col-sm-6">
                      <label class="form-label">Dokumentasi</label>
                      <input class="d-none" id="pond-documentation-input" type="file" accept="image/*,video/mp4,video/webm" multiple data-pond-documentation-input />
                      <div class="d-flex align-items-center gap-2">
                        <label class="btn btn-icon mb-0" for="pond-documentation-input" data-upload-pond-documentation data-role-required="farm-operate" aria-label="Upload media" title="Upload media"><Fragment set:html={uploadIcon} /></label>
                        <button class="btn btn-icon mb-0" type="button" data-paste-pond-documentation data-role-required="database-write" aria-label="Paste gambar dokumentasi" title="Paste gambar dokumentasi"><Fragment set:html={clipboardIcon} /></button>
                        <div class="form-hint mb-0" data-pond-documentation-status></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-8">
                  <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <label class="form-label mb-0" for="pond-detail-notes">Catatan Formulir</label>
                    <div data-pond-notes-date style="display:flex;flex-wrap:wrap;gap:.35rem;width:100%">
                      <input class="form-control form-control-sm" style="flex:1 1 11rem;min-width:0" type="number" min="1" max="31" inputmode="numeric" placeholder="Tanggal" data-notes-day data-no-clear aria-label="Tanggal catatan" />
                      <div style="position:relative;flex:1 1 11rem;min-width:0">
                        <input class="form-control form-control-sm" type="text" autocomplete="off" placeholder="Bulan (ketik 1 atau Des)" data-notes-month data-no-clear aria-label="Bulan catatan" />
                        <div class="list-group" data-notes-month-list hidden style="position:absolute;left:0;right:0;top:calc(100% + 2px);z-index:1060;max-height:13rem;overflow:auto;background:var(--tblr-bg-surface);border:1px solid var(--tblr-border-color);border-radius:6px;box-shadow:var(--tblr-shadow-dropdown)"></div>
                      </div>
                      <div class="input-group" style="flex:1 1 11rem;min-width:0;position:relative"><input class="form-control form-control-sm" type="number" min="1900" max="2100" inputmode="numeric" placeholder="Tahun" data-notes-year data-no-clear aria-label="Tahun catatan" /><button class="btn btn-sm btn-icon" type="button" data-notes-date-button aria-label="Pilih tanggal dari kalender" title="Pilih tanggal dari kalender"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon"><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12" /><path d="M16 3v4" /><path d="M8 3v4" /><path d="M4 11h16" /><path d="M11 15h1" /><path d="M12 15v3" /></svg></button><button class="btn btn-sm btn-icon" type="button" data-notes-date-clear aria-label="Hapus tanggal" title="Hapus tanggal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon"><path d="M18 6l-12 12" /><path d="M6 6l12 12" /></svg></button><input type="date" tabindex="-1" aria-hidden="true" data-notes-date-picker style="position:absolute;right:0;bottom:0;width:1px;height:1px;opacity:0;pointer-events:none;border:0;padding:0" /></div>
                    </div>
                  </div>
                  <textarea class="form-control" id="pond-detail-notes" data-role-disable-unless="farm-operate" name="notes" rows="3"></textarea>
                  <div class="d-flex justify-content-end mt-2">
                    <button class="btn" type="button" data-save-pond-notes data-role-required="farm-operate">Simpan Catatan</button>
                  </div>
                </div>
                <div class="col-12">
                  <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-2" data-pond-documentation-move-bar hidden>
                    <select class="form-select w-auto" data-doc-move-target data-role-required="farm-operate" aria-label="Kolam tujuan dokumentasi">
                      <option value="">Pindah ke kolam...</option>
                    </select>
                    <button class="btn btn-primary" style="min-width: 7.5rem" type="button" data-doc-move-button data-role-required="farm-operate" disabled>Pindahkan</button>
                    <button class="btn" style="min-width: 10.5rem" type="button" data-doc-gallery-button data-role-required="database-write" disabled>Simpan ke Galeri</button>
                  </div>
                  <div class="pond-documentation-grid" data-pond-documentation-list>
                    <div class="text-secondary">Belum ada dokumentasi.</div>
                  </div>
                </div>
              </div>
              <div class="d-flex align-items-center justify-content-between mt-3">
                <div class="text-secondary" data-pond-detail-message></div>
                <div class="d-flex align-items-end gap-2">
                  <button class="btn" type="button" data-print-pond-detail>Cetak</button>
                  <div>
                    <label class="form-label" for="pond-detail-status">Status</label>
                    <select class="form-select" id="pond-detail-status" name="status">
                      <option value="kosong">Kosong</option>
                      <option value="active">Aktif</option>
                      <option value="perbaikan">Perbaikan</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </form>
          <h1 class="pond-detail-print-title">SUMMARY IKAN &amp; LOKASI KOLAM</h1>
          <div class="table-responsive mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-2">
              <select class="form-select w-auto" data-fish-move-target data-role-required="database-write" aria-label="Kolam tujuan">
