            padding: 0 !important;
          }
        }
      </style>
    `

    const waitForPrintImages = (printWindow, timeout = 8000) => {
      const images = Array.from(printWindow.document.images || [])

      if (!images.length) return Promise.resolve()

      return Promise.race([
        Promise.all(images.map((image) => {
          if (image.complete && image.naturalWidth > 0) return Promise.resolve()

          return new Promise((resolve) => {
            let settled = false
            const done = () => {
              if (settled) return
              settled = true
              resolve()
            }

            image.onload = done
            image.onerror = done

            if (typeof image.decode === 'function') {
              image.decode().then(done).catch(() => {})
            }
          })
        })),
        new Promise((resolve) => setTimeout(resolve, timeout)),
      ])
    }

    // DEAD CODE (diperiksa 2026-10-14): openPrintDocument tidak dipanggil di mana pun. Aman dihapus; sengaja belum dihapus.
    const openPrintDocument = (title, bodyHtml) => {
      const printWindow = window.open('', '_blank')

      if (!printWindow) {
        alert('Jendela cetak gagal dibuka. Izinkan pop-up untuk mencetak.')
        return
      }

      const safeTitle = escapeHtml(title || 'Cetak Nishikigoi')
      printWindow.document.open()
      printWindow.document.write(`<!doctype html>
        <html>
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <base href="${escapeHtml(window.location.origin)}/">
            <title>${safeTitle}</title>
            ${printStyles()}
          </head>
          <body>${bodyHtml}</body>
        </html>`)
      printWindow.document.close()
      printWindow.focus()
      waitForPrintImages(printWindow).then(() => {
        setTimeout(() => printWindow.print(), 150)
      })
    }
    const printPondList = () => {
      const ponds = sortedPonds()
      if (!ponds.length) {
        alert('Belum ada data kolam untuk dicetak.')
        return
      }
      const kp = window.KoiPrint
      const e = kp.escapeHtml
      const groups = groupedPonds(ponds)
      const areas = orderedAreas(Array.from(groups.keys()))
      const totalFish = ponds.reduce((sum, pond) => sum + Number(totalPondQty(pond) || 0), 0)
      const body = areas.map((area) => {
        const items = groups.get(area) || []
        const areaFish = items.reduce((sum, pond) => sum + Number(totalPondQty(pond) || 0), 0)
        return `<section class="kp-section"><h2>${e(area)} <span class="kp-muted">(${items.length} kolam, ${areaFish} ikan)</span></h2>
          <table class="kp-table"><thead><tr><th class="kp-center" style="width:28px">No</th><th style="width:28%">Nama Kolam</th><th class="kp-num" style="width:12%">Qty Total</th><th>Catatan</th></tr></thead>
          <tbody>${items.map((pond, index) => `<tr><td class="kp-center">${index + 1}</td><td><strong>${e(pond.name || '-')}</strong></td><td class="kp-num">${totalPondQty(pond)}</td><td>${e(pond.notes || '-')}</td></tr>`).join('')}</tbody></table></section>`
      }).join('')
      kp.print({
        key: 'ponds-list',
        title: 'Daftar Kolam',
        heading: 'Daftar Kolam',
        info: [['Jumlah kolam', ponds.length], ['Jumlah area', areas.length], ['Total ikan', totalFish]],
        body,
      })
    }

    const printPondDetail = () => {
      const pond = pondsData.find((item) => String(item.id) === String(selectedPondId))
      if (!pond) {
        alert('Pilih kolam terlebih dahulu.')
        return
      }
      const kp = window.KoiPrint
      const e = kp.escapeHtml
      const fish = parseFish(pond.fish)
      const rows = fish.map((item, index) => `<tr>
          <td class="kp-center">${index + 1}</td>
          <td>${kp.photo(printAssetUrl(item.image_url || item.photo_url || item.imageUrl || item.image || item.photo), item.code)}</td>
          <td><strong>${e(item.code || '-')}</strong></td>
          <td>${e(item.name || '-')}</td>
          <td>${e(item.variety || '-')}</td>
          <td>${e(item.bloodline || '-')}</td>
          <td>${e(item.farm_name || '-')}</td>
          <td class="kp-num">${item.current_length_cm ? `${kp.size(item.current_length_cm)} cm` : '-'}</td>
        </tr>`).join('') || '<tr><td colspan="8" class="kp-muted">Belum ada ikan tercatat di Data Ikan untuk kolam ini.</td></tr>'
      kp.print({
        key: 'ponds-detail',
        title: `Isi Kolam ${pond.name || ''}`,
        heading: 'Daftar Ikan dalam Kolam',
        subheading: pond.name || '',
        info: [['Nama Kolam', pond.name], ['Area', pond.location], ['Ikan terdata', fish.length], ['Belum difoto', Number(pond.unphotographed_fish_qty || 0)], ['Qty Total', totalPondQty(pond)]],
        notes: pond.notes || '',
        body: `<table class="kp-table"><thead><tr>
          <th class="kp-center" style="width:28px">No</th><th class="kp-center" style="width:48px">Foto</th><th style="width:13%">Kode</th><th>Nama</th>
          <th style="width:15%">Variety</th><th style="width:13%">Bloodline</th><th style="width:17%">Ternakan</th><th class="kp-num" style="width:10%">Ukuran</th>
        </tr></thead><tbody>${rows}</tbody></table>`,
      })
    }

    const orderedAreas = (areas) => {
      const areaSet = new Set(areas)
      const savedAreas = areaOrder.filter((area) => areaSet.has(area))
      const newAreas = areas.filter((area) => !savedAreas.includes(area)).sort((first, second) => first.localeCompare(second))
      return [...savedAreas, ...newAreas]
    }

    const saveAreaOrder = (areas) => {
      areaOrder = areas
      localStorage.setItem('pondAreaOrder', JSON.stringify(areaOrder))
      fetch(`${apiUrl}/app-settings`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ pond_area_order: JSON.stringify(areas) }),
      }).catch(() => {})
      renderAreaSettings()
      renderPonds()
    }

    const renderAreaSettings = () => {
      const areas = orderedAreas(knownAreas())

      areaOrderList.innerHTML = areas.map((area, index) => `
        <div class="list-group-item d-flex align-items-center justify-content-between gap-2">
          <div class="fw-medium">${escapeHtml(area)}</div>
          <div class="btn-list flex-nowrap">
            <button class="btn btn-sm btn-icon" type="button" data-move-area="up" data-area-name="${escapeHtml(area)}" ${index === 0 ? 'disabled' : ''} aria-label="Naik" title="Naik">↑</button>
            <button class="btn btn-sm btn-icon" type="button" data-move-area="down" data-area-name="${escapeHtml(area)}" ${index === areas.length - 1 ? 'disabled' : ''} aria-label="Turun" title="Turun">↓</button>
          </div>
        </div>
      `).join('') || '<div class="list-group-item text-secondary">Belum ada area.</div>'
    }

    const renderPonds = () => {
      dock.prune(pondsData)
      const ponds = dock.apply(sortedPonds())

      if (ponds.length === 0) {
        table.innerHTML = `<div class="col-12 text-secondary">${searchQuery ? 'Data kolam tidak ditemukan.' : 'Belum ada data kolam.'}</div>`
        dock.refresh()
        return
      }

      const groups = groupedPonds(ponds)
      table.innerHTML = orderedAreas(Array.from(groups.keys())).map((area) => {
        const items = groups.get(area) || []
        return `
        <div class="col-12"><div class="pond-area-heading${/^#[0-9a-f]{6}$/i.test(areaColors[area] || '') ? ' has-color' : ''}"${/^#[0-9a-f]{6}$/i.test(areaColors[area] || '') ? ` style="--area-color:${areaColors[area]}"` : ''}>${escapeHtml(area)}</div></div>
        ${items.map((item) => {
          const status = statusLabels[item.status] || { label: text(item.status), className: 'bg-secondary-lt' }
          return `
          <div class="col-sm-6 col-lg-4 col-xl-3" data-search-text="${escapeHtml(pondSearchText(item))}">
            <div class="card h-100 pond-card" data-dock-id="${escapeHtml(item.id)}">
              <div class="pond-card-stat" data-dock-select title="Klik untuk memilih">
                <div class="pond-card-qty">${totalPondQty(item)}</div>
                <div class="text-secondary small">Qty Total</div>
              </div>
              <div class="card-body" role="button" tabindex="0" data-pond-row="${escapeHtml(item.id)}">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                  <div class="fw-semibold pond-card-ellipsis" title="${escapeHtml(text(item.name))}">${escapeHtml(text(item.name))}</div>
                  <div class="d-flex align-items-center gap-1 flex-shrink-0">
                    <span class="badge bg-blue text-blue-fg dock-selected-badge">Terpilih</span>
                    <span class="badge ${status.className}">${escapeHtml(status.label)}</span>
                  </div>
                </div>
                <div class="row g-2 small">
                  <div class="col-6"><span class="text-secondary">Terfoto</span><div>${Number(item.koi_count || 0)}</div></div>
                  <div class="col-6"><span class="text-secondary">Belum Difoto</span><div>${Number(item.unphotographed_fish_qty || 0)}</div></div>
                  <div class="col-12"><span class="text-secondary">Catatan</span>${item.notes_date ? `<div style="font-size:.75rem;color:var(--tblr-secondary)">${escapeHtml(formatNotesDate(item.notes_date))}</div>` : ''}<div class="pond-card-notes">${escapeHtml(text(item.notes))}</div></div>
                </div>
                <div class="pond-card-actions">
                  <button class="btn btn-sm btn-icon btn-outline-primary" type="button" data-edit-pond="${escapeHtml(item.id)}" data-role-required="farm-operate" aria-label="Edit kolam" title="Edit kolam">${window.KoiDock.icon('edit')}</button>
                </div>
              </div>
            </div>
          </div>
        `
        }).join('')}
      `
      }).join('')
      dock.refresh()
    }

    const loadPonds = async (silent = false) => {
      if (!silent) {
        table.innerHTML = '<div class="col-12 text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat data kolam...</span></div></div>'
      }

      try {
        const response = await fetch(`${apiUrl}/ponds`)

        if (!response.ok) {
          throw new Error('API kolam belum siap')
        }

        const ponds = await response.json()
        try {
          const settingsResponse = await fetch(`${apiUrl}/app-settings`)
          if (settingsResponse.ok) {
            const settings = await settingsResponse.json()
            const serverOrder = typeof settings.pond_area_order === 'string' ? JSON.parse(settings.pond_area_order) : null
            try {
              const parsedColors = typeof settings.pond_area_colors === 'string' ? JSON.parse(settings.pond_area_colors) : null
              areaColors = parsedColors && typeof parsedColors === 'object' ? parsedColors : {}
            } catch { areaColors = {} }
            if (Array.isArray(serverOrder)) {
              areaOrder = serverOrder
              localStorage.setItem('pondAreaOrder', JSON.stringify(serverOrder))
            }
          }
        } catch {
          // keep the locally cached order when the server order cannot be read
        }
        const signature = JSON.stringify(ponds)
        const changeKey = `${signature}|${JSON.stringify(areaOrder)}|${JSON.stringify(areaColors)}`
        if (silent && changeKey === pondsRealtimeSignature) {
          return
        }
        pondsRealtimeSignature = changeKey
        localStorage.setItem(pondsCacheKey, signature)
        pondsData = ponds
        renderAreaSettings()
        renderPonds()
      } catch (error) {
        if (!silent) {
          table.innerHTML = '<div class="col-12 text-danger">Data kolam gagal dimuat. Pastikan API berjalan.</div>'
        }
      }
    }

    const restorePondsCache = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(pondsCacheKey) || '[]')
        if (!Array.isArray(cached) || cached.length === 0) return false
        pondsRealtimeSignature = JSON.stringify(cached)
        pondsData = cached
        renderAreaSettings()
        renderPonds()
        return true
      } catch {
        localStorage.removeItem(pondsCacheKey)
        return false
      }
    }

    const resetPondForm = () => {
      editingPondId = null
      form.reset()
      formTitle.textContent = 'Formulir Tambah Kolam'
      formSubmit.textContent = 'Simpan Kolam'
      message.textContent = ''
    }

    const openPondForm = (pondId) => {
      const pond = pondsData.find((item) => String(item.id) === String(pondId))

      if (!pond) {
        return
      }

      editingPondId = pond.id
      form.elements.name.value = pond.name || ''
      form.elements.location.value = pond.location || ''
      form.elements.status.value = pond.status || 'kosong'
      form.elements.notes.value = pond.notes || ''
      formTitle.textContent = 'Formulir Edit Kolam'
      formSubmit.textContent = 'Simpan Perubahan'
      message.textContent = ''
      openModal(modalElement)
    }

    areaSettingsButton.addEventListener('click', () => {
      renderAreaSettings()
      openModal(areaSettingsModalElement)
    })

    areaOrderList.addEventListener('click', (event) => {
      const button = event.target.closest('[data-move-area]')

      if (!button) {
        return
      }

      const areas = orderedAreas(knownAreas())
      const index = areas.indexOf(button.dataset.areaName)
      const targetIndex = button.dataset.moveArea === 'up' ? index - 1 : index + 1

      if (index < 0 || targetIndex < 0 || targetIndex >= areas.length) {
        return
      }

      const [area] = areas.splice(index, 1)
      areas.splice(targetIndex, 0, area)
      saveAreaOrder(areas)
    })

    resetAreaOrderButton.addEventListener('click', () => {
      saveAreaOrder([])
    })

    const showPondDetail = (pondId) => {
      const pond = pondsData.find((item) => String(item.id) === String(pondId))

      if (!pond) {
        return
      }

      selectedPondId = pond.id
      selectedFishIds.clear()
      selectedDocIds.clear()
      detailForm.elements.unphotographed_fish_qty.value = Number(pond.unphotographed_fish_qty || 0)
      detailForm.elements.status.value = pond.status || 'kosong'
      detailForm.elements.notes.value = pond.notes || ''
      setNotesDate(pond.notes_date, true)
      notesDateTouched = false
      detailMessage.textContent = ''
      renderPondDetailFish(pond)

      openModal(detailModalElement)
      loadNoteHistory(pond.id)
      loadDocumentation(pond.id)
    }

    // Title, summary and the fish table of the pond form. Also used after fish are moved, so the
    // notes/documentation the user is typing are left alone.
    const renderPondDetailFish = (pond) => {
      const fish = parseFish(pond.fish)
      detailTitle.textContent = `Formulir Kolam ${text(pond.name)}`
      detailSummary.innerHTML = `
        <div class="col-sm-6 col-lg-3"><span class="text-secondary">Nama Kolam</span><div>${text(pond.name)}</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-secondary">Area</span><div>${text(pond.location)}</div></div>
        <div class="col-sm-6 col-lg-3" data-print-hidden><span class="text-secondary">Status</span><div>${statusLabels[pond.status]?.label || text(pond.status)}</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-secondary">Qty Total</span><div>${totalPondQty(pond)}</div></div>
        <div class="col-sm-6 col-lg-3" data-print-hidden><span class="text-secondary">Terfoto / Belum Difoto</span><div>${Number(pond.koi_count || 0)} / ${Number(pond.unphotographed_fish_qty || 0)}</div></div>
      `
      detailFish.innerHTML = fish.map((item) => `
        <tr style="cursor: pointer">
          <td data-role-required="database-write"><input class="form-check-input" type="checkbox" data-fish-select="${item.id}" aria-label="Pilih ${text(item.code)}" ${selectedFishIds.has(String(item.id)) ? 'checked' : ''} /></td>
          <td>${fishPreview(item)}</td>
          <td>${text(item.code)}</td>
          <td>${text(item.name)}</td>
          <td>${text(item.variety)}</td>
          <td>${text(item.bloodline)}</td>
          <td>${text(item.farm_name)}</td>
          <td>${item.current_length_cm ? `${formatSizeCm(item.current_length_cm)} cm` : '-'}</td>
        </tr>
      `).join('') || '<tr><td colspan="8" class="text-secondary">Belum ada ikan tercatat di Data Ikan untuk kolam ini.</td></tr>'
      renderFishMoveBar(pond)
    }

    const renderFishMoveBar = (pond) => {
      const count = selectedFishIds.size
      const total = parseFish(pond.fish).length
      fishSelectAll.checked = total > 0 && count === total
      fishSelectAll.indeterminate = count > 0 && count < total
      detailFish.querySelectorAll('[data-fish-select]').forEach((box) => {
        box.closest('tr').classList.toggle('table-active', box.checked)
      })
      // The count lives inside the button, so nothing is added to the row and the layout never shifts.
      fishMoveButton.textContent = count ? `Pindahkan (${count})` : 'Pindahkan'
      fishMoveButton.disabled = !count || !fishMoveTarget.value

      const current = fishMoveTarget.value
      fishMoveTarget.innerHTML = pondTargetOptions(pond.id)
      fishMoveTarget.value = current && fishMoveTarget.querySelector(`option[value="${current}"]`) ? current : ''
      fishMoveButton.disabled = !count || !fishMoveTarget.value
    }

    const currentDetailPond = () => pondsData.find((item) => String(item.id) === String(selectedPondId))

    detailFish.addEventListener('change', (event) => {
      const box = event.target.closest('[data-fish-select]')
      const pond = currentDetailPond()
      if (!box || !pond) return
      if (box.checked) selectedFishIds.add(box.dataset.fishSelect)
      else selectedFishIds.delete(box.dataset.fishSelect)
      renderFishMoveBar(pond)
    })

    // Click the photo to zoom it; click anywhere else on the row to tick/untick that fish.
    detailFish.addEventListener('click', (event) => {
      if (event.target.closest('[data-fish-select]')) return
      const preview = event.target.closest('.pond-fish-preview')
      const photo = preview && preview.querySelector('img')
      if (photo) {
        {
          let info = null
          try { info = JSON.parse(decodeURIComponent(photo.dataset.zoomInfo || '')) } catch (error) {}
          window.KoiAuth.zoomPhoto(photo.src, info?.title || photo.alt, info?.lines || [])
        }
        return
      }
      const box = event.target.closest('tr')?.querySelector('[data-fish-select]')
      if (!box || box.offsetParent === null || String(window.getSelection())) return
      box.checked = !box.checked
      box.dispatchEvent(new Event('change', { bubbles: true }))
    })

    fishSelectAll.addEventListener('change', () => {
      const pond = currentDetailPond()
      if (!pond) return
      selectedFishIds.clear()
      if (fishSelectAll.checked) parseFish(pond.fish).forEach((item) => selectedFishIds.add(String(item.id)))
      detailFish.querySelectorAll('[data-fish-select]').forEach((box) => {
        box.checked = selectedFishIds.has(box.dataset.fishSelect)
      })
      renderFishMoveBar(pond)
    })

    fishMoveTarget.addEventListener('change', () => {
      fishMoveButton.disabled = !selectedFishIds.size || !fishMoveTarget.value
    })

    fishMoveButton.addEventListener('click', async () => {
      const pond = currentDetailPond()
      const target = pondsData.find((item) => String(item.id) === String(fishMoveTarget.value))
      const ids = Array.from(selectedFishIds)
      if (!pond || !target || !ids.length) return

      fishMoveButton.disabled = true
      detailMessage.textContent = `Memindahkan ${ids.length} ikan ke ${target.name}.`
      const failed = []
      for (let start = 0; start < ids.length; start += 5) {
        await Promise.all(ids.slice(start, start + 5).map(async (id) => {
          try {
            const response = await fetch(`${apiUrl}/koi/${id}`, {
              method: 'PATCH',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ pond_id: target.id }),
            })
            if (!response.ok) throw new Error('gagal')
          } catch {
            failed.push(id)
          }
        }))
      }

      selectedFishIds.clear()
      failed.forEach((id) => selectedFishIds.add(id))
      await loadPonds(true)
      const refreshed = currentDetailPond()
      if (refreshed) renderPondDetailFish(refreshed)
      fishMoveTarget.value = ''
      if (refreshed) renderFishMoveBar(refreshed)
      const moved = ids.length - failed.length
      detailMessage.textContent = failed.length
        ? `${moved} ikan dipindah ke ${target.name}, ${failed.length} gagal (dipilih ulang).`
        : `${moved} ikan dipindah ke ${target.name}.`
    })

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-bs-toggle="modal"]')
      const dismiss = event.target.closest('[data-bs-dismiss="modal"]')

      if (toggle) {
        const target = document.querySelector(toggle.dataset.bsTarget)

        if (target) {
          openModal(target)
        }
      }

      if (dismiss) {
        const modal = dismiss.closest('.modal')

        if (modal) {
          closeModal(modal)
        }
      }
    })

    printButton.addEventListener('click', printPondList)

    printDetailButtons.forEach((button) => {
      button.addEventListener('click', printPondDetail)
    })

    window.addEventListener('afterprint', () => {
      document.body.classList.remove('printing-pond-detail')
      document.body.classList.remove('printing-pond-list')
    })

    const pondExcelColumns = ['Area', 'Nama Kolam', 'Status', 'Terfoto', 'Belum Difoto', 'Qty Total', 'Tanggal Catatan', 'Catatan']
    const pondStatusFromText = (value) => {
      const typed = String(value || '').trim().toLowerCase()
      if (typed === 'aktif' || typed === 'active') return 'active'
      if (typed === 'kosong' || typed === 'perbaikan') return typed
      return ''
    }
    // 2026-01-26, 26/01/2026 and "26 - [1] Januari - 2026" all become 2026-01-26; anything else becomes ''.
    const pondNoteDateFromText = (value) => window.KoiAuth.dateFromText(value)

    const exportPondsZip = async (ids) => {
      if (!pondsData.length) {
        importExportMessage.textContent = 'Belum ada data kolam untuk diexport.'
        return
      }
      const chosen = ids.length ? sortedPonds().filter((pond) => ids.includes(String(pond.id))) : sortedPonds()
      const progress = window.KoiZip.progress('Unduh ZIP Data Kolam')
      try {
        const response = await fetch('/api/pond-documentation')
        const everything = response.ok ? await response.json() : []
        const byPond = new Map()
        everything.forEach((doc) => {
          const list = byPond.get(String(doc.pond_id)) || []
          list.push({ type: doc.media_type === 'video' ? 'video' : 'image', url: doc.image_url, name: '', notes: doc.notes || '' })
          byPond.set(String(doc.pond_id), list)
        })
        const rows = chosen.map((pond) => [
          pond.location || '',
          pond.name || '',
          statusLabels[pond.status]?.label || pond.status || 'Kosong',
          Number(pond.koi_count || 0),
          Number(pond.unphotographed_fish_qty || 0),
          totalPondQty(pond),
          pond.notes_date ? String(pond.notes_date).slice(0, 10) : '',
          pond.notes || '',
        ])
        const result = await window.KoiZip.exportPackage({
          sheetName: 'Data Kolam',
          header: pondExcelColumns,
          rows,
          keyHeader: 'Nama Kolam',
          xlsxName: 'data-kolam.xlsx',
          docs: chosen.map((pond) => ({ key: pond.name || String(pond.id), media: byPond.get(String(pond.id)) || [] })),
          onProgress: (text) => progress.set(text),
        })
        window.KoiZip.download(result.blob, `zip-kolam-${window.KoiZip.today()}.zip`)
        window.KoiDock.showResult('Unduh ZIP Data Kolam', `Selesai: ${chosen.length} kolam, ${result.photos} foto, ${result.videos} video.`, result.problems)
      } catch (error) {
        window.KoiDock.showResult('Unduh ZIP Data Kolam', error.message || 'ZIP gagal dibuat.')
      } finally {
        progress.close()
      }
    }
    window.koiPondsZip = exportPondsZip

    exportButton.addEventListener('click', async () => {
      importExportMessage.textContent = 'Menyiapkan export Excel data kolam.'
      exportButton.disabled = true

      try {
        if (!pondsData.length) {
          throw new Error('Belum ada data kolam untuk diexport.')
        }
        if (!window.XLSX) {
          throw new Error('Pustaka Excel belum termuat. Muat ulang halaman.')
        }

        const rows = sortedPonds().map((pond) => [
          pond.location || '',
          pond.name || '',
          statusLabels[pond.status]?.label || pond.status || 'Kosong',
          Number(pond.koi_count || 0),
          Number(pond.unphotographed_fish_qty || 0),
          totalPondQty(pond),
          pond.notes_date ? String(pond.notes_date).slice(0, 10) : '',
          pond.notes || '',
        ])
        const sheet = XLSX.utils.aoa_to_sheet([pondExcelColumns, ...rows])
        sheet['!cols'] = pondExcelColumns.map((column) => ({ wch: Math.max(14, column.length + 2) }))
        const workbook = XLSX.utils.book_new()
        XLSX.utils.book_append_sheet(workbook, sheet, 'Data Kolam')
        const buffer = XLSX.write(workbook, { type: 'array', bookType: 'xlsx' })
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
        const link = document.createElement('a')
        const objectUrl = URL.createObjectURL(blob)

        link.href = objectUrl
        link.download = `data-kolam-${new Date().toISOString().slice(0, 10)}.xlsx`
        document.body.appendChild(link)
        link.click()
        link.remove()
        setTimeout(() => URL.revokeObjectURL(objectUrl), 1000)
        importExportMessage.textContent = 'Export Excel data kolam selesai.'
      } catch (error) {
        importExportMessage.textContent = error.message
      } finally {
        exportButton.disabled = false
      }
    })

    importButton.addEventListener('click', () => {
      importInput.click()
    })

    importInput.addEventListener('change', async () => {
      let [file] = Array.from(importInput.files || [])

      if (!file) {
        return
      }

      importButton.disabled = true
      importExportMessage.textContent = 'Membaca file import.'
      let progress = null

      // A pond whose name already exists is updated (only the columns that are filled in); a new name creates a pond.
      // Mass input works in two passes: the file is checked and shown as a preview first (nothing is written),
      // and only after "Lanjutkan" it is saved. A ZIP also adds the documentation (see zip-kit.js).
      const pondsFromFile = async (source) => {
        let records
        if (/\.csv$/i.test(source.name)) {
          records = parseCsv(await readFileAsText(source))
        } else {
          if (!window.XLSX) {
            throw new Error('Pustaka Excel belum termuat. Muat ulang halaman.')
          }
          const workbook = XLSX.read(await source.arrayBuffer(), { type: 'array', cellDates: true, dateNF: 'yyyy-mm-dd' })
          const rawRows = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], { defval: '', raw: false })
          records = rawRows.map((row) => Object.fromEntries(Object.entries(row).map(([key, value]) => [String(key).trim().toLowerCase(), value])))
        }

        return records.map((record) => ({
          name: String(record['nama kolam'] ?? record.nama ?? record.name ?? '').trim(),
          location: String(record.area ?? record.lokasi ?? record.location ?? '').trim(),
          status: pondStatusFromText(record.status),
          unphotographed: String(record['belum difoto'] ?? record.unphotographed_fish_qty ?? '').trim(),
          notesDate: pondNoteDateFromText(record['tanggal catatan']),
          notes: String(record.catatan ?? record.notes ?? '').trim(),
          docsCell: String(record.dokumentasi ?? '').trim(),
        }))
      }

      const runPondsImport = async (items, pkg, dryRun) => {
        const problems = []
        let inserted = 0
        let updated = 0
        let skipped = 0
        let docsAdded = 0
        let docsSkipped = 0
        let docsPlanned = 0
        const seen = new Set()

        // Documentation from the ZIP is added to the pond (the server skips files the pond already has).
        const attachDocs = async (pondId, name, docs) => {
          importExportMessage.textContent = `Mengupload dokumentasi ${name} (${docs.length})`
          progress?.set(`${name}: ${docs.length} dokumentasi`)
          const result = await window.KoiZip.addPondDocs(pondId, docs)
          docsAdded += result.added
          docsSkipped += result.skipped
          problems.push(...result.problems.map((message) => `${name}: ${message}`))
        }

        for (const [index, item] of items.entries()) {
          const line = index + 2
          if (!item.name) {
            skipped += 1
            problems.push(`Baris ${line}: Nama Kolam kosong, dilewati`)
            continue
          }
          const lowered = item.name.toLowerCase()
          if (seen.has(lowered)) {
            skipped += 1
            problems.push(`Baris ${line} (${item.name}): nama kolam kembar di file, dilewati`)
            continue
          }
          seen.add(lowered)
          if (pkg) pkg.markUsed(item.name)

          importExportMessage.textContent = `${dryRun ? 'Memeriksa' : 'Mengimport'} ${index + 1}/${items.length}: ${item.name}`
          const existing = pondsData.find((pond) => String(pond.name || '').trim().toLowerCase() === lowered)
          const fields = {}
          if (item.location) fields.location = item.location
          if (item.status) fields.status = item.status
          if (item.unphotographed !== '') fields.unphotographed_fish_qty = Math.max(0, Number(item.unphotographed) || 0)
          if (item.notes) fields.notes = item.notes
          if (item.notesDate) fields.notes_date = item.notesDate
          // Dokumentasi cell: folder(s) of the ZIP and/or @ID of media that is already in the Galeri
          let docs = null
          if (pkg) {
            const found = await pkg.docsForRow(item.docsCell, item.name)
            docs = found.docs
            problems.push(...found.problems.map((message) => `Baris ${line} (${item.name}): ${message}`))
          }
          const hasDocs = Boolean(docs && docs.length)
          if (hasDocs) docsPlanned += docs.length

          if (existing && Object.keys(fields).length === 0 && !hasDocs) {
            skipped += 1
            continue
          }
          if (dryRun) {
            if (!existing) inserted += 1
            else if (Object.keys(fields).length) updated += 1
            continue
          }

          try {
            if (existing) {
              if (Object.keys(fields).length === 0) {
                await attachDocs(existing.id, item.name, docs)
                continue
              }
              const response = await fetch(`/api/ponds/${existing.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(fields) })
              if (response.ok) {
                updated += 1
                if (hasDocs) await attachDocs(existing.id, item.name, docs)
              } else {
                skipped += 1
                problems.push(`Baris ${line} (${item.name}): gagal diperbarui`)
              }
            } else {
              const response = await fetch('/api/ponds', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ name: item.name, location: item.location, status: item.status || 'kosong', unphotographed_fish_qty: fields.unphotographed_fish_qty || 0, notes: item.notes }),
              })
              if (response.ok) {
                inserted += 1
                const created = item.notesDate || hasDocs ? await response.json().catch(() => null) : null
                if (created?.id && item.notesDate) await fetch(`/api/ponds/${created.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ notes_date: item.notesDate }) })
                if (created?.id && hasDocs) await attachDocs(created.id, item.name, docs)
              } else {
                skipped += 1
                problems.push(`Baris ${line} (${item.name}): gagal disimpan`)
              }
            }
          } catch {
            skipped += 1
            problems.push(`Baris ${line} (${item.name}): gagal disimpan`)
          }
        }

        if (pkg) {
          for (const key of pkg.unusedKeys()) problems.push(`Folder dokumentasi "${key}" tidak dipakai: tidak ada baris data yang memakainya`)
        }
        return { inserted, updated, skipped, docsAdded, docsSkipped, docsPlanned, problems }
      }

      try {
        progress = window.KoiZip.progress('Memeriksa file Data Kolam')
        let pkg = null
        const packageProblems = []
        if (/\.zip$/i.test(file.name)) {
          pkg = await window.KoiZip.readPackage(file)
          file = pkg.xlsxFile
          packageProblems.push(...pkg.problems)
        } else {
          pkg = await window.KoiZip.plainPackage()
        }
        const items = await pondsFromFile(file)

        if (items.length === 0) {
          throw new Error('File tidak berisi data kolam. Kolom yang dikenali: Area, Nama Kolam, Status, Belum Difoto, Tanggal Catatan, Catatan.')
        }

        // pass 1: check everything, write nothing
        const plan = await runPondsImport(items, pkg, true)
        progress.close()
        progress = null
        const planProblems = [...packageProblems, ...plan.problems]
        if (!plan.inserted && !plan.updated && !plan.docsPlanned) {
          importExportMessage.textContent = 'Tidak ada data kolam yang bisa diimport.'
          window.KoiDock.showResult('Import Data Kolam', 'Tidak ada data yang bisa diimport.', planProblems)
          return
        }
        const preview = `Kolam baru: ${plan.inserted}\nKolam diperbarui: ${plan.updated}` +
          (pkg.isZip || plan.docsPlanned ? `\nDokumentasi: ${plan.docsPlanned} file (yang sudah ada dilewati otomatis)` : '') +
          (planProblems.length ? '\nBaris atau file bermasalah dilewati.' : '')
        const go = await window.KoiDock.showResult('Pratinjau import Data Kolam', preview, planProblems, { confirm: true, okLabel: planProblems.length ? 'Lanjutkan (lewati yang bermasalah)' : 'Lanjutkan' })
        if (!go) {
          importExportMessage.textContent = 'Import dibatalkan.'
          return
        }

        // pass 2: write
        progress = window.KoiZip.progress('Import Data Kolam')
        const result = await runPondsImport(items, pkg, false)
        const summary = `Import selesai. Baru ${result.inserted}, diperbarui ${result.updated}, dilewati ${result.skipped}.${pkg.isZip || result.docsPlanned ? ` Dokumentasi ditambahkan ${result.docsAdded}, sudah ada ${result.docsSkipped}.` : ''}`
        importExportMessage.textContent = summary
        window.KoiDock.showResult('Import Data Kolam', summary, [...packageProblems, ...result.problems])
        await keepScroll(loadPonds)
      } catch (error) {
        importExportMessage.textContent = error.message || 'Import gagal.'
      } finally {
        progress?.close()
        importInput.value = ''
        importButton.disabled = false
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeActiveModal()
      }
    })

    const deletePondsBatch = async (ids) => {
      const names = ids.map((id) => pondsData.find((item) => String(item.id) === String(id))?.name).filter(Boolean)

      if (!(await window.KoiDialog.confirm(`Hapus ${ids.length} kolam (${names.join(', ')})?`))) {
        return
      }

      const failed = []

      for (const id of ids) {
        try {
          const response = await fetch(`${apiUrl}/ponds/${id}`, { method: 'DELETE' })
          if (!response.ok) failed.push(id)
        } catch {
          failed.push(id)
        }
      }

      dock.clear()
      await keepScroll(loadPonds)

      if (failed.length) {
        alert(`${failed.length} kolam gagal dihapus.`)
      }
    }

    // Catatan masal: the same text is added as a new line to the Catatan Formulir of every selected pond.
    const openPondBulkNote = (ids) => {
      document.querySelector('[data-pond-bulk-note]')?.remove()
      const overlay = document.createElement('div')
      overlay.setAttribute('data-pond-bulk-note', '')
      overlay.style.cssText = 'position:fixed;inset:0;z-index:4900;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.6)'
      overlay.innerHTML = `
        <div class="card" style="max-width:30rem;width:100%">
          <div class="card-header"><h3 class="card-title">Catatan Masal (${ids.length} kolam)</h3><div class="card-actions"><button type="button" class="btn-close" data-bulk-cancel aria-label="Tutup"></button></div></div>
          <div class="card-body">
            <label class="form-label" for="pond-bulk-note-text">Catatan yang ditambahkan ke Catatan Formulir kolam terpilih</label>
            <textarea class="form-control" id="pond-bulk-note-text" rows="4" data-bulk-text></textarea>
            <label class="form-check mt-3 mb-0"><input class="form-check-input" type="checkbox" data-bulk-replace /><span class="form-check-label">Ganti catatan (hapus catatan yang sudah ada)</span></label>
            <div class="form-hint mt-2" data-bulk-hint></div>
            <div class="text-danger small mt-2" data-bulk-error></div>
          </div>
          <div class="card-footer d-flex justify-content-end gap-2"><button type="button" class="btn" data-bulk-cancel>Batal</button><button type="button" class="btn btn-primary" data-bulk-save>Tambahkan</button></div>
        </div>`
      const close = () => overlay.remove()
      const replaceBox = overlay.querySelector('[data-bulk-replace]')
      const syncMode = () => {
        const replace = replaceBox.checked
        const button = overlay.querySelector('[data-bulk-save]')
        button.textContent = replace ? 'Ganti' : 'Tambahkan'
        button.classList.toggle('btn-danger', replace)
        button.classList.toggle('btn-primary', !replace)
        overlay.querySelector('[data-bulk-hint]').textContent = replace
          ? 'Semua catatan yang sudah ada pada kolam terpilih akan DIHAPUS dan diganti dengan teks ini. Tanggal catatan kolam menjadi hari ini.'
          : 'Ditambahkan di paling atas, dipisah garis, dan catatan lama tetap ada di bawahnya (tidak dihapus). Tanggal catatan kolam menjadi hari ini.'
      }
      replaceBox.addEventListener('change', syncMode)
      syncMode()
      overlay.addEventListener('click', async (event) => {
        if (event.target === overlay || event.target.closest('[data-bulk-cancel]')) {
          close()
          return
        }
        if (!event.target.closest('[data-bulk-save]')) return

        const text = overlay.querySelector('[data-bulk-text]').value.trim()
        if (!text) {
          overlay.querySelector('[data-bulk-error]').textContent = 'Isi catatan terlebih dahulu.'
          return
        }

        if (replaceBox.checked && !(await window.KoiDialog.confirm(`GANTI catatan ${ids.length} kolam terpilih? Semua catatan yang sudah ada akan dihapus.`))) return

        const saveButton = overlay.querySelector('[data-bulk-save]')
        saveButton.disabled = true
        saveButton.textContent = 'Menyimpan'
        const now = new Date()
        const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
        let failed = 0

        for (const id of ids) {
          const pond = pondsData.find((item) => String(item.id) === String(id))
          try {
            const response = await fetch(`/api/ponds/${id}`, {
              method: 'PATCH',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ notes: replaceBox.checked || !String(pond?.notes || '').trim() ? text : `${text}\n-----------\n\n${pond.notes}`, notes_date: today }),
            })
            if (!response.ok) failed += 1
          } catch {
            failed += 1
          }
        }

        close()
        dock.clear()
        await keepScroll(loadPonds)
        if (failed) alert(`${failed} kolam gagal diberi catatan.`)
      })
      document.body.appendChild(overlay)
      overlay.querySelector('[data-bulk-text]').focus()
    }

    const sortLabel = () => (sortState.direction === 'asc' ? 'A/Z' : 'Z/A')
    const sortTitle = () => (sortState.direction === 'asc' ? 'Urutan A ke Z (klik untuk Z ke A)' : 'Urutan Z ke A (klik untuk A ke Z)')

    // Floating action dock, the same one Breeding and Laporan use.
    const dock = window.KoiDock.create({
      root: table,
      label: 'kolam',
      idOf: (item) => String(item.id),
      visibleItems: () => dock.apply(sortedPonds()),
      render: () => renderPonds(),
      actions: [
        { key: 'edit', icon: 'edit', title: 'Edit kolam terpilih', role: 'farm-operate', show: (count) => count === 1, onClick: (ids) => openPondForm(ids[0]) },
        { key: 'bulk-note', icon: 'note', title: 'Catatan masal kolam terpilih', role: 'farm-operate', onClick: (ids) => openPondBulkNote(ids) },
        {
          key: 'print-one',
          icon: 'printer',
          variant: 'secondary',
          title: (count) => (count > 1 ? `Cetak ${count} kolam terpilih (satu halaman per kolam)` : 'Cetak kolam terpilih'),
          show: (count) => count >= 1,
          onClick: (ids) => {
            // Several ponds: one document, one page each, one "Pengaturan Cetak" dialog.
            if (ids.length > 1) {
              window.KoiPrint.printMany(ids, (id) => { selectedPondId = id; printPondDetail() }, { title: `Isi Kolam (${ids.length} kolam)` })
              return
            }
            selectedPondId = ids[0]
            printPondDetail()
          },
        },
        { key: 'delete', icon: 'trash', variant: 'danger', title: (count) => `Hapus ${count} kolam terpilih`, role: 'farm-operate', onClick: (ids) => deletePondsBatch(ids) },
        { key: 'print-list', icon: 'printer', variant: 'secondary', title: 'Cetak daftar kolam', always: true, show: (count) => count === 0, onClick: () => printButton.click() },
        { key: 'import', icon: 'upload', variant: 'success', title: 'Import kolam (Excel atau ZIP)', role: 'farm-operate', always: true, show: (count) => count === 0, onClick: () => importButton.click() },
        { key: 'export', icon: 'file-spreadsheet', variant: 'success', title: 'Export kolam (Excel)', always: true, show: (count) => count === 0, onClick: () => exportButton.click() },
        { key: 'zip', icon: 'file-zip', variant: 'success', title: (count) => (count ? `Unduh ZIP (${count} terpilih)` : 'Unduh ZIP (Excel + dokumentasi)'), always: true, onClick: (ids) => window.koiPondsZip(ids) },
        { key: 'settings', icon: 'settings', title: 'Pengaturan area', role: 'farm-operate', always: true, show: (count) => count === 0, onClick: () => areaSettingsButton.click() },
        {
          key: 'sort',
          text: sortLabel(),
          title: sortTitle(),
          always: true,
          onClick: () => {
            sortState = { key: 'name', direction: sortState.key === 'name' && sortState.direction === 'asc' ? 'desc' : 'asc' }
            try {
              sessionStorage.setItem(pondViewKey, JSON.stringify(sortState))
            } catch {
              // ignore
            }
            dock.updateAction('sort', { text: sortLabel(), title: sortTitle() })
            renderPonds()
          },
        },
      ],
      add: { title: 'Tambah kolam', role: 'farm-operate', onClick: () => document.querySelector('[data-add-pond-trigger]').click() },
    })

    table.addEventListener('click', async (event) => {
      const editButton = event.target.closest('[data-edit-pond]')

      if (editButton) {
        openPondForm(editButton.dataset.editPond)
        return
      }

      const selectArea = event.target.closest('[data-dock-select]')

      if (selectArea) {
        dock.toggle(selectArea.closest('[data-dock-id]').dataset.dockId)
        return
      }

      const row = event.target.closest('[data-pond-row]')

      if (row && !event.target.closest('button, input')) {
        showPondDetail(row.dataset.pondRow)
        return
      }

    })

    table.addEventListener('keydown', (event) => {
      const row = event.target.closest('[data-pond-row]')

      if (row && event.target === row && (event.key === 'Enter' || event.key === ' ')) {
        event.preventDefault()
        showPondDetail(row.dataset.pondRow)
      }
    })

    deletePondButton.addEventListener('click', async () => {
      if (!selectedPondId) {
        return
      }

      const pond = pondsData.find((item) => String(item.id) === String(selectedPondId))

      if (!(await window.KoiDialog.confirm(`Hapus ${text(pond?.name)}?`))) {
        return
      }

      deletePondButton.disabled = true
      deletePondButton.textContent = 'Menghapus'
      detailMessage.textContent = ''

      try {
        const response = await fetch(`${apiUrl}/ponds/${selectedPondId}`, {
          method: 'DELETE',
        })

        if (!response.ok) {
          const result = await response.json().catch(() => ({}))
          throw new Error(result.error || 'Kolam gagal dihapus.')
        }

        closeModal(detailModalElement)
        selectedPondId = null
        await keepScroll(loadPonds)
      } catch (error) {
        detailMessage.textContent = error.message
      } finally {
        deletePondButton.disabled = false
        deletePondButton.textContent = 'Hapus Kolam'
      }
    })

    const readClipboardImageFile = async (filename = 'clipboard-pond') => {
      if (!navigator.clipboard?.read) {
        throw new Error('Browser belum mengizinkan baca clipboard gambar.')
      }

      const items = await navigator.clipboard.read()
      for (const item of items) {
        const imageType = item.types.find((type) => type.startsWith('image/'))
        if (!imageType) {
          continue
        }

        const blob = await item.getType(imageType)
        const extension = imageType.split('/')[1] || 'png'
        return new File([blob], `${filename}.${extension}`, { type: imageType })
      }

      throw new Error('Clipboard tidak berisi gambar.')
    }

    const uploadPondDocumentationFiles = async (files) => {
      if (!selectedPondId) {
        return
      }

      files = Array.from(files || []).filter((file) => file.type.startsWith('image/') || file.type.startsWith('video/'))

      if (files.length === 0) {
        documentationStatus.textContent = '0/0'
        return
      }

      documentationButton.classList.add('disabled')
      documentationButton.setAttribute('aria-disabled', 'true')
      documentationStatus.innerHTML = `<div class="small text-secondary mb-1"><span data-upload-progress-label>0/${files.length}</span></div><div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div>`

      try {
        let uploadedCount = 0

        for (const file of files) {
          const isVideo = file.type.startsWith('video/')
          documentationStatus.querySelector('[data-upload-progress-label]').textContent = `${uploadedCount + 1}/${files.length} - Memproses ${file.name}`
          const mediaData = isVideo ? await readFileAsDataUrl(file) : await compressImage(file)
          documentationStatus.querySelector('[data-upload-progress-label]').textContent = `${uploadedCount + 1}/${files.length} - Mengupload ${file.name}`

          if (isVideo) {
            const thumbnailData = await createVideoThumbnail(file)
            const videoResponse = await fetch(`${apiUrl}/videos`, {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
              },
              body: JSON.stringify({
                prefix: 'pond-doc-video',
                video_data: mediaData,
                thumbnail_data: thumbnailData,
              }),
            })

            if (!videoResponse.ok) {
              const result = await videoResponse.json().catch(() => ({}))
              throw new Error(result.detail || result.error || 'Video gagal diupload.')
            }

            const videoResult = await videoResponse.json()
            pendingDocumentationNotes.set(`video-${Date.now()}-${uploadedCount}`, '')
            const currentItems = documentationItems()
            renderDocumentation([
              ...currentItems,
              {
                id: `video-${Date.now()}-${uploadedCount}`,
                image_url: videoResult.video_url,
                media_type: 'video',
                thumbnail_url: videoResult.video_thumbnail_url || '',
                notes: '',
              },
            ])
            uploadedCount += 1
            continue
          }

          const response = await fetch(`${apiUrl}/ponds/${selectedPondId}/documentation`, {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
            },
            body: JSON.stringify({
              images: isVideo ? [] : [mediaData],
              media: [{
                media_type: isVideo ? 'video' : 'image',
                [isVideo ? 'video_data' : 'image_data']: mediaData,
              }],
            }),
          })

          if (!response.ok) {
            const result = await response.json().catch(() => ({}))
            if (isVideo && response.status === 422) {
              throw new Error('Upload video perlu restart aplikasi agar API terbaru aktif.')
            }
            throw new Error(result.detail || result.error || 'Dokumentasi gagal diupload.')
          }

          uploadedCount += 1
        }

        documentationInput.value = ''
        documentationStatus.textContent = `${uploadedCount}/${files.length} media selesai diupload.`
        await loadDocumentation(selectedPondId)
      } catch (error) {
        documentationStatus.textContent = error.message
      } finally {
        documentationButton.classList.remove('disabled')
        documentationButton.removeAttribute('aria-disabled')
      }
    }

    documentationInput.addEventListener('change', async () => {
      uploadPondDocumentationFiles(documentationInput.files).catch((error) => {
        documentationStatus.textContent = error.message || 'Dokumentasi gagal diupload.'
      })
    })

    const documentationHasDraggedFiles = (event) => [...(event.dataTransfer?.types || [])].includes('Files')
    detailModalElement.addEventListener('dragover', (event) => {
      if (!documentationHasDraggedFiles(event)) return
      event.preventDefault()
      event.dataTransfer.dropEffect = 'copy'
      documentationButton.classList.add('is-dragover')
    })
    detailModalElement.addEventListener('dragleave', (event) => {
      if (event.target === detailModalElement || !detailModalElement.contains(event.relatedTarget)) {
        documentationButton.classList.remove('is-dragover')
      }
    })
    detailModalElement.addEventListener('drop', (event) => {
      documentationButton.classList.remove('is-dragover')
      if (!documentationHasDraggedFiles(event)) return
      event.preventDefault()
      if (!window.KoiAuth?.canAccess?.('farm-operate')) return
      uploadPondDocumentationFiles(event.dataTransfer.files).catch((error) => {
        documentationStatus.textContent = error.message || 'Dokumentasi gagal diupload.'
      })
    })

    documentationPasteButton.addEventListener('click', async () => {
      if (!selectedPondId) {
        return
      }

      documentationPasteButton.disabled = true
      try {
        const file = await readClipboardImageFile()
        await uploadPondDocumentationFiles([file])
      } catch (error) {
        documentationStatus.textContent = error.message || 'Paste gambar dokumentasi gagal.'
      } finally {
        documentationPasteButton.disabled = false
      }
    })

    documentationList.addEventListener('click', async (event) => {
      // Clicking a documentation photo/video opens the shared zoom preview (not a new tab).
      const previewLink = event.target.closest('.pond-documentation-preview')
      if (previewLink) {
        event.preventDefault()
        const note = previewLink.closest('[data-pond-documentation-item]')?.querySelector('[data-pond-documentation-notes]')?.value.trim()
        {
          const pondForZoom = pondsData.find((entry) => String(entry.id) === String(selectedPondId))
          window.KoiAuth.zoomPhoto(previewLink.getAttribute('href'), pondForZoom ? `Dokumentasi ${pondForZoom.name}` : 'Dokumentasi kolam', [pondForZoom?.location ? `Area: ${pondForZoom.location}` : '', note ? `Catatan: ${note}` : ''])
        }
        return
      }

      const saveNotesButton = event.target.closest('[data-save-pond-documentation-notes]')

      if (saveNotesButton && selectedPondId) {
        const notesInput = documentationList.querySelector(`[data-pond-documentation-notes="${saveNotesButton.dataset.savePondDocumentationNotes}"]`)
        const noteValue = notesInput?.value || ''

        pendingDocumentationNotes.set(String(saveNotesButton.dataset.savePondDocumentationNotes), noteValue)
        saveNotesButton.disabled = true
        saveNotesButton.textContent = 'Menyimpan'
        documentationStatus.textContent = ''

        try {
          const response = await fetch(`${apiUrl}/ponds/${selectedPondId}/documentation/${saveNotesButton.dataset.savePondDocumentationNotes}`, {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
            },
            body: JSON.stringify({ notes: noteValue }),
          })

          if (!response.ok) {
            const result = await response.json().catch(() => ({}))
            if (response.status === 404) {
              documentationStatus.textContent = ''
              saveNotesButton.textContent = 'Siap'
              setTimeout(() => {
                saveNotesButton.disabled = false
                saveNotesButton.textContent = 'Simpan Catatan'
              }, 900)
              return
            }
            throw new Error(result.detail || result.error || 'Catatan dokumentasi gagal disimpan.')
          }

          documentationStatus.textContent = ''
          saveNotesButton.textContent = 'Tersimpan'
          setTimeout(() => {
            saveNotesButton.disabled = false
            saveNotesButton.textContent = 'Simpan Catatan'
          }, 900)
        } catch (error) {
          documentationStatus.textContent = error.message
          saveNotesButton.disabled = false
          saveNotesButton.textContent = 'Simpan Catatan'
        }
        return
      }

      const button = event.target.closest('[data-delete-pond-documentation]')

      if (!button || !selectedPondId) {
        return
      }

      button.disabled = true
      button.textContent = 'Pindah'
      documentationStatus.textContent = ''

      try {
        if (String(button.dataset.deletePondDocumentation || '').startsWith('video-')) {
          button.closest('[data-pond-documentation-item]')?.remove()
          documentationStatus.textContent = ''
          return
        }

        const response = await fetch(`${apiUrl}/ponds/${selectedPondId}/documentation/${button.dataset.deletePondDocumentation}`, {
          method: 'DELETE',
        })

        if (!response.ok) {
          const result = await response.json().catch(() => ({}))
          throw new Error(result.detail || result.error || 'Dokumentasi gagal dihapus.')
        }

        documentationStatus.textContent = ''
        await loadDocumentation(selectedPondId)
      } catch (error) {
        documentationStatus.textContent = error.message
        button.disabled = false
        button.textContent = 'Hapus'
      }
    })

    documentationList.addEventListener('change', (event) => {
      const box = event.target.closest('[data-doc-select]')
      if (!box) return
      if (box.checked) selectedDocIds.add(box.dataset.docSelect)
      else selectedDocIds.delete(box.dataset.docSelect)
      renderDocMoveBar()
    })

    docMoveTarget.addEventListener('change', () => {
      docMoveButton.disabled = !selectedDocIds.size || !docMoveTarget.value
    })

    docMoveButton.addEventListener('click', async () => {
      const target = pondsData.find((item) => String(item.id) === String(docMoveTarget.value))
      const ids = Array.from(selectedDocIds)
      if (!selectedPondId || !target || !ids.length) return

      docMoveButton.disabled = true
      documentationStatus.textContent = `Memindahkan ${ids.length} dokumentasi ke ${target.name}.`
      // Notes that are still waiting to autosave travel with the move instead.
      ids.forEach((id) => { window.clearTimeout(docNoteTimers.get(id)); docNoteTimers.delete(id) })

      try {
        const response = await fetch(`${apiUrl}/ponds/${selectedPondId}/documentation/move`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            target_pond_id: target.id,
            items: ids.map((id) => (pendingDocumentationNotes.has(id) ? { id, notes: pendingDocumentationNotes.get(id) } : { id })),
          }),
        })
        const result = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(result.detail || result.error || 'Dokumentasi gagal dipindah.')

        ids.forEach((id) => pendingDocumentationNotes.delete(id))
        selectedDocIds.clear()
        docMoveTarget.value = ''
        await loadDocumentation(selectedPondId)
        documentationStatus.textContent = `${result.moved ?? ids.length} dokumentasi dipindah ke ${target.name}.`
      } catch (error) {
        documentationStatus.textContent = error.message
        renderDocMoveBar()
      }
    })

    docGalleryButton.addEventListener('click', async () => {
      const pond = pondsData.find((item) => String(item.id) === String(selectedPondId))
      const items = Array.from(documentationList.querySelectorAll('[data-pond-documentation-item]'))
        .filter((item) => selectedDocIds.has(item.dataset.pondDocumentationItem))
      if (!pond || !items.length) return

      docGalleryButton.disabled = true
      documentationStatus.textContent = 'Menyimpan ke Galeri.'
      const today = new Date()
      const title = `Dokumentasi ${pond.name} ${window.KoiAuth.formatDate(today)}`

      try {
        const response = await fetch(`${apiUrl}/gallery`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            pond_id: pond.id,
            title,
            gallery_date: `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`,
            images: items.map((item) => {
              const id = item.dataset.pondDocumentationItem
              const note = item.querySelector('[data-pond-documentation-notes]')?.value.trim() || pendingDocumentationNotes.get(id) || ''
              return {
                image_url: item.dataset.pondDocumentationUrl,
                media_type: item.dataset.pondDocumentationMediaType || 'image',
                thumbnail_url: item.dataset.pondDocumentationThumb || '',
                notes: note,
              }
            }),
          }),
        })
        const result = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(result.detail || result.error || 'Gagal menyimpan ke Galeri.')

        selectedDocIds.clear()
        documentationList.querySelectorAll('[data-doc-select]').forEach((box) => { box.checked = false })
        renderDocMoveBar()
        documentationStatus.textContent = `${items.length} dokumentasi disimpan ke Galeri: ${title}.`
      } catch (error) {
        documentationStatus.textContent = error.message
        renderDocMoveBar()
      }
    })

    // Documentation notes save themselves a moment after typing stops (and when the field loses focus).
    const saveDocumentationNote = async (pondId, docId) => {
      window.clearTimeout(docNoteTimers.get(docId))
      docNoteTimers.delete(docId)
      if (!/^\d+$/.test(docId) || !pendingDocumentationNotes.has(docId)) return
      const value = pendingDocumentationNotes.get(docId)

      try {
        const response = await fetch(`${apiUrl}/ponds/${pondId}/documentation/${docId}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ notes: value }),
        })
        if (!response.ok) throw new Error('gagal')
        if (pendingDocumentationNotes.get(docId) === value) pendingDocumentationNotes.delete(docId)
        if (String(selectedPondId) === String(pondId)) documentationStatus.textContent = 'Catatan tersimpan.'
      } catch {
        if (String(selectedPondId) === String(pondId)) documentationStatus.textContent = 'Catatan belum tersimpan, coba lagi.'
      }
    }

    documentationList.addEventListener('input', (event) => {
      const notesInput = event.target.closest('[data-pond-documentation-notes]')

      if (!notesInput) {
        return
      }

      const docId = String(notesInput.dataset.pondDocumentationNotes)
      const pondId = selectedPondId
      pendingDocumentationNotes.set(docId, notesInput.value || '')
      window.clearTimeout(docNoteTimers.get(docId))
      docNoteTimers.set(docId, window.setTimeout(() => saveDocumentationNote(pondId, docId), 800))
    })

    documentationList.addEventListener('focusout', (event) => {
      const notesInput = event.target.closest('[data-pond-documentation-notes]')
      if (notesInput) saveDocumentationNote(selectedPondId, String(notesInput.dataset.pondDocumentationNotes))
    })

    savePondNotesButton.addEventListener('click', async () => {
      if (!selectedPondId) {
        return
      }

      const notesDate = notesDateValue()

      if (notesDate === null) {
        detailMessage.textContent = 'Tanggal catatan belum lengkap atau tidak valid. Isi tanggal, bulan (contoh [1] Januari), dan tahun.'
        return
      }

      savePondNotesButton.disabled = true
      savePondNotesButton.textContent = 'Menyimpan'
      detailMessage.textContent = 'Menyimpan catatan kolam.'

      try {
        const payload = {
          ...Object.fromEntries(new FormData(detailForm).entries()),
          notes_date: notesDate,
          save_notes_only: true,
        }
        const response = await fetch(`${apiUrl}/ponds/${selectedPondId}`, {
          method: 'PATCH',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify(payload),
        })

        const result = await response.json().catch(() => ({}))

        if (!response.ok) {
          throw new Error(result.error || 'Catatan kolam gagal disimpan.')
        }

        const pondIndex = pondsData.findIndex((item) => String(item.id) === String(selectedPondId))
        if (pondIndex >= 0 && result.pond) {
          pondsData[pondIndex] = { ...pondsData[pondIndex], ...result.pond }
        }
        detailMessage.textContent = 'Catatan kolam berhasil disimpan.'
        await loadNoteHistory(selectedPondId)
        await keepScroll(loadPonds)
      } catch (error) {
        detailMessage.textContent = error.message
      } finally {
        savePondNotesButton.disabled = false
        savePondNotesButton.textContent = 'Simpan Catatan'
      }
    })

    detailForm.addEventListener('submit', (event) => event.preventDefault())

    noteHistory.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-delete-note-history]')

      if (!button || !selectedPondId) {
        return
      }

      button.disabled = true
      button.textContent = 'Menghapus'

      try {
        const response = await fetch(`${apiUrl}/ponds/${selectedPondId}/note-history/${button.dataset.deleteNoteHistory}`, {
          method: 'DELETE',
        })

        if (!response.ok) {
          const result = await response.json().catch(() => ({}))
          throw new Error(result.error || 'History catatan gagal dihapus.')
        }

        await loadNoteHistory(selectedPondId)
      } catch (error) {
        button.disabled = false
        button.textContent = 'Hapus'
        detailMessage.textContent = error.message
      }
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      message.textContent = editingPondId ? 'Menyimpan perubahan kolam.' : 'Menyimpan data kolam.'

      const payload = Object.fromEntries(new FormData(form).entries())
      let response

      try {
        response = await fetch(editingPondId ? `${apiUrl}/ponds/${editingPondId}` : `${apiUrl}/ponds`, {
          method: editingPondId ? 'PATCH' : 'POST',
          headers: {
            'content-type': 'application/json',
          },
          body: JSON.stringify(payload),
        })
      } catch (error) {
        message.textContent = `API tidak terhubung. Pastikan backend berjalan di ${apiUrl}.`
        return
      }

      if (!response.ok) {
        const result = await response.json().catch(() => ({}))
        message.textContent = result.detail ? `${result.error || 'Kolam gagal disimpan.'}: ${result.detail}` : result.error || 'Kolam gagal disimpan.'
        return
      }

      const savedMessage = editingPondId ? 'Kolam berhasil diperbarui.' : 'Kolam berhasil disimpan.'
      // Editing keeps the form open (and its scroll position); the popup from auth.js says it worked. Adding closes it.
      if (editingPondId) {
        message.textContent = savedMessage
        keepScroll(loadPonds)
        return
      }
      resetPondForm()
      message.textContent = savedMessage
      keepScroll(loadPonds)

      closeModal(modalElement)
    })

    modalElement.addEventListener('hidden.bs.modal', () => {
      resetPondForm()
    })

    const pondSearchInput = document.querySelector('[data-pond-search]')
    const navbarSearchBox = document.querySelector('#navbar-global-search')
    if (navbarSearchBox) {
      navbarSearchBox.setAttribute('placeholder', 'Nama kolam, area, catatan:kata')
      navbarSearchBox.setAttribute('title', 'Cari nama kolam atau area. Beberapa kata = semuanya harus cocok (mudpond 14). Pisahkan dengan koma untuk beberapa kolam (konkret 01, konkret 02). Cari di catatan: catatan:kata')
    }
    pondSearchInput?.addEventListener('input', () => {
      searchQuery = pondSearchInput.value.trim().toLowerCase()
      renderPonds()
    })

    const hasCachedPonds = restorePondsCache()
    loadPonds(hasCachedPonds)
    window.KoiAuth?.registerRealtimeRefresh(() => keepScroll(() => loadPonds(true)), { intervalMs: 25000 })
  </script>
  <script is:inline src="/assets/pond-areas.js?v=20261026a"></script>
</DefaultLayout>

