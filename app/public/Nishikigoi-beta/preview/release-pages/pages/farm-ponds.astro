    const importInput = document.querySelector('[data-import-ponds-input]')
    const importExportMessage = document.querySelector('[data-pond-import-export-message]')
    const form = document.querySelector('[data-pond-form]')
    const message = document.querySelector('[data-form-message]')
    const formTitle = document.querySelector('[data-pond-form-title]')
    const formSubmit = document.querySelector('[data-pond-submit]')
    const modalElement = document.querySelector('#pond-modal')
    const detailModalElement = document.querySelector('#pond-detail-modal')
    const detailTitle = document.querySelector('[data-pond-detail-title]')
    const detailSummary = document.querySelector('[data-pond-detail-summary]')
    const detailFish = document.querySelector('[data-pond-detail-fish]')
    const detailForm = document.querySelector('[data-pond-detail-form]')
    const detailMessage = document.querySelector('[data-pond-detail-message]')
    const savePondNotesButton = document.querySelector('[data-save-pond-notes]')
    const noteHistory = document.querySelector('[data-pond-note-history]')
    const deletePondButton = document.querySelector('[data-delete-pond]')
    const documentationInput = document.querySelector('[data-pond-documentation-input]')
    const documentationButton = document.querySelector('[data-upload-pond-documentation]')
    const documentationPasteButton = document.querySelector('[data-paste-pond-documentation]')
    const documentationStatus = document.querySelector('[data-pond-documentation-status]')
    const documentationList = document.querySelector('[data-pond-documentation-list]')
    const keepScroll = async (callback) => {
      const scrollX = window.scrollX
      const scrollY = window.scrollY
      const result = await callback()
      requestAnimationFrame(() => window.scrollTo(scrollX, scrollY))
      return result
    }
    let activeModal = null
    const fishSelectAll = document.querySelector('[data-fish-select-all]')
    const fishMoveTarget = document.querySelector('[data-fish-move-target]')
    const fishMoveButton = document.querySelector('[data-fish-move-button]')
    const selectedFishIds = new Set()
    let selectedPondId = null
    let editingPondId = null
    let pondsRealtimeSignature = ''
    const pendingDocumentationNotes = new Map()
    const formatSizeCm = (value) => { const number = Number(value); return Number.isFinite(number) && String(value).trim() !== '' ? number.toLocaleString('id-ID', { maximumFractionDigits: 1 }) : String(value ?? '') }
    // DEAD CODE (diperiksa 2026-10-14): koiLabels tidak dipanggil di mana pun. Aman dihapus; sengaja belum dihapus.
    const koiLabels = {
      unknown: 'Unknown',
      male: 'Male',
      female: 'Female',
      active: 'Active',
      quarantine: 'Quarantine',
      sold: 'Sold',
      dead: 'Dead',
      indukan: 'Indukan',
      non_indukan: 'Bukan Indukan',
    }
    let pondsData = []
    let areaOrder = JSON.parse(localStorage.getItem('pondAreaOrder') || '[]')
    let areaColors = {}
    let searchQuery = ''
    let sortState = { key: 'name', direction: 'asc' }
    const pondViewKey = 'nishikigoi-view:farm-ponds'
    try {
      const savedSort = JSON.parse(sessionStorage.getItem(pondViewKey) || 'null')
      if (savedSort && ['name', 'unphotographed_fish_qty', 'koi_count', 'notes'].includes(savedSort.key) && (savedSort.direction === 'asc' || savedSort.direction === 'desc')) {
        sortState = { key: savedSort.key, direction: savedSort.direction }
      }
    } catch {
      // sort is simply not remembered when storage is unavailable
    }
    const pondsCacheKey = 'nishikigoi-cache:farm-ponds'
    const statusLabels = {
      kosong: { label: 'Kosong', className: 'bg-secondary-lt' },
      active: { label: 'Aktif', className: 'bg-green-lt' },
      perbaikan: { label: 'Perbaikan', className: 'bg-yellow-lt' },
    }

    const getModalApi = () => window.tabler?.bootstrap?.Modal || window.bootstrap?.Modal

    const openModal = (element) => {
      const modalApi = getModalApi()

      if (modalApi) {
        modalApi.getOrCreateInstance(element).show()
        return
      }

      activeModal = element
      element.classList.add('show')
      element.style.display = 'block'
      element.removeAttribute('aria-hidden')
      element.setAttribute('aria-modal', 'true')
      element.setAttribute('role', 'dialog')
      document.body.classList.add('modal-open')

      if (!document.querySelector('[data-fallback-modal-backdrop]')) {
        const backdrop = document.createElement('div')
        backdrop.className = 'modal-backdrop fade show'
        backdrop.dataset.fallbackModalBackdrop = 'true'
        backdrop.addEventListener('click', closeActiveModal)
        document.body.appendChild(backdrop)
      }
    }

    const closeModal = (element) => {
      const modalApi = getModalApi()

      if (modalApi) {
        modalApi.getInstance(element)?.hide()
        return
      }

      element.classList.remove('show')
      element.style.display = 'none'
      element.setAttribute('aria-hidden', 'true')
      element.removeAttribute('aria-modal')
      element.removeAttribute('role')
      document.body.classList.remove('modal-open')
      document.querySelector('[data-fallback-modal-backdrop]')?.remove()
      activeModal = null
    }

    function closeActiveModal() {
      if (activeModal) {
        closeModal(activeModal)
      }
    }

    const parseFish = (fish) => {
      try {
        const parsedFish = typeof fish === 'string' ? JSON.parse(fish) : fish
        return Array.isArray(parsedFish) ? parsedFish.filter(Boolean) : []
      } catch (error) {
        return []
      }
    }

    const totalPondQty = (pond) => Number(pond.koi_count || 0) + Number(pond.unphotographed_fish_qty || 0)

    const readFileAsDataUrl = (file) =>
      new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.addEventListener('load', () => resolve(reader.result))
        reader.addEventListener('error', () => reject(new Error('Gambar gagal dibaca')))
        reader.readAsDataURL(file)
      })

    const readFileAsText = (file) =>
      new Promise((resolve, reject) => {
        const reader = new FileReader()
        reader.addEventListener('load', () => resolve(reader.result))
        reader.addEventListener('error', () => reject(new Error('File import gagal dibaca')))
        reader.readAsText(file)
      })

    // DEAD CODE (diperiksa 2026-10-14): csvValue tidak dipanggil di mana pun. Aman dihapus; sengaja belum dihapus.
    const csvValue = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`

    const parseCsv = (content) => {
      const rows = []
      let row = []
      let value = ''
      let inQuotes = false

      for (let index = 0; index < content.length; index += 1) {
        const character = content[index]
        const nextCharacter = content[index + 1]

        if (character === '"' && inQuotes && nextCharacter === '"') {
          value += '"'
          index += 1
          continue
        }

        if (character === '"') {
          inQuotes = !inQuotes
          continue
        }

        if (character === ',' && !inQuotes) {
          row.push(value)
          value = ''
          continue
        }

        if ((character === '\n' || character === '\r') && !inQuotes) {
          if (character === '\r' && nextCharacter === '\n') {
            index += 1
          }
          row.push(value)
          if (row.some((cell) => cell.trim())) {
            rows.push(row)
          }
          row = []
          value = ''
          continue
        }

        value += character
      }

      row.push(value)
      if (row.some((cell) => cell.trim())) {
        rows.push(row)
      }

      const [headers = [], ...dataRows] = rows
      const normalizedHeaders = headers.map((header) => header.trim().toLowerCase())

      return dataRows.map((dataRow) =>
        normalizedHeaders.reduce((item, header, index) => {
          item[header] = dataRow[index] || ''
          return item
        }, {})
      )
    }

    const loadImage = (src) =>
      new Promise((resolve, reject) => {
        const image = new Image()
        image.addEventListener('load', () => resolve(image))
        image.addEventListener('error', () => reject(new Error('Gambar gagal diproses')))
        image.src = src
      })

    const createVideoThumbnail = (file) =>
      new Promise((resolve) => {
        const video = document.createElement('video')
        const canvas = document.createElement('canvas')
        const objectUrl = URL.createObjectURL(file)

        video.muted = true
        video.playsInline = true
        video.preload = 'metadata'
        video.addEventListener('loadeddata', () => {
          canvas.width = video.videoWidth || 640
          canvas.height = video.videoHeight || 360
          canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height)
          URL.revokeObjectURL(objectUrl)
          resolve(canvas.toDataURL('image/webp', .82))
        }, { once: true })
        video.addEventListener('error', () => {
          URL.revokeObjectURL(objectUrl)
          resolve('')
        }, { once: true })
        video.src = objectUrl
      })

    const compressImage = async (file) => {
      const dataUrl = await readFileAsDataUrl(file)
      const image = await loadImage(dataUrl)
      const maxSize = 1600
      const scale = Math.min(1, maxSize / Math.max(image.naturalWidth, image.naturalHeight))
      const canvas = document.createElement('canvas')
      canvas.width = Math.max(1, Math.round(image.naturalWidth * scale))
      canvas.height = Math.max(1, Math.round(image.naturalHeight * scale))

      const context = canvas.getContext('2d')
      context.drawImage(image, 0, 0, canvas.width, canvas.height)

      return canvas.toDataURL('image/jpeg', 0.76)
    }

    const fishPreview = (item) => `
      <div class="pond-fish-preview d-flex align-items-center justify-content-center">
        ${
          item.image_url
            ? `<img src="${item.image_url}" alt="${text(item.code)}" loading="lazy" data-zoom-info="${encodeURIComponent(JSON.stringify(window.KoiAuth.koiZoomInfo(item)))}" />`
            : `<div class="pond-fish-preview-placeholder d-flex align-items-center justify-content-center">${text(item.code).slice(0, 4)}</div>`
        }
      </div>
    `

    const renderNoteHistory = (history) => {
      noteHistory.innerHTML =
        history.map((item) => {
          const date = item.created_at ? window.KoiAuth.formatDateTime(item.created_at) : '-'

          return `
            <div class="list-group-item">
              <div class="d-flex justify-content-between gap-3">
                <div>
                  <div class="text-secondary small">${date}</div>
                  <div>${text(item.new_notes)}</div>
                  <div class="text-secondary small mt-1">Sebelumnya: ${text(item.previous_notes)}</div>
                </div>
                <button class="btn btn-sm btn-outline-danger" type="button" data-delete-note-history="${item.id}" data-role-required="farm-operate">Hapus</button>
              </div>
            </div>
          `
        }).join('') || '<div class="list-group-item text-secondary">Belum ada history pengeditan catatan.</div>'
    }

    const loadNoteHistory = async (pondId) => {
      noteHistory.innerHTML = '<div class="list-group-item text-secondary"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Memuat history catatan...</div>'

      try {
        const response = await fetch(`${apiUrl}/ponds/${pondId}/note-history`)

        if (!response.ok) {
          throw new Error('History gagal dimuat')
        }

        renderNoteHistory(await response.json())
      } catch (error) {
        noteHistory.innerHTML = '<div class="list-group-item text-danger">History catatan gagal dimuat.</div>'
      }
    }

    // Date beside "Catatan Formulir": typed day, month (with suggestions such as [1] Januari) and year.
    const notesDay = document.querySelector('[data-notes-day]')
    const notesMonth = document.querySelector('[data-notes-month]')
    const notesMonthList = document.querySelector('[data-notes-month-list]')
    const notesYear = document.querySelector('[data-notes-year]')
    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember']
    const monthLabel = (number) => `[${number}] ${monthNames[number - 1]}`
    // 26 - [1] Januari - 2026
    const formatNotesDate = (value) => (/^(\d{4})-(\d{2})-(\d{2})/.test(String(value || '')) ? window.KoiAuth.formatDate(value) : '')

    // "1", "[1]", "jan" and "[1] Januari" all give month 1; anything else gives 0.
    const parseMonth = (value) => {
      const typed = String(value || '').trim().toLowerCase()
      if (!typed) return 0
      const numeric = typed.match(/^\[?(\d{1,2})\]?(?:\s|$)/)
      if (numeric) return Number(numeric[1]) >= 1 && Number(numeric[1]) <= 12 ? Number(numeric[1]) : 0
      const index = monthNames.findIndex((name) => name.toLowerCase().startsWith(typed))
      return index >= 0 ? index + 1 : 0
    }
    const monthSuggestions = (value) => {
      const typed = String(value || '').trim().toLowerCase().replace(/^\[|\]$/g, '')
      return monthNames.map((name, index) => index + 1).filter((number) => {
        if (!typed) return true
        return /^\d+$/.test(typed) ? String(number).startsWith(typed) : monthNames[number - 1].toLowerCase().includes(typed)
      })
    }
    let monthActive = -1
    const hideMonthList = () => {
      notesMonthList.hidden = true
      monthActive = -1
    }
    const chooseMonth = (number) => {
      notesMonth.value = monthLabel(number)
      notesMonth.classList.remove('is-invalid')
      hideMonthList()
      notesMonth.dispatchEvent(new Event('input', { bubbles: true }))
    }
    const showMonthList = () => {
      const numbers = monthSuggestions(notesMonth.value)
      monthActive = numbers.length ? 0 : -1
      notesMonthList.innerHTML = numbers.map((number, index) => `<button class="list-group-item list-group-item-action py-1 ${index === 0 ? 'active' : ''}" type="button" data-month-option="${number}">${monthLabel(number)}</button>`).join('')
      notesMonthList.hidden = numbers.length === 0
    }
    const moveMonthActive = (step) => {
      const options = [...notesMonthList.querySelectorAll('[data-month-option]')]
      if (!options.length) return
      monthActive = (monthActive + step + options.length) % options.length
      options.forEach((option, index) => option.classList.toggle('active', index === monthActive))
      options[monthActive].scrollIntoView({ block: 'nearest' })
    }
    notesMonth.addEventListener('focus', showMonthList)
    notesMonth.addEventListener('input', showMonthList)
    notesMonth.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); if (notesMonthList.hidden) showMonthList(); else moveMonthActive(1) }
      else if (event.key === 'ArrowUp') { event.preventDefault(); moveMonthActive(-1) }
      else if (event.key === 'Enter' || event.key === 'Tab') {
        const option = notesMonthList.hidden ? null : notesMonthList.querySelectorAll('[data-month-option]')[monthActive]
        if (option) { if (event.key === 'Enter') event.preventDefault(); chooseMonth(Number(option.dataset.monthOption)) }
      } else if (event.key === 'Escape' && !notesMonthList.hidden) { event.stopPropagation(); hideMonthList() }
    })
    // mousedown, so the pick happens before the field loses focus
    notesMonthList.addEventListener('mousedown', (event) => {
      const option = event.target.closest('[data-month-option]')
      if (!option) return
      event.preventDefault()
      chooseMonth(Number(option.dataset.monthOption))
    })
    notesMonth.addEventListener('blur', () => {
      hideMonthList()
      const number = parseMonth(notesMonth.value)
      if (number) notesMonth.value = monthLabel(number)
      notesMonth.classList.toggle('is-invalid', Boolean(notesMonth.value.trim()) && !number)
    })

    const pad2 = (value) => String(value).padStart(2, '0')
    // '' = nothing filled in, null = filled in but not a real date, otherwise YYYY-MM-DD.
    const notesDateValue = () => {
      const dayText = notesDay.value.trim()
      const yearText = notesYear.value.trim()
      if (!dayText && !notesMonth.value.trim() && !yearText) return ''
      const day = Number(dayText)
      const month = parseMonth(notesMonth.value)
      const year = Number(yearText)
      const valid = Number.isInteger(day) && day >= 1 && month >= 1 && Number.isInteger(year) && year >= 1900 && year <= 2100 && day <= new Date(year, month, 0).getDate()
      notesDay.classList.toggle('is-invalid', !valid && !(day >= 1 && day <= 31))
      notesMonth.classList.toggle('is-invalid', !month)
      notesYear.classList.toggle('is-invalid', !(year >= 1900 && year <= 2100))
      return valid ? `${year}-${pad2(month)}-${pad2(day)}` : null
    }
    // blankWhenMissing: a pond without a date shows empty fields (the date is filled in when its note is edited).
    const setNotesDate = (value, blankWhenMissing = false) => {
      const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(value || ''))
      const today = new Date()
      if (!match && blankWhenMissing) {
        notesYear.value = ''
        notesMonth.value = ''
        notesDay.value = ''
      } else {
        notesYear.value = String(match ? Number(match[1]) : today.getFullYear())
        notesMonth.value = monthLabel(match ? Number(match[2]) : today.getMonth() + 1)
        notesDay.value = String(match ? Number(match[3]) : today.getDate())
      }
      ;[notesDay, notesMonth, notesYear].forEach((field) => field.classList.remove('is-invalid'))
    }
    setNotesDate('', true)

    // Editing the note moves the date to today, unless the date was typed by hand for this form.
    let notesDateTouched = false
    ;[notesDay, notesMonth, notesYear].forEach((field) => field.addEventListener('input', () => { notesDateTouched = true }))
    document.querySelector('#pond-detail-notes').addEventListener('input', () => {
      if (!notesDateTouched) setNotesDate('')
    })

    // Calendar button: the browser's own date picker fills the three fields.
    const notesPicker = document.querySelector('[data-notes-date-picker]')
    document.querySelector('[data-notes-date-button]').addEventListener('click', () => {
      const today = new Date()
      notesPicker.value = notesDateValue() || `${today.getFullYear()}-${pad2(today.getMonth() + 1)}-${pad2(today.getDate())}`
      try {
        if (typeof notesPicker.showPicker === 'function') notesPicker.showPicker()
        else notesPicker.click()
      } catch {
        notesPicker.focus()
      }
    })
    // X button: empties the date (it stays empty until the user picks one or edits the note again).
    document.querySelector('[data-notes-date-clear]').addEventListener('click', () => {
      setNotesDate('', true)
      notesDateTouched = true
    })
    notesPicker.addEventListener('change', () => {
      if (!notesPicker.value) return
      notesDateTouched = true
      setNotesDate(notesPicker.value)
    })

    const selectedDocIds = new Set()
    const docMoveBar = document.querySelector('[data-pond-documentation-move-bar]')
    const docMoveTarget = document.querySelector('[data-doc-move-target]')
    const docMoveButton = document.querySelector('[data-doc-move-button]')
    const docGalleryButton = document.querySelector('[data-doc-gallery-button]')
    const docNoteTimers = new Map()

    // Destination list for moving fish/documentation: every other pond, grouped by area.
    const pondTargetOptions = (excludeId) => {
      const byArea = new Map()
      pondsData.filter((item) => String(item.id) !== String(excludeId)).forEach((item) => {
        const area = item.location || 'Tanpa Area'
        byArea.set(area, [...(byArea.get(area) || []), item])
      })
      return '<option value="">Pindah ke kolam...</option>' + orderedAreas(Array.from(byArea.keys())).map((area) => `
        <optgroup label="${escapeHtml(area)}">
          ${byArea.get(area).sort((a, b) => String(a.name).localeCompare(String(b.name), 'id', { numeric: true })).map((item) => `<option value="${item.id}">${text(item.name)}</option>`).join('')}
        </optgroup>
      `).join('')
    }

    const renderDocMoveBar = () => {
      const present = new Set(Array.from(documentationList.querySelectorAll('[data-doc-select]')).map((box) => box.dataset.docSelect))
      Array.from(selectedDocIds).forEach((id) => { if (!present.has(id)) selectedDocIds.delete(id) })
      docMoveBar.hidden = present.size === 0
      const keep = docMoveTarget.value
      docMoveTarget.innerHTML = pondTargetOptions(selectedPondId)
      docMoveTarget.value = keep && docMoveTarget.querySelector(`option[value="${keep}"]`) ? keep : ''
      // The count lives inside the button, so nothing is added to the row and the layout never shifts.
      docMoveButton.textContent = selectedDocIds.size ? `Pindahkan (${selectedDocIds.size})` : 'Pindahkan'
      docMoveButton.disabled = !selectedDocIds.size || !docMoveTarget.value
      docGalleryButton.disabled = !selectedDocIds.size
    }

    const renderDocumentation = (items) => {
      documentationList.innerHTML =
        items.map((item) => {
          const savedNote = pendingDocumentationNotes.get(String(item.id)) || item.notes || ''

          return `
          <div class="pond-documentation-item" data-pond-documentation-item="${item.id}" data-pond-documentation-url="${escapeHtml(item.image_url)}" data-pond-documentation-media-type="${escapeHtml(item.media_type || 'image')}" data-pond-documentation-thumb="${escapeHtml(item.thumbnail_url || '')}">
            <button class="btn btn-sm btn-danger pond-documentation-delete" type="button" data-delete-pond-documentation="${item.id}" data-role-required="farm-operate">Hapus</button>
            <label class="m-0" style="position:absolute;top:8px;left:8px;z-index:2;padding:4px 6px;line-height:1;border-radius:4px;background:rgba(0,0,0,.55)" data-role-required="farm-operate"><input class="form-check-input m-0" type="checkbox" data-doc-select="${item.id}" aria-label="Pilih dokumentasi" ${selectedDocIds.has(String(item.id)) ? 'checked' : ''} /></label>
            <a class="pond-documentation-preview" href="${escapeHtml(item.image_url)}" target="_blank" rel="noreferrer">
              ${
                item.media_type === 'video'
                  ? `<video src="${escapeHtml(item.image_url)}" preload="metadata"></video>`
                  : `<img src="${escapeHtml(item.image_url)}" alt="${escapeHtml(text(item.display_name || 'Dokumentasi kolam'))}" loading="lazy" />`
              }
            </a>
            <div class="pond-documentation-notes">
              <textarea class="form-control form-control-sm" name="pond_documentation_notes" rows="2" placeholder="Catatan dokumentasi" data-pond-documentation-notes="${item.id}" data-role-disable-unless="farm-operate">${escapeHtml(savedNote)}</textarea>
            </div>
          </div>
        `
        }).join('') || '<div class="text-secondary">Belum ada dokumentasi.</div>'
      renderDocMoveBar()
    }

    const loadDocumentation = async (pondId) => {
      documentationList.innerHTML = '<div class="text-secondary"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Memuat dokumentasi...</div>'

      try {
        const response = await fetch(`${apiUrl}/ponds/${pondId}/documentation`)

        if (!response.ok) {
          throw new Error('Dokumentasi gagal dimuat')
        }

        renderDocumentation(await response.json())
      } catch (error) {
        documentationList.innerHTML = '<div class="text-danger">Dokumentasi gagal dimuat.</div>'
      }
    }

    const documentationItems = () =>
      Array.from(documentationList.querySelectorAll('[data-pond-documentation-item]')).map((item) => {
        const notesInput = item.querySelector('[data-pond-documentation-notes]')

        return {
          id: item.dataset.pondDocumentationItem,
          image_url: item.dataset.pondDocumentationUrl || '',
          media_type: item.dataset.pondDocumentationMediaType || 'image',
          notes: notesInput?.value.trim() || pendingDocumentationNotes.get(item.dataset.pondDocumentationItem) || '',
        }
      }).filter((item) => item.id && item.image_url)

    const sortValue = (item, key) => {
      if (key === 'koi_count') {
        return totalPondQty(item)
      }

      if (key === 'unphotographed_fish_qty') {
        return Number(item.unphotographed_fish_qty || 0)
      }

      return String(item[key] || '').toLowerCase()
    }

    const pondSearchText = (item) => [item.name, item.location].filter(Boolean).join(' ').toLowerCase()

    // The navbar search feeds the hidden [data-pond-search] input. Spaces mean "all of these words" (so "mudpond 14"
    // finds exactly that pond), a comma separates alternatives ("konkret 01, konkret 02"), and "catatan:kata" looks in
    // the notes only. Name and area are what the plain words are matched against.
    const matchesSearch = (item) => {
      if (!searchQuery) {
        return true
      }

      let main = searchQuery
      let notesPhrase = ''
      const markerMatch = searchQuery.match(/(?:^|[\s,])ca(?:t(?:a(?:t(?:a(?:n)?)?)?)?)?\s*:/)
      const marker = markerMatch ? markerMatch.index : -1
      if (marker >= 0) {
        main = searchQuery.slice(0, marker)
        notesPhrase = searchQuery.slice(searchQuery.indexOf(':', marker) + 1).trim()
      }

      const alternatives = main.split(',').map((part) => part.split(/\s+/).filter(Boolean)).filter((words) => words.length)
      const searchableText = pondSearchText(item)

      if (alternatives.length && !alternatives.some((words) => words.every((word) => searchableText.includes(word)))) {
        return false
      }

      if (notesPhrase && !String(item.notes || '').toLowerCase().includes(notesPhrase)) {
        return false
      }

      return true
    }

    const sortedPonds = () =>
      pondsData.filter(matchesSearch).sort((a, b) => {
        const first = sortValue(a, sortState.key)
        const second = sortValue(b, sortState.key)
        const result = typeof first === 'number' && typeof second === 'number' ? first - second : first.localeCompare(second)

        return sortState.direction === 'asc' ? result : -result
      })

    const groupedPonds = (ponds) =>
      ponds.reduce((groups, pond) => {
        const area = text(pond.location)

        if (!groups.has(area)) {
          groups.set(area, [])
        }

        groups.get(area).push(pond)
        return groups
      }, new Map())

    const knownAreas = () => Array.from(new Set(pondsData.map((pond) => text(pond.location))))

    const printAssetUrl = (src) => {
      const value = text(src).trim()

      if (!value) return ''
      if (/^(data:|blob:|https?:\/\/)/i.test(value)) return value

      const apiResolved = window.KoiAuth?.apiUrl ? window.KoiAuth.apiUrl(value) : value

      try {
        return new URL(apiResolved, window.location.origin).href
      } catch (error) {
        return apiResolved
      }
    }

    // DEAD CODE (diperiksa 2026-10-14): printableImage tidak dipanggil di mana pun. Aman dihapus; sengaja belum dihapus.
    const printableImage = (src, alt) => {
      const imageSrc = printAssetUrl(src)

      return imageSrc
        ? `<img class="print-fish-photo" src="${escapeHtml(imageSrc)}" alt="${escapeHtml(alt || 'Foto ikan')}" decoding="sync" />`
        : '<div class="print-fish-photo print-fish-photo-empty">No foto</div>'
    }

    const printStyles = () => `
      <style>
