          text-transform: uppercase;
        }

        .print-table tr {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        .print-fish-photo {
          display: block;
          width: 52px;
          height: 70px;
          object-fit: contain;
          border: 1px solid #cbd5e1;
          border-radius: 3px;
          background: #f8fafc;
        }

        .print-fish-photo-empty {
          display: flex;
          align-items: center;
          justify-content: center;
          color: #64748b;
          font-size: 9px;
          text-align: center;
        }

        @media print {
          @page {
            size: auto;
            margin: 10mm;
          }

