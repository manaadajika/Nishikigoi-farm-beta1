    const setUploadedImage = (entry, imageUrl) => {
      const imageUrlInput = entry.querySelector('[data-koi-image-url]')
      const uploadPreview = entry.querySelector('[data-koi-upload-preview]')
      const uploadEmpty = entry.querySelector('[data-koi-upload-empty]')
      const uploadStatus = entry.querySelector('[data-koi-upload-status]')

      pendingZipImages.delete(entry)
      imageUrlInput.value = imageUrl
      uploadPreview.src = imageUrl
      uploadPreview.classList.remove('d-none')
      uploadEmpty.classList.add('d-none')
      uploadStatus.textContent = ''
    }

    const setPendingZipImage = (entry, file) => {
      const imageUrlInput = entry.querySelector('[data-koi-image-url]')
      const uploadPreview = entry.querySelector('[data-koi-upload-preview]')
      const uploadEmpty = entry.querySelector('[data-koi-upload-empty]')
      const uploadStatus = entry.querySelector('[data-koi-upload-status]')
      const previewUrl = URL.createObjectURL(file)

      pendingZipImages.set(entry, { file, previewUrl })
      imageUrlInput.value = ''
      uploadPreview.src = previewUrl
      uploadPreview.classList.remove('d-none')
      uploadEmpty.classList.add('d-none')
      uploadStatus.textContent = 'Foto dari ZIP siap diupload saat Simpan.'
    }

    const initEntryHelpPopovers = () => {
      if (!window.bootstrap?.Popover) {
        return
      }

      entriesContainer.querySelectorAll('[data-bs-toggle="popover"]').forEach((element) => {
        window.bootstrap.Popover.getOrCreateInstance(element, {
          container: 'body',
          trigger: 'manual',
        })
      })
    }

    const toggleEntryHelpPopover = (button) => {
      const message = button.dataset.bsContent || ''

      if (!window.bootstrap?.Popover) {
        if (activeHelpPopover?.button === button) {
          activeHelpPopover.element.remove()
          activeHelpPopover = null
          return
        }

        activeHelpPopover?.element.remove()

        const popover = document.createElement('div')
        popover.className = 'koi-help-popover'
        popover.textContent = message
        document.body.appendChild(popover)

        const buttonRect = button.getBoundingClientRect()
        const popoverRect = popover.getBoundingClientRect()
        const top = Math.max(8, buttonRect.top - popoverRect.height - 8)
        const left = Math.min(
          window.innerWidth - popoverRect.width - 8,
          Math.max(8, buttonRect.left + buttonRect.width / 2 - popoverRect.width / 2),
        )

        popover.style.top = `${top}px`
        popover.style.left = `${left}px`
        activeHelpPopover = { button, element: popover }
        return
      }

      activeHelpPopover?.element.remove()
      activeHelpPopover = null

      entriesContainer.querySelectorAll('[data-bs-toggle="popover"]').forEach((element) => {
        if (element !== button) {
          window.bootstrap.Popover.getInstance(element)?.hide()
        }
      })

      window.bootstrap.Popover.getOrCreateInstance(button, {
        container: 'body',
        trigger: 'manual',
      }).toggle()
    }

    const initEntryDatepickers = (root = entriesContainer) => {
      if (!window.Litepicker) {
        return
      }

      root.querySelectorAll('[data-koi-datepicker]').forEach((input) => {
        if (input.dataset.koiDatepickerReady) {
          return
        }

        new window.Litepicker({
          element: input,
          format: 'YYYY-MM-DD',
          singleMode: true,
          autoApply: true,
          dropdowns: {
            minYear: 1990,
            maxYear: new Date().getFullYear() + 5,
            months: true,
            years: true,
          },
        })
        input.dataset.koiDatepickerReady = 'true'
      })
    }

    const uploadPrefixFromCode = (code, fallback = 'koi') => {
      const safeCode = String(code || '')
        .trim()
        .replace(/[^a-z0-9_-]+/gi, '-')
        .replace(/^-+|-+$/g, '')

      return safeCode || fallback
    }

    const uploadImage = async (entry, file) => {
      if (!file || !file.type.startsWith('image/')) {
        return
      }

      const uploadStatus = entry.querySelector('[data-koi-upload-status]')
      const uploadBox = entry.querySelector('[data-koi-upload-box]')
      const uploadEmpty = entry.querySelector('[data-koi-upload-empty]')

      uploadBox.classList.add('is-loading')
      uploadEmpty.innerHTML = '<div class="w-100 px-2"><div class="small fw-medium mb-2">Mengompres dan mengupload foto...</div><div class="progress progress-sm"><div class="progress-bar progress-bar-indeterminate"></div></div></div>'
      uploadStatus.textContent = 'Memproses foto agar lebih ringan.'

      try {
        const compressedImageData = await compressImageFile(file)
        const imageData = compressedImageData || await readFileAsDataUrl(file)
        const response = await fetch(`${apiUrl}/koi-images`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_data: imageData,
            prefix: uploadPrefixFromCode(entry.querySelector('[name="code"]')?.value),
          }),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Foto gagal diupload')
        }

        setUploadedImage(entry, data.image_url)
      } catch (error) {
        uploadEmpty.innerHTML = '<div class="fw-medium small">Unggah foto</div><div class="text-secondary small">Belum ada foto</div>'
        throw error
      } finally {
        uploadBox.classList.remove('is-loading')
      }
    }

    const uploadPendingZipImages = async (entries) => {
      const pendingEntries = entries.filter((entry) => pendingZipImages.has(entry))

      if (pendingEntries.length === 0) {
        return
      }

      for (const [index, entry] of pendingEntries.entries()) {
        const pending = pendingZipImages.get(entry)
        const code = entry.querySelector('[name="code"]')?.value || `Entry ${index + 1}`

        showImportStatus(`Mengupload foto ZIP ${index + 1}/${pendingEntries.length}: ${code}`)
        await uploadImage(entry, pending.file)
        if (pending.previewUrl) {
          URL.revokeObjectURL(pending.previewUrl)
        }
      }
      hideImportStatus()
    }

    const uploadProgressPhoto = async (file) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!file || !file.type.startsWith('image/') || !koiId) {
        return
      }

      editProgressPhotoButton.disabled = true
      editProgressPhotoButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-label="Unggah foto progress"></span><span class="progress progress-sm flex-fill"><span class="progress-bar progress-bar-indeterminate"></span></span>'

      try {
        const compressedImageData = await compressImageFile(file)
        const imageData = compressedImageData || await readFileAsDataUrl(file)
        const uploadResponse = await fetch(`${apiUrl}/koi-images`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_data: imageData,
            prefix: `${uploadPrefixFromCode(editForm.querySelector('[name="code"]')?.value)}-progress`,
          }),
        })
        const uploadData = await uploadResponse.json()

        if (!uploadResponse.ok) {
          throw new Error(uploadData.error || 'Foto progress gagal diupload')
        }

        const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            image_url: uploadData.image_url,
            measured_at: new Date().toISOString().slice(0, 10),
            length_cm: editForm.querySelector('[name="current_length_cm"]').value,
          }),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Foto progress gagal disimpan')
        }

        await loadPhotoHistory(koiId)
        editKoiPreview.innerHTML = `<img style="cursor:zoom-in" src="${escapeHtml(uploadData.image_url)}" alt="Foto terbaru" />`
        keepScroll(loadKoi)
      } finally {
        editProgressPhotoButton.disabled = false
        editProgressPhotoButton.innerHTML = uploadIcon
        editProgressPhotoInput.value = ''
      }
    }

    const readClipboardImageFile = async (filename = 'clipboard-progress') => {
      if (!navigator.clipboard?.read) {
        throw new Error('Browser belum mengizinkan baca clipboard gambar.')
      }

      const items = await navigator.clipboard.read()
      for (const item of items) {
        const imageType = item.types.find((type) => type.startsWith('image/'))
        if (!imageType) {
          continue
        }

        const blob = await item.getType(imageType)
        const extension = imageType.split('/')[1] || 'png'
        return new File([blob], `${filename}.${extension}`, { type: imageType })
      }

      throw new Error('Clipboard tidak berisi gambar.')
    }

    const syncEmptyState = (count) => {
      const empty = document.querySelector('[data-koi-empty-state]')
      if (empty) empty.classList.toggle('d-none', count > 0)
      document.querySelector('.koi-bulk-card[aria-label="Aksi masal"]')?.classList.toggle('d-none', count === 0)
      if (submitButton) submitButton.disabled = count === 0
      if (draftButton) draftButton.disabled = count === 0 || bulkEditKoiIds.length > 0
    }
    const refreshEntryControls = () => {
      const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
      syncEmptyState(entries.length)
      entries.forEach((entry, index) => {
        entry.querySelector('[data-koi-entry-index]').textContent = index + 1
        entry.querySelector('[data-remove-koi-entry]').disabled = false
        entry.querySelectorAll('[data-entry-gender]').forEach((input) => {
          input.name = `entry_gender_option_${index}`
        })
      })
      initEntryDatepickers()
    }

    const updateEntrySourceBadge = (entry) => {
      const badge = entry.querySelector('[data-entry-source-badge]')
      const isExisting = Boolean(entry.dataset.editKoiId)

      if (!badge) {
        return
      }

      badge.textContent = isExisting ? 'Data existing' : 'Data baru'
      badge.classList.toggle('bg-blue-lt', !isExisting)
      badge.classList.toggle('bg-green-lt', isExisting)
    }

    let bulkEntryLoad = false
    const startBulkEntryLoad = () => {
      bulkEntryLoad = true
      setTimeout(() => { bulkEntryLoad = false }, 0)
    }
    const addKoiEntry = () => {
      entriesContainer.insertAdjacentHTML('beforeend', createEntryTemplate())
      updateEntrySourceBadge([...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1))
      if (!bulkEntryLoad) refreshEntryControls();
    }

    const ensureEntryCount = (count) => {
      while (entriesContainer.querySelectorAll('[data-koi-entry]').length < count) {
        addKoiEntry()
      }
    }

    const uploadBulkImages = async (files) => {
      const imageFiles = [...files].filter((file) => file.type.startsWith('image/'))

      if (imageFiles.length === 0) {
        return
      }

      ensureEntryCount(imageFiles.length)
      bulkUploadButton.disabled = true
      bulkUploadButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Unggah masal"></span>'

      const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')].slice(0, imageFiles.length)

      try {
        await Promise.all(imageFiles.map((file, index) => uploadImage(entries[index], file).catch((error) => {
          entries[index].querySelector('[data-koi-upload-status]').textContent = error.message
        })))
      } finally {
        bulkUploadButton.disabled = false
        bulkUploadButton.innerHTML = uploadIcon
        bulkUploadInput.value = ''
      }
    }

    const renderBulkInput = () => {
      bulkValueContainer.innerHTML = bulkFieldConfig[bulkField.value]?.() || ''
      initEntryDatepickers(bulkValueContainer)
      if (bulkField.value === 'parent_info') {
        updateBulkParentSelectors()
      }
    }

    const setEntryGender = (entry, gender = 'unknown') => {
      const normalizedGender = ['unknown', 'male', 'female'].includes(gender) ? gender : 'unknown'
      const genderInput = entry.querySelector('[name="gender"]')

      if (genderInput) {
        genderInput.value = normalizedGender
      }

      entry.querySelectorAll('[data-entry-gender]').forEach((input) => { input.value = normalizedGender })
    }

    let serverBulkIds = []
    let serverBulkHintText = ''
    const bulkHintElement = () => bulkValueContainer.closest('.koi-bulk-card')?.querySelector('.form-hint')
    let serverBulkCodeMode = false
    const syncBulkChips = (on) => {
      const card = bulkValueContainer.closest('.koi-bulk-card')
      const row = card?.querySelector('.koi-bulk-row-apply')
      const fieldCell = bulkField.closest('.koi-bulk-row-apply > div')
      card?.querySelector('[data-bulk-chips]')?.remove()

      if (!card || !row) return
      if (fieldCell) fieldCell.style.display = on ? 'none' : ''
      row.style.gridTemplateColumns = on ? 'minmax(0, 1fr) auto' : ''
      if (!on) return

      if (bulkField.value === 'code') {
        bulkField.value = 'pond_id'
        renderBulkInput()
      }
      // one click per thing to change, like Status Hasil Breeding; the field to fill appears under the buttons
      const box = document.createElement('div')
      box.setAttribute('data-bulk-chips', '')
      box.className = 'form-selectgroup mb-3'
      box.style.cssText = 'display:flex;flex-wrap:wrap;gap:.35rem;width:100%'
      
      const addChip = (value, text, onPick) => {
        const label = document.createElement('label')
        label.className = 'form-selectgroup-item'
        const input = document.createElement('input')
        input.type = 'radio'
        input.name = 'bulk_chip'
        input.value = value
        input.className = 'form-selectgroup-input'
        input.addEventListener('change', onPick)
        const span = document.createElement('span')
        span.className = 'form-selectgroup-label'
        span.textContent = text
        label.append(input, span)
        box.append(label)
        return input
      }
      serverBulkCodeMode = false
      addChip('code_auto', 'Kode Koi', () => {
        serverBulkCodeMode = true
        bulkValueContainer.innerHTML = '<div class="text-secondary small">Buat ulang Kode Koi otomatis (tahun + 4 karakter acak) untuk semua ikan terpilih. Kode lama diganti dan dicatat di Catatan ikan.</div>'
      })
;[...bulkField.options].filter((option) => !option.disabled && option.value !== 'code').forEach((option) => {
        const label = document.createElement('label')
        label.className = 'form-selectgroup-item'
        const input = document.createElement('input')
        input.type = 'radio'
        input.name = 'bulk_chip'
        input.value = option.value
        input.className = 'form-selectgroup-input'
        input.checked = bulkField.value === option.value
        input.addEventListener('change', () => {
          serverBulkCodeMode = false
          bulkField.value = option.value
          bulkField.dispatchEvent(new Event('change', { bubbles: true }))
        })
        const text = document.createElement('span')
        text.className = 'form-selectgroup-label'
        text.textContent = option.textContent.trim()
        label.append(input, text)
        box.append(label)
      })
      row.before(box)
    }
    const setServerBulkMode = (on, count = 0) => {
      const display = on ? 'none' : ''
      // the Aksi masal card is normally hidden until the form has rows; in this mode it is the whole popup
      bulkValueContainer.closest('.koi-bulk-card')?.classList.toggle('d-none', !on && !entriesContainer.querySelector('[data-koi-entry]'))
      const bulkToolbar = bulkValueContainer.closest('.koi-bulk-toolbar')
      if (bulkToolbar) bulkToolbar.style.gridTemplateColumns = on ? '1fr' : ''
      // room under the fields so the suggestion lists (kolam, variety...) are not cut off by the popup's own scroll
      const popupBody = bulkValueContainer.closest('.modal-body')
      if (popupBody) popupBody.style.minHeight = on ? '460px' : ''
      const pullCard = pullKoiIdsInput?.closest('.koi-bulk-card')
      if (pullCard) pullCard.style.display = display
      entriesContainer.style.display = display
      const emptyState = form.querySelector('[data-koi-empty-state]')
      if (emptyState) emptyState.style.display = display
      form.querySelectorAll('.modal-footer > *').forEach((element) => {
        if (!element.hasAttribute('data-bs-dismiss')) element.style.display = display
      })
      const codeOption = bulkField.querySelector('option[value="code"]')
      if (codeOption) codeOption.disabled = on
      const areaOption = bulkField.querySelector('option[value="area"]')
      if (areaOption) areaOption.disabled = !on
      syncBulkChips(on)
      const hint = bulkHintElement()
      if (on) {
        if (hint) {
          serverBulkHintText = hint.textContent
          hint.textContent = `Berlaku untuk ${count} ikan terpilih. Perubahan langsung disimpan ke server per 200 ikan.`
        }
        if (bulkField.value === 'code') {
          bulkField.value = 'pond_id'
          renderBulkInput()
        }
      } else {
        serverBulkIds = []
        if (hint && serverBulkHintText) hint.textContent = serverBulkHintText
      }
    }
    const serverBulkPayload = (fieldName) => {
      const raw = bulkValueContainer.querySelector('[data-bulk-value]')?.value || ''
      const value = moneyFieldNames.has(fieldName) ? cleanMoneyValue(raw) : raw

      if (fieldName === 'pond_id') {
        if (!String(value).trim()) return { pond_id: null }
        const pond = findPondByName(value)
        if (!pond) throw new Error('Lokasi tidak ditemukan. Pilih lokasi dari daftar.')
        return { pond_id: pond.id, area: null }
      }
      if (fieldName === 'area') return { area: String(value).trim() }
      if (fieldName === 'parent_type') return { parent_type: value === 'indukan' ? 'indukan' : 'non_indukan' }
      if (fieldName === 'parent_info') {
        const shortcut = parseBulkParentShortcut(raw)
        const female = bulkValueContainer.querySelector('[data-bulk-parent-female]')?.value || ''
        const male = bulkValueContainer.querySelector('[data-bulk-parent-male]')?.value || 'mix'
        return { parent_info: shortcut?.breeding ? selectedBreederLabel(shortcut.breeding, shortcut.male || male, shortcut.female || female) : value }
      }
      return { [fieldName]: value }
    }
    const regenerateCodesOnServer = async () => {
      const ids = [...serverBulkIds]
      const applyButton = bulkValueContainer.closest('.koi-bulk-card')?.querySelector('[data-apply-bulk-value]')
      const hint = bulkHintElement()

      errorBox.classList.add('d-none')
      if (!(await window.KoiDialog.confirm(`Buat ulang Kode Koi otomatis untuk ${ids.length} ikan terpilih?

Kode lama tidak berlaku lagi (perubahannya ditulis di Catatan tiap ikan). Teks di tempat lain yang menulis kode lama, misalnya Indukan/Breeding ikan lain, tidak ikut berubah.`))) return

      let done = 0
      if (applyButton) applyButton.disabled = true
      try {
        for (let index = 0; index < ids.length; index += 100) {
          const chunk = ids.slice(index, index + 100)
          const response = await fetch(`${apiUrl}/koi/regenerate-codes`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ids: chunk.map(Number) }),
          })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error(data.error || 'Kode baru gagal dibuat')
          done += chunk.length
          if (hint) hint.textContent = `Membuat kode... ${done} dari ${ids.length} ikan`
        }
        if (hint) hint.textContent = `Selesai: Kode Koi baru dibuat untuk ${done} ikan.`
        keepScroll(loadKoi)
      } catch (error) {
        errorBox.textContent = `${error.message} (${done} dari ${ids.length} ikan sudah berganti kode)`
        errorBox.classList.remove('d-none')
      } finally {
        if (applyButton) applyButton.disabled = false
      }
    }
    const applyBulkToServer = async () => {
      if (serverBulkCodeMode) {
        await regenerateCodesOnServer()
        return
      }
      const fieldName = bulkField.value
      const label = bulkField.selectedOptions[0]?.textContent.trim() || fieldName
      const applyButton = bulkValueContainer.closest('.koi-bulk-card')?.querySelector('[data-apply-bulk-value]')
      const hint = bulkHintElement()
      let fields

      try {
        fields = serverBulkPayload(fieldName)
      } catch (error) {
        errorBox.textContent = error.message
        errorBox.classList.remove('d-none')
        return
      }
      const notesReplace = fieldName === 'notes' && Boolean(bulkValueContainer.querySelector('[data-bulk-notes-replace]')?.checked)
      const notesAppend = fieldName === 'notes' && !notesReplace
      if (notesAppend && !String(fields.notes || '').trim()) {
        errorBox.textContent = 'Isi catatan terlebih dahulu.'
        errorBox.classList.remove('d-none')
        return
      }
      errorBox.classList.add('d-none')
      const confirmText = notesAppend
        ? `Tambahkan catatan ke ${serverBulkIds.length} ikan terpilih? Catatan yang sudah ada tidak dihapus.`
        : notesReplace
          ? `GANTI catatan ${serverBulkIds.length} ikan terpilih? Semua catatan yang sudah ada akan DIHAPUS dan diganti dengan teks ini.`
          : `Ubah "${label}" untuk ${serverBulkIds.length} ikan terpilih?

Nilai baru: ${bulkValueContainer.querySelector('[data-bulk-value]')?.value || '(dikosongkan)'}

Perubahan ini berlaku untuk SEMUA ikan terpilih, bukan hanya yang tampil di layar.`
      if (!(await window.KoiDialog.confirm(confirmText))) return

      const ids = [...serverBulkIds]
      let done = 0
      let sessionLinked = 0
      if (applyButton) applyButton.disabled = true
      try {
        for (let index = 0; index < ids.length; index += 200) {
          const chunk = ids.slice(index, index + 200)
          const response = await fetch(`${apiUrl}/koi/bulk-update`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ids: chunk.map(Number), fields, relocation_note: fieldName === 'pond_id', area_rule: fieldName === 'area', notes_append: notesAppend }),
          })
          const data = await response.json().catch(() => ({}))
          if (!response.ok) throw new Error(data.error || 'Perubahan masal gagal disimpan')
          sessionLinked += Number(data.session_linked || 0)
          done += chunk.length
          if (hint) hint.textContent = `Menyimpan... ${done} dari ${ids.length} ikan`
        }
        if (hint) hint.textContent = `Selesai: ${label} diubah untuk ${done - sessionLinked} ikan.${sessionLinked ? ` ${sessionLinked} ikan yang punya sesi Indukan/Breeding tidak diubah karena Bloodline dan Ternakannya mengikuti sesi.` : ''}`
        keepScroll(loadKoi)
      } catch (error) {
        errorBox.textContent = `${error.message} (${done} dari ${ids.length} ikan sudah tersimpan)`
        errorBox.classList.remove('d-none')
      } finally {
        if (applyButton) applyButton.disabled = false
      }
    }
    modalElement.addEventListener('hidden.bs.modal', () => {
      if (serverBulkIds.length) setServerBulkMode(false)
    })
    const openMassActionPopup = () => {
      const ids = [...selectedKoiIds].map(String)

      if (ids.length === 0) {
        return
      }

      serverBulkIds = ids
      bulkEditKoiIds = []
      addFormTitle.textContent = `Aksi Masal ${ids.length} Ikan Terpilih`
      form.reset()
      errorBox.classList.add('d-none')
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      setServerBulkMode(true, ids.length)
      openModal(modalElement)
    }
    const applyBulkValue = () => {
      if (serverBulkIds.length) {
        applyBulkToServer()
        return
      }
      const fieldName = bulkField.value
      const rawBulkValue = bulkValueContainer.querySelector('[data-bulk-value]')?.value || ''
      const notesReplaceLocal = Boolean(bulkValueContainer.querySelector('[data-bulk-notes-replace]')?.checked)
      const bulkValue = moneyFieldNames.has(fieldName) ? cleanMoneyValue(rawBulkValue) : rawBulkValue
      const bulkParentShortcut = fieldName === 'parent_info' ? parseBulkParentShortcut(rawBulkValue) : null
      const bulkParentFemale = bulkValueContainer.querySelector('[data-bulk-parent-female]')?.value || ''
      const bulkParentMale = bulkValueContainer.querySelector('[data-bulk-parent-male]')?.value || 'mix'
      const bulkParentValue = bulkParentShortcut?.breeding
        ? selectedBreederLabel(bulkParentShortcut.breeding, bulkParentShortcut.male || bulkParentMale, bulkParentShortcut.female || bulkParentFemale)
        : bulkValue

      const selectedEntries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
        .filter((entry) => entry.querySelector('[data-entry-bulk-apply]')?.checked)

      if (fieldName === 'code') {
        const codes = splitCodeList(rawBulkValue)
        const uniqueCodes = new Set(codes.map((code) => code.toUpperCase()))

        if (codes.length === 0) {
          selectedEntries.forEach((entry) => {
            const field = entry.querySelector('[name="code"]')
            if (field) field.value = ''
          })
          errorBox.classList.add('d-none')
          return
        }
        if (uniqueCodes.size !== codes.length) {
          errorBox.textContent = 'Kode Koi aksi masal tidak boleh duplikat.'
          errorBox.classList.remove('d-none')
          return
        }
        if (codes.length !== selectedEntries.length) {
          errorBox.textContent = `Jumlah Kode Koi (${codes.length}) harus sama dengan entry yang dicentang (${selectedEntries.length}).`
          errorBox.classList.remove('d-none')
          return
        }

        selectedEntries.forEach((entry, index) => {
          const field = entry.querySelector('[name="code"]')
          if (field) field.value = codes[index]
        })
        errorBox.classList.add('d-none')
        return
      }

      selectedEntries.forEach((entry) => {
        if (fieldName === 'pond_id') {
          const pond = findPondByName(bulkValue)
          setEntryPond(entry, pond?.id || '')
          return
        }

        if (fieldName === 'gender') {
          setEntryGender(entry, bulkValue)
          return
        }

        if (fieldName === 'parent_type') {
          entry.querySelector('[name="parent_type"]').checked = bulkValue === 'indukan'
          return
        }

        if (fieldName === 'notes' && !notesReplaceLocal) {
          // add mode: the text goes on a new line under the note the entry already has
          const notesField = entry.querySelector('[name="notes"]')
          if (notesField && bulkValue.trim()) {
            const oldNote = notesField.value.trim()
            notesField.value = oldNote ? `${bulkValue.trim()}\n-----------\n\n${oldNote}` : bulkValue.trim()
          }
          return
        }

        const field = entry.querySelector(`[name="${fieldName}"]`)

        if (field) {
          field.value = fieldName === 'parent_info'
            ? bulkParentValue
            : moneyFieldNames.has(fieldName) ? formatMoneyValue(bulkValue) : bulkValue
        }

        if (fieldName === 'parent_info') {
          const maleSelect = entry.querySelector('[data-entry-parent-male]')
          if (maleSelect) {
            maleSelect.value = bulkParentShortcut?.male || bulkParentMale
          }
          updateEntryParentPreview(entry)
        }
      })
    }

    const readEntryPayload = (entry) => {
      syncEntryPond(entry)
      const value = (name) => {
        const fieldValue = entry.querySelector(`[name="${name}"]`)?.value || ''

        return moneyFieldNames.has(name) ? cleanMoneyValue(fieldValue) : fieldValue
      }
      const parentType = entry.querySelector('[name="parent_type"]').checked ? 'indukan' : 'non_indukan'
      const parentMale = entry.querySelector('[data-entry-parent-male]')?.value || 'mix'

      return {
        code: value('code'),
        name: value('name'),
        pond_id: value('pond_id'),
        area: value('pond_id') ? '' : String(value('area') || '').trim(),
        variety: value('variety'),
        bloodline: value('bloodline'),
        farm_name: value('farm_name'),
        breeder: value('breeder'),
        parent_info: enrichParentInfoValue(value('parent_info'), parentMale),
        gender: value('gender'),
        parent_type: parentType,
        image_url: value('image_url'),
        birth_date: value('birth_date'),
        purchase_date: value('purchase_date'),
        purchase_price: value('purchase_price'),
        sale_price: value('sale_price'),
        current_length_cm: value('current_length_cm'),
        status: value('status'),
        notes: value('notes'),
      }
    }

    const saveKoiDraft = async () => {
      const items = [...entriesContainer.querySelectorAll('[data-koi-entry]')].map(readEntryPayload)
      const saved = await window.KoiDrafts.save({
        type: 'koi',
        id: currentKoiDraftId || undefined,
        summary: koiDraftSummary(items),
        item_count: items.length,
        data: { items },
      })
      currentKoiDraftId = saved.id
      draftButton.innerHTML = draftIcon
      showImportStatus('Draft tersimpan di Antrean.')
      await refreshKoiDrafts()
    }

    const setEntryValue = (entry, name, value) => {
      const field = entry.querySelector(`[name="${name}"]`)

      if (field) {
        field.value = moneyFieldNames.has(name)
          ? formatMoneyValue(value)
          : decimalFieldNames.has(name)
            ? formatDecimalForInput(value)
            : field.type === 'date'
              ? String(value || '').slice(0, 10)
              : value || ''
      }
    }

    const fillEntryFromDraft = (entry, item) => {
      entry.dataset.editKoiId = item.id || ''
      updateEntrySourceBadge(entry)
      setEntryValue(entry, 'code', item.code)
      setEntryValue(entry, 'name', item.name)
      setEntryPond(entry, item.pond_id)
      {
        const typedArea = String(item.area !== undefined && item.area !== null ? item.area : (item.pond_location || '')).trim()
        if (typedArea || !item.pond_id) setEntryValue(entry, 'area', typedArea)
      }
      setEntryValue(entry, 'variety', item.variety)
      setEntryValue(entry, 'bloodline', item.bloodline)
      setEntryValue(entry, 'farm_name', item.farm_name)
      setEntryValue(entry, 'breeder', item.breeder)
      setEntryValue(entry, 'parent_info', item.parent_info)
      setEntryGender(entry, item.gender || 'unknown')
      entry.querySelector('[name="parent_type"]').checked = item.parent_type === 'indukan'
      setEntryValue(entry, 'status', item.status || 'active')
      setEntryValue(entry, 'birth_date', item.birth_date)
      updateEntryParentPreview(entry)
      setEntryValue(entry, 'purchase_date', item.purchase_date)
      setEntryValue(entry, 'purchase_price', item.purchase_price)
      setEntryValue(entry, 'sale_price', item.sale_price)
      setEntryValue(entry, 'current_length_cm', item.current_length_cm)
      setEntryValue(entry, 'notes', item.notes)

      if (item.image_url) {
        setUploadedImage(entry, item.image_url)
      }
    }

    const resetAddFormMode = () => {
      setServerBulkMode(false)
      currentKoiDraftId = null
      bulkEditKoiIds = []
      addFormTitle.textContent = 'Formulir Tambah Ikan'
      addEntryButton.disabled = false
      draftButton.disabled = false
      draftToggle.disabled = false
      if (pullKoiIdsInput) pullKoiIdsInput.value = ''
      if (pullKoiIdsStatus) pullKoiIdsStatus.textContent = ''
      form.reset()
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      refreshEntryControls()
    }

    const openSelectedEditForm = () => {
      const items = selectedKoiItems()

      if (items.length === 0) {
        return
      }
      const maxEditRows = 150
      if (items.length > maxEditRows) {
        serverBulkIds = items.map((item) => String(item.id))
        bulkEditKoiIds = []
        addFormTitle.textContent = `Edit Masal ${items.length} Ikan Terpilih`
        form.reset()
        errorBox.classList.add('d-none')
        entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
        setServerBulkMode(true, items.length)
        openModal(modalElement)
        return
      }


      setServerBulkMode(false)
      bulkEditKoiIds = items.map((item) => String(item.id))
      addFormTitle.textContent = `Formulir Edit ${items.length} Ikan Terpilih`
      addEntryButton.disabled = true
      draftButton.disabled = true
      draftToggle.disabled = true
      if (pullKoiIdsInput) pullKoiIdsInput.value = ''
      if (pullKoiIdsStatus) pullKoiIdsStatus.textContent = `${items.length} data existing masuk ke formulir edit.`
      form.reset()
      errorBox.classList.add('d-none')
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())

      startBulkEntryLoad();
items.forEach((item) => {
        addKoiEntry()
        const entry = [...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1)
        fillEntryFromDraft(entry, {
          ...item,
          birth_date: item.birth_date ? String(item.birth_date).slice(0, 10) : '',
          purchase_date: item.purchase_date ? String(item.purchase_date).slice(0, 10) : '',
        })
      })

      refreshEntryControls()
      openModal(modalElement)
    }

    const loadKoiDraft = async (draftId) => {
      let draft
      try {
        draft = await window.KoiDrafts.get(draftId)
      } catch (error) {
        showKoiError(error.message)
        return
      }
      const items = Array.isArray(draft.data?.items) ? draft.data.items : []
      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      startBulkEntryLoad();
items.forEach((item) => {
        addKoiEntry()
        fillEntryFromDraft([...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1), item)
      })
      
      currentKoiDraftId = draft.id
      refreshEntryControls()
      showImportStatus(`Draft dimuat: ${draft.name || draft.summary || formatDraftName(draft.created_at)}`)
    }

    const deleteKoiDraft = async (draftId) => {
      if (!(await window.KoiDialog.confirm('Hapus draft ini?'))) return
      try {
        await window.KoiDrafts.remove(draftId)
      } catch (error) {
        showKoiError(error.message)
      }
      if (String(currentKoiDraftId) === String(draftId)) currentKoiDraftId = null
      await refreshKoiDrafts()
    }

    const renameKoiDraft = async (draftId) => {
      const draft = koiDraftCache.find((item) => String(item.id) === String(draftId))

      if (!draft) {
        return
      }

      const nextName = (await window.KoiDialog.prompt('Nama draft', draft.name || draft.summary || formatDraftName(draft.created_at)))?.trim()

      if (!nextName) {
        return
      }

      try {
        await window.KoiDrafts.rename(draftId, nextName)
      } catch (error) {
        showKoiError(error.message)
      }
      await refreshKoiDrafts()
    }

    const renderDraftMenu = () => {
      const drafts = readKoiDrafts()

      draftMenu.innerHTML = drafts.length
        ? drafts.map((draft) => `
          <div class="koi-draft-item">
            <button class="dropdown-item text-wrap" type="button" data-load-koi-draft="${escapeHtml(draft.id)}">
              <span class="d-block">${escapeHtml(draft.name || draft.summary || formatDraftName(draft.created_at))}</span>
              <span class="d-block small text-secondary">${escapeHtml([draft.updated_by_name || draft.created_by_name, window.KoiDrafts?.formatTime(draft.updated_at)].filter(Boolean).join(' · '))}</span>
            </button>
            <button class="btn btn-outline-primary btn-sm btn-icon" type="button" data-rename-koi-draft="${escapeHtml(draft.id)}" data-role-required="database-write" aria-label="Rename draft" title="Rename draft">
              ${pencilIcon}
            </button>
            <button class="btn btn-outline-danger btn-sm btn-icon" type="button" data-delete-koi-draft="${escapeHtml(draft.id)}" data-role-required="database-write" aria-label="Hapus draft" title="Hapus draft">
              ${trashIcon}
            </button>
          </div>
        `).join('')
        : '<span class="dropdown-item text-secondary">Belum ada draft</span>'
    }

    const readEditPayload = () => {
      syncEditPond()
      const value = (name) => {
        const fieldValue = editForm.querySelector(`[name="${name}"]`)?.value || ''

        return moneyFieldNames.has(name) ? cleanMoneyValue(fieldValue) : fieldValue
      }
      const editParentMale = editBreederMale?.value || 'mix'

      return {
        code: value('code'),
        name: value('name'),
        pond_id: value('pond_id'),
        area: value('pond_id') ? '' : String(editForm.querySelector('[data-edit-pond-location]')?.value || '').trim(),
        variety: value('variety'),
        bloodline: value('bloodline'),
        farm_name: value('farm_name'),
        breeder: value('breeder'),
        parent_info: enrichParentInfoValue(value('parent_info'), editParentMale),
        gender: value('gender'),
        parent_type: editForm.querySelector('[name="parent_type"]').checked ? 'indukan' : 'non_indukan',
        birth_date: value('birth_date'),
        purchase_date: value('purchase_date'),
        purchase_price: value('purchase_price'),
        sale_price: value('sale_price'),
        current_length_cm: value('current_length_cm'),
        status: value('status'),
        notes: value('notes'),
      }
    }

    const lastEditedDayNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']
    const formatLastEdited = (value) => (value ? window.KoiAuth.formatDate(value) : '')

    const setEditValue = (name, value) => {
      const field = editForm.querySelector(`[name="${name}"]`)

      if (field) {
        field.value = moneyFieldNames.has(name)
          ? formatMoneyValue(value)
          : decimalFieldNames.has(name)
            ? formatDecimalForInput(value)
            : field.type === 'date'
              ? String(value || '').slice(0, 10)
              : value || ''
      }
    }

    const pullKoiCache = new Map()
    // ids / codes typed in "tarik dari ID/kode" are looked up on the server before the form is filled
    const resolvePullKoiTokens = async (tokens) => {
      pullKoiCache.clear()
      const scope = archiveMode ? 'archived' : 'active'
      const numeric = tokens.filter((token) => /^\d+$/.test(token))
      const [byCode, byId] = await Promise.all([window.KoiPicker.byCodes(tokens, { scope }), numeric.length ? window.KoiPicker.byIds(numeric, { scope }) : []])
      byId.filter((item) => Boolean(item.archived_at) === archiveMode).forEach((item) => pullKoiCache.set(String(item.id), item))
      byCode.forEach((item) => pullKoiCache.set(String(item.code || '').toLowerCase(), item))
    }
    const findKoiByIdOrCode = (value) => {
      const token = String(value || '').trim().toLowerCase()

      if (!token) {
        return null
      }

      return pullKoiCache.get(token) || null
    }

    const pullKoiTokens = () => splitCodeList(pullKoiIdsInput?.value)
    const closePullKoiMenu = () => {
      document.querySelector('[data-pull-koi-menu]')?.classList.add('d-none')
    }
    let pullMenuToken = 0
    const renderPullKoiMenu = window.KoiPicker.debounce(() => {
      const menu = document.querySelector('[data-pull-koi-menu]')
      if (!menu || !pullKoiIdsInput) return

      const tokens = pullKoiTokens()
      const currentWord = /[\s,;.]$/.test(String(pullKoiIdsInput.value || '')) ? '' : (tokens[tokens.length - 1] || '').toLowerCase()
      const selected = new Set(tokens.map((token) => token.toLowerCase()))
      const mine = ++pullMenuToken
      window.KoiPicker.lookup(currentWord, { limit: 10, scope: archiveMode ? 'archived' : 'active' }).then((result) => {
        if (mine !== pullMenuToken) return
        const matches = result.items
        menu.innerHTML = matches.length
          ? matches.map((item) => {
            const code = String(item.code || item.id || '').trim()
            const active = selected.has(code.toLowerCase()) || selected.has(String(item.id).toLowerCase())
            return `
            <button class="koi-parent-search-item" type="button" data-pull-koi-pick="${escapeHtml(code)}">
              <span class="koi-parent-search-main">
                ${item.image_url ? `<img class="koi-parent-search-thumb" src="${escapeHtml(photoThumb(item.image_url, 120))}" alt="${escapeHtml(code)}" loading="lazy" decoding="async" fetchpriority="low" />` : '<span class="koi-parent-search-thumb koi-parent-search-placeholder">KOI</span>'}
                <span class="koi-parent-search-copy">
                  <span class="d-block fw-medium text-truncate">${active ? '✓ ' : ''}${escapeHtml(code)}</span>
                  <span class="d-block text-secondary small text-truncate">${escapeHtml([item.name, item.variety, item.bloodline].filter(Boolean).join(' - ') || 'Data ikan')}</span>
                </span>
              </span>
            </button>
          `
          }).join('')
          : '<div class="koi-parent-search-empty">Tidak ada ikan yang cocok</div>'
        menu.classList.remove('d-none')
      }).catch(() => {})
    }, 200)
    const pickPullKoiItem = (code) => {
      if (!pullKoiIdsInput || !code) return
      const tokens = pullKoiTokens()
      const exists = tokens.some((token) => token.toLowerCase() === String(code).toLowerCase())
      const rawValue = String(pullKoiIdsInput.value || '')
      const shouldReplaceLast = !/[\s,;.]$/.test(rawValue) && tokens.length > 0
      const nextTokens = exists
        ? tokens
        : shouldReplaceLast
          ? [...tokens.slice(0, -1), code]
          : [...tokens, code]

      pullKoiIdsInput.value = nextTokens.filter(Boolean).join(', ') + ', '
      pullKoiIdsStatus.textContent = `${nextTokens.length} ID/kode dipilih.`
      pullKoiIdsInput.focus()
      renderPullKoiMenu()
    }

    const pullKoiEntriesByIds = async () => {
      const tokens = pullKoiTokens()
      if (tokens.length === 0) {
        pullKoiIdsStatus.textContent = 'Masukkan ID/kode ikan terlebih dahulu.'
        return
      }
      pullKoiIdsStatus.textContent = 'Mencari ikan...'
      try {
        await resolvePullKoiTokens(tokens)
      } catch {
        pullKoiIdsStatus.textContent = 'Data ikan gagal dimuat.'
        return
      }
      pullKoiEntriesByIdsNow()
    }
    const pullKoiEntriesByIdsNow = () => {
      const tokens = pullKoiTokens()

      if (tokens.length === 0) {
        pullKoiIdsStatus.textContent = 'Masukkan ID/kode ikan terlebih dahulu.'
        return
      }

      const found = []
      const missing = []
      const seen = new Set()

      tokens.forEach((token) => {
        const koi = findKoiByIdOrCode(token)

        if (!koi) {
          missing.push(token)
          return
        }

        if (seen.has(String(koi.id))) {
          return
        }

        seen.add(String(koi.id))
        found.push(koi)
      })

      if (found.length === 0) {
        pullKoiIdsStatus.textContent = `Tidak ada data cocok: ${missing.join(', ')}`
        return
      }

      entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
      found.forEach((item) => {
        addKoiEntry()
        const entry = [...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1)
        fillEntryFromDraft(entry, {
          ...item,
          birth_date: item.birth_date ? String(item.birth_date).slice(0, 10) : '',
          purchase_date: item.purchase_date ? String(item.purchase_date).slice(0, 10) : '',
        })
      })
      bulkEditKoiIds = found.map((item) => String(item.id))
      addFormTitle.textContent = `Formulir Edit ${found.length} Ikan dari ID/Kode`
      addEntryButton.disabled = true
      draftButton.disabled = true
      draftToggle.disabled = true
      pullKoiIdsStatus.textContent = missing.length
        ? `${found.length} data ditarik. Tidak ditemukan: ${missing.join(', ')}`
        : `${found.length} data ditarik ke formulir.`
      refreshEntryControls()
    }

    const setEditGender = (value = 'unknown') => {
      const normalized = ['male', 'female'].includes(String(value || '').toLowerCase()) ? String(value).toLowerCase() : 'unknown'
      const hidden = editForm.querySelector('[data-edit-gender-value]')

      if (hidden) {
        hidden.value = normalized
      }

      editForm.querySelectorAll('[data-edit-gender]').forEach((input) => { input.value = normalized })
    }

    const setEditPreview = (koi) => {
      editKoiPreview.innerHTML = koi.image_url
        ? `<img style="cursor:zoom-in" src="${escapeHtml(koi.image_url)}" alt="${escapeHtml(text(koi.name))}" />`
        : `<span class="koi-card-preview-code">${escapeHtml(text(koi.code))}</span>`
    }

    const openPhotoHistoryZoom = (imageUrl, title) => {
      // the fish this photo belongs to: a fish whose main photo it is, or the fish being edited (a History Progress Foto)
      const history = currentPhotoHistory.find((item) => item.image_url === imageUrl)
      const owner = koiItems.find((item) => item.image_url === imageUrl)
        || Object.values(window.KoiPicker?.cache || {}).find((item) => item && item.image_url === imageUrl)
        || (history ? koiById(editForm.querySelector('[name="id"]')?.value) : null)
      const extra = []

      if (history) {
        if (title && (!owner || title !== owner.code)) extra.push(['Foto progress', title])
        if (history.weight_g) extra.push(['Berat', `${formatDecimal(history.weight_g)} g`])
        if (history.measured_at) extra.push(['Tanggal', window.KoiAuth.formatDate(history.measured_at)])
        if (history.notes) extra.push(['Catatan', history.notes])
        const fishNotes = String(editForm.querySelector('[name="notes"]')?.value || '').trim()
        if (fishNotes) extra.push({ block: fishNotes, title: 'Catatan' })
      } else if (owner && title && title !== owner.code) {
        extra.push(title)
      }

      if (owner) {
        window.KoiAuth.zoomKoi(imageUrl, owner, extra, title)
      } else {
        window.KoiAuth.zoomPhoto(imageUrl, title, extra)
      }
    }

    let currentPhotoHistory = []
    let photoHistoryDrag = null
    const photoHistoryLabel = (item, index) => `[${index + 1}] ${item.length_cm ? `${escapeHtml(formatDecimal(item.length_cm))} cm` : 'Tanpa ukuran'}`
    const dragHandleIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>'
    const renderPhotoHistory = (history) => {
      currentPhotoHistory = [...history]
      editPhotoHistory.innerHTML = history.map((item, index) => {
        const label = photoHistoryLabel(item, index)

        return `
          <div class="koi-photo-history-item" data-photo-history-card="${escapeHtml(item.id)}">
            <div class="koi-photo-history-actions btn-list flex-nowrap">
              <span class="btn btn-secondary btn-sm btn-icon koi-photo-history-drag-handle" style="box-shadow:0 1px 5px rgba(0,0,0,.55)" data-photo-history-drag-handle data-role-required="database-write" aria-label="Geser untuk urutkan" title="Geser untuk urutkan">${dragHandleIcon}</span>
              <button class="btn btn-danger btn-sm btn-icon" style="box-shadow:0 1px 5px rgba(0,0,0,.55)" type="button" data-delete-photo-history="${escapeHtml(item.id)}" data-role-required="database-write" aria-label="Hapus foto progress" ${history.length <= 1 ? 'disabled title="Foto terakhir tidak bisa dihapus"' : 'title="Hapus foto progress"'}>${trashIcon}</button>
            </div>
            <button class="koi-photo-history-preview" type="button" data-preview-photo-history="${escapeHtml(item.image_url)}" data-preview-photo-title="${label}" aria-label="Preview foto progress">
              <img src="${escapeHtml(item.image_url)}" alt="Progress foto" loading="lazy" />
            </button>
            <button class="btn btn-link p-0 small fw-medium text-center" type="button" data-edit-photo-history-size="${escapeHtml(item.id)}" data-role-disable-unless="database-write" title="Edit ukuran progress">${label}</button>
            <div class="text-secondary small">${escapeHtml(item.measured_at ? window.KoiAuth.formatDate(item.measured_at) : '')}</div>
          </div>
        `
      }).join('') || '<div class="text-secondary">Belum ada history foto.</div>'
    }

    const savePhotoHistoryOrder = async (nextHistory) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!koiId || nextHistory.length === 0) {
        return
      }

      renderPhotoHistory(nextHistory)
      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/order`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ids: nextHistory.map((historyItem) => historyItem.id) }),
      })
      const data = await response.json()

      if (!response.ok) {
        await loadPhotoHistory(koiId)
        throw new Error(data.detail || data.error || 'Urutan history foto gagal disimpan')
      }

      // Cover foto & size ikan ikut kode di endpoint order (lihat POST /koi/:id/photo-history/order),
      // jadi cukup patch data lokal di sini — tidak perlu fetch ulang+render ulang SELURUH grid ikan.
      const latestKoi = koiItems.find((koiItem) => String(koiItem.id) === String(koiId))
      const cover = nextHistory[0]

      if (latestKoi && cover?.image_url) {
        latestKoi.image_url = cover.image_url
        if (cover.length_cm != null) latestKoi.current_length_cm = cover.length_cm
        if (cover.weight_g != null) latestKoi.current_weight_g = cover.weight_g
        setEditPreview(latestKoi)
        renderCards()
      }
    }

    const getPhotoHistoryCards = () => Array.from(editPhotoHistory.querySelectorAll('[data-photo-history-card]'))

    const photoHistoryGridPosition = (drag, index) => {
      const col = index % drag.colCount
      const row = Math.floor(index / drag.colCount)
      return { x: drag.originLeft + col * drag.cellWidth, y: drag.originTop + row * drag.cellHeight }
    }

    const photoHistoryDragStart = (event) => {
      if (event.button !== undefined && event.button !== 0) return

      const card = event.target.closest('[data-photo-history-card]')

      // Drag only starts from the dedicated handle — never from the photo/preview button or the
      // other action buttons. On touch, a finger is far less precise than a mouse cursor, so
      // letting drag start from the same area as tap-to-zoom made the two gestures fight each
      // other (mobile taps kept getting swallowed as micro-drags).
      if (!card || !event.target.closest('[data-photo-history-drag-handle]')) return

      const cards = getPhotoHistoryCards()

      if (cards.length <= 1) return

      const rects = new Map(cards.map((item) => [item.dataset.photoHistoryCard, item.getBoundingClientRect()]))
      const firstRect = rects.get(cards[0].dataset.photoHistoryCard)
      let colCount = 1

      for (let i = 1; i < cards.length; i += 1) {
        const rect = rects.get(cards[i].dataset.photoHistoryCard)
        if (Math.abs(rect.top - firstRect.top) > 1) break
        colCount += 1
      }

      const secondRowCard = cards[colCount]

      photoHistoryDrag = {
        pointerId: event.pointerId,
        card,
        id: card.dataset.photoHistoryCard,
        startX: event.clientX,
        startY: event.clientY,
        initialOrder: cards.map((item) => item.dataset.photoHistoryCard),
        order: cards.map((item) => item.dataset.photoHistoryCard),
        colCount,
        cellWidth: colCount > 1 ? rects.get(cards[1].dataset.photoHistoryCard).left - firstRect.left : firstRect.width,
        cellHeight: secondRowCard ? rects.get(secondRowCard.dataset.photoHistoryCard).top - firstRect.top : firstRect.height,
        originLeft: firstRect.left,
        originTop: firstRect.top,
        activated: false,
      }
    }

    const photoHistoryDragMove = (event) => {
      const drag = photoHistoryDrag

      if (!drag || event.pointerId !== drag.pointerId) return

      const dx = event.clientX - drag.startX
      const dy = event.clientY - drag.startY

      if (!drag.activated) {
        if (Math.abs(dx) < 4 && Math.abs(dy) < 4) return

        drag.activated = true
        drag.card.classList.add('is-dragging')
        editPhotoHistory.classList.add('is-reordering')
        drag.card.setPointerCapture(drag.pointerId)
        document.body.style.userSelect = 'none'
        document.body.style.touchAction = 'none'
      }

      event.preventDefault()
      drag.card.style.transform = `translate(${dx}px, ${dy}px)`

      // Column/row shift = how many whole cell-widths/heights the pointer has moved,
      // added to the dragged item's ORIGINAL column/row (not its current one).
      const startIndex = drag.initialOrder.indexOf(drag.id)
      const startCol = startIndex % drag.colCount
      const startRow = Math.floor(startIndex / drag.colCount)
      const col = Math.min(drag.colCount - 1, Math.max(0, Math.round(startCol + dx / drag.cellWidth)))
      const row = Math.max(0, Math.round(startRow + dy / drag.cellHeight))
      const targetIndex = Math.min(drag.order.length - 1, row * drag.colCount + col)
      const fromIndex = drag.order.indexOf(drag.id)

      if (targetIndex !== fromIndex) {
        drag.order.splice(fromIndex, 1)
        drag.order.splice(targetIndex, 0, drag.id)
      }

      drag.order.forEach((id, currentIndex) => {
        if (id === drag.id) return

        const card = getPhotoHistoryCards().find((item) => item.dataset.photoHistoryCard === id)
        if (!card) return

        const naturalIndex = drag.initialOrder.indexOf(id)
        const naturalPos = photoHistoryGridPosition(drag, naturalIndex)
        const targetPos = photoHistoryGridPosition(drag, currentIndex)
        const shiftX = targetPos.x - naturalPos.x
        const shiftY = targetPos.y - naturalPos.y

        card.style.transform = shiftX || shiftY ? `translate(${shiftX}px, ${shiftY}px)` : ''
      })
    }

    const photoHistoryDragEnd = (event) => {
      const drag = photoHistoryDrag

      if (!drag || (event.pointerId !== undefined && event.pointerId !== drag.pointerId)) return

      photoHistoryDrag = null
      document.body.style.userSelect = ''
      document.body.style.touchAction = ''

      if (!drag.activated) return

      editPhotoHistory.classList.remove('is-reordering')

      const changed = drag.order.some((id, index) => id !== drag.initialOrder[index])

      if (!changed) {
        getPhotoHistoryCards().forEach((card) => { card.style.transform = '' })
        drag.card.classList.remove('is-dragging')
        return
      }

      const nextHistory = drag.order
        .map((id) => currentPhotoHistory.find((item) => String(item.id) === String(id)))
        .filter(Boolean)

      // renderPhotoHistory() (called synchronously at the start of savePhotoHistoryOrder, before
      // its first await) rebuilds the grid in the new order, so the dragged card gets swapped for a
      // fresh element sitting right in its natural resting slot. Capture where it visually was and
      // "fly" the new element from there back to rest, instead of letting it just snap into place.
      const beforeRect = drag.card.getBoundingClientRect()
      const savePromise = savePhotoHistoryOrder(nextHistory)
      const newCard = getPhotoHistoryCards().find((item) => item.dataset.photoHistoryCard === drag.id)

      if (newCard) {
        const afterRect = newCard.getBoundingClientRect()
        const flyX = beforeRect.left - afterRect.left
        const flyY = beforeRect.top - afterRect.top

        newCard.style.transition = 'none'
        newCard.style.transform = `translate(${flyX}px, ${flyY}px)`

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            newCard.style.transition = 'transform .2s ease'
            newCard.style.transform = ''
            newCard.addEventListener('transitionend', () => {
              newCard.style.transition = ''
            }, { once: true })
          })
        })
      }

      savePromise.catch((error) => alert(error.message))
    }

    const loadPhotoHistory = async (koiId) => {
      editPhotoHistory.innerHTML = '<div class="text-secondary"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Memuat history foto...</div>'
      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history`)
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'History foto gagal dimuat')
      }

      renderPhotoHistory(data)
    }

    const editPhotoHistorySize = async (historyId) => {
      const koiId = editForm.querySelector('[name="id"]').value
      const history = currentPhotoHistory.find((item) => String(item.id) === String(historyId))
      const currentValue = history?.length_cm ? formatDecimal(history.length_cm) : ''
      const nextValue = (await window.KoiDialog.prompt('Isi ukuran progress foto dalam cm. Kosongkan untuk Tanpa ukuran.', currentValue, { numeric: 'decimal' }))

      if (nextValue === null || !koiId) {
        return
      }

      const normalizedValue = String(nextValue || '').trim().replace(',', '.')
      if (normalizedValue && !Number.isFinite(Number(normalizedValue))) {
        alert('Ukuran tidak valid.')
        return
      }

      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/${historyId}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ length_cm: normalizedValue }),
      })
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'Ukuran history foto gagal disimpan')
      }

      await loadPhotoHistory(koiId)
      await keepScroll(loadKoi)
      const latestKoi = koiItems.find((item) => String(item.id) === String(koiId))

      if (latestKoi) {
        setEditPreview(latestKoi)
      }
    }
    const deletePhotoHistory = async (historyId) => {
      const koiId = editForm.querySelector('[name="id"]').value

      if (!koiId || !(await window.KoiDialog.confirm('Hapus foto progress ini?'))) {
        return
      }

      const response = await fetch(`${apiUrl}/koi/${koiId}/photo-history/${historyId}`, { method: 'DELETE' })
      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error || 'History foto gagal dihapus')
      }

      await loadPhotoHistory(koiId)
      await keepScroll(loadKoi)
      const latestKoi = koiItems.find((item) => String(item.id) === String(koiId))

      if (latestKoi) {
        setEditPreview(latestKoi)
      }
    }

    const openEditKoi = (id) => {
      const koi = koiItems.find((item) => String(item.id) === String(id))

      if (!koi) {
        return
      }

      editErrorBox.classList.add('d-none')
      setEditPreview(koi)
      setEditValue('id', koi.id)
      setEditValue('code', koi.code)
      setEditValue('name', koi.name)
      setEditValue('pond_id', koi.pond_id)
      editForm.querySelector('[data-edit-pond-select]').value = koi.pond_name || ''
      editForm.querySelector('[data-edit-pond-location]').value = koi.pond_location || koi.location_name || ''
      updatePondClearVisibility(editForm.querySelector('[data-edit-pond-select]')?.closest('.koi-pond-search'))
      updatePondClearVisibility(editForm.querySelector('[data-edit-pond-location]')?.closest('.koi-pond-search'))
      setEditValue('variety', koi.variety)
      setEditValue('bloodline', koi.bloodline)
      setEditValue('farm_name', koi.farm_name)
      setEditValue('breeder', koi.breeder)
      setEditValue('parent_info', koi.parent_info)
      setEditGender(koi.gender || 'unknown')
      editForm.querySelector('[name="parent_type"]').checked = koi.parent_type === 'indukan'
      setEditValue('status', koi.status || 'active')
      setEditValue('birth_date', koi.birth_date ? String(koi.birth_date).slice(0, 10) : '')
      setEditValue('purchase_date', koi.purchase_date ? String(koi.purchase_date).slice(0, 10) : '')
      setEditValue('purchase_price', koi.purchase_price)
      setEditValue('sale_price', koi.sale_price)
      setEditValue('current_length_cm', koi.current_length_cm)
      setEditValue('notes', koi.notes)
      const lastEditedField = editForm.querySelector('[data-edit-last-edited]')
      if (lastEditedField) lastEditedField.value = formatLastEdited(koi.updated_at)
      updateEditBreederParents()
      loadPhotoHistory(koi.id).catch((error) => {
        editPhotoHistory.innerHTML = `<div class="text-danger">${escapeHtml(error.message)}</div>`
      })
      openModal(editModalElement)
    }

    const buildFilterOptions = () => {
      filters.forEach((filter) => {
        const key = filter.dataset.filter
        const currentValues = Array.isArray(pendingViewFilters?.[key])
          ? pendingViewFilters[key]
          : Array.from(filter.selectedOptions).map((option) => option.value).filter(Boolean)
        const values = uniqueKoiValues(key)
        // Varietas, Lokasi, Bloodline, and Ternakan also offer "(Kosong)": the fish whose field is not filled in (the server knows it as __kosong__)
        const emptyOption = ['variety', 'pond_name', 'bloodline', 'farm_name'].includes(key) ? '<option value="__kosong__">(Kosong)</option>' : ''
        filter.innerHTML = '<option value="">Semua</option>' + emptyOption + values.map((value) => `
          <option value="${escapeHtml(value)}">${escapeHtml(labels[value] || value)}</option>
        `).join('')
        Array.from(filter.options).forEach((option) => {
          option.selected = currentValues.includes(option.value)
        })
      })

      if (koiItems.length > 0) pendingViewFilters = null

      varietyOptions.innerHTML = uniqueKoiValues('variety').map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
      buildBreederOptions()
    }

    const buildBreederOptionsLegacy = () => {
      const values = [...new Set([
        ...koiItems.map((item) => filterValue(item, 'breeder')).filter(Boolean),
      ])].sort()

      breederOptions.innerHTML = values.map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
      parentOptions.innerHTML = [...new Set([
        ...koiItems.map((item) => filterValue(item, 'parent_info')).filter(Boolean),
        ...breedingItems.flatMap((item) => {
          const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
          const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')

          return [
            ...breedingSearchValues(item),
            ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).map(parentLabel),
            ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).map(parentLabel),
          ].filter(Boolean)
        }),
      ])].sort()
        .map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
    }

    // Native <datalist> suggestion dropdowns are unreliable across mobile
    // browsers (often simply don't show), so name/bloodline/farm_name/breeder
    // get the same kind of self-contained overlay the app already uses for
    // variety/pond/parent search instead of relying on the browser's own UI.
    // only Nama keeps this menu: Bloodline, Ternakan and Owner use the shared suggestion panel (field-suggest.js)
    const textSuggestFields = [{ name: 'name', key: 'name' }]
    let activeTextSuggestMenu = null

    const closeTextSuggestMenu = () => {
      if (activeTextSuggestMenu) {
        activeTextSuggestMenu.remove()
        activeTextSuggestMenu = null
      }
    }

    const showTextSuggestMenuLegacy = (input, key) => {
      closeTextSuggestMenu()
      const query = input.value.trim().toLowerCase()
      const values = [...new Set(koiItems.map((item) => filterValue(item, key)).filter(Boolean))]
        .sort()
        .filter((value) => !query || value.toLowerCase().includes(query))
        .slice(0, 8)

      if (!values.length) return

      const menu = document.createElement('div')
      menu.className = 'koi-text-suggest-menu'
      values.forEach((value) => {
        const item = document.createElement('button')
        item.type = 'button'
        item.className = 'koi-text-suggest-item'
        item.textContent = value
        item.addEventListener('mousedown', (event) => {
          event.preventDefault()
          input.value = value
          input.dispatchEvent(new Event('input', { bubbles: true }))
          input.dispatchEvent(new Event('change', { bubbles: true }))
          closeTextSuggestMenu()
        })
        menu.appendChild(item)
      })

      document.body.appendChild(menu)
      const rect = input.getBoundingClientRect()
      const width = Math.max(rect.width, 200)
      menu.style.left = `${Math.min(rect.left, window.innerWidth - width - 8)}px`
      menu.style.top = `${rect.bottom + 4}px`
      menu.style.width = `${width}px`
      activeTextSuggestMenu = menu
    }

    const matchTextSuggestField = (target) => target instanceof HTMLInputElement
      && textSuggestFields.find((field) => target.matches(`input[name="${field.name}"]`))

    document.addEventListener('input', (event) => {
      const field = matchTextSuggestField(event.target)
      if (field) showTextSuggestMenu(event.target, field.key)
    })
    document.addEventListener('focusin', (event) => {
      const field = matchTextSuggestField(event.target)
      if (field) showTextSuggestMenu(event.target, field.key)
    })
    document.addEventListener('click', (event) => {
      if (activeTextSuggestMenu && !activeTextSuggestMenu.contains(event.target) && !matchTextSuggestField(event.target)) {
        closeTextSuggestMenu()
      }
    })
    window.addEventListener('scroll', closeTextSuggestMenu, true)
    window.addEventListener('resize', closeTextSuggestMenu)

    const normalizeSearchText = (value) => String(value || '').trim().toLowerCase()
    const parseSearchTerms = (value) => normalizeSearchText(value)
      .split(/[,\s]+/)
      .map((term) => term.trim())
      .filter(Boolean)
    // DEAD CODE (diperiksa 2026-10-14): parseSizeRange tidak dipanggil di mana pun. Aman dihapus; sengaja belum dihapus.
    const parseSizeRange = (value) => {
      const match = normalizeSearchText(value).match(/^(\d+(?:[.,]\d+)?)\s*-\s*(\d+(?:[.,]\d+)?)$/)

      if (!match) {
        return null
      }

      const min = Number(match[1].replace(',', '.'))
      const max = Number(match[2].replace(',', '.'))

      return Number.isFinite(min) && Number.isFinite(max) ? [Math.min(min, max), Math.max(min, max)] : null
    }
    const koiSequenceCompare = (first, second) => {
      const firstDate = String(first.created_at || '')
      const secondDate = String(second.created_at || '')
      const dateCompare = firstDate.localeCompare(secondDate)

      return dateCompare || Number(first.id || 0) - Number(second.id || 0)
    }

    const rebuildKoiSequence = () => {
      koiSequenceById = new Map([...koiItems]
        .sort(koiSequenceCompare)
        .map((item, index) => [String(item.id), index + 1]))
    }

    const koiSequenceIndexLegacy = (item) => koiSequenceById.get(String(item.id)) || 0

    // ---- search: plain words + "field:value" ----------------------------------------------------------------
    // "bloodline:isa ternakan:dwd catatan:vat 03" -> every field:value must match (a value runs until the next
    // field:). Plain words before the first field: look in kode, nama, bloodline, ternakan and nomor urut; a size
    // like 49-70cm or 45cm filters the size. A comma inside a text value means "or" (bloodline:isa,miya).
    const searchFieldAliases = {
      kode: 'code', code: 'code', id: 'code',
      nama: 'name', name: 'name',
      variety: 'variety', varietas: 'variety', jenis: 'variety',
      bloodline: 'bloodline', darah: 'bloodline',
      ternakan: 'farm_name', peternakan: 'farm_name', farm: 'farm_name',
      breeding: 'breeding_session', parrent: 'parent_info',
      breeder: 'breeder',
      induk: 'parent_info', indukan: 'parent_info', parent: 'parent_info',
      kolam: 'pond_name', lokasi: 'pond_name', pond: 'pond_name',
      area: 'pond_location',
      status: 'status',
      gender: 'gender', sex: 'gender', kelamin: 'gender', jk: 'gender',
      tipe: 'parent_type', type: 'parent_type',
      catatan: 'notes', notes: 'notes', note: 'notes',
      ukuran: 'current_length_cm', size: 'current_length_cm', panjang: 'current_length_cm',
      hargabeli: 'purchase_price', beli: 'purchase_price',
      hargajual: 'sale_price', jual: 'sale_price',
      lahir: 'birth_date', tanggallahir: 'birth_date',
      tanggalbeli: 'purchase_date', tglbeli: 'purchase_date',
      nomor: 'sequence', no: 'sequence', urut: 'sequence',
      kodekoi: 'code', owner: 'breeder', parentbreeding: 'parent_info', typ: 'parent_type', sizesaatini: 'current_length_cm', ukuransaatini: 'current_length_cm',
      tgllahir: 'birth_date', terakhirdiedit: 'updated_at', diedit: 'updated_at',
    }
    // "bloo:isa" works too: a field name may be shortened to its first letters (2 or more). Exact names win, then the
    // first name in the list above that starts with what was typed. Unknown names stay plain text.
        // "Harga Jual:15", "Tanggal Lahir:2025" ... : the labels of the Edit / Tambah Ikan form (with spaces) become one word
    const searchLabelWords = {
      'parent/breeding': 'parentbreeding', 'parent breeding': 'parentbreeding', 'indukan/breeding': 'parentbreeding', 'indukan breeding': 'parentbreeding', 'ukuran saat ini': 'sizesaatini', 'terakhir diedit': 'terakhirdiedit', 'tanggal lahir': 'tanggallahir',
      'tanggal beli': 'tanggalbeli', 'size saat ini': 'sizesaatini', 'harga beli': 'hargabeli', 'harga jual': 'hargajual', 'kode koi': 'kodekoi',
    }
    const normalizeSearchLabels = (keyword) => Object.entries(searchLabelWords).reduce((text, [label, compact]) => {
      const escaped = label.replace(/[.*+?^${}()|[\]\\/]/g, '\\$&')
      return text.replace(new RegExp(`(^|[\\s,])${escaped}\\s*:`, 'gi'), `$1${compact}:`)
    }, keyword)
    const resolveSearchMarkers = (keyword, aliases) => {
      const names = Object.keys(aliases)
      const found = []
      const pattern = /(?:^|[\s,])([a-z]+)\s*:/gi
      let match
      while ((match = pattern.exec(keyword))) {
        const key = match[1].toLowerCase()
        const name = aliases[key] ? key : (key.length >= 2 ? names.find((alias) => alias.startsWith(key)) : null)
        if (name) {
          const hit = [match[0], name]
          hit.index = match.index
          found.push(hit)
        }
      }
      return found
    }
    const statusWords = { aktif: 'active', nonaktif: 'non_active', 'non-aktif': 'non_active', karantina: 'quarantine', terjual: 'sold', mati: 'dead', active: 'active', 'non-active': 'non_active', nonactive: 'non_active', quarantine: 'quarantine', sold: 'sold', dead: 'dead' }
    const genderWords = { jantan: 'male', male: 'male', m: 'male', betina: 'female', female: 'female', f: 'female', u: 'unknown', unknown: 'unknown', belum: 'unknown', 'tidak diketahui': 'unknown' }

    let breedingMatchCache = { items: null, map: new Map() }
    const parseSearchNumber = (value, money) => {
      let text = String(value || '').toLowerCase().replace(/rp|cm|\s/g, '')
      // 15jt / 15 juta = 15.000.000, 500rb / 500 ribu = 500.000 (prices only)
      let factor = 1
      const unit = money ? text.match(/^(.+?)(juta|jt|ribu|rb)$/) : null
      if (unit) {
        factor = unit[2] === 'juta' || unit[2] === 'jt' ? 1000000 : 1000
        text = unit[1]
      }
      text = money ? text.replace(/\./g, '').replace(',', '.') : text.replace(',', '.')
      let number = Number(text) * factor
      // a bare small number in a price field is read as millions ("Harga Jual:15" = 15 juta); real prices here are never below 1.000
      if (money && factor === 1 && number > 0 && number < 1000) number *= 1000000
      return text !== '' && Number.isFinite(number) ? number : null
    }
    // "49-70", "45", ">50", ">=50", "<30", "<=30"
    const numberTest = (value, money) => {
      const text = String(value || '').toLowerCase().replace(/rp|cm|\s/g, '')
      const compare = text.match(/^(>=|<=|>|<)(.+)$/)
      if (compare) {
        const limit = parseSearchNumber(compare[2], money)
        if (limit === null) return null
        return { '>=': (n) => n >= limit, '<=': (n) => n <= limit, '>': (n) => n > limit, '<': (n) => n < limit }[compare[1]]
      }
      const range = money
        ? text.match(/^([\d.,]+)-([\d.,]+)$/)
        : text.match(/^(\d+(?:[.,]\d+)?)-(\d+(?:[.,]\d+)?)$/)
      if (range) {
        const first = parseSearchNumber(range[1], money)
        const second = parseSearchNumber(range[2], money)
        if (first === null || second === null) return null
        const [min, max] = [Math.min(first, second), Math.max(first, second)]
        return (n) => n >= min && n <= max
      }
      const exact = parseSearchNumber(text, money)
      if (exact === null) return null
      return (n) => (Number.isInteger(exact) && !money ? Math.floor(n) === exact : n === exact)
    }
    const dateSearchText = (value) => {
      const match = String(value || '').trim().match(/^(\d{1,2})[/.-](\d{1,2})[/.-](\d{4})$/)
      if (match) return `${match[3]}-${match[2].padStart(2, '0')}-${match[1].padStart(2, '0')}`
      // the program's own date text: 2026 - [10] Oktober - 20 (- Selasa)
      return window.KoiAuth?.dateFromText?.(value) || String(value || '').trim()
    }

    // returns true / false, or null when the value is still being typed (no filter yet)
    const matchesFieldCriterion = (item, field, rawValue) => {
      const value = normalizeSearchText(rawValue)
      if (!value) return null

      if (field === 'current_length_cm' || field === 'purchase_price' || field === 'sale_price') {
        const test = numberTest(value, field !== 'current_length_cm')
        const number = Number(item[field])
        if (!test) return null
        return item[field] !== null && item[field] !== undefined && item[field] !== '' && Number.isFinite(number) && test(number)
      }
      if (field === 'breeding_session') {
        // fish of a breeding session: by the session (kode, nama) or by its parents (kode, nama, ternakan, bloodline)
        const wanted = value.split(',').map((part) => part.trim()).filter(Boolean)
        const info = normalizeSearchText(item.parent_info)
        return wanted.some((choice) => {
          if (info.includes(choice)) return true
          if (breedingMatchCache.items !== breedingItems) breedingMatchCache = { items: breedingItems, map: new Map() }
          if (!breedingMatchCache.map.has(choice)) {
            const codes = breedingItems
              .filter((session) => {
                const parents = [...parseParentEntries(session.male_parent_entries, session.male_koi_id, session.male_koi_name), ...parseParentEntries(session.female_parent_entries, session.female_koi_id, session.female_koi_name)]
                const parentText = parents.map((entry) => {
                  const koi = koiById(entry.koi_id)
                  return [entry.koi_id, entry.label, koi?.code, koi?.name, koi?.variety, koi?.bloodline, koi?.farm_name].filter(Boolean).join(' ')
                }).join(' ')
                return normalizeSearchText([session.batch_code, session.session_name, session.male_koi_code, session.male_koi_name, session.female_koi_code, session.female_koi_name, parentText].join(' ')).includes(choice)
              })
              .map((session) => normalizeSearchText(session.batch_code))
              .filter(Boolean)
            breedingMatchCache.map.set(choice, codes)
          }
          return breedingMatchCache.map.get(choice).some((code) => info.includes(code))
        })
      }
      if (field === 'sequence') {
        const wanted = parseSearchNumber(value, false)
        return wanted === null ? null : wanted === koiSequenceIndex(item)
      }
      if (field === 'birth_date' || field === 'purchase_date' || field === 'updated_at') {
        return String(item[field] || '').slice(0, 10).includes(dateSearchText(value))
      }

      const choices = value.split(',').map((part) => part.trim()).filter(Boolean)
      return choices.some((choice) => {
        if (field === 'status') {
          const raw = String(item.status || '').toLowerCase()
          return raw === (statusWords[choice] || choice) || normalizeSearchText(labels[item.status]).includes(choice)
        }
        if (field === 'gender') {
          const raw = String(item.gender || 'unknown').toLowerCase()
          return raw === (genderWords[choice] || choice)
        }
        if (field === 'parent_type') {
          const wanted = /^(bukan|non)/.test(choice) ? 'non_indukan' : 'indukan'
          return String(item.parent_type || 'non_indukan').toLowerCase() === wanted
        }
        if (field === 'pond_location') {
          return normalizeSearchText(item.pond_location || item.location_name || item.location).includes(choice)
        }
        return normalizeSearchText(item[field]).includes(choice)
      })
    }

    const matchesKoiSearch = (item) => {
      const keyword = normalizeSearchLabels(searchInput.value.trim())

      if (!keyword) {
        return true
      }

      // split into the plain part (before the first field:) and the field:value parts
      const markers = resolveSearchMarkers(keyword, searchFieldAliases)
      const plain = markers.length ? keyword.slice(0, markers[0].index) : keyword

      for (let index = 0; index < markers.length; index += 1) {
        const marker = markers[index]
        const valueStart = marker.index + marker[0].length
        const valueEnd = index + 1 < markers.length ? markers[index + 1].index : keyword.length
        const field = searchFieldAliases[marker[1].toLowerCase()]
        const result = matchesFieldCriterion(item, field, keyword.slice(valueStart, valueEnd))

        if (result === false) {
          return false
        }
      }

      // "49 - 70 cm" / "49cm-70cm" are written without spaces so the split below keeps a range in one piece
      // Spaces mean "all of these words"; a comma or a period starts an alternative (OR). A list of bare fish codes ("26CY8E 26EQ6M") lists those fish.
      const cleaned = compareSizeWords(plain).replace(/\b(?:size|ukuran|panjang)\s*(?=\d)/gi, "").replace(/(\d)\s+cm(?![a-z])/gi, '$1cm').replace(/(\d)\s*(?:cm)?\s*-\s*(\d)/gi, '$1-$2')
      const groups = []
      cleaned.replace(/(\d)\.(?=\d)/g, '$1\u0001').split(/[,.]+/).forEach((chunk) => {
        const words = parseSearchTerms(chunk.replace(/\u0001/g, '.'))
        const codeList = words.length > 1 && words.every((word) => /^\d{2}[a-z0-9]{2,}$/.test(word) && !/cm$/.test(word))
        ;(codeList ? words.map((word) => [word]) : [words]).forEach((group) => {
          if (group.length) groups.push(group)
        })
      })

      const groupMatches = (terms) => {
        const idTerms = []
        const sizeTests = []
        const compareTests = []   // ">30 <60": every comparison has to hold

        terms.forEach((term) => {
          const range = term.match(/^(\d+(?:[.,]\d+)?)-(\d+(?:[.,]\d+)?)(?:cm)?$/)
          const single = term.match(/^(\d+(?:[.,]\d+)?)cm$/)
          const compare = term.match(/^(gt|ge|lt|le)(\d+(?:\.\d+)?)$/)

          if (range) {
            const first = Number(range[1].replace(',', '.'))
            const second = Number(range[2].replace(',', '.'))
            const [min, max] = [Math.min(first, second), Math.max(first, second)]
            sizeTests.push((size) => size >= min && size <= max)
          } else if (compare) {
            const limit = Number(compare[2])
            compareTests.push((size) => (compare[1] === 'gt' ? size > limit : compare[1] === 'ge' ? size >= limit : compare[1] === 'lt' ? size < limit : size <= limit))
          } else if (single) {
            const wanted = Number(single[1].replace(',', '.'))
            sizeTests.push((size) => (Number.isInteger(wanted) ? Math.floor(size) === wanted : size === wanted))
          } else {
            idTerms.push(term)
          }
        })

        // the words typed together (spaces) are ONE phrase; only a comma or a period starts another search
        if (idTerms.length > 1) idTerms.splice(0, idTerms.length, idTerms.join(' '))

        // kode, nama, bloodline, ternakan, and the number shown on the card (a bare number is that nomor urut): the whole phrase has to be found in one of them
        if (idTerms.length) {
          const searchableValues = [item.code, item.name, item.bloodline, item.farm_name].map(normalizeSearchText)
          const sequence = koiSequenceIndex(item)
          const matched = idTerms.every((term) => /^\d+$/.test(term)
            ? Number(term) === sequence || searchableValues.some((value) => value.includes(term))
            : searchableValues.some((value) => value.includes(term)))

          if (!matched) {
            return false
          }
        }

        if (sizeTests.length || compareTests.length) {
          const known = item.current_length_cm !== null && item.current_length_cm !== undefined && item.current_length_cm !== ''
          const size = Number(item.current_length_cm)

          // a fish without a size is never "less than" anything
          if (compareTests.length && !(known && Number.isFinite(size) && compareTests.every((test) => test(size)))) {
            return false
          }
          if (sizeTests.length && (!Number.isFinite(size) || !sizeTests.some((test) => test(size)))) {
            return false
          }
        }

        return true
      }

      return groups.length === 0 || groups.some(groupMatches)
    }

    const selectedGenderFilter = () => Array.from(genderSelect?.selectedOptions || []).map((option) => option.value).filter(Boolean).join(',')

    const selectedParentTypeFilters = () => Array.from(parentTypeSelect?.selectedOptions || []).map((option) => option.value).filter(Boolean)

    const saveViewState = () => {
      try {
        sessionStorage.setItem(viewStateKey, JSON.stringify({
          sort: sequenceSortDirection,
          pageSize,
          page: currentPage,
          search: searchInput.value,
          filters: pendingViewFilters || Object.fromEntries(filters.map((filter) => [filter.dataset.filter, Array.from(filter.selectedOptions).map((option) => option.value).filter(Boolean)])),
          gender: selectedGenderFilter(),
          parentTypes: selectedParentTypeFilters(),
          scrollY: window.scrollY,
          selected: [...selectedKoiIds],
          selectedOnly: showSelectedOnly,
          hideSelected,
        }))
      } catch {
        // sessionStorage can be unavailable (private mode); the view simply is not remembered
      }
    }

    const restoreViewState = () => {
      try {
        const saved = JSON.parse(sessionStorage.getItem(viewStateKey) || 'null')
        if (!saved || typeof saved !== 'object') return
        if (saved.sort === 'asc' || saved.sort === 'desc') {
          sequenceSortDirection = saved.sort
          const isDesc = sequenceSortDirection === 'desc'
          sequenceSortToggle.textContent = isDesc ? 'Z/A' : 'A/Z'
          sequenceSortToggle.setAttribute('aria-pressed', isDesc ? 'true' : 'false')
          sequenceSortToggle.setAttribute('aria-label', isDesc ? 'Urutan Z ke A' : 'Urutan A ke Z')
          sequenceSortToggle.setAttribute('title', isDesc ? 'Urutan Z ke A' : 'Urutan A ke Z')
        }
        if (pageSizeButtons.some((button) => Number(button.dataset.koiPageSize) === Number(saved.pageSize))) {
          pageSize = Number(saved.pageSize)
        }
        currentPage = Math.max(1, Number(saved.page) || 1)
        searchInput.value = typeof saved.search === 'string' ? saved.search : ''
        pendingViewFilters = saved.filters && typeof saved.filters === 'object' ? saved.filters : null
        if (genderSelect) {
          const wantedGenders = String(saved.gender || '').split(',')
          Array.from(genderSelect.options).forEach((option) => { option.selected = option.value !== '' && wantedGenders.includes(option.value) })
        }
        const savedParentTypes = Array.isArray(saved.parentTypes) ? saved.parentTypes : []
        if (parentTypeSelect) Array.from(parentTypeSelect.options).forEach((option) => { option.selected = option.value !== '' && savedParentTypes.includes(option.value) })
        pendingViewScroll = Number(saved.scrollY) > 0 ? Number(saved.scrollY) : null
        selectedKoiIds.clear()
        ;(Array.isArray(saved.selected) ? saved.selected : []).forEach((id) => selectedKoiIds.add(String(id)))
        showSelectedOnly = Boolean(saved.selectedOnly) && selectedKoiIds.size > 0
        hideSelected = Boolean(saved.hideSelected) && selectedKoiIds.size > 0
      } catch {
        sessionStorage.removeItem(viewStateKey)
      }
    }

    const applyPendingScroll = () => {
      if (pendingViewScroll === null || koiItems.length === 0) return
      const targetY = pendingViewScroll
      pendingViewScroll = null
      window.scrollTo(0, targetY)
    }

    // the search box and the dropdown filters are independent: this is about the dropdown filters only
    const hasActiveKoiFilters = () => filters.some((filter) => filter.selectedOptions.length > 0 && Array.from(filter.selectedOptions).some((option) => option.value)) || Boolean(selectedGenderFilter()) || selectedParentTypeFilters().length > 0

    const updateClearFiltersButton = () => {
      if (clearFiltersButton) clearFiltersButton.disabled = !hasActiveKoiFilters()
    }

    const clearKoiFilters = () => {
      filters.forEach((filter) => {
        Array.from(filter.options).forEach((option) => { option.selected = false })
        filter.dispatchEvent(new Event('change', { bubbles: true }))
      })
      if (genderSelect) {
        Array.from(genderSelect.options).forEach((option) => { option.selected = false })
        genderSelect.dispatchEvent(new Event('change', { bubbles: true }))
      }
      if (parentTypeSelect) {
        Array.from(parentTypeSelect.options).forEach((option) => { option.selected = false })
        parentTypeSelect.dispatchEvent(new Event('change', { bubbles: true }))
      }
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    }
    const getFilteredKoiLegacy = () => {
      const direction = sequenceSortDirection === 'desc' ? -1 : 1
      const filteredItems = koiItems.filter((item) => {
        if (showSelectedOnly && !selectedKoiIds.has(String(item.id))) {
          return false
        }

        if (hideSelected && selectedKoiIds.has(String(item.id))) {
          return false
        }

        if (!matchesKoiSearch(item)) {
          return false
        }

        const matchDropdownFilters = filters.every((filter) => {
          const values = Array.from(filter.selectedOptions).map((option) => option.value).filter(Boolean)
          return values.length === 0 || values.includes(filterValue(item, filter.dataset.filter))
        })

        if (!matchDropdownFilters) {
          return false
        }

        const genderFilter = selectedGenderFilter()
        if (genderFilter && !genderFilter.split(',').includes(filterValue(item, 'gender'))) {
          return false
        }

        const parentTypeValues = selectedParentTypeFilters()
        return !parentTypeValues.length || parentTypeValues.includes(filterValue(item, 'parent_type') || 'non_indukan')
      })

      return filteredItems.sort((first, second) => {
        const sequenceDiff = koiSequenceIndex(first) - koiSequenceIndex(second)

        return direction * (sequenceDiff || Number(first.id || 0) - Number(second.id || 0))
      })
    }

    const getVisibleKoiLegacy = () => getFilteredKoi().slice((currentPage - 1) * pageSize, currentPage * pageSize)

    const pageRange = (current, total) => {
      const pages = new Set([1, total])

      for (let page = current - 2; page <= current + 2; page += 1) {
        if (page >= 1 && page <= total) {
          pages.add(page)
        }
      }

      return [...pages].sort((a, b) => a - b)
    }

    const renderPagination = (totalItems, totalPages) => {
      previewControls.classList.toggle('d-none', totalItems === 0)
      topControls?.classList.toggle('d-none', totalItems === 0)
      if (pageSizeSelect) pageSizeSelect.value = String(pageSize)
      pageSizeButtons.forEach((button) => {
        const active = Number(button.dataset.koiPageSize) === pageSize
        button.classList.toggle('btn-primary', active)
        button.classList.toggle('btn-outline-primary', !active)
      })

      if (totalItems === 0) {
        pageSummary.textContent = ''
        pagination.innerHTML = ''
        return
      }

      const start = (currentPage - 1) * pageSize + 1
      const end = Math.min(currentPage * pageSize, totalItems)

      pageSummary.textContent = `Menampilkan ${start} - ${end} dari ${totalItems} ikan`
      pagination.innerHTML = `
        <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
          <button class="page-link" type="button" data-koi-page="${currentPage - 1}" data-mobile-label="Prev" aria-label="Halaman sebelumnya">Sebelumnya</button>
        </li>
        ${pageRange(currentPage, totalPages).map((page, index, pages) => `
          ${index > 0 && page - pages[index - 1] > 1 ? '<li class="page-item disabled"><span class="page-link">...</span></li>' : ''}
          <li class="page-item ${page === currentPage ? 'active' : ''}">
            <button class="page-link" type="button" data-koi-page="${page}">${page}</button>
          </li>
        `).join('')}
        <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
          <button class="page-link" type="button" data-koi-page="${currentPage + 1}" data-mobile-label="Next" aria-label="Halaman berikutnya">Berikutnya</button>
        </li>
      `
    }

    const updateSelectedCount = () => {
      if (selectedKoiIds.size === 0 && actionDock) {
        actionDock.classList.remove('is-group-open')
        dockGroupToggle?.setAttribute('aria-pressed', 'false')
        dockGroupToggle?.setAttribute('title', 'Aksi lainnya')
      }
      selectedNumber.textContent = selectedKoiIds.size
      selectedCount.classList.toggle('btn-outline-primary', !showSelectedOnly)
      selectedCount.classList.toggle('btn-primary', showSelectedOnly)
      selectedCount.disabled = selectedKoiIds.size === 0
      selectedCount.setAttribute('aria-pressed', showSelectedOnly ? 'true' : 'false')
      selectedCount.setAttribute('aria-label', showSelectedOnly ? 'Tampilkan semua data ikan' : `Tampilkan ${selectedKoiIds.size} ikan yang dipilih`)
      selectedCount.setAttribute('title', showSelectedOnly ? 'Tampilkan semua data' : 'Tampilkan yang dipilih')
      hideSelectedButton.classList.toggle('btn-outline-primary', !hideSelected)
      hideSelectedButton.classList.toggle('btn-primary', hideSelected)
      hideSelectedButton.setAttribute('aria-pressed', hideSelected ? 'true' : 'false')
      hideSelectedButton.setAttribute('aria-label', hideSelected ? 'Tampilkan kembali yang disembunyikan' : 'Sembunyikan yang dipilih')
      hideSelectedButton.setAttribute('title', hideSelected ? 'Tampilkan kembali yang disembunyikan' : 'Sembunyikan yang dipilih')
      deleteSelectedButton.classList.toggle('d-none', selectedKoiIds.size === 0)
      selectedActionButtons.forEach((button) => button.classList.toggle('d-none', selectedKoiIds.size === 0))
      openAddButton.classList.toggle('koi-selection-hidden', selectedKoiIds.size > 0)
      deleteSelectedButton.innerHTML = trashIcon
      deleteSelectedButton.setAttribute('aria-label', selectedKoiIds.size > 0 ? `Hapus ${selectedKoiIds.size} ikan terpilih` : 'Hapus terpilih')
      deleteSelectedButton.setAttribute('title', selectedKoiIds.size > 0 ? `Hapus ${selectedKoiIds.size} ikan terpilih` : 'Hapus terpilih')
    }

    const syncSelectionView = () => {
      if (selectedKoiIds.size === 0) {
        showSelectedOnly = false
        hideSelected = false
      }

      if (showSelectedOnly || hideSelected) {
        currentPage = 1
        renderCards()
      } else {
        updateSelectedCount()
      }
    }

    const toggleKoiSelection = (id, forceSelected = null) => {
      const koiId = String(id)
      const shouldSelect = forceSelected ?? !selectedKoiIds.has(koiId)

      if (shouldSelect) {
        selectedKoiIds.add(koiId)
      } else {
        selectedKoiIds.delete(koiId)
      }

      const escapedId = window.CSS?.escape ? CSS.escape(koiId) : koiId.replace(/"/g, '\\"')
      cards.querySelectorAll(`[data-koi-preview-select="${escapedId}"]`).forEach((preview) => {
        preview.closest('.koi-card-compact')?.classList.toggle('is-selected', selectedKoiIds.has(koiId))
      })
      syncSelectionView()
    }

    const selectVisibleKoi = () => {
      getVisibleKoi().forEach((item) => selectedKoiIds.add(String(item.id)))
      showSelectedOnly = false
      hideSelected = false
      renderCards()
    }

    const clearSelectedKoi = () => {
      selectedKoiIds.clear()
      showSelectedOnly = false
      hideSelected = false
      currentPage = 1
      renderCards()
    }

    const copyText = async (value) => {
      const textValue = String(value || '')

      if (!textValue || textValue === '-') {
        return false
      }

      const textarea = document.createElement('textarea')
      textarea.value = textValue
      textarea.setAttribute('readonly', '')
      textarea.style.position = 'fixed'
      textarea.style.top = '0'
      textarea.style.left = '0'
      textarea.style.width = '1px'
      textarea.style.height = '1px'
      textarea.style.opacity = '0'
      document.body.appendChild(textarea)
      textarea.focus()
      textarea.select()
      textarea.setSelectionRange(0, textValue.length)

      try {
        const copied = document.execCommand('copy')
        textarea.remove()

        if (copied) {
          return true
        }
      } catch {
        textarea.remove()
      }

      try {
        await navigator.clipboard?.writeText(textValue)
        return true
      } catch {
        return false
      }
    }

    const selectedKoiItemsLegacy = () => selectedKoiItems()
    const copySelectedKoiIds = async () => {
      const ids = selectedKoiItems().map((item) => item.code).filter(Boolean)

      if (ids.length === 0) {
        alert('Ikan terpilih belum memiliki ID.')
        return
      }

      const copied = await copyText(ids.join(', '))
      copySelectedIdsButton.classList.toggle('btn-outline-primary', !copied)
      copySelectedIdsButton.classList.toggle('btn-success', copied)
      copySelectedIdsButton.setAttribute('title', copied ? 'ID terpilih tersalin' : 'ID gagal disalin')

      window.setTimeout(() => {
        copySelectedIdsButton.classList.add('btn-outline-primary')
        copySelectedIdsButton.classList.remove('btn-success')
        copySelectedIdsButton.setAttribute('title', 'Salin ID ikan terpilih')
      }, 1200)
    }
    let mergePhotoOrder = []
    const ensureMergeModal = () => {
      let modal = document.querySelector('#merge-koi-modal')

      if (modal) {
        return modal
      }

      modal = document.createElement('div')
      modal.className = 'modal modal-blur fade'
      modal.id = 'merge-koi-modal'
      modal.tabIndex = -1
      modal.innerHTML = `
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Gabungkan Ikan</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Acuan Data</label>
                <div class="row g-2" data-merge-master-list></div>
              </div>
              <div class="mb-2 d-flex align-items-center justify-content-between gap-2">
                <label class="form-label mb-0">Urutan Progress Foto</label>
                <small class="text-secondary">Foto paling kanan menjadi preview utama</small>
              </div>
              <div class="row g-2" data-merge-photo-list></div>
            </div>
