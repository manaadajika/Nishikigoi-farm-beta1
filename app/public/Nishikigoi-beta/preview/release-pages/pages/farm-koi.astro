    const changeSelectedPond = async (pondId) => {
      const newPond = pondsList.find((pond) => String(pond.id) === String(pondId || ''))
      const newLocationLabel = newPond ? newPond.name : 'Tanpa Lokasi'
      const todayLabel = new Date().toISOString().slice(0, 10)

      bulkPondProgress.classList.remove('d-none')
      try {
