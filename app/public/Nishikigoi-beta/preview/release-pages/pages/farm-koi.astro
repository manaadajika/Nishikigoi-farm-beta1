    const syncEntryPond = (entry) => {
      const pondInput = entry.querySelector('[data-pond-select]')
      const pondId = entry.querySelector('[data-pond-id]')
      const areaInput = entry.querySelector('[data-entry-area]')
      const pond = findPondByName(pondInput.value)

      pondId.value = pond ? pond.id : ''
      // a chosen pond decides the area; without a pond the typed area stays
      if (pond && areaInput) areaInput.value = pond.location || ''
    }

    const setEntryPond = (entry, pondIdValue) => {
      const pond = pondsList.find((item) => String(item.id) === String(pondIdValue || ''))
      const pondInput = entry.querySelector('[data-pond-select]')
      const pondId = entry.querySelector('[data-pond-id]')
      const areaInput = entry.querySelector('[data-entry-area]')

      pondId.value = pond ? pond.id : ''
      pondInput.value = pond ? pond.name : ''
      if (pond && areaInput) areaInput.value = pond.location || ''
      updatePondClearVisibility(pondInput.closest('.koi-pond-search'))
    }
    // pond chosen + a different area typed (typed, imported or edited by hand) is not allowed
    const entryAreaProblem = (entry, index) => {
      const pond = findPondByName(entry.querySelector('[data-pond-select]')?.value)
      const typed = String(entry.querySelector('[data-entry-area]')?.value || '').trim()

      if (!pond || !typed || typed.toLowerCase() === String(pond.location || '').trim().toLowerCase()) {
        return ''
      }

      const code = String(entry.querySelector('[name="code"]')?.value || '').trim()

      return `Entry ${index + 1}${code ? ` (${code})` : ''}: Area "${typed}" tidak sesuai dengan lokasi ${pond.name} (area lokasi: ${pond.location || 'kosong'}). Kosongkan Area agar terisi otomatis dari lokasi, atau kosongkan Lokasi kalau hanya tahu areanya.`
    }

    // A fish of a breeding session does not choose its own Bloodline and Ternakan: Bloodline is the session's title and Ternakan is the
    // program's name (Master Akun > Nama program). Both are filled in and locked while a session is chosen; clearing the session unlocks them.
    const ownFarmName = () => {
      try {
        const saved = JSON.parse(localStorage.getItem('nishikigoi-app-settings') || 'null') || {}
        return String(saved.brand_name || '').trim()
      } catch (error) {
        return ''
      }
    }
    const lockSessionFields = (form, breeding) => {
      const targets = [['bloodline', breeding ? String(breeding.session_name || '').trim() : ''], ['farm_name', breeding ? ownFarmName() : '']]

      targets.forEach(([name, value]) => {
        const field = form?.querySelector(`[name="${name}"]`)

        if (!field) return

        if (value) {
          field.value = value
          field.readOnly = true
          field.dataset.sessionLocked = '1'
          field.title = 'Mengikuti sesi breeding'
          field.dispatchEvent(new Event('input', { bubbles: true }))
        } else if (field.dataset.sessionLocked) {
          field.readOnly = false
          delete field.dataset.sessionLocked
          field.removeAttribute('title')
        }
      })
    }

    const updateEntryParentPreview = (entry) => {
      const parentField = entry.querySelector('[name="parent_info"]')
      const birthDateField = entry.querySelector('[name="birth_date"]')
      const panel = entry.querySelector('[data-entry-parent-panel]')
      const femalePreview = entry.querySelector('[data-entry-parent-female-preview]')
      const malePreview = entry.querySelector('[data-entry-parent-male-preview]')
      const maleSelect = entry.querySelector('[data-entry-parent-male]')
      const breeding = findBreedingByValue(parentField?.value)

      if (breeding?.breeding_date && birthDateField && !birthDateField.value) {
