            <div class="koi-card-preview d-flex align-items-end position-relative ${item.image_url ? '' : 'p-3'}" style="--koi-preview-color: ${previewColors[index % previewColors.length]}" data-koi-preview-select="${escapeHtml(item.id)}">
              ${previewMedia(item)}
            </div>
            <div class="card-body">
              <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                <div class="koi-card-main-text">
