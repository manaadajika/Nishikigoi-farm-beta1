      const switcher = document.createElement('div')
      switcher.className = 'btn-group mb-3'
      switcher.setAttribute('role', 'group')
      switcher.innerHTML = '<button type="button" class="btn btn-primary" disabled>Ikan</button><a class="btn" href="./farm-archive.html" data-go-archive-gallery>Galeri <span class="badge bg-secondary-lt ms-1" data-archive-gallery-count>0</span></a>'
      const pageContainer = document.querySelector('#content .container-xl') || document.querySelector('.page-body .container-xl')
      if (pageContainer) pageContainer.insertBefore(switcher, pageContainer.firstChild)
      switcher.querySelector('[data-go-archive-gallery]').addEventListener('click', () => {
        try { sessionStorage.setItem('nishikigoi-archive-tab', 'galeri') } catch (error) {}
      })
      fetch(`${apiUrl}/gallery`).then((response) => response.json()).then((list) => {
        const count = Array.isArray(list) ? list.filter((item) => item.archived_at).length : 0
        switcher.querySelector('[data-archive-gallery-count]').textContent = count
      }).catch(() => {})
    }

    const archiveSelectedKoi = async () => {
      if (archiveMode) return restoreSelectedKoi()

      const ids = [...selectedKoiIds]

      if (ids.length === 0 || !(await window.KoiDialog.confirm(`Arsipkan ${ids.length} ikan terpilih?\n\nIkan pindah ke menu Arsip dan keluar dari daftar Data Ikan, total Dashboard, dan jumlah ikan kolam. Data di Breeding dan Laporan tetap ada. Ikan bisa dikembalikan dari menu Arsip.`))) {
        return
      }

      archiveSelectedButton.disabled = true

      try {
        const response = await fetch(`${apiUrl}/koi/archive`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids: ids.map(Number) }),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Ikan gagal diarsipkan')
        }

        selectedKoiIds.clear()
        showSelectedOnly = false
        hideSelected = false
        updateSelectedCount()
        keepScroll(loadKoi)
      } catch (error) {
        alert(error.message)
      } finally {
        archiveSelectedButton.disabled = false
        updateSelectedCount()
      }
    }

    // The place cell of a card names what is known about the fish: its Lokasi (pond), or only its Area when no pond is chosen. Arsip shows the "lokasi arsip".
    const koiPlace = (item) => {
      if (archiveMode) return { label: 'Lokasi arsip', value: item.archive_location || item.pond_name }
      if (!String(item.pond_name || '').trim() && String(item.area || '').trim()) return { label: 'Area', value: item.area }
      return { label: 'Lokasi', value: item.pond_name }
    }
    const koiSequenceNumber = (item) => String(Math.max(koiSequenceIndex(item), 1)).padStart(10, '0')
    const koiStatusBadgeClass = (status) => ({
      active: 'bg-green-lt',
      non_active: 'bg-secondary-lt',
      quarantine: 'bg-yellow-lt',
      sold: 'bg-purple-lt',
      dead: 'bg-red-lt',
    }[status] || 'bg-blue-lt')

    const syncPageUrl = () => {
      // ?page=N in the address: a refresh stays on the page and the link can be shared (replaces the entry, no extra history)
      try {
        const url = new URL(window.location.href)
        if (currentPage > 1) url.searchParams.set('page', String(currentPage))
        else url.searchParams.delete('page')
        const next = url.pathname + url.search + url.hash
        if (next !== window.location.pathname + window.location.search + window.location.hash) {
          window.history.replaceState(window.history.state, '', next)
        }
      } catch {}
    }

    
    const renderCardsLocal = () => {
      const filtered = getFilteredKoi()
      const totalPages = koiPageMeta.totalPages

