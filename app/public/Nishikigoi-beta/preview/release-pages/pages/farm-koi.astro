      sale_price: 'Angka saja tanpa Rp dan tanpa titik, contoh 2500000. Boleh kosong.',
      current_length_cm: 'Ukuran dalam cm, angka saja, contoh 45 atau 45.5. Kalau ada foto, ukuran ini ikut tercatat di foto progress.',
      notes: 'Opsional. Catatan bebas.',
      image_url: 'Biarkan kosong (diisi oleh program).',
    }
    const importNotesRow = (columns) => columns.map(([, key]) => importColumnNotes[key] || '')
    // Indukan codes may belong to archived fish, so they are checked against all fish.
    const loadAllKoiCodes = async (items = []) => {
      const wanted = [...new Set(items.flatMap((item) => [item.parent_female, item.parent_male]).map((value) => String(value || '').split(' - ')[0].trim()).filter(Boolean))]
      const found = wanted.length ? await window.KoiPicker.byCodes(wanted, { scope: 'all' }) : []
      return new Set(found.map((item) => normalizeZipCode(item.code)))
    }
    const parentCodeFromText = (value) => normalizeZipCode(String(value || '').split(' - ')[0])
    const validateImportParents = async (items, rowNumberFor) => {
      const hasParentCodes = items.some((item) => String(item.parent_female || '').trim() || String(item.parent_male || '').trim())
      const codes = hasParentCodes ? await loadAllKoiCodes(items) : new Set()
      const problems = []
      items.forEach((item, index) => {
        const row = `Baris ${rowNumberFor(index)}`
        const session = String(item.parent_info || '').trim()
        if (session && !/\|\s*Female:/i.test(session) && !findBreedingByValue(session)) {
          problems.push(`${row}: Sesi breeding ${session} tidak terdaftar di Breeding.`)
        }
        ;[['parent_female', 'Indukan Female'], ['parent_male', 'Indukan Male']].forEach(([key, label]) => {
          const text = String(item[key] || '').trim()
          if (!text || text === '-' || text.toLowerCase() === 'mix') return
          if (!codes.has(parentCodeFromText(text))) problems.push(`${row}: ${label} ${text} tidak ada di Data Ikan.`)
        })
      })
      if (problems.length) throw new Error(problems.join('\n'))
    }
    const importKoiZipFile = async (file) => {
      if (!file) {
        return
      }

      if (hasFilledKoiEntries() && !(await window.KoiDialog.confirm('Isi formulir yang sedang ada akan diganti oleh data ZIP. Lanjutkan?'))) {
        importZipInput.value = ''
        return
      }

      hideKoiError()
      showImportStatus('Membaca file ZIP...')
      importZipButton.disabled = true
      importZipButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-label="Impor ZIP"></span>'
      try {
        const entries = await parseKoiZip(file)
        const xlsxEntries = entries.filter((entry) => fileExtension(entry.name) === 'xlsx')
        const imageEntries = entries.filter((entry) => ['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(fileExtension(entry.name)) && !zipBaseName(entry.name).startsWith('.'))

        showImportStatus('Memvalidasi isi ZIP...')
        if (xlsxEntries.length !== 1) {
          throw new Error('ZIP wajib berisi tepat satu file .xlsx.')
        }

        const xlsxFile = new File([xlsxEntries[0].data], zipBaseName(xlsxEntries[0].name))
        const rows = await parseXlsxRows(xlsxFile)
        const headerIndex = findHeaderRowIndex(rows, zipHeaderMap)
        const rawHeaders = rows[headerIndex] || []
        const dataRows = rows.slice(headerIndex + 1)
        const rowNumber = (index) => dataRows[index]?.excelRow || index + headerIndex + 2
        if (rawHeaders.length === 0) {
          throw new Error('.xlsx tidak memiliki judul kolom.')
        }
        const unknownHeaders = rawHeaders.map((item) => String(item).trim()).filter((header) => header && !zipHeaderMap.has(header.toLowerCase()))
        if (unknownHeaders.length) {
          throw new Error(`Judul kolom tidak dikenal: ${unknownHeaders.join(', ')}`)
        }

        const headers = rawHeaders.map((item) => zipHeaderMap.get(String(item).trim().toLowerCase()) || '')
        const duplicateHeaders = headers.filter((key, index) => key && headers.indexOf(key) !== index)
        if (duplicateHeaders.length) {
          throw new Error(`Judul kolom duplikat: ${[...new Set(duplicateHeaders)].join(', ')}`)
        }
        const requiredHeaders = zipEntryColumns.map(([, key]) => key).filter((key) => key !== 'image_url' && key !== 'code')
        const missingHeaders = requiredHeaders.filter((key) => !headers.includes(key))
        if (missingHeaders.length) {
          const missingLabels = missingHeaders.map((key) => zipEntryColumns.find(([, columnKey]) => columnKey === key)?.[0] || key)
          throw new Error(`Kolom belum lengkap: ${missingLabels.join(', ')}`)
        }
        if (!headers.includes('code')) {
          throw new Error('.xlsx wajib memiliki kolom Kode Koi (boleh dikosongkan per baris untuk ikan baru).')
        }
        dataRows.forEach((row, index) => {
          if (row.length > rawHeaders.length) {
            throw new Error(`Baris ${rowNumber(index)}: jumlah kolom lebih banyak dari judul kolom.`)
          }
        })

        const rawDrafts = dataRows.map((row) => row.reduce((result, value, index) => {
          const key = headers[index]
          if (key) result[key] = value
          return result
        }, {}))
        if (rawDrafts.length === 0) {
          throw new Error('.xlsx tidak memiliki baris data (data dimulai dari baris 3).')
        }

        rawDrafts.forEach((item, index) => validateZipRow(item, rowNumber(index)))

        const photoNameSet = new Set()
        for (const item of rawDrafts) {
          const photoName = normalizePhotoName(item.photo_name)
          if (!photoName) continue
          if (photoNameSet.has(photoName)) throw new Error(`Nama Foto dipakai lebih dari satu baris: ${item.photo_name}`)
          photoNameSet.add(photoName)
        }

        const codeSet = new Set()
        for (const item of rawDrafts) {
          const code = normalizeZipCode(item.code)
          if (!code) continue
          if (codeSet.has(code)) throw new Error(`Kode Koi duplikat di file: ${code}`)
          codeSet.add(code)
        }

        // Kode Koi terisi -> harus sudah ada di Data Ikan (ditarik & diupdate).
        const existingByCode = new Map((await window.KoiPicker.byCodes([...codeSet], { scope: archiveMode ? 'archived' : 'active' })).map((item) => [normalizeZipCode(item.code), item]))
        const notFoundCodes = [...codeSet].filter((code) => !existingByCode.has(code))
        if (notFoundCodes.length) {
          throw new Error(`Kode Koi tidak ditemukan di Data Ikan: ${notFoundCodes.join(', ')}. Kosongkan Kode Koi untuk entry baru, atau perbaiki kodenya kalau memang salah ketik.`)
        }

        showImportStatus('Memeriksa sesi breeding dan indukan...')
        await validateImportParents(rawDrafts, rowNumber)

        // Photos are matched by file name (Nama Foto). Old files: a photo named after the Kode Koi.
        const photosByKey = new Map()
        const duplicatePhotos = []
        for (const entry of imageEntries) {
          const key = normalizePhotoName(entry.name)
          if (photosByKey.has(key)) {
            duplicatePhotos.push(zipBaseName(entry.name))
            continue
          }
          const mimeType = fileExtension(entry.name) === 'png'
            ? 'image/png'
            : fileExtension(entry.name) === 'webp'
              ? 'image/webp'
              : fileExtension(entry.name) === 'gif'
                ? 'image/gif'
                : 'image/jpeg'
          photosByKey.set(key, new File([entry.data], zipBaseName(entry.name), { type: mimeType }))
        }
        const rowPhotoKey = (item) => {
          const photoName = normalizePhotoName(item.photo_name)
          if (photoName) return photoName
          const code = normalizeZipCode(item.code)
          return code && photosByKey.has(code) ? code : ''
        }
        const problems = []
        if (duplicatePhotos.length) problems.push(`Nama file foto kembar di ZIP: ${duplicatePhotos.join(', ')}`)
        const missingPhotos = rawDrafts
          .map((item, index) => ({ key: rowPhotoKey(item), label: `Baris ${rowNumber(index)}: ${item.photo_name || item.code}` }))
          .filter(({ key }) => key && !photosByKey.has(key))
          .map(({ label }) => label)
        if (missingPhotos.length) problems.push(`Foto tidak ada di ZIP untuk: ${missingPhotos.join('; ')}`)
        const usedKeys = new Set(rawDrafts.map(rowPhotoKey).filter(Boolean))
        const unusedPhotos = [...photosByKey.entries()].filter(([key]) => !usedKeys.has(key)).map(([, photo]) => photo.name)
        if (unusedPhotos.length) problems.push(`Foto di ZIP tidak dipakai baris mana pun (cek ejaan Nama Foto): ${unusedPhotos.join(', ')}`)
        if (problems.length) {
          throw new Error(problems.join('\n'))
        }

        const drafts = rawDrafts.map((rawItem) => {
          const code = normalizeZipCode(rawItem.code)
          const existing = code ? existingByCode.get(code) : null
          const normalized = normalizeImportedKoiItem(rawItem)

          return existing ? mergeExistingKoiWithZipOverrides(existing, rawItem, normalized) : normalized
        })

        showImportStatus(`ZIP valid. Menyiapkan ${drafts.length} entry ikan dan preview foto...`)
        entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => entry.remove())
        let photoCount = 0
        rawDrafts.forEach((rawItem, index) => {
          const key = rowPhotoKey(rawItem)
          const photo = key ? photosByKey.get(key) : null
          addKoiEntry()
          const entry = [...entriesContainer.querySelectorAll('[data-koi-entry]')].at(-1)
          // Existing fish without a new photo keep their current photo (an empty value would remove it).
          fillEntryFromDraft(entry, { ...drafts[index], image_url: photo ? '' : (drafts[index].image_url || '') })
          if (photo) {
            showImportStatus(`Menyiapkan preview foto ${index + 1}/${drafts.length}: ${rawItem.photo_name || key}`)
            setPendingZipImage(entry, photo)
            photoCount += 1
          }
        })
        refreshEntryControls()
        showImportStatus(`Impor ZIP selesai. ${drafts.length} entry siap disimpan, ${photoCount} foto (ikan lama yang diberi foto: foto masuk History Progress Foto). Foto diupload saat Simpan.`)
      } finally {
        importZipButton.disabled = false
        importZipButton.innerHTML = fileImportIcon
        importZipInput.value = ''
      }
    }
    const normalizeImportedKoiItem = (item) => {
      const pond = item.pond_id ? pondsList.find((entry) => String(entry.id) === String(item.pond_id)) : findPondByName(item.pond_name)

      return {
        code: item.code || '',
        name: item.name || '',
        pond_id: pond?.id || '',
        area: String(item.area || '').trim(),
        variety: item.variety || '',
        bloodline: item.bloodline || '',
        farm_name: item.farm_name || '',
        breeder: item.breeder || '',
        parent_info: buildParentInfoFromParts(item.parent_info, item.parent_female, item.parent_male),
        gender: normalizeImportOption(item.gender, 'unknown', validImportOptions.gender),
        parent_type: normalizeImportOption(item.parent_type, 'non_indukan', validImportOptions.parent_type),
        birth_date: normalizeImportDate(item.birth_date),
        purchase_date: normalizeImportDate(item.purchase_date),
        purchase_price: cleanMoneyValue(item.purchase_price),
        sale_price: cleanMoneyValue(item.sale_price),
        current_length_cm: String(item.current_length_cm || '').replace(',', '.'),
        status: normalizeImportOption(item.status, 'active', validImportOptions.status),
        notes: item.notes || '',
        image_url: item.image_url || '',
      }
    }
    // Baris ZIP dengan Kode Koi yang cocok ke ikan existing: `existing` (data ikan yang sudah ada,
    // ditarik) jadi dasar, cuma kolom yang memang diisi di file (dicek dari `rawItem`, nilai mentah
    // sebelum dinormalisasi) yang menimpa nilai lamanya. Kolom kosong = data lama tetap dipakai.
    const mergeExistingKoiWithZipOverrides = (existing, rawItem, normalized) => {
      const touched = (key) => String(rawItem[key] ?? '').trim() !== ''
      const merged = {
        ...existing,
        birth_date: existing.birth_date ? String(existing.birth_date).slice(0, 10) : '',
        purchase_date: existing.purchase_date ? String(existing.purchase_date).slice(0, 10) : '',
      }

      if (touched('name')) merged.name = normalized.name
      if (touched('pond_name')) merged.pond_id = normalized.pond_id
      merged.area = touched('area') ? normalized.area : touched('pond_name') ? '' : merged.pond_location || ''
      if (touched('variety')) merged.variety = normalized.variety
      if (touched('bloodline')) merged.bloodline = normalized.bloodline
      if (touched('farm_name')) merged.farm_name = normalized.farm_name
      if (touched('breeder')) merged.breeder = normalized.breeder
      if (touched('parent_info') || touched('parent_female') || touched('parent_male')) merged.parent_info = normalized.parent_info
      if (touched('gender')) merged.gender = normalized.gender
      if (touched('parent_type')) merged.parent_type = normalized.parent_type
      if (touched('status')) merged.status = normalized.status
      if (touched('birth_date')) merged.birth_date = normalized.birth_date
      if (touched('purchase_date')) merged.purchase_date = normalized.purchase_date
      if (touched('purchase_price')) merged.purchase_price = normalized.purchase_price
      if (touched('sale_price')) merged.sale_price = normalized.sale_price
      if (touched('current_length_cm')) merged.current_length_cm = normalized.current_length_cm
      if (touched('notes')) merged.notes = normalized.notes

      return merged
    }
    const exportKoiExcelTemplate = () => {
      const entries = [...entriesContainer.querySelectorAll('[data-koi-entry]')]
      const items = entries.map((entry) => {
        const payload = readEntryPayload(entry)
        const pond = pondsList.find((item) => String(item.id) === String(payload.pond_id || ''))
        const parentParts = parseParentInfoParts(payload.parent_info)

        return {
          ...payload,
          pond_name: pond?.name || '',
          area: pond?.location || payload.area,
          parent_info: parentBatchCodeFromInfo(payload.parent_info),
          parent_female: parentParts.female,
          parent_male: parentParts.male,
        }
      })
      const headerRow = excelEntryColumns.map(([header]) => header)
      const dataRows = (items.length ? items : [{}]).map((item) => excelEntryColumns.map(([, key]) => item[key] ?? ''))
      const blob = buildXlsxBlob(headerRow, dataRows, importNotesRow(excelEntryColumns))

      downloadBlob(blob, `template-entry-ikan-${new Date().toISOString().slice(0, 10)}.xlsx`)
    }
    const importKoiExcelFile = async (file) => {
      if (!file) {
        return
      }

      const rows = await parseXlsxRows(file)
      const headerIndex = findHeaderRowIndex(rows, excelHeaderMap)
      const headers = (rows[headerIndex] || []).map((item) => excelHeaderMap.get(String(item).trim().toLowerCase()) || String(item).trim())
      const rawItems = rows.slice(headerIndex + 1).map((row) => row.reduce((result, value, index) => {
        const key = headers[index]

        if (key) {
          result[key] = value
        }

        return result
      }, {}))

      if (rawItems.length === 0) {
        throw new Error('File import tidak memiliki baris data.')
