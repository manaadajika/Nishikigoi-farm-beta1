                  <div class="text-secondary small koi-text-ellipsis" title="${escapeHtml(text(item.variety))}">${escapeHtml(text(item.variety))}</div>
                </div>
                <div class="koi-card-badges d-flex align-items-center gap-1 flex-shrink-0">
                  <span class="badge bg-blue text-blue-fg koi-selected-badge">Terpilih</span>
                  <span class="badge ${koiStatusBadgeClass(item.status)}">${escapeHtml(labels[item.status] || text(item.status))}</span>
                </div>
              </div>
              <div class="row g-2 small">
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">Nama</span><div class="koi-text-ellipsis" title="${escapeHtml(text(item.name))}">${escapeHtml(text(item.name))}</div></div>
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">Bloodline</span><div class="koi-text-ellipsis" title="${escapeHtml(text(item.bloodline))}">${escapeHtml(text(item.bloodline))}</div></div>
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">Ternakan</span><div class="koi-text-ellipsis" title="${escapeHtml(text(item.farm_name))}">${escapeHtml(text(item.farm_name))}</div></div>
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">${koiPlace(item).label}</span><div class="koi-text-ellipsis" title="${escapeHtml(text(koiPlace(item).value))}">${escapeHtml(text(koiPlace(item).value))}</div></div>
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">Sex</span><div class="koi-text-ellipsis" title="${escapeHtml(labels[item.gender] || text(item.gender))}">${escapeHtml(labels[item.gender] || text(item.gender))}</div></div>
                <div class="col-6 koi-card-detail-cell"><span class="text-secondary">Size</span><div class="koi-text-ellipsis" title="${item.current_length_cm ? `${escapeHtml(formatDecimal(item.current_length_cm))} cm` : '-'}">${item.current_length_cm ? `${escapeHtml(formatDecimal(item.current_length_cm))} cm` : '-'}</div></div>
              </div>
              <div class="mt-2 d-flex align-items-center justify-content-between gap-2">
                <span class="koi-sequence-number koi-text-ellipsis" data-seq-koi-id="${escapeHtml(item.id)}" style="cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px" title="${koiSequenceNumber(item)}${archiveMode && item.archived_at ? ` - diarsipkan ${window.KoiAuth.formatDate(item.archived_at)}` : ''} - klik untuk memindahkan nomor urut">${koiSequenceNumber(item)}${archiveMode && item.archived_at ? ` · Arsip ${window.KoiAuth.formatDate(item.archived_at)}` : ''}</span>
                <div class="d-flex gap-2"><button class="btn btn-outline-primary btn-icon" type="button" data-progress-koi-id="${escapeHtml(item.id)}" aria-label="Foto progress" title="Foto progress">${eyeIcon}</button><button class="btn btn-outline-primary btn-icon" type="button" data-edit-koi-id="${escapeHtml(item.id)}" data-role-required="database-write" aria-label="Edit ikan" title="Edit ikan">${editIcon}</button></div>
              </div>
            </div>
          </div>
        </div>
      `).join('') || '<div class="col-12 text-secondary">Belum ada data ikan yang sesuai filter.</div>'
      renderPagination(koiPageMeta.total, totalPages)
      updateSelectedCount()
      saveViewState()
    }

    const loadKoiLegacy = (silent = false) => {
      if (!silent) {
        cards.innerHTML = '<div class="col-12 text-secondary"><div class="d-flex flex-column align-items-center justify-content-center gap-2 py-5 text-secondary"><span class="spinner-border text-primary" role="status" aria-hidden="true"></span><span>Memuat data ikan...</span></div></div>'
      }

      return fetch(`${apiUrl}/koi${archiveMode ? '?archived=1' : ''}`)
        .then((response) => response.json())
        .then((koi) => {
          const signature = JSON.stringify(koi)
          if (silent && signature === koiRealtimeSignature) {
            return
          }
          koiRealtimeSignature = signature
          localStorage.setItem(koiCacheKey, signature)
          koiItems = koi
          rebuildKoiSequence()
          buildFilterOptions()
          updateClearFiltersButton()
          renderCards()
          applyPendingScroll()
        })
        .catch(() => {
          if (!silent) {
            cards.innerHTML = '<div class="col-12 text-danger">Data ikan gagal dimuat.</div>'
          }
        })
    }

    const restoreKoiCacheLegacy = () => {
      try {
        const cached = JSON.parse(localStorage.getItem(koiCacheKey) || '[]')
        if (!Array.isArray(cached) || cached.length === 0) return false
        koiRealtimeSignature = JSON.stringify(cached)
        koiItems = cached
        rebuildKoiSequence()
        buildFilterOptions()
        updateClearFiltersButton()
        renderCards()
        applyPendingScroll()
        return true
      } catch {
        localStorage.removeItem(koiCacheKey)
        return false
      }
    }

    const loadBreeding = () => {
      fetch(`${apiUrl}/breeding`)
        .then((response) => response.json())
        .then((items) => {
          breedingItems = items
          buildBreederOptions()
          entriesContainer.querySelectorAll('[data-koi-entry]').forEach(updateEntryParentPreview)
          updateEditBreederParents()
          // the parents named by the sessions are fetched by id (only those) for the photos and details shown
          const parentIds = [...new Set(items.flatMap((item) => [...parseParentEntries(item.male_parent_entries, item.male_koi_id, ''), ...parseParentEntries(item.female_parent_entries, item.female_koi_id, '')].map((entry) => entry.koi_id)).filter(Boolean).map(String))]
          if (parentIds.length) {
            window.KoiPicker.byIds(parentIds, { scope: 'all' }).then(() => {
              entriesContainer.querySelectorAll('[data-koi-entry]').forEach(updateEntryParentPreview)
              updateEditBreederParents()
            }).catch(() => {})
          }
        })
        .catch(() => {
          breedingItems = []
          buildBreederOptions()
          entriesContainer.querySelectorAll('[data-koi-entry]').forEach(updateEntryParentPreview)
          updateEditBreederParents()
        })
    }

    const loadPonds = () => {
      fetch(`${apiUrl}/ponds`)
        .then((response) => response.json())
        .then((ponds) => {
          pondsList = ponds
          const areaDatalist = document.querySelector('[data-area-options]')
          if (areaDatalist) areaDatalist.innerHTML = [...new Set(ponds.map((pond) => String(pond.location || '').trim()).filter(Boolean))].map((area) => `<option value="${escapeHtml(area)}"></option>`).join('')
          pondDatalist.innerHTML = '<option value="Tanpa lokasi"></option>' + ponds.map((pond) => `
            <option value="${escapeHtml(pond.name)}"></option>
          `).join('')
          entriesContainer.querySelectorAll('[data-koi-entry]').forEach((entry) => syncEntryPond(entry))
          syncEditPond()
          renderBulkInput()
        })
    }

    filters.forEach((filter) => filter.addEventListener('change', () => {
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    }))
    searchInput.addEventListener('input', () => {
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    })
    genderSelect?.addEventListener('change', () => {
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    })
    parentTypeSelect?.addEventListener('change', () => {
      currentPage = 1
      updateClearFiltersButton()
      renderCards()
    })
    clearFiltersButton?.addEventListener('click', clearKoiFilters)
    // The less common actions (merge, delete, bulk note, archive) live behind a "..." button next to "Batal pilih".
    dockGroupToggle?.addEventListener('click', () => {
      const open = actionDock.classList.toggle('is-group-open')
      dockGroupToggle.setAttribute('aria-pressed', open ? 'true' : 'false')
      dockGroupToggle.setAttribute('title', open ? 'Kembali ke tombol utama' : 'Aksi lainnya')
      dockGroupToggle.setAttribute('aria-label', open ? 'Kembali ke tombol utama' : 'Aksi lainnya')
    })
    // "Pindah menu" drop-up above the dock (shared with Breeding, Data Kolam and Laporan).
    window.KoiDock?.attachNav(document.querySelector('[data-dock-nav]'), actionDock)
    actionDockHide?.addEventListener('click', () => {
      actionDockHidden = true
      updateActionDock()
    })
    actionDockReveal?.addEventListener('click', () => {
      actionDockHidden = false
      updateActionDock()
    })
    window.addEventListener('scroll', updateActionDock, { passive: true })
    window.addEventListener('resize', updateActionDock)
    sequenceSortToggle?.addEventListener('click', () => {
      sequenceSortDirection = sequenceSortDirection === 'asc' ? 'desc' : 'asc'
      const isDesc = sequenceSortDirection === 'desc'
      sequenceSortToggle.textContent = isDesc ? 'Z/A' : 'A/Z'
      sequenceSortToggle.setAttribute('aria-pressed', isDesc ? 'true' : 'false')
      sequenceSortToggle.setAttribute('aria-label', isDesc ? 'Urutan Z ke A' : 'Urutan A ke Z')
      sequenceSortToggle.setAttribute('title', isDesc ? 'Urutan Z ke A' : 'Urutan A ke Z')
      renderCards()
    })
    pageSizeSelect?.addEventListener('change', () => {
      pageSize = Number(pageSizeSelect.value) || 24
      currentPage = 1
      renderCards()
    })
    pageSizeButtons.forEach((button) => button.addEventListener('click', () => {
      pageSize = Number(button.dataset.koiPageSize) || 20
      currentPage = 1
      renderCards()
    }))
    pagination.addEventListener('click', (event) => {
      const pageButton = event.target.closest('[data-koi-page]')

      if (!pageButton || pageButton.closest('.disabled')) {
        return
      }

      currentPage = Number(pageButton.dataset.koiPage) || 1
      renderCards()
      window.scrollTo({ top: 0, behavior: 'instant' })
    })
    bulkField.addEventListener('change', renderBulkInput)
    bulkValueContainer.addEventListener('input', (event) => {
      if (event.target.matches('[data-money-input]')) {
        formatMoneyInput(event.target)
      }
      if (event.target.matches('[data-bulk-parent-session]')) {
        renderParentSearchMenu(event.target)
        updateParentClearVisibility(event.target.closest('.koi-parent-search'))
        updateBulkParentSelectors()
      }
      if (event.target.matches('[data-bulk-value][data-pond-search-input]')) {
        renderPondSearchMenu(event.target)
        syncPondSearchContext(event.target)
      }
      if (event.target.matches('[data-bulk-value][data-variety-search-input]')) {
        renderVarietySearchMenu(event.target)
      }
    })
    bulkValueContainer.addEventListener('change', (event) => {
      if (event.target.matches('[data-bulk-parent-session]')) {
        updateBulkParentSelectors()
      }
    })
    bulkValueContainer.addEventListener('focusin', (event) => {
      if (event.target.matches('[data-bulk-parent-session]')) {
        closeParentSearchMenus(event.target)
        renderParentSearchMenu(event.target)
      }
      if (event.target.matches('[data-bulk-value][data-pond-search-input]')) {
        closePondSearchMenus(event.target)
        renderPondSearchMenu(event.target)
      }
      if (event.target.matches('[data-bulk-value][data-variety-search-input]')) {
        closeVarietySearchMenus(event.target)
        renderVarietySearchMenu(event.target)
      }
    })
    bulkValueContainer.addEventListener('click', (event) => {
      const parentPick = event.target.closest('[data-parent-search-pick]')
      const parentClear = event.target.closest('[data-parent-clear]')
      const pondPick = event.target.closest('[data-pond-search-pick]')
      const pondClear = event.target.closest('[data-pond-clear]')
      const varietyPick = event.target.closest('[data-variety-search-pick]')
      const autoCode = event.target.closest('[data-bulk-auto-code]')

      if (autoCode) {
        bulkValueContainer.querySelector('[data-bulk-value]').value = ''
        applyBulkValue()
        return
      }

      if (parentPick) {
        pickParentSearchItem(parentPick)
        return
      }

      if (parentClear) {
        clearParentField(parentClear)
        return
      }

      if (pondPick) {
        pickPondSearchItem(pondPick)
        return
      }

      if (pondClear) {
        clearPondField(pondClear)
        return
      }

      if (varietyPick) {
        pickVarietySearchItem(varietyPick)
      }
    })
    applyBulkButton.addEventListener('click', applyBulkValue)
    selectVisibleButton.addEventListener('click', selectVisibleKoi)
    selectedCount.addEventListener('click', toggleSelectedView)
    hideSelectedButton.addEventListener('click', toggleHideSelectedView)
    clearSelectedButton.addEventListener('click', clearSelectedKoi)
    editSelectedButton.addEventListener('click', openSelectedEditForm)
    copySelectedIdsButton.addEventListener('click', () => {
      copySelectedKoiIds().catch(() => alert('ID gagal disalin.'))
    })
    mergeSelectedButton.addEventListener('click', () => openMergeSelectedKoi().catch((error) => alert(error.message)))
    deleteSelectedButton.addEventListener('click', deleteSelectedKoi)
    archiveSelectedButton.addEventListener('click', archiveSelectedKoi)
    openAddButton.addEventListener('click', resetAddFormMode)
    // While fish are selected the main "+" is hidden; the same button is also offered in "Aksi lainnya" (the "..." group)
    if (!archiveMode) {
      const extraAddButton = openAddButton.cloneNode(true)
      extraAddButton.removeAttribute('data-open-add-koi')
      extraAddButton.setAttribute('data-open-add-koi-extra', '')
      extraAddButton.setAttribute('data-dock-group', '')
      extraAddButton.classList.remove('koi-selection-hidden', 'd-none')
      const firstGroupButton = document.querySelector('[data-merge-selected-koi]')
      if (firstGroupButton) firstGroupButton.parentElement.insertBefore(extraAddButton, firstGroupButton)
      extraAddButton.addEventListener('click', resetAddFormMode)
    }
    bulkPondButton.addEventListener("click", openMassActionPopup)
    bulkPondSearch.addEventListener('input', renderBulkPondList)
    bulkPondList.addEventListener('click', (event) => {
      const button = event.target.closest('[data-apply-selected-pond]')

      if (button) {
        changeSelectedPond(button.dataset.applySelectedPond).catch((error) => alert(error.message))
      }
    })
    bulkNoteButton.addEventListener('click', () => appendSelectedNotes().catch((error) => alert(error.message)))
    printSelectedButton.addEventListener('click', printSelectedKoi)
    exportSpreadsheetButton.addEventListener('click', exportSelectedSpreadsheet)
    downloadImagesButton.addEventListener('click', () => downloadSelectedImages().catch((error) => alert(error.message)))
    cards.addEventListener('click', async (event) => {
      const seqSpan = event.target.closest('[data-seq-koi-id]')
      if (seqSpan) {
        event.preventDefault()
        event.stopPropagation()
        const seqKoi = koiItems.find((entry) => String(entry.id) === String(seqSpan.dataset.seqKoiId))
        if (!seqKoi) return
        const current = koiSequenceIndex(seqKoi)
        const answer = await window.KoiDialog.prompt({
          title: 'Pindahkan nomor urut',
          message: `Nomor urut baru untuk ${seqKoi.code} (sekarang ${current}).
      Bila nomor itu sudah dipakai ikan lain, ikan itu dan semua sesudahnya bergeser satu nomor.`,
          confirmText: 'Pindahkan',
          numeric: 'integer',
        }, String(current))
        if (answer === null || answer === undefined) return
        const wanted = parseInt(String(answer).trim(), 10)
        if (!Number.isFinite(wanted) || wanted < 1) { window.KoiToast?.show('Nomor urut harus angka 1 atau lebih.'); return }
        if (wanted === current) return
        const moveResponse = await fetch(`${apiUrl}/koi/move-seq`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: seqKoi.id, seq: wanted }) })
        const moved = await moveResponse.json().catch(() => ({}))
        if (!moveResponse.ok) { window.KoiDialog.alert(moved.error || 'Nomor urut gagal dipindahkan'); return }
        window.KoiToast?.show(moved.clamped ? `Nomor terbesar ${moved.total}: ${seqKoi.code} dipindahkan ke ${moved.seq}` : `${seqKoi.code} dipindahkan ke nomor ${moved.seq}`)
        await keepScroll(loadKoi)
        return
      }

      const editButton = event.target.closest('[data-edit-koi-id]')
      const copyCodeButton = event.target.closest('[data-copy-koi-code]')

      const zoomButton = event.target.closest('[data-zoom-koi-id]')

      if (zoomButton) {
        event.preventDefault()
        event.stopPropagation()
        const zoomItem = koiItems.find((entry) => String(entry.id) === String(zoomButton.dataset.zoomKoiId))
        if (zoomItem?.image_url) window.KoiAuth.zoomKoi(zoomItem.image_url, zoomItem, [], zoomItem.code)
        return
      }

      const progressButton = event.target.closest('[data-progress-koi-id]')

      if (progressButton) {
        event.preventDefault()
        event.stopPropagation()
        const progressKoi = koiItems.find((entry) => String(entry.id) === String(progressButton.dataset.progressKoiId))
        if (!progressKoi) return
        progressButton.disabled = true
        try {
          const detailResponse = await fetch(`${apiUrl}/koi/${progressKoi.id}`).catch(() => null)
          const fishDetail = detailResponse && detailResponse.ok ? await detailResponse.json().catch(() => null) : null
          const fishNotes = String(fishDetail?.notes ?? progressKoi.notes ?? '').trim()
          const response = await fetch(`${apiUrl}/koi/${progressKoi.id}/photo-history`)
          const history = response.ok ? await response.json() : []
          const photos = history.filter((entry) => entry.image_url)
          if (progressKoi.image_url && !photos.some((entry) => entry.image_url === progressKoi.image_url)) {
            photos.unshift({ image_url: progressKoi.image_url, length_cm: progressKoi.current_length_cm, measured_at: '', notes: 'Foto utama' })
          }
          if (!photos.length) {
            window.KoiToast?.show('Belum ada foto progress untuk ikan ini.')
          } else {
            const info = window.KoiAuth.koiZoomInfo(progressKoi)
            const progressItems = photos.map((entry, index) => {
              const sizeLabel = `[${index + 1}] ${entry.length_cm ? `${formatDecimal(entry.length_cm)} cm` : 'Tanpa ukuran'}`
              const dateText = entry.measured_at ? window.KoiAuth.formatDate(entry.measured_at) : ''
              return {
                src: entry.image_url,
                title: info.title || progressKoi.code,
                label: sizeLabel,
                sub: dateText,
                lines: [...info.lines, sizeLabel, entry.weight_g ? `${formatDecimal(entry.weight_g)} g` : '', dateText, entry.notes || '', ...(fishNotes ? [{ block: fishNotes, title: 'Catatan' }] : [])].filter(Boolean),
              }
            })
            // one photo only: open its zoom right away, several: all of them in a grid
            if (progressItems.length === 1) window.KoiAuth.zoomSeries(progressItems, 0)
            else window.KoiAuth.photoGrid(progressItems, info.title || progressKoi.code, info.lines)
          }
        } catch (error) {
          window.KoiToast?.show('Foto progress gagal dimuat.')
        } finally {
          progressButton.disabled = false
        }
        return
      }

      if (copyCodeButton) {
        event.preventDefault()
        event.stopPropagation()
        const originalText = copyCodeButton.textContent
        const copied = await copyText(copyCodeButton.dataset.copyKoiCode)
        copyCodeButton.setAttribute('title', copied ? 'Kode Koi tersalin' : 'Kode Koi gagal disalin')
        copyCodeButton.classList.toggle('is-copied', copied)
        copyCodeButton.classList.toggle('is-copy-failed', !copied)
        copyCodeButton.textContent = copied ? 'Tersalin' : 'Gagal'

        window.setTimeout(() => {
          copyCodeButton.textContent = originalText
          copyCodeButton.classList.remove('is-copied', 'is-copy-failed')
        }, 1000)
        return
      }

      if (editButton) {
        openEditKoi(editButton.dataset.editKoiId)
        return
      }

      const preview = event.target.closest('[data-koi-preview-select]')

      if (preview) {
        toggleKoiSelection(preview.dataset.koiPreviewSelect)
      }
    })
    addEntryButton.addEventListener('click', addKoiEntry)
    document.querySelector('[data-koi-empty-state]')?.addEventListener('click', (event) => {
      const action = event.target.closest('[data-empty-action]')?.dataset.emptyAction
