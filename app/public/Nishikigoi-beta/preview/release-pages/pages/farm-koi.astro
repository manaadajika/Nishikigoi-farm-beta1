        const keys = new Set(rows[index].map((cell) => headerMap.get(String(cell).trim().toLowerCase())).filter(Boolean))
        if (keys.size > bestCount) {
          best = index
          bestCount = keys.size
        }
      }
      return best
    }
    const importColumnNotes = {
      photo_name: 'WAJIB untuk ikan baru: nama file foto di ZIP, contoh IMG_20260927_101500 (.jpg boleh ditulis atau tidak, huruf besar/kecil bebas). Ikan lama (Kode Koi diisi): boleh kosong; kalau diisi, foto masuk History Progress Foto sebagai foto terbaru.',
      code: 'Kosongkan untuk ikan BARU. Isi Kode Koi yang sudah ada (contoh 26RLZI) untuk memperbarui ikan itu; kolom lain yang dikosongkan = data lama tetap dipakai.',
