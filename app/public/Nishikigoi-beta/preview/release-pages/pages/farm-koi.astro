      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    }[char]))

    const updateActionDock = () => {
      if (!actionDock || !actionDockSentinel) return
      const shouldFloat = true
      actionDock.classList.toggle('is-floating', shouldFloat && !actionDockHidden)
      actionDock.classList.toggle('is-dock-hidden', shouldFloat && actionDockHidden)
      actionDockReveal?.classList.toggle('is-visible', shouldFloat && actionDockHidden)
    }

    const labels = {
      unknown: 'Unknown',
      male: 'Male',
      female: 'Female',
      active: 'Aktif',
      non_active: 'Non-Aktif',
      quarantine: 'Karantina',
      sold: 'Terjual',
