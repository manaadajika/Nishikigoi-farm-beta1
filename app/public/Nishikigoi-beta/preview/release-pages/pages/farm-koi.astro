          <option value="active">Aktif</option>
          <option value="non_active">Non-Aktif</option>
          <option value="quarantine">Karantina</option>
          <option value="sold">Terjual</option>
          <option value="dead">Mati</option>
        </select>
      `,
      birth_date: () => `<input class="form-control" type="text" data-date-parts data-bulk-value />`,
      purchase_date: () => `<input class="form-control" type="text" data-date-parts data-bulk-value />`,
      purchase_price: () => '<input class="form-control" type="text" inputmode="numeric" data-bulk-value data-money-input placeholder="0" />',
      sale_price: () => '<input class="form-control" type="text" inputmode="numeric" data-bulk-value data-money-input placeholder="0" />',
      current_length_cm: () => '<input class="form-control" type="number" min="0" step="0.1" data-bulk-value placeholder="0" />',
      notes: () => '<input class="form-control" data-bulk-value placeholder="Catatan" /><label class="form-check mt-2 mb-0"><input class="form-check-input" type="checkbox" data-bulk-notes-replace /><span class="form-check-label">Ganti catatan (hapus catatan yang sudah ada)</span></label>',
    }

    const previewColors = ['#dbeafe', '#fee2e2', '#dcfce7', '#fef3c7', '#ede9fe', '#e0f2fe', '#fce7f3', '#e5e7eb']
    const previewPlaceholder = (item) => `<span class="koi-card-preview-placeholder"><span class="koi-card-preview-code">${escapeHtml(text(item.code))}</span><small>No foto</small></span>`
    // lists show small copies of the photos (the server makes them the first time: /api/thumb/<width>/<path>); the photo itself opens on a click
    const photoThumb = (url, width) => {
      const match = /^\/api\/uploads\/(.+)$/.exec(String(url || ''))
      return match ? `/api/thumb/${width}/${match[1]}` : url
    }
    const previewMedia = (item) => item.image_url
      ? `<img src="${escapeHtml(photoThumb(item.image_url, 480))}" alt="${escapeHtml(text(item.name))}" loading="lazy" decoding="async" fetchpriority="low" />`
      : previewPlaceholder(item)
    const formatDecimal = (value) => {
      if (value === null || value === undefined || value === '') {
        return ''
      }

      const number = Number(value)

      if (!Number.isFinite(number)) {
        return String(value)
      }

      return number.toLocaleString('id-ID', {
        maximumFractionDigits: 1,
      })
    }
    const decimalFieldNames = new Set(['current_length_cm', 'current_weight_g'])
    const formatDecimalForInput = (value) => {
      if (value === null || value === undefined || value === '') {
        return ''
      }

      const number = Number(value)

      if (!Number.isFinite(number)) {
        return ''
      }

      return String(Math.round(number * 10) / 10)
    }
    const moneyFieldNames = new Set(['purchase_price', 'sale_price'])
    const cleanMoneyValue = (value) => {
      const text = String(value ?? '').trim()
      // The server sends money as decimal text ("8475000.00"). Keep the whole rupiah: stripping every non-digit made the
      // cents into two extra zeros (847.500.000 instead of 8.475.000), and saving that multiplied the price by 100.
      if (/^\d+\.\d{1,2}$/.test(text)) return String(Math.round(Number(text)))
      return text.replace(/[^\d]/g, '')
    }
    const formatMoneyValue = (value) => {
      const cleanValue = cleanMoneyValue(value)

      return cleanValue ? Number(cleanValue).toLocaleString('id-ID') : ''
    }
    const formatMoneyInput = (input) => {
      input.value = formatMoneyValue(input.value)
    }
    const filterValue = (item, key) => String(item[key] || '').trim()
    const uniqueKoiValuesLegacy = (key) => [...new Set(koiItems.map((item) => filterValue(item, key)).filter(Boolean))].sort()
    // Drafts live on the server (Antrean menu) so they can be continued from any device.
    let koiDraftCache = []
    let currentKoiDraftId = null
    const readKoiDrafts = () => koiDraftCache
    const koiDraftSummary = (items) => {
      const names = items.map((item) => item.code || item.name || item.variety).filter(Boolean)
      return `${items.length} ikan${names.length ? `: ${names.slice(0, 4).join(', ')}${names.length > 4 ? ', ...' : ''}` : ''}`
    }
    const refreshKoiDrafts = async () => {
      if (!window.KoiDrafts?.canSee()) return
      try {
        koiDraftCache = await window.KoiDrafts.list('koi')
      } catch {
        // keep the last list
      }
      renderDraftMenu()
      draftButton.setAttribute('title', koiDraftCache.length ? `Simpan draft (${koiDraftCache.length} tersimpan)` : 'Simpan draft')
    }
    // One-time move of drafts that older versions kept only in this browser.
    const migrateLocalKoiDrafts = async () => {
      let local = []
      try {
        local = JSON.parse(localStorage.getItem(draftStorageKey) || '[]')
      } catch {
        local = []
      }
      if (!Array.isArray(local) || !local.length || !window.KoiDrafts?.canUse('koi')) return
      for (const draft of local) {
        const items = Array.isArray(draft.items) ? draft.items : []
        await window.KoiDrafts.save({ type: 'koi', name: draft.name || '', summary: koiDraftSummary(items), item_count: items.length, data: { items } })
      }
      localStorage.removeItem(draftStorageKey)
    }
    const formatDraftName = (value) => {
      const date = new Date(value)

      if (Number.isNaN(date.getTime())) {
        return 'Draft tanpa tanggal'
      }

      return date.toLocaleString('id-ID', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      })
    }
    const breedingLabel = (item) => {
      const code = item.batch_code || `#${item.id}`
      const sessionName = item.session_name || 'Tanpa nama sesi'

      return `${code} - ${sessionName}`
    }
    const parseParentEntries = (value, fallbackId, fallbackLabel) => {
      try {
        const parsed = typeof value === 'string' ? JSON.parse(value) : value
        const entries = Array.isArray(parsed) ? parsed : []

        return entries.length > 0 ? entries : fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '' }] : []
      } catch {
        return fallbackId ? [{ koi_id: fallbackId, label: fallbackLabel || '' }] : []
      }
    }
    const parentLabel = (entry) => entry.label || `ID ${entry.koi_id}`
    const parentPreviewCard = (label, imageUrl, detail = '') => {
      const tag = imageUrl ? 'button' : 'div'
      const attrs = imageUrl
        ? ` type="button" data-preview-parent-photo="${escapeHtml(imageUrl)}" data-preview-parent-title="${escapeHtml(label || 'Indukan')}"`
        : ''

      return `
      <${tag} class="koi-parent-preview-card d-flex align-items-center gap-2 p-2"${attrs}>
        ${imageUrl ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(label)}" />` : `<div class="avatar avatar-lg">${escapeHtml(label || '-').slice(0, 1)}</div>`}
        <div class="min-width-0">
          <div class="fw-medium text-truncate">${escapeHtml(label || '-')}</div>
          <div class="text-secondary small text-truncate">${escapeHtml(detail || '')}</div>
        </div>
      </${tag}>
    `
    }
    const koiById = (id) => window.KoiPicker.cache[String(id || '')] || koiItems.find((item) => String(item.id) === String(id || ''))
    const parentEntryPreview = (entry, fallbackImage = '', fallbackDetail = '') => {
      const koi = koiById(entry?.koi_id)

      return {
        label: parentLabel(entry),
        image: koi?.image_url || fallbackImage || '',
        detail: [koi?.variety, koi?.bloodline].filter(Boolean).join(' - ') || fallbackDetail || '',
      }
    }
    const breedingSearchValues = (item) => [
      breedingLabel(item),
      item.batch_code,
      item.session_name,
      item.male_koi_name,
      item.female_koi_name,
    ].filter(Boolean)
    const findBreedingByValue = (value) => {
      const normalized = parseParentInfoParts(value).parent.trim().toLowerCase()

      if (!normalized) {
        return null
      }

      return breedingItems.find((item) => {
        const label = breedingLabel(item).toLowerCase()
        const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
        const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
        const parentValues = [
          ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).map(parentLabel),
          ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).map(parentLabel),
        ]

        const candidates = [label, ...breedingSearchValues(item), ...parentValues]
          .map((candidate) => String(candidate || '').trim().toLowerCase())
          .filter(Boolean)

        return candidates.some((candidate) => candidate === normalized || candidate.includes(normalized) || normalized.startsWith(candidate))
      }) || null
    }
    const parentSearchText = (item) => {
      const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
      const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')

      return [
        breedingLabel(item),
        ...breedingSearchValues(item),
        ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).flatMap((entry) => [entry.koi_id, parentLabel(entry)]),
        ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).flatMap((entry) => [entry.koi_id, parentLabel(entry)]),
      ].filter(Boolean).join(' ').toLowerCase()
    }
    const parentSearchMatches = (value) => {
      const terms = String(value || '').trim().toLowerCase().split(/\s+/).filter(Boolean)

      return breedingItems
        .filter((item) => terms.length === 0 || terms.every((term) => parentSearchText(item).includes(term)))
        .slice(0, 8)
    }
    // Photo of the session in the Indukan/Breeding list: the female parent first (found through the parent entries,
    // because most sessions keep their parents there and not in female_koi_id), then the server's fields, then the male.
    const parentEntriesOf = (item, side) => parseParentEntries(item[side + '_parent_entries'], item[side + '_koi_id'], '')
    const parentThumbUrl = (item) => {
      const sides = ['female', 'male']
      for (const side of sides) {
        for (const entry of parentEntriesOf(item, side)) {
          const code = String(entry.label || '').trim().toLowerCase()
          const koi = (window.KoiPicker.cache[String(entry.koi_id)] || koiItems.find((candidate) => String(candidate.id) === String(entry.koi_id) || (code && String(candidate.code || '').toLowerCase() === code)))
          if (koi && koi.image_url) return koi.image_url
        }
        if (item[side + '_koi_image_url']) return item[side + '_koi_image_url']
      }
      return ''
    }
    const parentEntryText = (item, side) => parentEntriesOf(item, side).map(parentLabel).filter((label) => !/^ID /.test(label)).join(', ')
    const renderParentSearchMenu = (input) => {
      const menu = input.closest('.koi-parent-search')?.querySelector('[data-parent-search-menu]')

      if (!menu) {
        return
      }

      const matches = parentSearchMatches(input.value)
      menu.innerHTML = matches.length
        ? matches.map((item) => {
          const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')
          const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
          const method = isNaturalBreeding(item) ? 'Alami' : 'Stripping'
          const thumbUrl = parentThumbUrl(item)
          const thumbMarkup = thumbUrl
            ? `<img class="koi-parent-search-thumb" src="${escapeHtml(thumbUrl)}" alt="${escapeHtml(breedingLabel(item))}" loading="lazy" decoding="async" fetchpriority="low" />`
            : '<span class="koi-parent-search-thumb koi-parent-search-placeholder">BR</span>'

          return `
            <button class="koi-parent-search-item" type="button" data-parent-search-pick="${escapeHtml(item.id)}">
              <span class="koi-parent-search-main">
                ${thumbMarkup}
                <span class="koi-parent-search-copy">
                  <span class="d-block fw-medium text-truncate">${escapeHtml(breedingLabel(item))}</span>
                  <span class="d-block text-secondary small text-truncate">Female: ${escapeHtml(parentEntryText(item, 'female') || femaleFallback || '-')} | Male: ${escapeHtml(parentEntryText(item, 'male') || maleFallback || 'Mix')} | ${escapeHtml(method)}</span>
                </span>
              </span>
            </button>
          `
        }).join('')
        : '<div class="koi-parent-search-empty">Tidak ada sesi breeding yang cocok</div>'
      menu.classList.remove('d-none')
    }
    const closeParentSearchMenus = (exceptInput = null) => {
      document.querySelectorAll('[data-parent-search-menu]').forEach((menu) => {
        if (exceptInput && menu === exceptInput.closest('.koi-parent-search')?.querySelector('[data-parent-search-menu]')) {
          return
        }

        menu.classList.add('d-none')
      })
    }
    const enrichParentInfoValue = (parentValue, maleValue = 'mix') => {
      const parts = parseParentInfoParts(parentValue)

      if (parts.parent && (parts.female || parts.male)) {
        return buildParentInfoFromParts(parts.parent, parts.female, parts.male || maleValue)
      }

      // standard text "BR250601 - nama sesi - id female - id male" (typed, pasted or from Excel)
      const shortcut = parseBulkParentShortcut(parentValue)

      if (!shortcut.breeding) {
        return parentValue
      }

      const typedMale = shortcut.male && !/^mix$/i.test(shortcut.male) ? shortcut.male : ''

      return selectedBreederLabel(shortcut.breeding, typedMale || maleValue, shortcut.female)
    }
    const pickParentSearchItem = (button) => {
      const input = button.closest('.koi-parent-search')?.querySelector('[data-parent-search-input]')
      const breeding = breedingItems.find((item) => String(item.id) === String(button.dataset.parentSearchPick))

      if (!input || !breeding) {
        return
      }

      input.value = breedingLabel(breeding)
      updateParentClearVisibility(input.closest('.koi-parent-search'))
      closeParentSearchMenus()

      const entry = input.closest('[data-koi-entry]')
      if (entry) {
        updateEntryParentPreview(entry)
        return
      }

      if (input.matches('[data-bulk-parent-session]')) {
        updateBulkParentSelectors()
        return
      }

      updateEditBreederParents()
    }

    const showKoiError = (message) => {
      errorBox.textContent = message
      errorBox.classList.remove('d-none')
    }

    const hideKoiError = () => {
      errorBox.textContent = ''
      errorBox.classList.add('d-none')
    }

    const showImportStatus = (message) => {
      importStatusBox.textContent = message
      importStatusBox.classList.remove('d-none')
    }

    const hideImportStatus = () => {
      importStatusBox.textContent = ''
      importStatusBox.classList.add('d-none')
    }
    const updateParentClearVisibility = (wrapper) => {
      const input = wrapper?.querySelector('[data-parent-search-input]')
      const button = wrapper?.querySelector('[data-parent-clear]')

      if (!input || !button) {
        return
      }

      button.classList.toggle('d-none', !String(input.value || '').trim())
    }
    const clearParentField = (button) => {
      const wrapper = button.closest('.koi-parent-search')
      const input = wrapper?.querySelector('[data-parent-search-input]')

      if (!input) {
        return
      }

      input.value = ''
      closeParentSearchMenus()
      updateParentClearVisibility(wrapper)

      const entry = input.closest('[data-koi-entry]')
      if (entry) {
        updateEntryParentPreview(entry)
        input.focus()
        return
      }

      if (input.matches('[data-bulk-parent-session]')) {
        updateBulkParentSelectors()
        input.focus()
        return
      }

      updateEditBreederParents()
      input.focus()
    }
    const parentEntriesForBreeding = (breeding, role) => {
      if (!breeding) {
        return []
      }

      const fallbackCode = role === 'female' ? breeding.female_koi_code : breeding.male_koi_code
      const fallbackName = role === 'female' ? breeding.female_koi_name : breeding.male_koi_name
      const fallbackId = role === 'female' ? breeding.female_koi_id : breeding.male_koi_id
      const source = role === 'female' ? breeding.female_parent_entries : breeding.male_parent_entries
      const fallbackLabel = [fallbackCode, fallbackName].filter(Boolean).join(' - ')

      return parseParentEntries(source, fallbackId, fallbackLabel)
    }
    const renderParentOptionList = (entries, includeMix = false) => [
      ...(includeMix ? [{ value: 'mix', label: 'Mix' }] : []),
      ...entries.map((entry) => ({ value: parentLabel(entry), label: parentLabel(entry) })),
    ]
    const entryCodeTokens = (entry) => [
      entry.koi_id,
      entry.code,
      entry.label,
      parentLabel(entry),
    ].filter(Boolean).map((item) => String(item).trim().toLowerCase())
    const findParentEntryByToken = (entries, token) => {
      const normalized = String(token || '').trim().toLowerCase()
      if (!normalized) return null

      return entries.find((entry) => entryCodeTokens(entry).some((candidate) => candidate === normalized || candidate.includes(normalized)))
    }
    const parseBulkParentShortcut = (rawValue = '') => {
      const raw = String(rawValue || '').trim()
      if (!raw) return { breeding: null, female: '', male: 'mix', parent: '' }

      const escapeRegex = (text) => String(text).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
      const exactBatch = breedingItems.find((item) => {
        const code = String(item.batch_code || '').trim()
        return code && new RegExp(`^${escapeRegex(code)}\\s*-\\s*`, 'i').test(raw)
      })
      const breeding = exactBatch || findBreedingByValue(raw)

      if (!breeding) {
        return { breeding: null, female: '', male: 'mix', parent: raw }
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parentEntriesForBreeding(breeding, 'female')
      const maleEntries = parentEntriesForBreeding(breeding, 'male')
      const female = femaleEntries.map(parentLabel).join(', ') || femaleFallback || '-'

      // standard: "BR250601 - nama sesi (boleh dikosongkan) - id female - id male"; no male given = mix
      let rest = exactBatch ? raw.replace(new RegExp(`^${escapeRegex(String(exactBatch.batch_code).trim())}\\s*-?\\s*`, 'i'), '') : ''
      rest = rest.replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim()
      const sessionName = String(breeding.session_name || '').replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim()
      if (sessionName && rest.toLowerCase().startsWith(sessionName.toLowerCase())) {
        rest = rest.slice(sessionName.length).replace(/^\s*-\s*/, '').trim()
      }
      const tokens = rest.split(/\s+-\s+/).map((token) => token.trim()).filter(Boolean)
      let maleToken = ''
      if (tokens.length >= 2) {
        maleToken = tokens[1]
      } else if (tokens.length === 1 && !findParentEntryByToken(femaleEntries, tokens[0])) {
        maleToken = tokens[0]
      }
      const isMix = !maleToken || /^mix$/i.test(maleToken)
      const selectedMale = isMix ? null : findParentEntryByToken(maleEntries, maleToken)

      return {
        breeding,
        female,
        male: isMix ? 'mix' : parentLabel(selectedMale || { label: maleToken }),
        parent: breedingLabel(breeding),
      }
    }
    const updateBulkParentSelectors = () => {
      const sessionInput = bulkValueContainer.querySelector('[data-bulk-parent-session]')
      const femaleSelect = bulkValueContainer.querySelector('[data-bulk-parent-female]')
      const maleSelect = bulkValueContainer.querySelector('[data-bulk-parent-male]')
      const shortcut = parseBulkParentShortcut(sessionInput?.value)
      const breeding = shortcut.breeding || findBreedingByValue(sessionInput?.value)

      if (!sessionInput || !femaleSelect || !maleSelect) {
        return
      }

      if (!breeding) {
        femaleSelect.innerHTML = '<option value="">Pilih sesi dulu</option>'
        maleSelect.innerHTML = '<option value="mix">Mix</option>'
        femaleSelect.disabled = true
        maleSelect.disabled = true
        return
      }

      const femaleOptions = renderParentOptionList(parentEntriesForBreeding(breeding, 'female'))
      const maleOptions = renderParentOptionList(parentEntriesForBreeding(breeding, 'male'), true)
      const previousFemale = femaleSelect.value
      const previousMale = maleSelect.value

      femaleSelect.innerHTML = femaleOptions.length
        ? femaleOptions.map((option) => `<option value="${escapeHtml(option.value)}">${escapeHtml(option.label)}</option>`).join('')
        : '<option value="-">-</option>'
      maleSelect.innerHTML = maleOptions.map((option) => `<option value="${escapeHtml(option.value)}">${escapeHtml(option.label)}</option>`).join('')
      femaleSelect.value = femaleOptions.some((option) => option.value === previousFemale) ? previousFemale : femaleOptions[0]?.value || '-'
      maleSelect.value = maleOptions.some((option) => option.value === shortcut.male)
        ? shortcut.male
        : maleOptions.some((option) => option.value === previousMale) ? previousMale : 'mix'
      femaleSelect.disabled = false
      maleSelect.disabled = false
    }
    const updateKoiFieldClearVisibility = (field) => {
      const control = field?.querySelector('input.form-control:not([type="hidden"]), textarea.form-control')
      const button = field?.querySelector('[data-koi-field-clear]')

      if (!control || !button) {
        return
      }

      button.classList.toggle('d-none', !String(control.value || '').trim())
    }
    const clearKoiField = (button) => {
      const field = button.closest('.koi-help-field')
      const control = field?.querySelector('input.form-control:not([type="hidden"]), textarea.form-control')

      if (!control || control.disabled || control.readOnly) {
        return
      }

      control.value = ''
      control.dispatchEvent(new Event('input', { bubbles: true }))
      control.dispatchEvent(new Event('change', { bubbles: true }))
      updateKoiFieldClearVisibility(field)
      control.focus()
    }
    // Aksi masal and Tarik data ikan: their text fields get the same clear (x) button as the fields of the entries.
    // Fields that already have their own (kolam, parent) are left alone.
    const wrapBulkClearables = () => {
      document.querySelectorAll('.koi-bulk-card input.form-control:not([type="hidden"]):not([type="file"]):not([data-date-parts])').forEach((input) => {
        if (input.dataset.bulkClearReady || input.closest('.koi-help-field')) return
        if (input.parentElement?.querySelector('[data-pond-clear], [data-parent-clear]')) return
        input.dataset.bulkClearReady = 'true'
        let field = input.parentElement
        if (!field?.classList.contains('input-group')) {
          field = document.createElement('div')
          field.className = 'koi-help-field'
          input.parentNode.insertBefore(field, input)
          field.appendChild(input)
        } else {
          field.classList.add('koi-help-field')
        }
        field.classList.add('has-clear')
        field.insertAdjacentHTML('beforeend', '<button class="koi-field-clear d-none" type="button" data-koi-field-clear aria-label="Kosongkan field" title="Kosongkan field">&times;</button>')
        updateKoiFieldClearVisibility(field)
      })
    }
    // Visible field names without cluttering the compact grid: a small label floats above the text once a field has a
    // value or focus. The sentence that used to hide behind the "!" button is now the tooltip of the field.
    const decorateKoiFieldLabels = (root = document) => {
      root.querySelectorAll('.koi-entry-table input.form-control:not([type="hidden"]):not([type="file"]), .koi-entry-table select.form-select, .koi-entry-table textarea.form-control').forEach((control) => {
        if (control.dataset.floatLabel) return
        const name = control.getAttribute('aria-label') || control.getAttribute('placeholder') || ''
        if (!name) return
        control.dataset.floatLabel = 'true'
        const hint = control.closest('.koi-help-field')?.querySelector('.form-help')?.getAttribute('data-bs-content')
        if (hint && !control.title) control.title = hint
        // the name is a small caption ABOVE the field, outside the box: the field (with its help button) is wrapped together with the caption
        let cell = control
        while (cell.parentElement && !cell.parentElement.classList.contains('koi-entry-fields-grid')) cell = cell.parentElement
        if (!cell.parentElement || cell.classList.contains('koi-entry-cell') || cell.classList.contains('d-none') || cell.hasAttribute('data-entry-parent-panel')) return
        const wrapper = document.createElement('div')
        wrapper.className = ['koi-entry-cell', ...[...cell.classList].filter((cls) => /^koi-entry-(field-wide|gender-field)$/.test(cls))].join(' ')
        const caption = document.createElement('span')
        caption.className = 'koi-entry-label'
        caption.textContent = name
        cell.parentElement.insertBefore(wrapper, cell)
        wrapper.appendChild(caption)
        wrapper.appendChild(cell)
      })
    }
    const decorateKoiClearFields = (root = document) => {
      wrapBulkClearables()
      decorateKoiFieldLabels(root)
      root.querySelectorAll('.koi-help-field').forEach((field) => {
        if (field.classList.contains('has-clear') || field.querySelector('.koi-parent-search')) {
          return
        }

        const control = field.querySelector('input.form-control:not([type="hidden"]):not([type="file"]):not([data-date-parts]), textarea.form-control')

        if (!control || control.disabled || control.readOnly) {
          return
        }

        field.classList.add('has-clear')
        field.insertAdjacentHTML('beforeend', '<button class="koi-field-clear d-none" type="button" data-koi-field-clear aria-label="Kosongkan field" title="Kosongkan field">&times;</button>')
        updateKoiFieldClearVisibility(field)
      })
    }
    const observeKoiClearFields = () => {
      decorateKoiClearFields()
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          mutation.addedNodes.forEach((node) => {
            if (node.nodeType === Node.ELEMENT_NODE) {
              decorateKoiClearFields(node)
              if (typeof node.querySelectorAll === 'function') {
                node.querySelectorAll('.koi-parent-search').forEach(updateParentClearVisibility)
              }
            }
          })
        })
      })
      observer.observe(document.body, { childList: true, subtree: true })
    }
    const entryKoiId = (entry) => String(entry?.code || koiById(entry?.koi_id)?.code || String(parentLabel(entry || {})).replace(/[()]/g, ' ').split(/\s+-\s+/)[0] || '').replace(/\s+/g, ' ').trim()
    const selectedBreederLabel = (item, maleValue = 'mix', femaleName = editBreederFemale.value) => {
      const femaleIds = parentEntriesForBreeding(item, 'female').map(entryKoiId).filter(Boolean).join(', ')
      const femaleText = femaleIds || String(femaleName || '').replace(/[()]/g, ' ').split(/\s+-\s+/)[0].trim()
      const maleEntry = !maleValue || /^mix$/i.test(maleValue) ? null : findParentEntryByToken(parentEntriesForBreeding(item, 'male'), maleValue)
      const maleText = !maleValue || /^mix$/i.test(maleValue) ? 'Mix' : (maleEntry ? entryKoiId(maleEntry) : String(maleValue).replace(/[()]/g, ' ').trim())

      return `${breedingLabel(item)} | Female: ${femaleText || '-'} | Male: ${maleText || '-'}`
    }
    const parseParentInfoParts = (value = '') => {
      const text = String(value || '').trim()
      // "BR260903 - Sesi | Female: X | Male: Y", or without a breeding session "Female: X | Male: Y"
      const [, parent = text] = text.match(/^(.*?)\s*(?:\|\s*)?Female:/i) || []
      const [, female = ''] = text.match(/(?:^|\|)\s*Female:\s*(.*?)(?:\s*\|\s*Male:|$)/i) || []
      const [, male = ''] = text.match(/\|\s*Male:\s*(.*?)$/i) || []

      return {
        parent: parent.trim(),
        female: female.trim(),
        male: male.trim(),
      }
    }
    const buildParentInfoFromParts = (parentInfo = '', female = '', male = '') => {
      const parent = String(parentInfo || '').trim()
      const femaleValue = String(female || '').trim()
      const maleValue = String(male || '').trim()

      if (/(?:^|\|)\s*Female:/i.test(parent)) {
        return parent
      }

      if (!femaleValue && !maleValue) {
        return parent
      }

      // No breeding session: keep the parent fish codes on their own (they used to be dropped).
      if (!parent) {
        return `Female: ${femaleValue || '-'} | Male: ${maleValue || '-'}`
      }

      return `${parent} | Female: ${femaleValue || '-'} | Male: ${maleValue || '-'}`
    }
    const parentBatchCodeFromInfo = (value = '') => {
      const parent = parseParentInfoParts(value).parent
      const breeding = findBreedingByValue(parent)

      if (breeding?.batch_code) {
        return breeding.batch_code
      }

      return String(parent || '').split(' - ')[0].trim()
    }
    const isNaturalBreeding = (breeding) => String(breeding?.spawning_method || '').toLowerCase() === 'alami'
    const maleParentOptions = (breeding) => {
      const maleFallback = [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - ')
      const maleEntries = parseParentEntries(breeding.male_parent_entries, breeding.male_koi_id, maleFallback)

      return [
        { value: 'mix', label: 'Mix', image: '', detail: 'Semua male dalam sesi' },
        ...maleEntries.map((entry) => {
        const preview = parentEntryPreview(
          entry,
          maleEntries.length === 1 ? breeding.male_koi_image_url : '',
          maleEntries.length === 1 ? [breeding.male_koi_variety, breeding.male_koi_bloodline].filter(Boolean).join(' - ') : '',
        )
        return { value: parentLabel(entry), label: parentLabel(entry), image: preview.image, detail: preview.detail }
      }),
      ]
    }
    const renderParentPreview = (panel, femalePreview, malePreview, maleSelect, breeding) => {
      if (!breeding) {
        panel?.classList.add('d-none')
        const clearFemaleId = panel?.querySelector('[data-entry-breeder-female]')
        if (clearFemaleId) clearFemaleId.value = ''
        if (femalePreview) femalePreview.innerHTML = ''
        if (malePreview) malePreview.innerHTML = ''
        if (maleSelect) {
          maleSelect.innerHTML = ''
          maleSelect.disabled = false
          maleSelect.title = ''
        }
        return
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)
      const femaleName = femaleEntries.map(parentLabel).join(', ') || femaleFallback || '-'
      const femalePrimary = parentEntryPreview(femaleEntries[0], breeding.female_koi_image_url, [breeding.female_koi_variety, breeding.female_koi_bloodline].filter(Boolean).join(' - '))
      const maleOptions = maleParentOptions(breeding)
      const savedParentText = maleSelect?.closest('[data-koi-entry], form')?.querySelector('[name="parent_info"]')?.value
      const typedShortcut = parseBulkParentShortcut(savedParentText)
      const savedMale = parseParentInfoParts(savedParentText).male || (typedShortcut.breeding && !/^mix$/i.test(typedShortcut.male) ? typedShortcut.male : '')
      const selectedMaleRaw = maleSelect?.value || savedMale || 'mix'
      const maleEntriesAll = parseParentEntries(breeding.male_parent_entries, breeding.male_koi_id, [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - '))
      const resolvedMaleEntry = /^mix$/i.test(selectedMaleRaw) ? null : findParentEntryByToken(maleEntriesAll, selectedMaleRaw)
      const selectedMale = /^mix$/i.test(selectedMaleRaw) ? 'mix' : resolvedMaleEntry ? parentLabel(resolvedMaleEntry) : selectedMaleRaw
      const maleName = selectedMale === 'mix' ? 'Mix' : selectedMale
      const selectedMaleEntry = parseParentEntries(
        breeding.male_parent_entries,
        breeding.male_koi_id,
        [breeding.male_koi_code, breeding.male_koi_name].filter(Boolean).join(' - '),
      ).find((entry) => parentLabel(entry) === selectedMale)
      const malePrimary = selectedMaleEntry ? parentEntryPreview(selectedMaleEntry, breeding.male_koi_image_url, [breeding.male_koi_variety, breeding.male_koi_bloodline].filter(Boolean).join(' - ')) : null

      const femaleIdField = panel?.querySelector('[data-entry-breeder-female]')
      if (femaleIdField) femaleIdField.value = femaleName

      if (femalePreview) {
        femalePreview.innerHTML = parentPreviewCard(femaleName, femalePrimary.image, femalePrimary.detail)
      }
      if (malePreview) {
        malePreview.innerHTML = parentPreviewCard(maleName, selectedMale === 'mix' ? '' : malePrimary?.image || breeding.male_koi_image_url, selectedMale === 'mix' ? 'Semua male dalam sesi' : malePrimary?.detail || [breeding.male_koi_variety, breeding.male_koi_bloodline].filter(Boolean).join(' - '))
      }
      if (maleSelect) {
        maleSelect.innerHTML = maleOptions
          .map((option) => `<option value="${escapeHtml(option.value)}" data-image="${escapeHtml(option.image || '')}" data-detail="${escapeHtml(option.detail || '')}">${escapeHtml(option.label)}</option>`)
          .join('')
        maleSelect.value = maleOptions.some((option) => option.value === selectedMale) ? selectedMale : 'mix'
        maleSelect.disabled = false
        maleSelect.title = ''
      }
      panel?.classList.remove('d-none')
    }
    const updateEditBreederParents = () => {
      const parentField = editForm.querySelector('[name="parent_info"]')
      const breeding = findBreedingByValue(parentField.value)

      lockSessionFields(editForm, breeding)

      if (!breeding) {
        editBreederFemale.value = ''
        renderParentPreview(editBreederParentPanel, editParentFemalePreview, editParentMalePreview, editBreederMale, null)
        return
      }

      const femaleFallback = [breeding.female_koi_code, breeding.female_koi_name].filter(Boolean).join(' - ')
      const femaleEntries = parseParentEntries(breeding.female_parent_entries, breeding.female_koi_id, femaleFallback)

      editBreederFemale.value = femaleEntries.map(parentLabel).join(', ') || '-'
      renderParentPreview(editBreederParentPanel, editParentFemalePreview, editParentMalePreview, editBreederMale, breeding)
    }
    const findPondByName = (name) => pondsList.find((pond) => pond.name.toLowerCase() === String(name || '').trim().toLowerCase())

    const pondSearchText = (pond) => [pond.name, pond.location, pond.status].filter(Boolean).join(' ').toLowerCase()
    const pondAreaMatches = (value) => {
      const terms = String(value || '').trim().toLowerCase().split(/\s+/).filter(Boolean)
      const seen = new Set()

      return pondsList
        .filter((pond) => String(pond.location || '').trim())
        .filter((pond) => terms.every((term) => String(pond.location).toLowerCase().includes(term)))
        .filter((pond) => {
          const key = String(pond.location).trim().toLowerCase()
          if (seen.has(key)) return false
          seen.add(key)
          return true
        })
        .slice(0, 12)
        .map((pond) => ({ id: '', name: '', location: String(pond.location).trim(), status: '' }))
    }
    const pondSearchMatches = (value) => {
      const terms = String(value || '').trim().toLowerCase().split(/\s+/).filter(Boolean)

      return pondsList
        .filter((pond) => terms.length === 0 || terms.every((term) => pondSearchText(pond).includes(term)))
        .slice(0, 12)
    }
    const updatePondClearVisibility = (wrapper) => {
      const input = wrapper?.querySelector('[data-pond-search-input]')
      const button = wrapper?.querySelector('[data-pond-clear]')

      if (!input || !button) {
        return
      }

      button.classList.toggle('d-none', !String(input.value || '').trim())
    }
    const closePondSearchMenus = (exceptInput = null) => {
      document.querySelectorAll('[data-pond-search-menu]').forEach((menu) => {
        if (exceptInput && menu === exceptInput.closest('.koi-pond-search')?.querySelector('[data-pond-search-menu]')) {
          return
        }

        menu.classList.add('d-none')
      })
    }
    const renderPondSearchMenu = (input) => {
      const menu = input.closest('.koi-pond-search')?.querySelector('[data-pond-search-menu]')

      if (!menu) {
        return
      }

      const isLocationInput = input.matches('[data-edit-pond-location], [data-bulk-area]')
      const matches = input.matches('[data-bulk-area]') ? pondAreaMatches(input.value) : pondSearchMatches(input.value)
      menu.innerHTML = `
        <button class="koi-pond-search-item" type="button" data-pond-search-pick="">
          <span class="koi-pond-search-main">
            <span class="koi-pond-search-copy">
              <span class="d-block fw-medium text-truncate">${isLocationInput ? 'Tanpa area' : 'Tanpa lokasi'}</span>
              <span class="d-block text-secondary small text-truncate">${isLocationInput ? 'Kosongkan lokasi dan area ikan' : 'Kosongkan lokasi ikan'}</span>
            </span>
          </span>
        </button>
        ${matches.length
          ? matches.map((pond) => `
            <button class="koi-pond-search-item" type="button" data-pond-search-pick="${escapeHtml(pond.id)}" data-pond-search-name="${escapeHtml(pond.name)}" data-pond-search-location="${escapeHtml(pond.location || '')}">
              <span class="koi-pond-search-main">
                <span class="koi-pond-search-copy">
                  <span class="d-block fw-medium text-truncate">${escapeHtml(isLocationInput ? pond.location || 'Tanpa area' : pond.name || '-')}</span>
                  <span class="d-block text-secondary small text-truncate">${escapeHtml([pond.location, labels[pond.status] || pond.status].filter(Boolean).join(' | ') || 'Tanpa area')}</span>
                </span>
              </span>
            </button>
          `).join('')
          : '<div class="koi-pond-search-empty">Tidak ada lokasi yang cocok</div>'}
      `
      menu.classList.remove('d-none')
    }
    const syncPondSearchContext = (input) => {
      if (input.matches('[data-pond-select]')) {
        syncEntryPond(input.closest('[data-koi-entry]'))
      } else if (input.matches('[data-edit-pond-select]')) {
        syncEditPond()
      }
      // Area: typing or picking an area never chooses a pond for the fish, Kolam stays as it is (blank is fine)
      updatePondClearVisibility(input.closest('.koi-pond-search'))
    }
    const pickPondSearchItem = (button) => {
      const input = button.closest('.koi-pond-search')?.querySelector('[data-pond-search-input]')

      if (!input) {
        return
      }
      if (input.matches('[data-bulk-area]')) {
        input.value = String(button.dataset.pondSearchLocation || '').trim()
        closePondSearchMenus()
        syncPondSearchContext(input)
        input.focus()
        return
      }

      if (input.matches('[data-edit-pond-location]')) {
        const area = String(button.dataset.pondSearchLocation || '').trim()
        input.value = area
        const pondInput = editForm.querySelector('[data-edit-pond-select]')
        const pondId = editForm.querySelector('[data-edit-pond-id]')
        const current = findPondByName(pondInput.value)
        // the area does not decide the pond: Kolam is kept only when it already belongs to that area, otherwise it is left blank
        if (!area || !current || String(current.location || '').trim().toLowerCase() !== area.toLowerCase()) {
          pondInput.value = ''
          pondId.value = ''
        }
        updatePondClearVisibility(pondInput.closest('.koi-pond-search'))
      } else {
        input.value = button.dataset.pondSearchName || ''
      }
      closePondSearchMenus()
      syncPondSearchContext(input)
      input.focus()
    }
    const clearPondField = (button) => {
      const input = button.closest('.koi-pond-search')?.querySelector('[data-pond-search-input]')

      if (!input) {
        return
      }

      input.value = ''
      if (input.matches('[data-edit-pond-location]')) {
        const pondInput = editForm.querySelector('[data-edit-pond-select]')
        const pondId = editForm.querySelector('[data-edit-pond-id]')
        pondInput.value = ''
        pondId.value = ''
        updatePondClearVisibility(pondInput.closest('.koi-pond-search'))
      }
      closePondSearchMenus()
      syncPondSearchContext(input)
      input.focus()
    }

    const closeVarietySearchMenus = (exceptInput = null) => {
      document.querySelectorAll('[data-variety-search-menu]').forEach((menu) => {
        if (exceptInput && menu === exceptInput.closest('.koi-variety-search')?.querySelector('[data-variety-search-menu]')) {
          return
        }

        menu.classList.add('d-none')
      })
    }
    const varietySearchMatches = (value) => {
      const terms = String(value || '').toLowerCase().split(/[\s,]+/).map((term) => term.trim()).filter(Boolean)
      return uniqueKoiValues('variety')
        .filter((item) => {
          const text = item.toLowerCase()
          return terms.length === 0 || terms.every((term) => text.includes(term))
        })
        .slice(0, 18)
    }
    const renderVarietySearchMenu = (input) => {
      const menu = input.closest('.koi-variety-search')?.querySelector('[data-variety-search-menu]')

      if (!menu) {
