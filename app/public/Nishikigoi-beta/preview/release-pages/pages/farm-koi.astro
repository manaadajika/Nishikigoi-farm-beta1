        // Catatan masal dialog: textarea + checkbox. Unchecked = the text is added on a new line under each fish's note;
    // checked = every existing note is deleted and replaced by this text.
    const askBulkNote = (count) => new Promise((resolve) => {
      document.querySelector('[data-koi-bulk-note]')?.remove()
