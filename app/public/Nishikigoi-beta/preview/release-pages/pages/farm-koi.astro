    // A list of codes may be separated by spaces, new lines, commas, semicolons or periods (a period between two digits stays a decimal point).
    // "<30", ">30cm", ">=45", "30>", "kurang dari 30", "lebih dari 30" are size comparisons: each becomes one word (lt30, gt30, le30, ge30). The sign alone says the direction, on either side of the number.
    const compareSizeWords = (text) => {
      const num = '(\\d+(?:\\.\\d+)?)'
      const ops = { '<=': 'le', '≤': 'le', '>=': 'ge', '≥': 'ge', '<': 'lt', '>': 'gt' }
      return String(text)
        .replace(new RegExp('\\b(?:kurang\\s+dari|di\\s*bawah)\\s*' + num + '\\s*(?:cm)?', 'gi'), (all, n) => ' lt' + n + ' ')
        .replace(new RegExp('\\b(?:lebih\\s+dari|di\\s*atas)\\s*' + num + '\\s*(?:cm)?', 'gi'), (all, n) => ' gt' + n + ' ')
        .replace(new RegExp('(<=|>=|≤|≥|<|>)\\s*' + num + '\\s*(?:cm)?', 'gi'), (all, op, n) => ' ' + ops[op] + n + ' ')
        .replace(new RegExp(num + '\\s*(?:cm)?\\s*(<=|>=|≤|≥|<|>)(?!\\s*\\d)', 'gi'), (all, n, op) => ' ' + ops[op] + n + ' ')
    }
    const splitCodeList = (text) => String(text || '').replace(/(\d)\.(?=\d)/g, '$1\u0001').split(/[\s,;.]+/).map((part) => part.replace(/\u0001/g, '.').trim()).filter(Boolean)
