      }

      const matches = varietySearchMatches(input.value)
      closeVarietySearchMenus(input)
      menu.innerHTML = matches.length
        ? matches.map((value) => `
          <button class="koi-variety-search-item" type="button" data-variety-search-pick="${escapeHtml(value)}">
            <span class="koi-variety-search-main">
              <span class="koi-variety-search-copy">
                <span class="d-block fw-medium text-truncate">${escapeHtml(value)}</span>
              </span>
            </span>
          </button>
