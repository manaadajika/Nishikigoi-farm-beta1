      const photos = [...currentPhotoHistory]
      if (!photos.length) {
        window.alert('Belum ada foto progress untuk dicetak.')
        return
      }
      const field = (name) => String(editForm.querySelector(`[name="${name}"]`)?.value || '').trim()
      const genderLabels = { male: 'Male', female: 'Female', unknown: 'Unknown' }
      const code = field('code') || 'Ikan'
      const pond = [
        editForm.querySelector('[data-edit-pond-select]')?.value,
        editForm.querySelector('[data-edit-pond-location]')?.value,
      ].map((value) => String(value || '').trim()).filter(Boolean).join(' - ')
      const length = field('current_length_cm')
      const cards = photos.map((item, index) => `
        <div style="break-inside:avoid;page-break-inside:avoid;border:1px solid #999;padding:4px;text-align:center">
          <img src="${escapeHtml(item.image_url)}" alt="" style="display:block;width:100%;aspect-ratio:2/3;object-fit:cover;border:1px solid #bbb" />
          <div style="font-weight:700;margin-top:3px">${photoHistoryLabel(item, index)}</div>
          <div style="color:#555;font-size:9px">${escapeHtml(item.measured_at ? window.KoiAuth.formatDate(item.measured_at) : '-')}</div>
          ${item.notes ? `<div style="color:#555;font-size:9px">${escapeHtml(item.notes)}</div>` : ''}
        </div>`).join('')

      window.KoiPrint.print({
        key: 'koi-progress',
        title: `Progress ${code}`,
        heading: 'Progress Foto Ikan',
        subheading: [code, field('name')].filter(Boolean).join(' - '),
        orientation: 'landscape',
        info: [
          ['Kode Koi', code],
          ['Nama', field('name')],
          ['Varietas', field('variety')],
          ...(field('gender') && field('gender') !== 'unknown' ? [['Sex', genderLabels[field('gender')] || field('gender')]] : []), // hideUnknownGender
          ['Kolam / Lokasi', pond],
          ['Size Saat Ini', length ? `${length} cm` : ''],
          ['Jumlah Foto', photos.length],
        ],
        body: `<section class="kp-section"><h2>History Progress Foto</h2><div style="display:grid;grid-template-columns:repeat(6,1fr);gap:8px">${cards}</div></section>`,
      })
    })
    editProgressPhotoPasteButton.addEventListener('click', async () => {
      if (!editForm.querySelector('[name="id"]').value) {
        return
      }

      editProgressPhotoPasteButton.disabled = true
      try {
        const file = await readClipboardImageFile()
        await uploadProgressPhoto(file)
      } catch (error) {
        alert(error.message || 'Paste gambar progress gagal.')
      } finally {
        editProgressPhotoPasteButton.disabled = false
      }
    })
    editProgressPhotoInput.addEventListener('change', async () => {
      // several photos chosen at once are added one after the other
      const chosen = [...editProgressPhotoInput.files]
      for (const file of chosen) {
        try {
          await uploadProgressPhoto(file)
        } catch (error) {
          alert(error.message)
          break
        }
      }
    })
    // Drag a photo (from the gallery, another app in split screen, or a file) onto History Progress Foto to add it, like in Tambah Ikan
    const progressDropZone = editPhotoHistory.closest('.col-12')
    if (progressDropZone) {
      const hasFiles = (event) => [...(event.dataTransfer?.types || [])].includes('Files')
      progressDropZone.addEventListener('dragover', (event) => {
        if (!hasFiles(event)) return
        event.preventDefault()
        progressDropZone.style.outline = '2px dashed var(--tblr-primary)'
        progressDropZone.style.outlineOffset = '4px'
        window.clearTimeout(progressDropZone.idleTimer)
        progressDropZone.idleTimer = window.setTimeout(() => { progressDropZone.style.outline = '' }, 1200)
      })
      progressDropZone.addEventListener('dragleave', (event) => {
        if (!progressDropZone.contains(event.relatedTarget)) progressDropZone.style.outline = ''
      })
      progressDropZone.addEventListener('drop', async (event) => {
        if (!hasFiles(event)) return
        event.preventDefault()
        event.stopPropagation()
        progressDropZone.style.outline = ''
        if (!editForm.querySelector('[name="id"]').value || window.KoiAuth?.canAccess?.('database-write') === false) return
        const images = [...event.dataTransfer.files].filter((file) => file.type.startsWith('image/'))
        for (const file of images) {
          try {
            await uploadProgressPhoto(file)
          } catch (error) {
            alert(error.message)
            break
          }
        }
      })
    }
    editPhotoHistory.addEventListener('click', (event) => {
      const deleteButton = event.target.closest('[data-delete-photo-history]')
      const previewButton = event.target.closest('[data-preview-photo-history]')
      const editSizeButton = event.target.closest('[data-edit-photo-history-size]')

      if (editSizeButton) {
        editPhotoHistorySize(editSizeButton.dataset.editPhotoHistorySize).catch((error) => alert(error.message))
        return
      }

      if (deleteButton) {
        deletePhotoHistory(deleteButton.dataset.deletePhotoHistory).catch((error) => alert(error.message))
        return
      }

      if (previewButton) {
        openPhotoHistoryZoom(previewButton.dataset.previewPhotoHistory, previewButton.dataset.previewPhotoTitle)
      }
    })
    editPhotoHistory.addEventListener('pointerdown', photoHistoryDragStart)
    document.addEventListener('pointermove', photoHistoryDragMove, { passive: false })
    document.addEventListener('pointerup', photoHistoryDragEnd)
    document.addEventListener('pointercancel', photoHistoryDragEnd)
    editForm.addEventListener('change', (event) => {
      if (event.target.matches('[data-edit-gender]')) {
        setEditGender(event.target.value)
      }
    })
    editForm.querySelector('[name="parent_info"]').addEventListener('input', (event) => {
      renderParentSearchMenu(event.target)
      updateParentClearVisibility(event.target.closest('.koi-parent-search'))
      updateEditBreederParents()
    })
    editForm.querySelector('[name="parent_info"]').addEventListener('focusin', (event) => {
      closeParentSearchMenus(event.target)
      renderParentSearchMenu(event.target)
    })
    editForm.addEventListener('click', (event) => {
      const parentPick = event.target.closest('[data-parent-search-pick]')
      const parentClear = event.target.closest('[data-parent-clear]')

      if (parentPick) {
        pickParentSearchItem(parentPick)
        return
      }

      if (parentClear) {
        clearParentField(parentClear)
      }
    })
    editBreederMale.addEventListener('change', () => {
      const parentField = editForm.querySelector('[name="parent_info"]')
      const breeding = findBreedingByValue(parentField.value)

      if (breeding) {
        parentField.value = selectedBreederLabel(breeding, editBreederMale.value)
        updateEditBreederParents()
      }
    })

    form.addEventListener('paste', (event) => {
      const file = [...event.clipboardData.files].find((item) => item.type.startsWith('image/'))
      const entry = event.target.closest('[data-koi-entry]')

      if (file && entry) {
        event.preventDefault()
        uploadImage(entry, file).catch((error) => {
          entry.querySelector('[data-koi-upload-status]').textContent = error.message
        })
      }
    })

    refreshEntryControls()
    renderBulkInput()
    renderDraftMenu()
    loadPonds()
    loadBreeding()
    observeKoiClearFields()
    restoreViewState()
    {
      const urlPage = Math.floor(Number(new URLSearchParams(window.location.search).get('page')))
      if (urlPage >= 1) currentPage = urlPage
    }
    const hasCachedKoi = restoreKoiCache()
    window.addEventListener('pagehide', saveViewState)
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') saveViewState()
    })
    keepScroll(() => loadKoi(hasCachedKoi))
    updateActionDock()
    window.KoiAuth?.registerRealtimeRefresh(() => keepScroll(() => loadKoi(true)), { intervalMs: 20000 })
  </script>
</DefaultLayout>











































