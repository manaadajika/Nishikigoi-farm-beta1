---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Icon from '@shared/ui/Icon.astro'
import icons from '@data/icons.json'

const iconSvg = (name: string) => {
  const icon = (icons as unknown as Record<string, { svg: Record<string, string> }>)[name]
  let svg = icon?.svg?.outline ?? ''

  svg = svg.replace(/<path stroke="none" d="M0 0h24v24H0z" fill="none"\s*\/>/, '')
  svg = svg.replace(/class="[^"]+"/, 'aria-hidden="true" focusable="false" class="icon"')

  return svg
}

const plusIcon = iconSvg('plus')
const trashIcon = iconSvg('trash')
const editIcon = iconSvg('edit')
const eyeIcon = iconSvg('eye')
const historyIcon = iconSvg('history')
const pencilIcon = iconSvg('pencil')
const saveIcon = iconSvg('device-floppy')
const draftIcon = iconSvg('file-plus')
const uploadIcon = iconSvg('upload')
const clipboardIcon = iconSvg('clipboard')
const fileImportIcon = iconSvg('file-import')
const fileExportIcon = iconSvg('file-export')
const calendarIcon = iconSvg('calendar')
---

<DefaultLayout title="Data Ikan" pageHeader="Data Ikan" pretitle="Manajemen" pageMenu="farm-koi" pageLibs={['litepicker']}>
  <style is:global>
    [data-koi-action-dock]:not(.is-group-open) [data-dock-group]{display:none!important}
    [data-koi-action-dock].is-group-open .koi-list-actions>*:not([data-dock-group]):not([data-dock-group-toggle]):not([data-koi-action-dock-hide]):not([data-clear-selected-koi]){display:none!important}

    .koi-card-preview {
      aspect-ratio: 2 / 3;
      min-height: 220px;
      background: var(--koi-preview-color, #d8e2ef);
    }

    .koi-card-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }


    .koi-upload-box {
      min-height: 104px;
      border: 1px dashed var(--tblr-border-color);
      border-radius: 6px;
      background: var(--tblr-bg-surface-secondary);
      cursor: pointer;
      overflow: hidden;
    }

    .koi-upload-box img {
      width: 100%;
      height: 100%;
      max-height: 160px;
      object-fit: contain;
    }

    .koi-card-preview-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      padding: 1rem;
      color: var(--tblr-secondary-color);
      text-align: center;
    }

    .koi-card-preview-placeholder .koi-card-preview-code {
      position: static;
      color: var(--tblr-body-color);
      font-weight: 700;
    }

    .koi-card-preview-placeholder small {
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .koi-card-preview-code {
      background: rgba(255, 255, 255, .82);
      border-radius: 4px;
      padding: .25rem .5rem;
      color: #182433;
      font-weight: 600;
    }

    .koi-card-preview[data-koi-preview-select] {
      border-radius: 6px;
      cursor: pointer;
      overflow: hidden;
      transition: opacity .15s ease;
    }

    .koi-card-compact {
      border: 1px solid var(--tblr-border-color);
      transition: border-color .15s ease, box-shadow .15s ease;
    }

    .koi-card-compact.is-selected {
      border-color: var(--tblr-primary);
      box-shadow: 0 0 0 .2rem rgba(var(--tblr-primary-rgb), .18);
    }

    .koi-card-compact.is-selected .koi-card-preview[data-koi-preview-select] {
      border-bottom-right-radius: 0;
      border-bottom-left-radius: 0;
      box-shadow: inset 0 0 0 2px var(--tblr-primary);
    }

    .koi-selected-badge {
      display: none;
    }

    .koi-selection-hidden {
      display: none !important;
    }

    .koi-card-compact.is-selected .koi-selected-badge {
      display: inline-flex;
    }

    .koi-merge-thumb {
      width: 42px;
      aspect-ratio: 2 / 3;
      flex: 0 0 42px;
      border: 1px solid var(--tblr-border-color);
      border-radius: 6px;
      object-fit: cover;
      background: var(--tblr-bg-surface-secondary);
    }

    .koi-merge-photo-preview {
      display: block;
      width: 100%;
      aspect-ratio: 2 / 3;
      overflow: hidden;
      border: 1px solid var(--tblr-border-color);
      border-radius: 6px 6px 0 0;
      background: var(--tblr-bg-surface-secondary);
    }

    .koi-merge-photo-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .koi-card-compact .card-body {
      padding: .75rem;
    }


    .koi-sequence-number {
      display: inline-flex;
      align-items: center;
      color: var(--tblr-secondary);
      font-family: var(--tblr-font-monospace, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
      font-size: .68rem;
      line-height: 1;
      letter-spacing: 0;
      opacity: .8;
    }
    .koi-card-compact .card-title {
      font-size: .95rem;
      line-height: 1.25;
    }

    .koi-text-ellipsis {
      display: block;
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .koi-card-detail-cell {
      min-width: 0;
    }

    .koi-card-main-text {
      min-width: 0;
      max-width: 100%;
    }


    .koi-icon-filter-row {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
      width: fit-content;
      flex-wrap: nowrap;
      gap: .5rem;
      padding: 1.625rem .25rem 0;
      margin: 0;
      min-height: 4.125rem;
    }

    .koi-icon-filter-row .form-selectgroup,
    .koi-icon-filter {
      display: inline-flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: .5rem;
      margin: 0;
      height: 2.5rem;
    }

    .koi-icon-filter-row .form-selectgroup-item {
      margin: 0 !important;
    }

    .koi-icon-filter-row .form-selectgroup-label,
    .koi-icon-filter-row .btn-icon {
      width: 2.5rem;
      min-width: 2.5rem;
      height: 2.5rem;
      min-height: 2.5rem;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .koi-icon-filter-row .form-selectgroup-label svg,
    .koi-icon-filter-row .btn-icon svg {
      width: 1rem;
      height: 1rem;
      flex: 0 0 1rem;
    }

    .koi-icon-filter-row .btn-icon {
      border-radius: var(--tblr-border-radius);
    }
    .koi-icon-filter-row .btn-icon {
      flex: 0 0 2.5rem;
      margin: 0;
    }


    .koi-icon-filter-row .koi-icon-filter {
      column-gap: .5rem;
    }

    .koi-icon-filter-row .koi-icon-filter .form-selectgroup-item,
    .koi-icon-filter-row .koi-icon-filter .form-selectgroup-item + .form-selectgroup-item {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .koi-icon-filter-row .koi-icon-filter .form-selectgroup-label {
      border-radius: var(--tblr-border-radius) !important;
    }
    .koi-code-copy {
      display: inline-flex;
      max-width: 100%;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      font-weight: 600;
      padding: 0;
      cursor: pointer;
      user-select: none;
    }

    .koi-code-copy:hover {
      color: var(--tblr-primary);
    }

    .koi-code-copy.is-copied {
      color: var(--tblr-success);
    }

    .koi-code-copy.is-copy-failed {
      color: var(--tblr-danger);
    }

    .koi-entry-table {
      border-collapse: separate;
      border-spacing: 0 .75rem;
      min-width: 0;
      margin-bottom: 0;
    }

    .koi-entry-table td {
      vertical-align: middle;
      border-bottom-width: 0;
      box-shadow: none;
    }

    .koi-entry-table tbody td {
      border: 0;
      background: transparent;
    }

    .koi-entry-table tbody + tbody td {
      padding-top: 1.1rem;
      background-image: linear-gradient(
        to bottom,
        var(--tblr-border-color) 0,
        var(--tblr-border-color) 1px,
        transparent 1px,
        transparent 4px,
        var(--tblr-border-color) 4px,
        var(--tblr-border-color) 5px,
        transparent 5px
      );
      background-position: top left;
      background-repeat: no-repeat;
      background-size: 100% 5px;
    }

    .koi-entry-table-wrap {
      border: 0;
      border-radius: 6px;
    }

    .koi-photo-history-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
      gap: .75rem;
    }

    .koi-photo-history-item img {
      width: 100%;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--tblr-border-color);
    }

    .koi-photo-history-preview {
      display: block;
      width: 100%;
      padding: 0;
      background: transparent;
      border: 0;
      cursor: zoom-in;
    }

    .koi-photo-history-item {
      position: relative;
      will-change: transform;
    }

    .koi-photo-history-drag-handle {
      touch-action: none;
      cursor: grab;
      user-select: none;
    }

    .koi-photo-history-item.is-dragging .koi-photo-history-drag-handle {
      cursor: grabbing;
    }

    .koi-photo-history-grid.is-reordering .koi-photo-history-item:not(.is-dragging) {
      transition: transform .2s ease;
    }

    .koi-photo-history-item.is-dragging {
      cursor: grabbing;
      z-index: 5;
      transition: none;
    }

    .koi-photo-history-actions {
      position: absolute;
      top: .35rem;
      right: .35rem;
      left: .35rem;
      z-index: 1;
      justify-content: center;
      gap: .25rem;
    }

    .koi-photo-history-actions .btn {
      width: 1.75rem;
      height: 1.75rem;
    }

    /* History Progress Foto: kartu berbingkai; tombol geser dan hapus berada DI ATAS foto (bukan menimpa gambar);
       keterangan dan tanggal rata tengah */
    .koi-photo-history-grid { grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); }
    .koi-photo-history-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: .5rem;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-card-border-radius, 8px);
      background: var(--tblr-bg-surface-secondary);
      text-align: center;
    }
    .koi-photo-history-item .koi-photo-history-actions {
      position: static;
      width: 100%;
      margin: 0 0 .5rem;
      justify-content: center;
    }
    .koi-photo-history-item .koi-photo-history-preview { width: 100%; }
    .koi-photo-history-item .btn-link { width: 100%; text-align: center; }

    .koi-edit-preview {
      aspect-ratio: 2 / 3;
      min-height: 220px;
      border-radius: 6px;
      background: var(--tblr-bg-surface-secondary);
      overflow: hidden;
    }

    .koi-edit-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .koi-photo-zoom-img {
      width: min(64vw, 560px);
      height: min(74vh, 760px);
      border-radius: 6px;
      object-fit: contain;
      background: var(--tblr-bg-surface-secondary);
    }

    .koi-parent-preview-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .5rem;
      align-items: stretch;
    }

    .koi-parent-preview-card {
      width: 100%;
      min-height: 100px;
      border: 1px solid var(--tblr-border-color);
      border-radius: 6px;
      background: var(--tblr-bg-surface-secondary);
      overflow: hidden;
      color: var(--tblr-body-color);
      text-align: left;
    }

    .koi-parent-preview-field {
      margin-top: .5rem !important;
      min-height: 40px;
      width: 100%;
    }

    .koi-parent-preview-grid > div {
      display: flex;
      flex-direction: column;
    }

    .koi-parent-preview-grid [data-edit-parent-female-preview],
    .koi-parent-preview-grid [data-edit-parent-male-preview],
    .koi-parent-preview-grid [data-entry-parent-female-preview],
    .koi-parent-preview-grid [data-entry-parent-male-preview] {
      display: block;
    }

    button.koi-parent-preview-card {
      cursor: zoom-in;
    }

    button.koi-parent-preview-card:hover,
    button.koi-parent-preview-card:focus {
      border-color: var(--tblr-primary);
      outline: none;
    }

    .koi-parent-preview-card img {
      width: 54px;
      height: 82px;
      object-fit: cover;
    }

    .koi-parent-search,
    .koi-pond-search,
    .koi-variety-search {
      position: relative;
    }

    .koi-parent-search .form-control,
    .koi-pond-search .form-control,
    .koi-variety-search .form-control {
      padding-right: 4rem;
    }

    .koi-parent-clear,
    .koi-pond-clear {
      position: absolute;
      top: 50%;
      right: .7rem;
      z-index: 3;
      width: 1.15rem;
      height: 1.15rem;
      min-width: 1.15rem;
      padding: 0;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-border-radius);
      color: var(--tblr-danger);
      background: var(--tblr-bg-surface-secondary);
      font-size: .85rem;
      font-weight: 700;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform: translateY(-50%);
      box-shadow: none;
    }

    html[data-bs-theme="dark"] .koi-parent-clear,
    body[data-bs-theme="dark"] .koi-parent-clear,
    [data-bs-theme="dark"] .koi-parent-clear,
    html[data-bs-theme="dark"] .koi-pond-clear,
    body[data-bs-theme="dark"] .koi-pond-clear,
    [data-bs-theme="dark"] .koi-pond-clear {
      color: var(--tblr-danger);
      background: var(--tblr-bg-surface);
      border-color: var(--tblr-border-color);
    }

    .koi-parent-clear:hover,
    .koi-parent-clear:focus,
    .koi-pond-clear:hover,
    .koi-pond-clear:focus {
      color: var(--tblr-danger-fg, #fff);
      border-color: var(--tblr-danger);
      background: var(--tblr-danger);
      outline: none;
    }

    .koi-parent-clear.d-none,
    .koi-pond-clear.d-none {
      display: none !important;
    }

    .koi-parent-search-menu,
    .koi-pond-search-menu,
    .koi-variety-search-menu {
      position: absolute;
      top: calc(100% + .25rem);
      left: 0;
      right: 0;
      z-index: 20;
      max-height: 260px;
      overflow: auto;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-border-radius);
      background: var(--tblr-bg-surface);
      box-shadow: var(--tblr-shadow-dropdown);
    }

    .koi-text-suggest-menu {
      position: fixed;
      z-index: 2000;
      max-height: 220px;
      overflow: auto;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-border-radius);
      background: var(--tblr-bg-surface);
      box-shadow: var(--tblr-shadow-dropdown);
    }

    .koi-text-suggest-item {
      display: block;
      width: 100%;
      border: 0;
      border-bottom: 1px solid var(--tblr-border-color);
      padding: .55rem .75rem;
      color: var(--tblr-body-color);
      background: transparent;
      text-align: left;
      font: inherit;
    }

    .koi-text-suggest-item:last-child {
      border-bottom: 0;
    }

    .koi-text-suggest-item:hover,
    .koi-text-suggest-item:focus {
      background: rgba(var(--tblr-primary-rgb), .12);
      outline: none;
    }

    .koi-parent-search-item,
    .koi-pond-search-item,
    .koi-variety-search-item {
      width: 100%;
      border: 0;
      border-bottom: 1px solid var(--tblr-border-color);
      padding: .65rem .75rem;
      color: var(--tblr-body-color);
      background: transparent;
      text-align: left;
    }

    .koi-parent-search-main,
    .koi-pond-search-main,
    .koi-variety-search-main {
      display: flex;
      align-items: center;
      gap: .65rem;
      min-width: 0;
    }

    .koi-parent-search-thumb {
      width: 40px;
      height: 60px;
      flex: 0 0 40px;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-border-radius);
      object-fit: contain;
      background: var(--tblr-bg-surface-secondary);
    }

    .koi-parent-search-placeholder {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--tblr-secondary);
      font-size: .75rem;
      font-weight: 700;
    }

    .koi-parent-search-copy,
    .koi-pond-search-copy,
    .koi-variety-search-copy {
      min-width: 0;
    }

    .koi-parent-search-item:last-child,
    .koi-pond-search-item:last-child,
    .koi-variety-search-item:last-child {
      border-bottom: 0;
    }

    .koi-parent-search-item:hover,
    .koi-parent-search-item:focus,
    .koi-pond-search-item:hover,
    .koi-pond-search-item:focus,
    .koi-variety-search-item:hover,
    .koi-variety-search-item:focus {
      color: var(--tblr-primary);
      background: var(--tblr-bg-surface-secondary);
      outline: none;
    }

    .koi-parent-search-empty,
    .koi-pond-search-empty,
    .koi-variety-search-empty {
      padding: .65rem .75rem;
      color: var(--tblr-secondary);
    }

    .koi-entry-table .koi-entry-type-cell {
      min-width: 112px;
    }

    .koi-entry-table .koi-entry-photo-cell {
      min-width: 128px;
      text-align: center;
      vertical-align: top;
    }

    .koi-entry-gender-field,
    .koi-edit-gender-field {
      width: max-content;
      max-width: 100%;
      justify-self: start;
      align-self: start;
      grid-column: auto;
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
    }

    .koi-entry-gender-field .form-selectgroup-label,
    .koi-edit-gender-field .form-selectgroup-label {
      width: 40px;
      min-width: 40px;
      height: 40px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .koi-entry-gender-field .icon,
    .koi-edit-gender-field .icon {
      width: 18px;
      height: 18px;
      margin: 0;
    }

    .koi-entry-fields-cell {
      width: 100%;
    }

    .koi-entry-fields-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(150px, 1fr));
      gap: .75rem;
      align-items: start;
    }

    .koi-entry-field-wide {
      grid-column: span 2;
    }

    .koi-entry-selectgroup {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      gap: .5rem;
      min-height: 40px;
      white-space: nowrap;
    }

    .koi-entry-selectgroup .form-selectgroup-label {
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .45rem .75rem;
    }

    .koi-entry-gender-field,
    .koi-edit-gender-field {
      gap: .5rem;
    }

    .koi-entry-gender-field .form-selectgroup-item,
    .koi-edit-gender-field .form-selectgroup-item {
      margin: 0;
    }

    .koi-entry-gender-field .form-selectgroup-label,
    .koi-edit-gender-field .form-selectgroup-label {
      width: 40px;
      min-width: 40px;
      height: 40px;
      min-height: 40px;
      justify-content: center;
      padding: 0;
    }

    .koi-entry-gender-field .form-selectgroup-check,
    .koi-edit-gender-field .form-selectgroup-check {
      display: none;
    }

    .koi-entry-gender-field .icon,
    .koi-edit-gender-field .icon {
      width: 18px;
      height: 18px;
    }

    .koi-parent-preview-grid > div {
      display: flex;
      flex-direction: column;
      gap: .5rem;
      min-width: 0;
    }

    .koi-parent-preview-grid [data-edit-parent-female-preview],
    .koi-parent-preview-grid [data-edit-parent-male-preview],
    .koi-parent-preview-grid [data-entry-parent-female-preview],
    .koi-parent-preview-grid [data-entry-parent-male-preview] {
      min-height: 100px;
    }

    .koi-parent-preview-grid .koi-parent-preview-card {
      width: 100%;
      min-height: 100px;
      margin: 0;
    }

    .koi-parent-preview-grid .koi-parent-preview-field {
      height: 40px;
      min-height: 40px;
      margin-top: 0 !important;
    }

    .koi-entry-field-label {
      display: block;
      margin-bottom: .25rem;
      color: var(--tblr-secondary);
      font-size: .72rem;
      font-weight: 600;
      line-height: 1;
    }

    .koi-help-field {
      position: relative;
    }

    .koi-help-field .form-control,
    .koi-help-field .form-select {
      padding-right: 2.75rem;
    }

    .koi-help-field .input-icon .form-control {
      padding-left: 2.5rem;
      padding-right: 2.75rem;
    }

    .koi-help-field .form-help {
      position: absolute;
      top: 50%;
      right: .7rem;
      z-index: 2;
      width: 1.15rem;
      height: 1.15rem;
      min-width: 1.15rem;
      padding: 0;
      border: 1px solid var(--tblr-border-color);
      border-radius: var(--tblr-border-radius) !important;
      color: var(--tblr-secondary);
      background: var(--tblr-bg-surface-secondary);
      font-size: .72rem;
      font-weight: 700;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transform: translateY(-50%);
      cursor: pointer;
      box-shadow: none;
