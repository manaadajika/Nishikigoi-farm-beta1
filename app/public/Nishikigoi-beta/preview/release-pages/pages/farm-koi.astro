    })

    const patchSelectedKoi = async (overridesForItem, onProgress) => {
      const items = selectedKoiItems()
      const total = items.length

      for (let index = 0; index < total; index += 1) {
        const item = items[index]
        onProgress?.(index + 1, total, item)

        const response = await fetch(`${apiUrl}/koi/${item.id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(koiPatchPayload(item, overridesForItem(item))),
        })
        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error || 'Aksi masal gagal diproses')
        }
      }
    }

