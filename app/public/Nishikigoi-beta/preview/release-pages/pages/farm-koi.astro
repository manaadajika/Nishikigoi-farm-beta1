    const navbarSearchBox = document.querySelector('#navbar-global-search')
    if (navbarSearchBox) {
      navbarSearchBox.setAttribute('placeholder', 'Kode, nama, size 49-70cm, bloodline:isa')
      navbarSearchBox.setAttribute('title', 'Cari bebas: kode, nama, bloodline, ternakan, nomor urut, ukuran (49-70cm, <30, >40cm). Cari per kolom dengan kolom:isi, boleh digabung: bloodline:isa ternakan:dwd catatan:vat 03. Nama kolom boleh disingkat (bloo:isa, tern:dwd, br:miya). Kolom: nama kolom di formulir boleh ditulis persis dengan spasi, mis. Kode Koi:26G, Harga Jual:15jt (angka kecil di harga dibaca juta), Tanggal Lahir:2025, Terakhir Diedit:2026 - [10] Oktober - 20, Size Saat Ini:49-70, Indukan/Breeding:BR2609, Owner:arin, Typ:indukan; juga kode, nama, variety, bloodline, ternakan, breeding (sesi atau induk sesi), breeder, induk, kolam, area, status, gender, tipe, catatan, ukuran, hargabeli, hargajual, lahir, tanggalbeli, nomor.')
    }
    const parentTypeSelect = document.querySelector('[data-parent-type-select]')
    const genderSelect = document.querySelector('[data-gender-select]')
    const clearFiltersButton = document.querySelector('[data-clear-koi-filters]')
    const sequenceSortToggle = document.querySelector('[data-koi-sequence-toggle]')
    let koiItems = []

    // ---- Data Ikan: the list is served one page at a time (GET /koi/page, see api-php/lib/koi_query.php) ----------------
    // koiPageItems = the fish shown now; koiItems = every fish we know of (the page's, or the whole farm once a form needed
    // it); koiFacets = the values of the dropdown filters and suggestion menus.
    let koiPageItems = []
    let koiPageMeta = { total: 0, totalPages: 1, baseTotal: 0 }
    let koiFacets = {}
    let koiFacetsSignature = ''
    let koiQueryKey = ''
    let koiFetchSeq = 0
    let koiFetchController = null
    let koiPageTimer = null
    let koiReady = false
    let koiPageSignature = ''
    const koiSelectedCache = new Map()
    class KoiSelectionSet extends Set {
      add(id) {
        const item = koiPageItems.find((candidate) => String(candidate.id) === String(id))
        if (item) koiSelectedCache.set(String(id), item)
        return super.add(id)
      }
    }
    const uniqueKoiValues = (key) => koiFacets[key] || []
    const koiSequenceIndex = (item) => Number(item.seq) || koiSequenceById.get(String(item.id)) || 0
    const getFilteredKoi = () => koiPageItems
    const getVisibleKoi = () => koiPageItems
    const selectedKoiItems = () => [...selectedKoiIds]
      .map((id) => koiPageItems.find((item) => String(item.id) === String(id)) || koiSelectedCache.get(String(id)))
      .filter(Boolean)

    const koiQuery = () => {
      const f = {}
      filters.forEach((filter) => {
        const values = Array.from(filter.selectedOptions).map((option) => option.value).filter(Boolean)
        if (values.length) f[filter.dataset.filter] = values
      })
      const query = {
        archived: archiveMode ? '1' : '',
        q: searchInput.value.trim(),
        f,
        gender: selectedGenderFilter(),
        types: selectedParentTypeFilters().join(','),
        sort: sequenceSortDirection,
        page: currentPage,
        per_page: Math.min(pageSize, 5000),
      }
      if (showSelectedOnly || hideSelected) {
        query.ids = [...selectedKoiIds].map(String)
        query.ids_mode = showSelectedOnly ? 'only' : 'hide'
      }
      return query
    }

    // the full list is only fetched when a form, picker or import needs to look fish up
    const syncKoiSuperset = () => {
      // the fish we hold: the page, plus the selected ones that are on other pages
      const onPage = new Set(koiPageItems.map((item) => String(item.id)))
      koiItems = [...koiPageItems, ...[...koiSelectedCache.values()].filter((item) => !onPage.has(String(item.id)))]
    }
    
    const ensureKoiSelectionLoaded = () => {
      const missing = [...selectedKoiIds].filter((id) => !koiSelectedCache.has(String(id)) && !koiPageItems.some((item) => String(item.id) === String(id)))
      if (!missing.length) return Promise.resolve()
      return fetch(`${apiUrl}/koi/batch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: missing, archived: archiveMode ? '1' : '' }),
      })
        .then((response) => response.json())
        .then((items) => {
          ;(Array.isArray(items) ? items : []).forEach((item) => koiSelectedCache.set(String(item.id), item))
          syncKoiSuperset()
        })
        .catch(() => {})
    }

    // IDs typed in the search box that are not in this list but are in the archive: say so, with a way to get there.
    // Only for IDs (a code or a list of codes), never for other searches.
    const archiveHint = document.createElement('div')
    archiveHint.className = 'alert alert-info d-none mb-3'
    archiveHint.setAttribute('data-koi-archive-hint', '')
    cards.parentNode.insertBefore(archiveHint, cards)
    let archiveHintToken = 0
    const updateArchiveHint = () => {
      archiveHint.classList.add('d-none')
      const query = searchInput.value.trim()
      const tokens = splitCodeList(query)
      const idsOnly = tokens.length > 0 && tokens.length <= 50 && tokens.every((token) => /^[A-Za-z0-9][A-Za-z0-9_-]{3,}$/.test(token))
      if (archiveMode || !idsOnly || !window.KoiPicker) return
      const mine = ++archiveHintToken
      window.KoiPicker.byCodes(tokens, { scope: 'archived' }).then((rows) => {
        if (mine !== archiveHintToken || !rows.length) return
        const codes = rows.map((row) => row.code)
        const shown = codes.slice(0, 6).join(', ') + (codes.length > 6 ? ` dan ${codes.length - 6} lainnya` : '')
        const lead = koiPageMeta.total === 0
          ? `ID <strong>${escapeHtml(shown)}</strong> tidak ada di Data Ikan, tetapi ada di Arsip.`
          : `${codes.length} dari ${tokens.length} ID ada di Arsip, bukan di Data Ikan: <strong>${escapeHtml(shown)}</strong>.`
        archiveHint.innerHTML = `<div class="d-flex flex-wrap align-items-center justify-content-between gap-2"><span>${lead}</span><a class="btn btn-sm btn-primary" href="./farm-koi.html?arsip=1&cari=${encodeURIComponent(query)}">Lihat di Arsip</a></div>`
        archiveHint.classList.remove('d-none')
      }).catch(() => {})
    }

    const requestKoiPage = ({ force = false, silent = false } = {}) => {
      const query = koiQuery()
      const key = JSON.stringify(query)
      if (!force && key === koiQueryKey) return Promise.resolve()
      const token = ++koiFetchSeq
      if (koiFetchController) koiFetchController.abort()
      koiFetchController = new AbortController()
      const init = { signal: koiFetchController.signal }
      let url = `${apiUrl}/koi/page`
      if (Array.isArray(query.ids)) {
        init.method = 'POST'
        init.headers = { 'Content-Type': 'application/json' }
        init.body = key
      } else {
        url += '?' + new URLSearchParams({ ...query, f: JSON.stringify(query.f) }).toString()
      }
      return fetch(url, init)
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error('Data ikan gagal dimuat'))))
        .then((result) => {
          if (token !== koiFetchSeq) return
          const signature = JSON.stringify(result)
          const unchanged = silent && signature === koiPageSignature && koiReady
          koiPageSignature = signature
          koiPageItems = Array.isArray(result.items) ? result.items : []
          koiPageMeta = { total: result.total || 0, totalPages: result.total_pages || 1, baseTotal: result.base_total || 0 }
          currentPage = result.page || 1
          koiQueryKey = JSON.stringify(koiQuery())
          syncKoiSuperset()
          pendingViewFilters = null
          koiReady = true
          if (unchanged) return
          updateClearFiltersButton()
          renderCardsLocal()
          updateArchiveHint()
          applyPendingScroll()
          ensureKoiSelectionLoaded()
        })
        .catch((error) => {
          if (error && error.name === 'AbortError') return
          if (!silent) cards.innerHTML = '<div class="col-12 text-danger">Data ikan gagal dimuat.</div>'
        })
    }

    // renderCards() is still what every filter, search, sort, page and selection handler calls. When what the server needs
    // to know changed (not just a card highlight), it asks the server for the new page first.
    const renderCards = () => {
      if (!koiReady) return
      if (JSON.stringify(koiQuery()) === koiQueryKey) {
        renderCardsLocal()
        return
      }
      clearTimeout(koiPageTimer)
      koiPageTimer = setTimeout(() => {
        requestKoiPage()
      }, 120)
    }

    const loadKoiFacets = () => fetch(`${apiUrl}/koi/facets?fields=variety,bloodline,pond_name,status,breeder,farm_name${archiveMode ? '&archived=1' : ''}`)
      .then((response) => response.json())
      .then((facets) => {
        const signature = JSON.stringify(facets)
        const changed = signature !== koiFacetsSignature
        koiFacetsSignature = signature
        koiFacets = facets && typeof facets === 'object' ? facets : {}
        return changed
      })
      .catch(() => false)

    const loadKoi = (silent = false) => {
      if (!silent) koiItems = koiPageItems
      return loadKoiFacets().then((changed) => {
        if (changed || !koiReady) buildFilterOptions()
        return requestKoiPage({ force: true, silent })
      })
    }
    const restoreKoiCache = () => false

    const renderParentOptions = (extra = []) => {
      parentOptions.innerHTML = [...new Set([
        ...extra,
        ...breedingItems.flatMap((item) => {
          const maleFallback = [item.male_koi_code, item.male_koi_name].filter(Boolean).join(' - ')
          const femaleFallback = [item.female_koi_code, item.female_koi_name].filter(Boolean).join(' - ')

          return [
            ...breedingSearchValues(item),
            ...parseParentEntries(item.male_parent_entries, item.male_koi_id, maleFallback).map(parentLabel),
            ...parseParentEntries(item.female_parent_entries, item.female_koi_id, femaleFallback).map(parentLabel),
          ].filter(Boolean)
        }),
      ])].sort()
        .map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
    }
    const buildBreederOptions = () => {
      breederOptions.innerHTML = (koiFacets.breeder || []).map((value) => `
        <option value="${escapeHtml(value)}"></option>
      `).join('')
      renderParentOptions()
    }

    let textSuggestToken = 0
    const showTextSuggestMenu = (input, key) => {
      closeTextSuggestMenu()
      const query = input.value.trim().toLowerCase()
      const paint = (values) => {
        if (!values.length) return

        const menu = document.createElement('div')
        menu.className = 'koi-text-suggest-menu'
        values.forEach((value) => {
          const item = document.createElement('button')
          item.type = 'button'
          item.className = 'koi-text-suggest-item'
          item.textContent = value
          item.addEventListener('mousedown', (event) => {
            event.preventDefault()
            input.value = value
            input.dispatchEvent(new Event('input', { bubbles: true }))
            input.dispatchEvent(new Event('change', { bubbles: true }))
            closeTextSuggestMenu()
          })
          menu.appendChild(item)
        })

        closeTextSuggestMenu()
        document.body.appendChild(menu)
        const rect = input.getBoundingClientRect()
        const width = Math.max(rect.width, 200)
        menu.style.left = `${Math.min(rect.left, window.innerWidth - width - 8)}px`
        menu.style.top = `${rect.bottom + 4}px`
        menu.style.width = `${width}px`
        activeTextSuggestMenu = menu
      }
      if (Array.isArray(koiFacets[key])) {
        paint(koiFacets[key].filter((value) => !query || value.toLowerCase().includes(query)).slice(0, 8))
        return
      }
      // a value per fish (names): asked from the server while typing
      const mine = ++textSuggestToken
      fetch(`${apiUrl}/koi/facet-search?field=${encodeURIComponent(key)}&limit=8&q=${encodeURIComponent(input.value.trim())}${archiveMode ? '&archived=1' : ''}`)
        .then((response) => response.json())
        .then((values) => {
          if (mine === textSuggestToken && document.activeElement === input) paint(Array.isArray(values) ? values : [])
        })
        .catch(() => {})
    }

    let koiSequenceById = new Map()
    let breedingItems = []
    const selectedKoiIds = new KoiSelectionSet()
    let bulkEditKoiIds = []
    let showSelectedOnly = false
    let hideSelected = false
    let currentPage = 1
