    const viewStateKey = 'nishikigoi-view:farm-koi' + (archiveMode ? ':arsip' : '')
    let pendingViewFilters = null
    let pendingViewScroll = null
    let activeHelpPopover = null

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({
